{
	"name": "baka-page",
	"compatibility_date": "2026-08-05",
	"assets": {
		"directory": "./dist"
	},
	// Свой домен. Записан здесь, а не проставлен галочкой в панели Cloudflare,
	// нарочно: привязка живёт в репозитории и восстановится сама, если воркер
	// когда-нибудь придётся пересоздавать. `custom_domain: true` означает, что
	// Cloudflare сам заводит нужные записи в DNS и сам выпускает сертификат.
	//
	// Главный адрес — без www (тз/06, канонические адреса — следующая сессия).
	// www привязан тоже, чтобы набравший его по привычке не упёрся в ошибку.
	"routes": [
		{ "pattern": "bakapodcast.com", "custom_domain": true },
		{ "pattern": "www.bakapodcast.com", "custom_domain": true }
	]
}
