#!/bin/bash
# ЯРЛЫК: ОТКРЫТЬ АДМИНКУ И КНОПКУ «ВЫЛОЖИТЬ» (задача 26).
#
# Обёртка, и намеренно крошечная: вся работа в scripts/local-admin.mjs.
# Здесь только то, чего нельзя сделать из node, — открыть окно и найти node.
#
# ОКНО ЗАКРЫВАТЬ НЕЛЬЗЯ, ПОКА РАБОТАЕТЕ. Оно и есть сервер админки: пока окно
# открыто — админка жива, закрыли — выключилась. Поэтому здесь НЕТ ожидания
# Enter в конце, как у «Выложить-на-сайт.command»: там программа отработала
# и ушла, а тут она живёт, пока живёт окно.
#
# ИМЕНА ПЕРЕМЕННЫХ ТОЛЬКО ЛАТИНИЦЕЙ. Русское имя в bash не имя вовсе: строка
# выполняется как команда и падает, а обращение к ней разбирается как литерал
# и никогда не пусто. На этом уже обжигались (урок в CLAUDE.md).

cd "$(dirname "$0")" || exit 1

printf '\033]0;Админка Баки\007'
clear

NODE_BIN=""
for CANDIDATE in "$(command -v node)" /usr/local/bin/node /opt/homebrew/bin/node; do
	if [ -n "$CANDIDATE" ] && [ -x "$CANDIDATE" ]; then NODE_BIN="$CANDIDATE"; break; fi
done

if [ -z "$NODE_BIN" ]; then
	echo
	echo "✗ Не нашёл Node.js — без него админку не поднять."
	echo
	echo "ЧТО ДЕЛАТЬ: позовите Claude Code и скажите:"
	echo "«ярлык админки не находит node»."
	echo
	echo "Нажмите Enter, чтобы закрыть окно."
	read -r IGNORED
	exit 1
fi

"$NODE_BIN" scripts/local-admin.mjs
EXIT_CODE=$?

# Сюда доходим либо когда всё упало, либо когда человек нажал Ctrl+C.
# В первом случае надо дать прочитать написанное, во втором — не мешать.
if [ "$EXIT_CODE" -ne 0 ]; then
	echo
	echo "───────────────────────────────────────────────────────────────"
	echo "Не получилось — прочтите, что написано выше."
	echo "Нажмите Enter, чтобы закрыть окно."
	read -r IGNORED
fi

exit "$EXIT_CODE"
