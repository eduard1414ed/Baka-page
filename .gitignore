# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
# ЗАКРЫТЫ ВСЕ ФАЙЛЫ, НАЧИНАЮЩИЕСЯ НА .env, А НЕ ДВА ИМЕНИ.
# 26 августа 2026: резервная копия .env.бэкап-до-аналитики под прежние
# две строки не попала — git показал её в списке на коммит. Ключи внутри
# были настоящие. Копию делают руками в спешке, и имя у неё всегда новое.
.env*

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Python
__pycache__/
*.pyc

# рабочие файлы транскрипции (аудио, результаты, состояние) — живут на Hetzner
scripts/transcribe/tmp/
scripts/transcribe/output/
scripts/transcribe/state.json

# отчёт пересчёта падежных форм — сотни строк, читается один раз глазами
отчёт-падежи.txt

# отчёт разведки по кавычкам и широкой разметке постов — там же и по той же причине
отчёт-кавычки.txt

# отчёт сбора кандидатов в тайтлы (этап 11, часть C) — сотни строк, читается глазами
отчёт-кандидаты.txt

# кэш ответов Shikimori: чужие данные, а не наши. Нужен затем, чтобы прерванный
# прогон продолжался с места остановки и не спрашивал одно и то же дважды
.tmp-shikimori/

# рабочая папка разовых замеров этой сессии
.tmp-probe/

# лог долгого прогона сбора кандидатов
.tmp-candidates-run.log

# кэш ответов api.dtf.ru: чужие данные, качаются заново за секунду
# (scripts/dtf/source.mjs)
.tmp-dtf/

# отчёт поиска дубликатов постов (задача 19) — сотни строк, читается глазами
отчёт-дубликаты.txt

# замер блоков «упоминания» по собранному сайту: 658 строк, по строке на тайтл.
# Считается из dist/ за секунды и устаревает от каждого сохранения в админке,
# поэтому живёт на машине, а не в репозитории — как и остальные отчёты выше.
# Пересчитать: разбор dist/anime/*/index.html (см. статус/задача-31).
mentions.csv

# Черновики писем и отчётов, которые роботы пишут при каждом заходе. На GitHub
# Actions машина была одноразовой и они исчезали сами; на Hetzner роботы живут
# в постоянной папке, и без этих строк файлы копились бы в рабочей копии —
# рано или поздно попав в чужой коммит (задача 21).
notify.md
notify-covers.md
notify-index.md
notify-tg.md
mirror-report.txt

# Логи индексируемости страниц тайтлов. Пишутся при КАЖДОЙ сборке, нужны
# ровно для одного — сравнить нынешнюю сборку с прошлой на этой же машине
# (кто вошёл в индекс, кто выпал). Держатся 30 дней и убираются сами.
# В git не едут по общему правилу проекта: отчёты и логи остаются на машине,
# а выводы переезжают в статус/. Плюс отдельный довод: файл переписывается
# каждой сборкой, и попади он в репозиторий — быстрая выкладка отказывала бы
# на «незакоммиченном» после собственной же сборки.
build-logs/
