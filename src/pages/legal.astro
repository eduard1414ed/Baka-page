---
// Страница «Пользовательское соглашение» (/legal/).
//
// ТЕКСТ ЛЕЖИТ НЕ ЗДЕСЬ, а в src/content/pages/legal.md — и правится в админке,
// раздел «Страницы» → «Пользовательское соглашение». В этом файле только
// вёрстка, ровно как у «О проекте» и «Поддержать».
//
// ЧЕЛОВЕК ПРИШЁЛ ЧИТАТЬ ДОКУМЕНТ, поэтому здесь НЕТ блока соцсетей и блока
// поддержки — решение заказчика. Это единственное, чем страница отличается
// от двух соседних по устройству.
//
// В ПОИСК ПО САЙТУ СТРАНИЦА НЕ ПОПАДАЕТ, и отдельного запрета для этого
// не нужно: Pagefind берёт только то, у чего есть `data-pagefind-body`.
// Его тут нет — как нет на `/search/` и на 404. Правило одно на весь сайт,
// второй копии не заводим.
//
// В КАРТУ САЙТА ПОПАДАЕТ: это обычная публичная страница, и её адрес вписан
// в src/pages/sitemap.xml.ts рядом с `/about/` и `/support/`.
//
// НА ЗЕРКАЛО ЕДЕТ САМА: `едетНаЗеркало` в scripts/mirror-sync.mjs отсеивает
// только админку и её служебные файлы, и `legal/` под это не подходит.
// Проверено вызовом самой функции, а не чтением списка.
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/JsonLd.astro';
import { breadcrumbsSchema } from '../lib/schema.mjs';
import { excerptFromBody } from '../lib/excerpt.mjs';
import { SITE_DESCRIPTION } from '../lib/site.mjs';

// Файла может не быть — например, его удалили из админки. Страница тогда
// остаётся с одним заголовком, но собирается: ронять сборку всего сайта
// из-за одной страницы нельзя (CLAUDE.md).
const page = await getEntry('pages', 'legal');
const { Content } = page ? await render(page) : { Content: null };

const revision = page?.data.revision?.trim();
const hasBody = Boolean(page?.body?.trim());

// Описание для поисковика и превью — из первой фразы документа, тем же
// модулем, что у постов и у двух соседних страниц. Отдельного поля под него
// нет специально: ещё одно поле в админке, которое надо не забыть заполнить,
// однажды разойдётся с текстом.
const description = excerptFromBody(page?.body ?? '', SITE_DESCRIPTION);
---

<Layout title="Пользовательское соглашение" description={description}>
	<JsonLd slot="head" data={breadcrumbsSchema([{ name: 'Пользовательское соглашение', path: '/legal/' }])} />

	<div class="site">
		<article class="legal">
			{/* ДАТА РЕДАКЦИИ — ПЕРВАЯ СТРОКА СТРАНИЦЫ. Технический слой, как
			    надзаголовки на «О проекте» и «Поддержать»: это служебная пометка
			    к документу, а не часть его текста. */}
			{revision && <div class="eyebrow tech">{revision}</div>}
			<h1>Пользовательское соглашение</h1>

			{hasBody && Content && (
				<div class="legal-copy">
					<Content />
				</div>
			)}
		</article>
	</div>
</Layout>

<style>
	/* ЧИТАЛЬНАЯ КОЛОНКА — общий токен `--reading` (700 px), тот же, которым
	   набран текст любого материала. Своего числа здесь нет: колонка, шириной
	   отличающаяся от статьи на десяток точек, читается неряшливостью,
	   а не решением. */
	.legal {
		max-width: var(--reading);
		margin-block: var(--sp-12) var(--sp-12);
	}

	/* Все правила этого блока пишутся ОДНОЙ ФОРМОЙ СЕЛЕКТОРА — `.legal-copy`
	   плюс тег через `:global`. Разметка приезжает из markdown, классов на ней
	   нет и поставить их некуда; смешай формы — и правила начнут перебивать
	   друг друга по весу молча. */
	.legal-copy {
		margin-top: var(--sp-8);
	}

	/* Заголовки разделов («## 2. Сведения об Администрации»). Вид приходит
	   от общего правила `h2` в global.css — здесь только воздух вокруг:
	   у общего правила верхнего отступа нет вовсе, и разделы документа
	   слиплись бы в сплошную полосу. */
	.legal-copy :global(h2) {
		margin-block: var(--sp-12) var(--sp-4);
	}

	.legal-copy :global(h2:first-child) {
		margin-top: 0;
	}

	/* Адреса и домены в документе набраны служебным начертанием. Гарнитура —
	   та же, что у всего технического слоя; кегль НЕ уменьшаем, иначе адрес
	   почты в тексте станет мельче текста вокруг и будет читаться хуже
	   именно там, где его надо прочесть и переписать. */
	.legal-copy :global(code) {
		font-family: var(--font-tech);
		font-size: 0.92em;
		overflow-wrap: anywhere;
	}

	.legal-copy :global(p) {
		margin-block: 0 var(--sp-4);
		font-size: var(--body-lg);
		line-height: 1.65;
		color: var(--text);
	}

	/* Пункты соглашения набраны ОБЫЧНЫМ ТЕКСТОМ, а не списками разметки:
	   у списка номера считает браузер, и «10.2» превратилось бы в «1».
	   Правило ниже на случай, если список всё-таки появится: он не должен
	   выглядеть чужеродно. */
	.legal-copy :global(ul),
	.legal-copy :global(ol) {
		margin-block: 0 var(--sp-4);
		padding-left: 1.25em;
	}

	.legal-copy :global(li) {
		margin-bottom: var(--sp-2);
		line-height: 1.65;
	}

	.legal-copy :global(a) {
		color: var(--accent-text);
	}
</style>
