---
// «МОИ ДЕВЯТЬ АНИМЕ» — `/mybest/` (задача 22).
// ТЗ: тз/тз-22-moi-devyat-anime.md; размеры: тз/спецификация-22-вид.md;
// макет: холст «Моя девятка — интерфейс», экраны «Страница», «Выбор аниме»,
// «Телефон», «Картинка 16:9», «Картинка 9:16». Первая часть: справочник,
// страница, поиск, выбор. Вторая: картинка — выбор формата и «Скачать
// картинку» (рисует src/lib/mybestImage.mjs, см. «Картинка» в скрипте ниже).
//
// ЧТО ОТКУДА:
//   справочник своего каталога — `/mybest/titles.json` (titles.json.ts рядом),
//     качается при заходе на эту страницу и больше нигде;
//   поиск по своему каталогу — `matchQuery` из src/lib/animeMentions.mjs,
//     то есть тот же список названий, падежей и вариантов, что у упоминаний;
//   внешний поиск — src/lib/mybestExternal.mjs (Шикимори, потом AniList);
//   подпись под маркой — `shortTitle` из src/lib/animeShortTitle.mjs, одно
//     правило на страницу и будущую картинку;
//   что выбрано и как это живёт в адресе — src/lib/mybestState.mjs;
//   картинка — src/lib/mybestImage.mjs (раскладка и рисование), постеры
//     для неё — `picturePosters` из mybestExternal.mjs.
//
// В ПОИСК ПО САЙТУ СТРАНИЦА НЕ ИДЁТ: на ней нет `data-pagefind-body`, как
// и на `/search/`, — это инструмент, а не материал.
//
// ДВА ВИДА СТРАНИЦЫ (правки 3 октября 2026, вторая сессия):
//   своя девятка — правится; живёт в хранилище браузера, в адрес НЕ пишется:
//     ссылку собирает кнопка «Скопировать ссылку» в момент нажатия;
//   чужая — пришла ссылкой с девяткой в адресе. Только смотреть: ни плюсов,
//     ни кнопок у марок, ни правки подписи; кнопка «Собрать свою девятку»
//     ведёт на голый `/mybest/`. Своя сохранённая при этом не трогается.
//   Отдельно — ПРИГЛАШЕНИЕ со страницы тайтла (задача 23, метка `add=1`):
//     это своя девятка, начатая заново с этого тайтла; см. setup().
//
// ПЕРЕТАСКИВАНИЯ НЕТ, ЕСТЬ ПЕРЕСТАНОВКА НАЖАТИЯМИ (решение заказчика
// 3 октября 2026): ⇄ у одной марки, потом нажатие на место. Работает одинаково
// мышью и пальцем и не спорит с прокруткой страницы. В режиме перестановки
// каждая клетка, кроме двигаемой, становится целью: приглушённый постер,
// контур `--accent-text`, подпись «поставить сюда» / «поменять местами».
//
// СТИЛИ ГЛОБАЛЬНЫЕ, НО ТОЛЬКО ЭТОЙ СТРАНИЦЫ, И ВСЕ ОДНОЙ ФОРМОЙ — класс
// с приставкой `mb-`. Марки и строки выдачи собирает скрипт, а у собранного
// скриптом нет меток Astro: ограниченные стили до них бы не дотянулись,
// а смесь из ограниченных и `:global()` — это две формы селектора в одном
// компоненте.
//
// ВИДИМОСТЬ — ТОЛЬКО АТРИБУТОМ `hidden` НА ОБЁРТКАХ БЕЗ СВОЕГО `display`
// (`data-own-only`, `data-foreign-only`), раскладка — классами. Режимы
// никогда не прячут элемент правилом CSS (дизайн-система, §2.1).
import Layout from '../../layouts/Layout.astro';
import { DEFAULT_CAPTION, MAX_TEXT } from '../../lib/mybestState.mjs';
// Логотип в картинку — тот же файл, что в шапке (Header.astro): японские знаки
// в нём нарисованы, шрифтами сайта их не набрать.
import logo from '../../assets/images/logo-ink.png';

const DESCRIPTION =
	'Соберите девять любимых аниме и поделитесь подборкой: поиск по каталогу «Баки!», Шикимори и AniList.';
---

<Layout title="Мои девять аниме" description={DESCRIPTION}>
	<div class="site">
		<div class="mb" data-mybest data-logo={logo.src}>
			<div class="mb-intro">
				<h1 class="mb-title" data-title>Мои девять аниме</h1>
				{/* «—&nbsp;для&nbsp;канала» склеены: тире и предлог переносятся
				    вместе со словом, а не висят в конце строки (правка заказчика
				    3 октября 2026). */}
				<p class="mb-lead">
					Соберите свои любимые тайтлы или персональную подборку по жанрам и заберите красивую картинку
					—&nbsp;для&nbsp;канала, сторис или чтобы поспорить с друзьями.
				</p>
			</div>

			{/* У чужой девятки этого блока нет: её подпись стоит заголовком. */}
			<div class="mb-caption" data-own-only>
				<div data-own-only>
					<label for="mb-caption-input" class="eyebrow tech mb-label">подпись на картинке</label>
					<input
						id="mb-caption-input"
						class="mb-caption-input"
						type="text"
						value={DEFAULT_CAPTION}
						maxlength={MAX_TEXT}
						autocomplete="off"
						spellcheck="false"
					/>
					<p class="mb-note">Можно поменять: «9 аниме детства», «9 аниме, после которых я плакал».</p>
				</div>
			</div>

			<div class="mb-actions">
				{/* Картинка — только у своей девятки. Линии над блоком нет: её сняли
				    по решению заказчика 3 октября 2026 (третий заход). */}
				<div data-own-only>
					<div class="mb-picture">
						<span class="eyebrow tech mb-label" id="mb-format-label">формат картинки</span>
						<div class="mb-formats" role="group" aria-labelledby="mb-format-label">
							<button type="button" class="mb-format tech" data-format="9x16" aria-pressed="true">9:16</button>
							<button type="button" class="mb-format tech" data-format="16x9" aria-pressed="false">16:9</button>
						</div>
					</div>
					<div class="mb-buttons">
						<button type="button" class="mb-btn mb-btn-main" data-download>Скачать картинку</button>
						<button type="button" class="mb-btn" data-copy>Скопировать ссылку</button>
					</div>
					<p class="mb-note" data-picture-status aria-live="polite"></p>
				</div>
				<div data-foreign-only hidden>
					<a class="mb-btn" href="/mybest/">Собрать свою девятку</a>
				</div>
				<p class="visually-hidden" aria-live="polite" data-announce></p>
			</div>

			{/* Инструкция — в самом низу, над линией подвала (решение заказчика
			    3 октября 2026): она нужна, когда уже что-то выбрано, а не до. */}
			<div class="mb-help">
				<p class="mb-note" data-own-only>
					Подпись под маркой правится нажатием на неё. Чтобы поменять марки местами, нажмите ⇄ у одной
					и выберите место.
				</p>
				<p class="mb-note" data-foreign-only hidden>
					Это чужая девятка — её можно только смотреть. Ваша собственная не пропадёт.
				</p>
			</div>

			<section class="mb-picks" aria-label="Девять аниме">
				<div data-own-only>
					<div class="mb-head">
						<span class="eyebrow tech mb-count" data-count>выбрано 0 из 9</span>
						<button type="button" class="mb-clear tech" data-clear>Очистить всё</button>
					</div>
				</div>
				<ol class="mb-grid" data-grid></ol>
			</section>

			<dialog class="mb-dialog" data-dialog aria-labelledby="mb-dialog-title">
				<div class="mb-dialog-body">
					<div class="mb-dialog-head">
						<h2 class="mb-dialog-title" id="mb-dialog-title" data-dialog-title>Первое аниме</h2>
						<button type="button" class="mb-close tech" data-close>Закрыть</button>
					</div>
					<input
						class="mb-search"
						type="search"
						aria-label="Поиск аниме"
						placeholder="Название аниме"
						autocomplete="off"
						spellcheck="false"
						data-search
					/>
					<div class="mb-dialog-scroll">
						<p class="mb-status tech" data-status hidden></p>
						<ul class="mb-results" data-results></ul>
						<div class="mb-empty" data-empty hidden>
							<p class="mb-empty-title" data-empty-title></p>
							<p class="mb-empty-text" data-empty-text></p>
							<button type="button" class="mb-btn mb-manual" data-manual>Вписать руками</button>
						</div>
					</div>
				</div>
			</dialog>

			{/* Заготовки клеток. Собирает скрипт, вид задают стили ниже. */}
			<template data-tpl-slot>
				<li class="mb-cell">
					<button type="button" class="mb-slot">
						<svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
							<path d="M9 1v16M1 9h16"></path>
						</svg>
					</button>
				</li>
			</template>
			<template data-tpl-blank>
				<li class="mb-cell"><span class="mb-slot"></span></li>
			</template>
			<template data-tpl-pick>
				<li class="mb-cell">
					<figure class="mb-pick">
						<a class="mb-stamp"><span class="mb-perf"></span></a>
						<div class="mb-under mb-under-tall">
							<button type="button" class="mb-cap-edit"><span class="mb-cap"></span></button>
							<div class="mb-tools">
								<button type="button" class="mb-icon mb-move">
									<svg width="11" height="11" viewBox="0 0 11 11" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
										<path d="M1 3.5h9M7.5 1l2.5 2.5L7.5 6M10 7.5H1M3.5 5L1 7.5 3.5 10"></path>
									</svg>
								</button>
								<button type="button" class="mb-icon mb-remove">
									<svg width="11" height="11" viewBox="0 0 11 11" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
										<path d="M1 1l9 9M10 1L1 10"></path>
									</svg>
								</button>
							</div>
						</div>
					</figure>
				</li>
			</template>
			<template data-tpl-view>
				<li class="mb-cell">
					<figure class="mb-pick">
						<a class="mb-stamp"><span class="mb-perf"></span></a>
						<div class="mb-under">
							<p class="mb-cap"></p>
						</div>
					</figure>
				</li>
			</template>
			<template data-tpl-target>
				<li class="mb-cell">
					<button type="button" class="mb-target">
						<span class="mb-target-face"></span>
						<span class="mb-under mb-under-tall">
							<span class="mb-target-hint tech"></span>
						</span>
					</button>
				</li>
			</template>
			<template data-tpl-row>
				<li>
					<button type="button" class="mb-row">
						<span class="mb-thumb"></span>
						<span class="mb-row-text">
							<span class="mb-row-title"></span>
							<span class="mb-row-meta tech"></span>
						</span>
					</button>
				</li>
			</template>
		</div>
	</div>
</Layout>

<style is:global>
	/* ЧИСЛА — ИЗ ЗАКРЫТЫХ ШКАЛ ДИЗАЙН-СИСТЕМЫ (§3.2 кегли, §3.5 отступы).
	   Первая версия брала числа спецификации задачи (40, 19, 21, 17, 13 px,
	   отступы 30, 22, 36, 56), а их в шкалах нет; приведено 3 октября 2026.
	   Цвета — токены сайта. Ширина — общая оболочка `.site` (`--site`), как
	   у каталога, главной и поиска.

	   ПОРЯДОК: узкий экран, с 621 px — шире, с 1101 px — две колонки. */

	.mb {
		display: grid;
		grid-template-areas: 'intro' 'caption' 'picks' 'actions' 'help';
		padding-block: var(--sp-6) var(--sp-8);
	}

	.mb-intro {
		grid-area: intro;
	}

	/* Отступ от подводки стоит у блока подписи, а не у подводки: у чужой
	   девятки блока нет, и кнопка встаёт под подводкой с тем же отступом,
	   а не с двойным. */
	.mb-caption {
		grid-area: caption;
		margin-top: var(--sp-6);
	}

	.mb-picks {
		grid-area: picks;
		margin-top: var(--sp-6);
	}

	.mb-actions {
		grid-area: actions;
		margin-top: var(--sp-6);
	}

	.mb-help {
		grid-area: help;
		margin-top: var(--sp-6);
	}

	/* Кегль заголовка — общий H1 сайта (`h1` в global.css). Отступ до подводки
	   — общий отступ заголовка сайта (16), на широком экране 24: у H1 строка
	   тесная (1.02), и при двух строках — у чужой девятки заголовком стоит её
	   подпись — хвосты «р» и «у» вставали вплотную к подводке (замечание
	   заказчика 3 октября 2026; было 12). */
	.mb-title {
		margin-bottom: var(--sp-4);
	}

	.mb-lead {
		margin: 0;
		max-width: 30em;
		font-size: var(--body-sm);
		line-height: 1.5;
	}

	/* Надзаголовок общий (`.eyebrow` в global.css). Стоит в два класса,
	   потому что у `.eyebrow` свой отступ и равный вес решал бы порядок файлов. */
	.mb-label.eyebrow {
		display: block;
		margin-bottom: var(--sp-2);
	}

	/* ПОЛЕ — ТОЛЬКО НИЖНЯЯ ЛИНИЯ `--line`. Фокус: линия темнеет до `--ink`.
	   Общую акцентную обводку фокуса (`:focus-visible` в global.css) тут
	   снимаем: у текстового поля браузер включает её всегда, и поле стояло
	   в акцентной рамке по всему контуру. Замена равноценная — линия меняет
	   цвет, — без неё убирать обводку было бы нельзя. */
	.mb-caption-input,
	.mb-search {
		display: block;
		width: 100%;
		min-height: 44px;
		padding: var(--sp-2) 0;
		border: 0;
		border-bottom: 1px solid var(--line);
		border-radius: 0;
		background: transparent;
		color: var(--ink);
		font-family: var(--font-display);
		font-size: var(--body-md);
		/* 1.5, а не 1.15: у Literata хвосты «р», «у», «д» уходят ниже тесной
		   строки, и поле срезает их по краю (замечено заказчиком 3 октября 2026,
		   «Борут»). Та же грабля, что «гарнитура не помещается в свою строку». */
		line-height: 1.5;
		-webkit-appearance: none;
		appearance: none;
	}

	.mb-caption-input:focus,
	.mb-caption-input:focus-visible,
	.mb-search:focus,
	.mb-search:focus-visible {
		outline: none;
		border-bottom-color: var(--ink);
	}

	.mb-search::-webkit-search-decoration,
	.mb-search::-webkit-search-cancel-button {
		-webkit-appearance: none;
	}

	.mb-note {
		margin: var(--sp-2) 0 0;
		font-size: var(--caption);
		line-height: 1.45;
		color: var(--muted);
	}

	/* Кнопка — Outline button §8: min-height 44, рамка `--line`. */
	.mb-btn {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 var(--sp-4);
		border: 1px solid var(--line);
		border-radius: 0;
		background: transparent;
		color: var(--ink);
		font-family: var(--font-body);
		font-size: var(--body-sm);
		text-decoration: none;
		transition:
			color var(--transition-fast),
			border-color var(--transition-fast);
	}

	.mb-btn:hover,
	.mb-btn:focus-visible {
		border-color: var(--accent-text);
		color: var(--accent-text);
	}

	/* ——— Картинка ———
	   Кнопки формата — техслой с рамкой `--line`, выбранная — рамка и текст
	   `--ink`, начертание 600 (спецификация). Капслок и разрядку техслоя
	   пишем ЯВНО: на `<button>` браузер сбрасывает их своими правилами, и класс
	   `.tech` их не возвращает (урок CLAUDE.md). */
	.mb-picture {
		margin-bottom: var(--sp-6);
	}

	.mb-formats {
		display: flex;
		gap: var(--sp-2);
	}

	.mb-format {
		min-height: 44px;
		padding: 0 var(--sp-4);
		border: 1px solid var(--line);
		border-radius: 0;
		background: transparent;
		color: var(--muted);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		transition:
			color var(--transition-fast),
			border-color var(--transition-fast);
	}

	.mb-format:hover,
	.mb-format:focus-visible {
		border-color: var(--accent-text);
		color: var(--accent-text);
	}

	.mb-format[aria-pressed='true'] {
		border-color: var(--ink);
		color: var(--ink);
		font-weight: 600;
	}

	.mb-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-3);
	}

	/* «Скачать картинку» — заливка `--ink`, текст бумагой (спецификация).
	   Наведение — та же смена на акцент, что у кнопок с рамкой, только заливкой.
	   Погашенная (выбрано меньше девяти или идёт рисование) — вид кнопки
	   с рамкой и `--muted`; что случилось, говорит строка под кнопками. */
	.mb-btn.mb-btn-main {
		border-color: var(--ink);
		background: var(--ink);
		color: var(--paper);
	}

	.mb-btn.mb-btn-main:hover,
	.mb-btn.mb-btn-main:focus-visible {
		border-color: var(--accent-text);
		background: var(--accent-text);
		color: var(--paper);
	}

	.mb-btn.mb-btn-main:disabled {
		border-color: var(--line);
		background: transparent;
		color: var(--muted);
		cursor: default;
	}

	/* ——— Сетка девяти ———
	   Ровно три колонки, а не `auto-fill`: девятка — это 3×3 по смыслу,
	   на любой ширине. `auto-fill` в §4.5 дизайн-системы — про ленты, где число
	   колонок решает ширина экрана. */
	.mb-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--sp-4);
		margin-bottom: var(--sp-2);
	}

	.mb-count.eyebrow {
		margin: 0;
	}

	/* Цель нажатия 44 px, а строка над сеткой от этого не толстеет: лишнее
	   уходит в поля сверху и снизу. */
	.mb-clear {
		min-height: 44px;
		margin-block: calc(var(--sp-2) * -1);
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--muted);
	}

	.mb-clear:hover,
	.mb-clear:focus-visible {
		color: var(--accent-text);
	}

	.mb-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--sp-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.mb-cell {
		min-width: 0;
	}

	.mb-pick {
		margin: 0;
	}

	/* Пустая клетка: рамка `--line`, у своей девятки — плюс в центре.
	   Пропорция та же, что у марки рядом, иначе ряд прыгал бы. */
	.mb-slot {
		display: grid;
		place-items: center;
		width: 100%;
		aspect-ratio: var(--poster-ratio);
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 0;
		background: transparent;
		color: var(--line-strong);
		transition:
			border-color var(--transition-fast),
			color var(--transition-fast);
	}

	button.mb-slot:hover,
	button.mb-slot:focus-visible {
		border-color: var(--accent-text);
		color: var(--accent-text);
	}

	/* ——— Марка ———
	   ВИД ИЗ ДИЗАЙН-СИСТЕМЫ (§11, §9.0): постер заполняет рамку (`cover`),
	   рамка — от `--poster-ratio`, перфорация — кружками цвета бумаги по четырём
	   сторонам, теми же числами, что у вертикальной марки каталога
	   (AnimeCard.astro: полоса 12, кружок 5, шаг 18). Заливка `--line-soft`
	   видна только пока постера нет. */
	.mb-stamp {
		position: relative;
		display: block;
		aspect-ratio: var(--poster-ratio);
		overflow: hidden;
		background: var(--line-soft);
		color: var(--ink);
		transition: transform var(--transition-fast);
	}

	a.mb-stamp[href]:hover {
		transform: translateY(-3px);
	}

	.mb-stamp img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transition: opacity var(--transition-fast);
	}

	.mb-stamp .img-missing {
		height: 100%;
	}

	.mb-stamp::before,
	.mb-stamp::after {
		content: '';
		position: absolute;
		z-index: 3;
		left: 0;
		right: 0;
		height: 12px;
		pointer-events: none;
		background: radial-gradient(circle at 6px 0, var(--paper) 5px, transparent 5.5px) 0 0 / 18px 12px repeat-x;
	}

	.mb-stamp::before {
		top: -1px;
	}

	.mb-stamp::after {
		bottom: -1px;
		transform: rotate(180deg);
	}

	.mb-perf {
		position: absolute;
		z-index: 3;
		inset: 0;
		pointer-events: none;
	}

	.mb-perf::before,
	.mb-perf::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		width: 12px;
		background: radial-gradient(circle at 0 6px, var(--paper) 5px, transparent 5.5px) 0 0 / 12px 18px repeat-y;
	}

	.mb-perf::before {
		left: -1px;
	}

	.mb-perf::after {
		right: -1px;
		transform: rotate(180deg);
	}

	/* ПОД МАРКОЙ: подпись слева, кнопки столбиком справа (правка 3 октября
	   2026: в одной строке с годом кнопки читались приложением к году; год
	   снят совсем). Столбик — две зоны 44×44 (88), поднятые на 20 (см. `.mb-tools`),
	   поэтому место под маркой — 68 у своей девятки и у целей перестановки:
	   ряд не прыгает, когда клетка становится целью. */
	.mb-under {
		display: flex;
		align-items: flex-start;
		gap: var(--sp-1);
		margin-top: var(--sp-2);
	}

	.mb-under-tall {
		min-height: 68px;
	}

	/* Подпись под маркой: не больше трёх строк, дальше многоточие (вторая
	   из трёх мер против длинных названий; первая — `shortTitle`, третья —
	   правка нажатием). */
	.mb-cap {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		flex: 1 1 auto;
		min-width: 0;
		margin: 0;
		overflow: hidden;
		font-family: var(--font-display);
		font-size: var(--caption);
		line-height: 1.25;
		text-align: left;
		overflow-wrap: anywhere;
	}

	/* У своей девятки подпись — кнопка правки: цель нажатия ≥ 44.
	   ТЕКСТ — ОТДЕЛЬНЫМ ЭЛЕМЕНТОМ ВНУТРИ, прижатым к верху: своё содержимое
	   кнопка браузера ставит по вертикальной середине, и однострочная подпись
	   («Наруто») опускалась на 15 px ниже трёхстрочной соседки (замер
	   3 октября 2026). */
	.mb-cap-edit {
		display: flex;
		flex: 1 1 auto;
		align-items: flex-start;
		min-width: 0;
		min-height: 44px;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--ink);
		text-align: left;
		cursor: text;
	}

	.mb-cap-edit:hover,
	.mb-cap-edit:focus-visible {
		color: var(--accent-text);
	}

	.mb-cap-input {
		flex: 1 1 auto;
		min-width: 0;
		height: 44px;
		padding: 0;
		line-height: 1.5;
		border: 0;
		border-bottom: 1px solid var(--ink);
		border-radius: 0;
		background: transparent;
		color: var(--ink);
		font-family: var(--font-display);
		font-size: var(--caption);
	}

	.mb-cap-input:focus,
	.mb-cap-input:focus-visible {
		outline: none;
	}

	/* ЗНАЧКИ ВМЕСТЕ, ЗОНЫ ПО 44. Значок по центру своей зоны давал между ⇄ и ×
	   33 px, и × висел отдельно, как чужой элемент (замечание заказчика
	   3 октября 2026). Зоны сблизить нельзя — каждая 44×44, — поэтому сдвинуты
	   значки: ⇄ к низу своей зоны, × к верху своей, между ними 12.
	   Столбик поднят на 20 = зазор под маркой (8) + полоса перфорации (12):
	   так ⇄ встаёт вровень с первой строкой подписи, а верхняя зона заходит
	   только на декоративную полосу перфорации, не на постер. */
	.mb-tools {
		position: relative;
		z-index: 4;
		display: flex;
		flex: 0 0 44px;
		flex-direction: column;
		margin-top: calc(var(--sp-2) * -1 - 12px);
	}

	/* Значки 11 px в зонах 44×44. */
	.mb-icon {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--muted);
	}

	/* Два класса, а не один: у `.mb-icon` свой `place-items`, и при равном
	   весе исход решал бы порядок правил в файле. */
	.mb-icon.mb-move {
		align-items: end;
		padding-bottom: var(--sp-3);
	}

	.mb-icon.mb-remove {
		align-items: start;
	}

	.mb-icon:hover,
	.mb-icon:focus-visible,
	.mb-move[aria-pressed='true'] {
		color: var(--accent-text);
	}

	/* ——— Режим перестановки ———
	   ОТВЕЧАЕТ НА ДВА ВОПРОСА СРАЗУ. «Что двигаю» — марка остаётся как есть,
	   её ⇄ горит акцентом, строка над сеткой называет её: «куда переставить
	   «Кэйон!»?». «Куда можно» — каждая другая клетка целиком становится одной
	   кнопкой: постер приглушён прозрачностью, вокруг контур `--accent-text`,
	   под ним техническим слоем «поставить сюда» или «поменять местами».
	   Наведение и фокус возвращают цели постер в полную силу — так видно,
	   какую клетку сейчас выберешь. Выход — «Отменить» или Esc.
	   Без теней, скруглений и новых цветов. */
	.mb-target {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--ink);
		text-align: left;
	}

	.mb-target-face {
		display: block;
		outline: 1px solid var(--accent-text);
	}

	.mb-target-blank {
		display: block;
		aspect-ratio: var(--poster-ratio);
	}

	.mb-target-face .mb-stamp img,
	.mb-target-face .img-missing {
		opacity: 0.4;
	}

	.mb-target:hover .mb-stamp img,
	.mb-target:hover .img-missing,
	.mb-target:focus-visible .mb-stamp img,
	.mb-target:focus-visible .img-missing {
		opacity: 1;
	}

	.mb-target-hint {
		color: var(--accent-text);
	}

	/* ——— Окно выбора ———
	   ПО ЦЕНТРУ ЭКРАНА от 621 px: `margin: auto` у модального окна ставит его
	   в середину по обеим осям. Голова и поле стоят на месте, прокручивается
	   только выдача — внутри окна, а не страница под ним.

	   НА ТЕЛЕФОНЕ — К ВЕРХУ ТОГО, ЧТО ВИДНО НАД КЛАВИАТУРОЙ. Айфон, выдвигая
	   клавиатуру, НЕ уменьшает ни `100dvh`, ни окно страницы: окно выбора
	   растягивалось на весь экран, Safari уводил его вверх, и поле с первыми
	   строками выдачи оказывались за краем (снимок заказчика 3 октября 2026,
	   запрос «Ми»). Видимую область знает только `visualViewport`; её высоту
	   и сдвиг скрипт кладёт в `--mb-view-h` и `--mb-view-top`, пока окно
	   открыто. Нет переменных (браузер без `visualViewport`) — прежнее
	   поведение по `100dvh`. */
	.mb-dialog {
		width: calc(100% - var(--sp-8));
		max-width: 720px;
		margin: calc(var(--mb-view-top, 0px) + var(--sp-4)) auto auto;
		padding: 0;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 0;
		background: var(--paper);
		color: var(--ink);
	}

	.mb-dialog::backdrop {
		background: var(--paper-veil);
	}

	.mb-dialog-body {
		display: flex;
		flex-direction: column;
		max-height: calc(var(--mb-view-h, 100dvh) - var(--sp-8));
		padding: var(--sp-6) var(--sp-4) var(--sp-4);
	}

	.mb-dialog-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--sp-6);
		margin-bottom: var(--sp-4);
	}

	.mb-dialog-title {
		margin: 0;
		font-size: var(--h3);
		line-height: 1.12;
		letter-spacing: 0;
	}

	.mb-close {
		flex: 0 0 auto;
		min-height: 44px;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--muted);
	}

	.mb-close:hover,
	.mb-close:focus-visible {
		color: var(--accent-text);
	}

	.mb-dialog-scroll {
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.mb-status {
		margin: var(--sp-4) 0 0;
		color: var(--muted);
	}

	.mb-results {
		margin: var(--sp-4) 0 0;
		padding: 0;
		list-style: none;
	}

	.mb-row {
		display: flex;
		align-items: center;
		gap: var(--sp-4);
		width: 100%;
		min-height: 44px;
		padding: var(--sp-3) var(--sp-1);
		border: 0;
		border-top: 1px solid var(--line);
		border-radius: 0;
		background: transparent;
		color: var(--ink);
		text-align: left;
	}

	.mb-results > li:first-child .mb-row {
		border-top: 0;
	}

	.mb-row:hover .mb-row-title,
	.mb-row:focus-visible .mb-row-title {
		color: var(--accent-text);
	}

	.mb-row:disabled {
		cursor: default;
	}

	.mb-row:disabled .mb-row-title {
		color: var(--muted);
	}

	.mb-thumb {
		display: block;
		flex: 0 0 46px;
		width: 46px;
		height: 69px;
		overflow: hidden;
		background: var(--line-soft);
	}

	.mb-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.mb-row-text {
		display: block;
		min-width: 0;
	}

	.mb-row-title {
		display: block;
		font-family: var(--font-display);
		font-size: var(--body-lg);
		line-height: 1.25;
		transition: color var(--transition-fast);
	}

	.mb-row-meta {
		display: block;
		margin-top: var(--sp-1);
		color: var(--muted);
	}

	.mb-empty {
		margin-top: var(--sp-6);
	}

	.mb-empty-title {
		margin: 0 0 var(--sp-2);
		font-family: var(--font-display);
		font-size: var(--card-title);
		line-height: 1.15;
	}

	.mb-empty-text {
		margin: 0;
		font-size: var(--body-sm);
		line-height: 1.5;
		color: var(--muted);
	}

	.mb-manual {
		margin-top: var(--sp-4);
	}

	@media (min-width: 621px) {
		.mb {
			padding-block: var(--sp-8) var(--sp-12);
		}

		.mb-caption {
			margin-top: var(--sp-8);
		}

		.mb-title {
			margin-bottom: var(--sp-6);
		}

		/* На телефоне Body M: подпись по умолчанию («9 аниме, которые меня
		   сформировали») в Card title 20 в поле шириной 354 не помещалась. */
		.mb-caption-input,
		.mb-search {
			font-size: var(--card-title);
		}

		.mb-picks,
		.mb-actions,
		.mb-help {
			margin-top: var(--sp-8);
		}

		.mb-head {
			margin-bottom: var(--sp-4);
		}

		.mb-grid {
			gap: var(--sp-4);
			max-width: 460px;
		}

		.mb-dialog {
			width: calc(100% - var(--sp-16));
			margin: auto;
		}

		.mb-dialog-body {
			max-height: calc(var(--mb-view-h, 100dvh) - var(--sp-16));
			padding: var(--sp-8);
		}

		.mb-dialog-head {
			margin-bottom: var(--sp-6);
		}

		.mb-results {
			margin-top: var(--sp-6);
		}
	}

	/* Две колонки: управление слева, сетка справа (460 из спецификации),
	   зазор 64 по шкале. Сетка занимает всю высоту справа, левые блоки стоят
	   по верху, инструкция — по низу. */
	@media (min-width: 1101px) {
		.mb {
			grid-template-columns: minmax(0, 1fr) 460px;
			grid-template-rows: auto auto auto 1fr;
			grid-template-areas: 'intro picks' 'caption picks' 'actions picks' 'help picks';
			column-gap: var(--sp-16);
			align-items: start;
		}

		.mb-picks {
			margin-top: 0;
		}

		/* Последняя строка тянется до низа сетки, инструкция прижата к её низу —
		   то есть стоит прямо над линией подвала. */
		.mb-help {
			align-self: end;
		}

		/* ИНСТРУКЦИЯ — У ПОДВАЛА, ДАЖЕ КОГДА ОКНО ВЫШЕ СТРАНИЦЫ. С 3 октября 2026
		   подвал прижат к низу окна (`body > main` растёт, global.css), и на
		   большом мониторе между сеткой и подвалом появлялась пустота, а
		   инструкция оставалась у сетки (замечание заказчика). Поэтому рост
		   доходит до девятки: `main` и оболочка этой страницы — колонки flex,
		   `.mb` тянется на всю их высоту, и последняя строка грида (1fr) с
		   инструкцией вместе с ней. Внутри `main` здесь ровно одна оболочка,
		   внутри неё ровно `.mb` — полей между соседями, которые flex перестал
		   бы схлопывать, нет. Без `:has` (Safari до 15.4) — как было раньше. */
		main:has(> .site > .mb) {
			display: flex;
			flex-direction: column;
		}

		main:has(> .site > .mb) > .site {
			display: flex;
			flex: 1 0 auto;
			flex-direction: column;
		}

		.mb {
			flex: 1 0 auto;
		}
	}
</style>

<script>
	import { buildAnimeMatcher, matchQuery, fold } from '../../lib/animeMentions.mjs';
	import { shortTitle } from '../../lib/animeShortTitle.mjs';
	import { imageMissingHtml } from '../../lib/imageMissing.mjs';
	import {
		SLOTS,
		ORDINALS,
		MAX_TEXT,
		DEFAULT_CAPTION,
		emptyState,
		encodeState,
		decodeState,
		readStored,
		sameItem,
		isInvite,
		readInvite,
	} from '../../lib/mybestState.mjs';
	import { searchShikimori, searchAniList, lookupByIds, picturePosters } from '../../lib/mybestExternal.mjs';
	import { drawPicture, pixelSize, PICTURE_ADDRESS } from '../../lib/mybestImage.mjs';
	import { slugify } from '../../lib/slug.mjs';

	const STORE_KEY = 'mybest:v1';
	const CACHE_KEY = 'mybest:q:';
	/** Пауза в наборе перед походом к чужим сервисам. Свой каталог ищется сразу. */
	const PAUSE = 400;
	const SOURCE_LABEL = { shiki: 'шикимори', anilist: 'анилист' };

	type Item = {
		src: 'cat' | 'shiki' | 'anilist' | 'manual';
		id?: string;
		title: string;
		year?: number;
		studio?: string;
		poster?: string;
		thumb?: string;
		href?: string;
		label?: string;
	};
	type State = { caption: string; slots: (Item | null)[] };
	type Entry = { id: string; ru?: string; orig: string; year?: number; studio?: string; poster?: string; aliases?: string[]; auto?: string[] };

	// Справочник один на вкладку: переход по сайту без перезагрузки и возврат
	// на страницу не качают его второй раз.
	let catalogPromise: Promise<{ byId: Map<string, Entry>; matcher: any[] } | null> | null = null;

	function loadCatalog() {
		catalogPromise ??= fetch('/mybest/titles.json')
			.then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
			.then((list: Entry[]) => ({
				byId: new Map(list.map((e) => [e.id, e])),
				matcher: buildAnimeMatcher(
					list.map((e) => ({ id: e.id, data: { titleRu: e.ru, titleOriginal: e.orig, aliases: e.aliases, aliasesAuto: e.auto } })),
					{ quotes: 'ignore', speech: false },
				),
			}))
			.catch(() => {
				catalogPromise = null;
				return null;
			});
		return catalogPromise;
	}

	function fromCatalog(entry: Entry): Item {
		return {
			src: 'cat',
			id: entry.id,
			title: entry.ru || entry.orig,
			year: entry.year,
			studio: entry.studio,
			poster: entry.poster,
			thumb: entry.poster,
			href: `/anime/${entry.id}/`,
		};
	}

	// Хранилища браузера бывают выключены и бывают полны — ни то ни другое
	// не повод ломать страницу.
	const store = {
		get(key: string, session = false) {
			try {
				return (session ? sessionStorage : localStorage).getItem(key);
			} catch {
				return null;
			}
		},
		set(key: string, value: string, session = false) {
			try {
				(session ? sessionStorage : localStorage).setItem(key, value);
			} catch {}
		},
	};

	// ——— Картинка: постеры, шрифты, рисование, файл ———

	type Format = '9x16' | '16x9';
	type Delivery = 'downloaded' | 'shared' | 'cancelled' | 'tap';

	/** Ошибка, у которой есть что сказать человеку. */
	class PictureError extends Error {}

	const PICTURE_TIMEOUT = 10000;

	function withTimeout<T>(promise: Promise<T>, ms = PICTURE_TIMEOUT): Promise<T> {
		return Promise.race([promise, new Promise<T>((_, no) => setTimeout(() => no(new Error('timeout')), ms))]);
	}

	// КАРТИНКА ГРУЗИТСЯ КАК ДАННЫЕ, А НЕ ТЕГОМ. Скачанный файл превращается
	// в адрес внутри страницы (`blob:`), и холст считает его своим. Постер
	// чужого сервера, разрешившего чтение (AniList), проходит; не разрешившего —
	// падает здесь, на загрузке, а не потом на сохранении всей картинки.
	async function loadPicture(url: string) {
		const controller = new AbortController();
		const timer = setTimeout(() => controller.abort(), PICTURE_TIMEOUT);
		try {
			const response = await fetch(url, { mode: 'cors', credentials: 'omit', signal: controller.signal });
			if (!response.ok) return null;
			const blobUrl = URL.createObjectURL(await response.blob());
			const img = new Image();
			img.src = blobUrl;
			try {
				await img.decode();
				return img;
			} finally {
				URL.revokeObjectURL(blobUrl);
			}
		} catch {
			return null;
		} finally {
			clearTimeout(timer);
		}
	}

	// ВИД КАРТИНКИ — ИЗ СТИЛЕЙ САЙТА, А НЕ КОПИЕЙ ЧИСЕЛ. Цвета и пропорция
	// марки — токены; заглушка «изображения нет» снимается с настоящего
	// элемента (`imageMissingHtml` внутри марки страницы): рисунок, заливка,
	// доля ширины, прозрачность и наложение — какими их видит читатель.
	async function pictureLook(root: HTMLElement) {
		const css = getComputedStyle(document.documentElement);
		const token = (name: string) => css.getPropertyValue(name).trim();
		const probe = document.createElement('span');
		probe.className = 'mb-stamp';
		probe.setAttribute('aria-hidden', 'true');
		probe.style.cssText = 'position:absolute;left:-10000px;top:0;width:200px;visibility:hidden';
		probe.innerHTML = imageMissingHtml({ compact: true });
		const box = probe.querySelector<HTMLElement>('.img-missing')!;
		const art = box.querySelector('img')!;
		art.loading = 'eager';
		root.append(probe);
		try {
			const [image, logo] = await Promise.all([withTimeout(art.decode().then(() => art)).catch(() => null), loadPicture(root.dataset.logo!)]);
			if (!logo) throw new PictureError('logo');
			const artStyle = getComputedStyle(art);
			return {
				logo,
				look: {
					colors: {
						paper: token('--paper'),
						ink: token('--ink'),
						muted: token('--muted'),
						line: token('--line'),
						lineSoft: getComputedStyle(probe).backgroundColor,
					},
					fonts: { display: token('--font-display'), tech: token('--font-tech') },
					ratio: parseFloat(token('--poster-ratio')),
					missing: {
						image,
						fill: getComputedStyle(box).backgroundColor,
						share: art.getBoundingClientRect().width / box.getBoundingClientRect().width,
						alpha: parseFloat(artStyle.opacity),
						blend: artStyle.mixBlendMode === 'normal' ? 'source-over' : artStyle.mixBlendMode,
					},
				},
			};
		} finally {
			probe.remove();
		}
	}

	// ШРИФТЫ — ДО РИСОВАНИЯ. Холст не ждёт шрифт, как страница: не загруженный
	// — и подписи молча выходят Georgia, а видно это только на готовом файле.
	// Спрашиваем ровно те буквы, что пойдут в картинку: шрифты сайта разрезаны
	// по диапазонам знаков, и браузер грузит только нужные куски.
	async function fontsReady(fonts: { display: string; tech: string }, texts: string[]) {
		const family = (faces: FontFace[], name: string) => faces.some((f) => f.family.replace(/["']/g, '') === name && f.status === 'loaded');
		try {
			const [display, tech] = await withTimeout(
				Promise.all([
					document.fonts.load(`400 40px ${fonts.display}`, texts.join(' ')),
					document.fonts.load(`400 12px ${fonts.tech}`, `${PICTURE_ADDRESS} 0123456789`),
				]),
			);
			return family(display, 'Literata') && family(tech, 'IBM Plex Mono');
		} catch {
			return false;
		}
	}

	// Подписи приходят готовыми — те же, что под марками на странице
	// (`captionOf` в `setup`): второго правила подписи здесь нет.
	async function makePicture(
		format: Format,
		caption: string,
		items: Item[],
		captions: string[],
		progress: (done: number, total: number) => void,
	) {
		const root = document.querySelector<HTMLElement>('[data-mybest]')!;
		const [{ logo, look }, remote] = await Promise.all([pictureLook(root), picturePosters(items)]);
		if (!(await fontsReady(look.fonts, [caption, ...captions]))) throw new PictureError('fonts');

		// Откуда постер: свой каталог — свой файл; AniList — крупный с AniList,
		// не ответил — тот, что был на странице; Шикимори — ТОЛЬКО через AniList
		// (свой сервер Шикимори сохранять картинку не разрешает); ручная — без.
		const sources = items.map((item) => {
			if (item.src === 'cat') return item.poster ?? null;
			if (item.src === 'anilist') return remote.get(`anilist:${item.id}`) ?? item.poster ?? null;
			if (item.src === 'shiki') return remote.get(`shiki:${item.id}`) ?? null;
			return null;
		});
		let done = 0;
		const expected = sources.filter(Boolean).length;
		progress(0, expected);
		const images = await Promise.all(
			sources.map(async (url) => {
				if (!url) return null;
				const img = await loadPicture(url);
				progress(++done, expected);
				return img;
			}),
		);
		// Не нашлось или не загрузилось то, что должно было быть, — назовём.
		// У ручной марки постера нет по замыслу, это не потеря.
		const missing = items.flatMap((item, i) => (item.src !== 'manual' && !images[i] ? [captions[i]] : []));

		const canvas = document.createElement('canvas');
		drawPicture(canvas, {
			format,
			caption,
			cells: captions.map((text, i) => ({ caption: text, year: items[i].year, image: images[i] })),
			logo,
			look,
		});
		const blob = await new Promise<Blob | null>((ok) => {
			try {
				canvas.toBlob(ok, 'image/jpeg', 0.92);
			} catch {
				ok(null);
			}
		});
		if (!blob) throw new PictureError('save');
		return { blob, missing };
	}

	// ИМЯ ФАЙЛА — ИЗ ПОДПИСИ, ЛАТИНИЦЕЙ: `baka-9-anime-kotorye-menya-sformirovali-9x16.jpg`.
	// Латиницей, потому что русское имя файла телефоны и мессенджеры коверкают.
	// Длинная подпись режется до 60 знаков по границе слова, а не посреди него.
	const FILE_WORDS = 60;
	function fileName(caption: string, format: Format) {
		const slug = slugify(caption);
		const words = slug.length > FILE_WORDS ? slug.slice(0, FILE_WORDS + 1).replace(/-[^-]*$/, '') : slug;
		return `baka-${words || 'moi-9-anime'}-${format}.jpg`;
	}

	// ТЕЛЕФОН. Айфон по ссылке «скачать» кладёт файл в приложение «Файлы»,
	// а сторис берут картинку из «Фото» — поэтому на айфоне открываем меню
	// «Поделиться» с файлом: в нём есть «Сохранить изображение» (в «Фото»)
	// и сразу Телеграм. Меню браузер открывает только сразу после нажатия;
	// опоздали — просим нажать ещё раз (`tap`). Остальные — обычная загрузка:
	// компьютер и Андроид кладут файл в «Загрузки».
	async function deliver(file: File): Promise<Delivery> {
		const apple = /iPhone|iPad|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
		if (apple && navigator.canShare?.({ files: [file] })) {
			try {
				await navigator.share({ files: [file] });
				return 'shared';
			} catch (error) {
				const name = (error as Error)?.name;
				if (name === 'AbortError') return 'cancelled';
				if (name === 'NotAllowedError') return 'tap';
			}
		}
		const link = document.createElement('a');
		link.href = URL.createObjectURL(file);
		link.download = file.name;
		document.body.append(link);
		link.click();
		link.remove();
		setTimeout(() => URL.revokeObjectURL(link.href), 60000);
		return 'downloaded';
	}

	function pictureError(error: unknown) {
		const kind = error instanceof PictureError ? error.message : '';
		if (kind === 'fonts')
			return 'Не загрузились шрифты сайта — без них подписи вышли бы не той гарнитурой. Проверьте интернет и нажмите «Скачать картинку» ещё раз.';
		if (kind === 'save')
			return 'Браузер не разрешил сохранить картинку. Нажмите ещё раз; если не выйдет снова — откройте страницу в другом браузере.';
		if (kind === 'logo') return 'Не загрузился логотип сайта. Проверьте интернет и нажмите «Скачать картинку» ещё раз.';
		return 'Картинку нарисовать не вышло. Обновите страницу и нажмите «Скачать картинку» ещё раз.';
	}

	// Esc выводит из режима перестановки. Слушатель один на вкладку: при
	// переходах без перезагрузки `setup` зовётся заново и только меняет,
	// кого звать.
	let onEscape: (() => void) | null = null;
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') onEscape?.();
	});

	function setup() {
		onEscape = null;
		const root = document.querySelector<HTMLElement>('[data-mybest]');
		if (!root) return;

		const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
		const grid = $<HTMLOListElement>('[data-grid]');
		const count = $<HTMLElement>('[data-count]');
		const clear = $<HTMLButtonElement>('[data-clear]');
		const captionInput = $<HTMLInputElement>('#mb-caption-input');
		const title = $<HTMLElement>('[data-title]');
		const copy = $<HTMLButtonElement>('[data-copy]');
		const announce = $<HTMLElement>('[data-announce]');
		const dialog = $<HTMLDialogElement>('[data-dialog]');
		const dialogTitle = $<HTMLElement>('[data-dialog-title]');
		const search = $<HTMLInputElement>('[data-search]');
		const status = $<HTMLElement>('[data-status]');
		const results = $<HTMLUListElement>('[data-results]');
		const empty = $<HTMLElement>('[data-empty]');
		const emptyTitle = $<HTMLElement>('[data-empty-title]');
		const emptyText = $<HTMLElement>('[data-empty-text]');
		const tpl = (name: string) => $<HTMLTemplateElement>(`[data-tpl-${name}]`);
		const clone = (name: string) => tpl(name).content.firstElementChild!.cloneNode(true) as HTMLElement;

		// ЧУЖАЯ ИЛИ СВОЯ. Девятка в адресе — это ссылка, которую кто-то прислал:
		// показываем её только для просмотра и в хранилище НЕ ПИШЕМ НИЧЕГО —
		// своя сохранённая девятка от этого не меняется. Исключение одно:
		// человек открыл ссылку на собственную девятку (совпала с сохранённой
		// до буквы) — тогда это своя, и адрес становится голым.
		//
		// ТРЕТИЙ СЛУЧАЙ — ПРИГЛАШЕНИЕ со страницы тайтла (задача 23, метка
		// `add=1`, см. mybestState.mjs). Это не чужая девятка, а начало своей:
		// прежняя очищается (решение заказчика), тайтл встаёт первым, всё
		// сохраняется сразу, а адрес становится голым — иначе обновление
		// страницы очищало бы девятку заново.
		const invite = isInvite(location.search);
		const invited = readInvite(location.search) as State | null;
		if (invited) store.set(STORE_KEY, JSON.stringify(invited));
		const own = invited ?? (readStored(store.get(STORE_KEY) ?? '') as State | null);
		const fromUrl = invite ? null : (decodeState(location.search) as State | null);
		const foreign = !!fromUrl && encodeState(fromUrl) !== encodeState(own ?? emptyState());
		if (invite || (fromUrl && !foreign)) history.replaceState(history.state, '', location.pathname);

		let state: State = foreign ? fromUrl! : (own ?? (emptyState() as State));
		let openSlot = -1;
		let moving = -1;
		let editing = -1;

		for (const el of root.querySelectorAll<HTMLElement>('[data-own-only]')) el.hidden = foreign;
		for (const el of root.querySelectorAll<HTMLElement>('[data-foreign-only]')) el.hidden = !foreign;
		captionInput.value = state.caption;
		// У чужой девятки заголовок страницы — её подпись (решение заказчика
		// 3 октября 2026): это название подборки, «Мои девять аниме» тут неправда.
		if (foreign) title.textContent = state.caption;

		function save() {
			if (!foreign) store.set(STORE_KEY, JSON.stringify(state));
		}

		function change() {
			save();
			render();
		}

		// ——— Картинка ———
		// Нажали «Скачать картинку» — кнопка гаснет до конца работы (второе
		// нажатие ничего не плодит), строка под кнопками говорит, что идёт
		// и сколько ждать. Готовый файл помнится, пока девятка и формат те же:
		// на айфоне меню «Сохранить изображение» открывается только по нажатию,
		// и если рисование заняло дольше, чем браузер ждёт после нажатия,
		// кнопка становится «Сохранить картинку» — повторно рисовать не надо.
		const download = $<HTMLButtonElement>('[data-download]');
		const pictureStatus = $<HTMLElement>('[data-picture-status]');
		const formatButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-format]')];
		let format: Format = '9x16';
		let drawing = false;
		let ready: { key: string; file: File; missing: string[] } | null = null;
		let noteKey = '';

		const pictureKey = () => `${format}|${encodeState(state)}`;

		function note(text: string) {
			pictureStatus.textContent = text;
			noteKey = pictureKey();
		}

		function updateDownload() {
			const filled = state.slots.filter(Boolean).length;
			const key = pictureKey();
			if (ready && ready.key !== key) ready = null;
			download.disabled = drawing || filled < SLOTS;
			download.textContent = drawing ? 'Рисуем…' : ready ? 'Сохранить картинку' : 'Скачать картинку';
			if (drawing) return;
			// Сообщение о прошлой картинке живёт, пока девятка та же.
			if (noteKey !== key) note(filled < SLOTS ? `Картинка соберётся, когда будут выбраны все девять — сейчас ${filled}.` : '');
		}

		for (const button of formatButtons) {
			button.addEventListener('click', () => {
				format = button.dataset.format as Format;
				for (const b of formatButtons) b.setAttribute('aria-pressed', String(b === button));
				updateDownload();
			});
		}

		download.addEventListener('click', async () => {
			if (drawing) return;
			const key = pictureKey();
			if (ready?.key === key) return void tell(await deliver(ready.file), ready.file, ready.missing);
			if (state.slots.filter(Boolean).length < SLOTS) return;

			drawing = true;
			ready = null;
			updateDownload();
			const size = pixelSize(format);
			const name = format === '9x16' ? '9:16' : '16:9';
			note(`Рисуем картинку ${name} — обычно это занимает несколько секунд.`);
			try {
				const items = state.slots.map((item) => item!);
				const picture = await makePicture(
					format,
					state.caption,
					items,
					items.map((item) => captionOf(item).caption),
					(done, total) => note(`Рисуем картинку ${name} — обычно это занимает несколько секунд. Постеры: ${done} из ${total}.`),
				);
				const file = new File([picture.blob], fileName(state.caption, format), { type: picture.blob.type });
				ready = { key, file, missing: picture.missing };
				drawing = false;
				updateDownload();
				tell(await deliver(file), file, picture.missing, size);
			} catch (error) {
				note(pictureError(error));
			} finally {
				drawing = false;
				updateDownload();
			}
		});

		function tell(outcome: Delivery, file: File, missing: string[], size = pixelSize(format)) {
			const where = {
				downloaded: `Картинка скачана: ${file.name}, ${size.width}×${size.height}. Она в папке «Загрузки».`,
				shared: `Готово: ${file.name}, ${size.width}×${size.height}.`,
				cancelled: 'Сохранение отменено. Картинка готова — нажмите «Сохранить картинку», чтобы открыть меню ещё раз.',
				tap: 'Картинка готова — нажмите «Сохранить картинку».',
			}[outcome];
			const lost = missing.length
				? ` Не загрузилось постеров: ${missing.length} (${missing.map((t) => `«${t}»`).join(', ')}) — на их месте заглушка «изображения нет». Можно нажать ещё раз через минуту.`
				: '';
			// Отданный файл больше не держим: следующее нажатие рисует заново —
			// и заново пробует постеры, которые не загрузились. Держим только
			// не отданный (айфон ждёт второго нажатия).
			if (outcome === 'downloaded' || outcome === 'shared') ready = null;
			note(where + lost);
			updateDownload();
		}

		function captionOf(item: Item) {
			// Марка каталога из ссылки до прихода справочника знает только адрес.
			const title = item.title || item.id || '';
			return { title, caption: item.label || shortTitle(title) };
		}

		// ——— Сетка ———

		function render() {
			const filled = state.slots.filter(Boolean).length;
			const movingItem = moving >= 0 ? state.slots[moving] : null;
			count.textContent = movingItem ? `куда переставить «${captionOf(movingItem).caption}»?` : `выбрано ${filled} из ${SLOTS}`;
			if (!foreign) updateDownload();
			clear.textContent = movingItem ? 'Отменить' : 'Очистить всё';
			clear.disabled = !movingItem && filled === 0;
			onEscape = movingItem ? cancelMove : null;
			grid.replaceChildren(
				...state.slots.map((item, i) => {
					if (foreign) return item ? pickCell(item, i, 'view') : clone('blank');
					if (movingItem && i !== moving) return targetCell(item, i);
					return item ? pickCell(item, i, 'pick') : slotCell(i);
				}),
			);
		}

		function slotCell(i: number) {
			const cell = clone('slot');
			const button = cell.querySelector<HTMLButtonElement>('.mb-slot')!;
			button.dataset.slot = String(i);
			button.setAttribute('aria-label', `Выбрать ${ORDINALS[i]} аниме`);
			return cell;
		}

		function fillStamp(stamp: HTMLElement, item: Item) {
			if (item.poster) {
				const img = document.createElement('img');
				img.src = item.poster;
				img.alt = '';
				img.decoding = 'async';
				if (item.src !== 'cat') img.referrerPolicy = 'no-referrer';
				stamp.prepend(img);
			} else if (item.src === 'manual') {
				// Постера нет и не будет — заглушка обязательна (§9.1). У внешних
				// без постера её нет: постер ещё дозапрашивается.
				stamp.insertAdjacentHTML('afterbegin', imageMissingHtml({ compact: true }));
			}
		}

		function pickCell(item: Item, i: number, kind: 'pick' | 'view') {
			const cell = clone(kind);
			const { title, caption } = captionOf(item);

			const stamp = cell.querySelector<HTMLAnchorElement>('.mb-stamp')!;
			stamp.dataset.slot = String(i);
			if (item.href) {
				stamp.href = item.href;
				if (item.src !== 'cat') {
					stamp.target = '_blank';
					stamp.rel = 'noopener';
				}
				stamp.setAttribute('aria-label', item.src === 'cat' ? `«${title}» в каталоге «Баки!»` : `«${title}» на сайте ${SOURCE_LABEL[item.src as 'shiki']}`);
			} else {
				stamp.setAttribute('role', 'img');
				stamp.setAttribute('aria-label', `«${title}»`);
			}
			fillStamp(stamp, item);

			const cap = cell.querySelector<HTMLElement>('.mb-cap')!;
			cap.textContent = caption;
			if (kind === 'view') return cell;

			const edit = cell.querySelector<HTMLButtonElement>('.mb-cap-edit')!;
			edit.dataset.slot = String(i);
			edit.setAttribute('aria-label', `Подпись «${caption}», править`);
			const move = cell.querySelector<HTMLButtonElement>('.mb-move')!;
			move.dataset.slot = String(i);
			move.setAttribute('aria-label', moving === i ? `Не переставлять «${caption}»` : `Переставить «${caption}»`);
			move.setAttribute('aria-pressed', String(moving === i));
			const remove = cell.querySelector<HTMLButtonElement>('.mb-remove')!;
			remove.dataset.slot = String(i);
			remove.setAttribute('aria-label', `Убрать «${caption}»`);
			return cell;
		}

		// Цель перестановки: вся клетка — одна кнопка.
		function targetCell(item: Item | null, i: number) {
			const cell = clone('target');
			const button = cell.querySelector<HTMLButtonElement>('.mb-target')!;
			button.dataset.slot = String(i);
			const face = cell.querySelector<HTMLElement>('.mb-target-face')!;
			const hint = cell.querySelector<HTMLElement>('.mb-target-hint')!;
			if (item) {
				const stamp = document.createElement('span');
				stamp.className = 'mb-stamp';
				stamp.innerHTML = '<span class="mb-perf"></span>';
				fillStamp(stamp, item);
				face.append(stamp);
				hint.textContent = 'поменять местами';
				button.setAttribute('aria-label', `Поменять местами с «${captionOf(item).caption}»`);
			} else {
				const blank = document.createElement('span');
				blank.className = 'mb-target-blank';
				face.append(blank);
				hint.textContent = 'поставить сюда';
				button.setAttribute('aria-label', `Поставить на ${ORDINALS[i]} место`);
			}
			return cell;
		}

		function focusSlot(selector: string, i: number) {
			grid.querySelector<HTMLElement>(`${selector}[data-slot="${i}"]`)?.focus();
		}

		function cancelMove() {
			if (moving < 0 || dialog.open) return;
			const i = moving;
			moving = -1;
			render();
			focusSlot('.mb-move', i);
			say('Перестановка отменена');
		}

		function place(target: number) {
			const slots = [...state.slots];
			[slots[moving], slots[target]] = [slots[target], slots[moving]];
			state.slots = slots;
			moving = -1;
			change();
			focusSlot('.mb-move', target);
			say(`Поставлено на ${ORDINALS[target]} место`);
		}

		grid.addEventListener('click', (event) => {
			if (foreign) return;
			const el = (event.target as Element).closest<HTMLElement>('[data-slot]');
			if (!el) return;
			const i = Number(el.dataset.slot);

			// В режиме перестановки: цель — ставим; что-то у самой двигаемой
			// марки (⇄, подпись, постер-ссылка) — отменяем, никуда не уходя.
			if (moving >= 0) {
				event.preventDefault();
				if (el.classList.contains('mb-target')) place(i);
				else cancelMove();
				return;
			}
			if (el.classList.contains('mb-move')) {
				moving = i;
				render();
				focusSlot('.mb-move', i);
				say('Выберите место: другие клетки стали кнопками');
			} else if (el.classList.contains('mb-slot')) openPicker(i);
			else if (el.classList.contains('mb-remove')) {
				const title = state.slots[i]?.title;
				state.slots[i] = null;
				change();
				say(`«${title}» убрано`);
				focusSlot('.mb-slot', i);
			} else if (el.classList.contains('mb-cap-edit')) editLabel(i, el as HTMLButtonElement);
		});

		clear.addEventListener('click', () => {
			if (moving >= 0) return cancelMove();
			state.slots = Array(SLOTS).fill(null);
			change();
			say('Девятка очищена');
		});

		// ——— Правка подписи под маркой ———

		function editLabel(i: number, cap: HTMLButtonElement) {
			const item = state.slots[i];
			if (!item || editing >= 0) return;
			editing = i;
			const input = document.createElement('input');
			input.className = 'mb-cap-input';
			input.type = 'text';
			input.maxLength = MAX_TEXT;
			input.value = captionOf(item).caption;
			input.setAttribute('aria-label', `Подпись под маркой «${item.title}». Пустая — вернётся название.`);
			cap.replaceWith(input);
			input.focus();
			input.select();

			let done = false;
			const finish = (keep: boolean) => {
				if (done) return;
				done = true;
				editing = -1;
				if (keep) {
					const value = input.value.replace(/\s+/g, ' ').trim();
					item.label = value && value !== shortTitle(item.title) ? value : undefined;
					change();
				} else render();
				focusSlot('.mb-cap-edit', i);
			};
			input.addEventListener('keydown', (event) => {
				if (event.key === 'Enter') finish(true);
				if (event.key === 'Escape') {
					event.preventDefault();
					event.stopPropagation();
					finish(false);
				}
			});
			input.addEventListener('blur', () => finish(true));
		}

		// ——— Подпись над картинкой, ссылка ———

		captionInput.addEventListener('input', () => {
			state.caption = captionInput.value.replace(/\s+/g, ' ').trim() || DEFAULT_CAPTION;
			save();
			updateDownload();
		});

		// Ссылка собирается в момент нажатия: адрес своей страницы остаётся
		// голым, иначе перезагрузка превращала бы свою девятку в «чужую».
		let copyTimer = 0;
		copy.addEventListener('click', async () => {
			const tail = encodeState(state);
			const link = `${location.origin}/mybest/${tail ? `?${tail}` : ''}`;
			let ok = false;
			try {
				await navigator.clipboard.writeText(link);
				ok = true;
			} catch {}
			copy.textContent = ok ? 'Ссылка скопирована' : 'Не вышло скопировать';
			say(ok ? 'Ссылка скопирована' : `Не вышло скопировать. Ссылка: ${link}`);
			clearTimeout(copyTimer);
			copyTimer = window.setTimeout(() => (copy.textContent = 'Скопировать ссылку'), 2500);
		});

		function say(text: string) {
			announce.textContent = text;
		}

		// ——— Окно выбора ———

		let token = 0;
		let pauseTimer = 0;

		function openPicker(i: number) {
			openSlot = i;
			const name = ORDINALS[i];
			dialogTitle.textContent = `${name[0].toUpperCase()}${name.slice(1)} аниме`;
			search.value = '';
			showRows([]);
			setStatus('');
			empty.hidden = true;
			dialog.showModal();
			fitView();
			view?.addEventListener('resize', fitView);
			view?.addEventListener('scroll', fitView);
			search.focus();
			void loadCatalog();
		}

		// Видимая область над клавиатурой — см. «Окно выбора» в стилях.
		const view = window.visualViewport;
		function fitView() {
			if (!view) return;
			dialog.style.setProperty('--mb-view-h', `${view.height}px`);
			dialog.style.setProperty('--mb-view-top', `${view.offsetTop}px`);
		}

		// ОКНО ЗАКРЫВАЕТСЯ ТОЛЬКО ЗДЕСЬ. Браузер сообщает о закрытии событием
		// `close` с опозданием, уже следующей задачей: открой окно на другой
		// клетке сразу после выбора — и опоздавшее событие забыло бы, в какую
		// клетку выбирают (поймано прогоном страницы, 3 октября 2026). Поэтому
		// Escape тоже идёт сюда, а не в штатное закрытие.
		function closePicker() {
			token++;
			clearTimeout(pauseTimer);
			const back = openSlot;
			openSlot = -1;
			view?.removeEventListener('resize', fitView);
			view?.removeEventListener('scroll', fitView);
			if (dialog.open) dialog.close();
			focusSlot('', back);
		}

		dialog.addEventListener('cancel', (event) => {
			event.preventDefault();
			closePicker();
		});
		// Нажатие на подложку вокруг окна закрывает его, как «Закрыть». Подложка
		// и поля самого окна для браузера — один и тот же элемент, поэтому
		// смотрим, куда пришлось нажатие, а не на что.
		dialog.addEventListener('click', (event) => {
			if (event.target !== dialog) return;
			const box = dialog.getBoundingClientRect();
			const inside = event.clientX >= box.left && event.clientX <= box.right && event.clientY >= box.top && event.clientY <= box.bottom;
			if (!inside) closePicker();
		});
		root.querySelector('[data-close]')!.addEventListener('click', closePicker);

		function setStatus(text: string) {
			status.textContent = text;
			status.hidden = !text;
		}

		function showRows(items: Item[]) {
			results.replaceChildren(...items.map(row));
		}

		function row(item: Item) {
			const li = clone('row');
			const button = li.querySelector<HTMLButtonElement>('.mb-row')!;
			const thumb = li.querySelector<HTMLElement>('.mb-thumb')!;
			if (item.thumb) {
				const img = document.createElement('img');
				img.src = item.thumb;
				img.alt = '';
				img.loading = 'lazy';
				if (item.src !== 'cat') img.referrerPolicy = 'no-referrer';
				thumb.append(img);
			}
			li.querySelector('.mb-row-title')!.textContent = item.title;
			const taken = state.slots.some((s, i) => i !== openSlot && sameItem(s, item));
			const meta = [item.year, item.studio, SOURCE_LABEL[item.src as 'shiki'], taken ? 'уже в девятке' : ''].filter(Boolean);
			li.querySelector('.mb-row-meta')!.textContent = meta.join(' · ');
			button.disabled = taken;
			button.addEventListener('click', () => choose(item));
			return li;
		}

		function choose(item: Item) {
			const i = openSlot;
			if (i < 0) return;
			const { label, ...clean } = item;
			state.slots[i] = clean;
			closePicker();
			change();
			focusSlot('.mb-cap-edit', i);
			say(`«${item.title}» — ${ORDINALS[i]} в девятке`);
		}

		root.querySelector('[data-manual]')!.addEventListener('click', () => {
			const title = search.value.replace(/\s+/g, ' ').trim().slice(0, MAX_TEXT);
			if (title) choose({ src: 'manual', title });
		});

		search.addEventListener('input', () => void find());

		// ТРИ СТУПЕНИ, ОДИН СПИСОК. Нашлось у себя — дальше не ищем и чужого
		// не показываем. Не нашлось — Шикимори; не ответил или пусто — AniList;
		// пусто везде — предложение вписать руками. Заголовков ступеней нет:
		// внешние строки подписаны названием источника, и всё.
		async function find() {
			const mine = ++token;
			clearTimeout(pauseTimer);
			const query = search.value.replace(/\s+/g, ' ').trim();
			empty.hidden = true;
			if (fold(query).length < 2) {
				showRows([]);
				setStatus('');
				return;
			}

			const catalog = await loadCatalog();
			if (mine !== token) return;
			if (catalog) {
				const ids = matchQuery(query, catalog.matcher);
				if (ids.length) {
					setStatus('');
					showRows(ids.slice(0, 12).map((id) => fromCatalog(catalog.byId.get(id)!)));
					return;
				}
			}

			showRows([]);
			setStatus('Ищем…');
			pauseTimer = window.setTimeout(async () => {
				const outcome = await external(query, mine);
				if (mine !== token) return;
				setStatus('');
				if (outcome.items.length) return showRows(outcome.items);
				emptyTitle.textContent = `По запросу «${query}» ничего не нашлось.`;
				emptyText.textContent = outcome.failed
					? 'Внешние каталоги сейчас не отвечают. Можно вписать название руками — марка будет без постера.'
					: 'Попробуйте оригинальное название. Если и так пусто — впишите название руками, марка будет без постера.';
				empty.hidden = false;
			}, PAUSE);
		}

		// Ответ на тот же запрос в этой вкладке в сеть второй раз не ходит.
		// Запоминается только честный ответ: «не ответил» спросим снова.
		async function external(query: string, mine: number) {
			let failed = 0;
			for (const [src, run] of [
				['shiki', searchShikimori],
				['anilist', searchAniList],
			] as const) {
				const key = `${CACHE_KEY}${src}:${fold(query)}`;
				const cached = store.get(key, true);
				let outcome: { ok: boolean; items: Item[] } | null = null;
				if (cached) {
					try {
						outcome = JSON.parse(cached);
					} catch {}
				}
				if (!outcome) {
					outcome = (await run(query)) as { ok: boolean; items: Item[] };
					if (mine !== token) return { items: [], failed: false };
					if (outcome.ok) store.set(key, JSON.stringify(outcome), true);
				}
				if (!outcome.ok) failed++;
				if (outcome.items.length) return { items: outcome.items, failed: false };
			}
			return { items: [], failed: failed === 2 };
		}

		// ——— Первый показ ———

		render();

		// Марки каталога приходят адресом и названием из справочника: свежим,
		// а не тем, что было на момент сохранения.
		void loadCatalog().then((catalog) => {
			if (!catalog || !document.contains(root)) return;
			let changed = false;
			state.slots = state.slots.map((item) => {
				if (item?.src !== 'cat') return item;
				const entry = catalog.byId.get(item.id!);
				changed = true;
				// Тайтл убрали из каталога — марка остаётся ручной, а не пропадает.
				if (!entry) return item.title ? { src: 'manual', title: item.title, label: item.label } : null;
				return { ...fromCatalog(entry), label: item.label };
			});
			if (changed && editing < 0) {
				save();
				render();
			}
		});

		// Внешние марки из ссылки приходят без постера — дозапрашиваем.
		const bare = state.slots.filter((i): i is Item => !!i && (i.src === 'shiki' || i.src === 'anilist') && !i.poster);
		if (bare.length) {
			void lookupByIds(bare).then((found) => {
				if (!document.contains(root)) return;
				state.slots = state.slots.map((item) => {
					const hit = item && found.get(`${item.src}:${item.id}`);
					return hit ? { ...item, poster: hit.poster, thumb: hit.thumb, href: hit.href, studio: hit.studio } : item;
				});
				if (editing < 0) render();
			});
		}
	}

	// Переходы между страницами идут без перезагрузки (<ClientRouter />
	// в Layout.astro), поэтому подписываемся на событие Astro, а не выполняем
	// код один раз при загрузке файла.
	document.addEventListener('astro:page-load', setup);
</script>
