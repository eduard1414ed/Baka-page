---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { categories } from '../../content.config';
import { getYoutubeEmbedUrl } from '../../lib/youtube.mjs';
import { getLinkIcon } from '../../lib/linkIcon.mjs';
import { findEpisodeByGuid } from '../../lib/podcastFeed.mjs';
import PlatformIcon from '../../components/PlatformIcon.astro';
import AnimeBadge from '../../components/AnimeBadge.astro';
import EpisodePlayer from '../../components/EpisodePlayer.astro';
import Transcript from '../../components/Transcript.astro';
import { hasUsableTimecodes } from '../../lib/transcript.mjs';
import { applyPostOverrides } from '../../lib/transcriptOverrides.mjs';
import { buildAnimeMatcher } from '../../lib/animeMentions.mjs';
import { makeExceptionFilter } from '../../lib/mentionExceptions.mjs';
import { animeMentionedIn } from '../../lib/animeMentionIndex.mjs';
import { resolveEpisodeCover } from '../../lib/episodeCover.mjs';
import { isPublished } from '../../lib/publishing.mjs';

export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => isPublished(data));
	return Promise.all(
		posts.map(async (post) => ({
			params: { slug: post.id },
			// Аудио отдаёт хостинг подкаста по прямой ссылке из RSS — файлы себе
			// не копируем (см. CLAUDE.md), поэтому ссылку ищем в фиде по audioGuid
			// поста при каждой сборке. Если фид недоступен или выпуск из него
			// пропал — episode будет null, страница просто останется без плеера.
			props: { post, episode: post.data.audioGuid ? await findEpisodeByGuid(post.data.audioGuid) : null },
		})),
	);
}

const { post, episode } = Astro.props;
const { Content } = await render(post);

const { title, date, category, cover, youtube, video, buttons, anime } = post.data;

// Расшифровка (тз/05, шаг 5). Ищем сначала по полю `transcript`, если автор его
// заполнил, иначе по audioGuid — у выпусков подкаста файл расшифровки называется
// тем же guid, что и запись в RSS, поэтому вести поле руками не нужно.
// Поле нужно там, где audioGuid нет вовсе (видеоэссе с YouTube в фиде нет).
//
// getEntry вернёт undefined, если расшифровки для этого выпуска ещё нет —
// таких сейчас 36 (эссе и «Врата аниме», их не распознавали, у них свой путь
// через выравнивание сценария по звуку). Страница просто останется без блока.
const transcriptId = post.data.transcript ?? post.data.audioGuid;
const transcript = transcriptId ? await getEntry('transcripts', transcriptId) : undefined;
const showTranscript = transcript && hasUsableTimecodes(transcript.data);

// Правки, сделанные руками в админке: имена голосов и подтверждённые
// исправления названий (тз/05, шаг 6). Сам файл расшифровки не трогается —
// см. src/lib/transcriptOverrides.mjs.
const transcriptData = showTranscript ? applyPostOverrides(transcript.data, post.data) : null;

// Обложка выпуска для плеера. Хостинг подкаста отдаёт квадрат 2000×2000
// весом около 1 МБ на картинку 72×72 — берём сжатую копию из public/episodes/
// (см. src/lib/episodeCover.mjs). Если её ещё не скачали, вернётся исходная
// ссылка: тяжело, но не битая картинка.
const playerCover = episode?.imageUrl ? resolveEpisodeCover(episode.imageUrl).src : null;
const categoryLabel = categories.find((c) => c.id === category)?.label ?? category;
const dateFormatter = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });

const youtubeEmbed = youtube ? getYoutubeEmbedUrl(youtube) : null;

// Плашки тайтлов под текстом. Показываем и то, что стоит в поле `anime` поста
// (разметка в тексте, тз/03), и то, что прозвучало в расшифровке (тз/05, шаг 5):
// без второго выходила несогласица — на странице тайтла выпуск есть,
// а на странице выпуска тайтла нет.
//
// Порядок: сначала тайтлы поста, потом найденные в расшифровке, по первому
// упоминанию. Повторы убираем.
//
// Тайтл может быть размечен в тексте до того, как робот донабрал его в справочник
// (см. тз/03-тайтлы.md) — тогда ссылки ещё нет, getEntry вернёт undefined,
// такие просто не показываем в плашках, не ломая страницу.
const mentionedInTranscript = showTranscript
	? animeMentionedIn(
			transcriptData,
			buildAnimeMatcher(await getCollection('anime')),
			makeExceptionFilter(post.data.mentionsHidden),
		)
	: [];

const animeIds = [...new Set([...(anime ?? []).map((ref: { id: string }) => ref.id), ...mentionedInTranscript])];
const animeEntries = (await Promise.all(animeIds.map((id) => getEntry('anime', id)))).filter(Boolean);
---

<Layout title={`${title} — Бака!`}>
	<article class="post">
		<a class="back" href={`/category/${category}/`}>← {categoryLabel}</a>
		<h1>{title}</h1>
		<p class="date">{dateFormatter.format(date)}</p>

		{
			cover && (
				<Image
					class="cover"
					src={cover}
					alt=""
					widths={[600, 1200]}
					sizes="(max-width: 700px) 100vw, 700px"
					width={1200}
					height={Math.round(1200 * (cover.height / cover.width))}
				/>
			)
		}

		{
			youtubeEmbed && (
				<div class="video-wrap">
					<iframe
						src={youtubeEmbed}
						title={title}
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
						allowfullscreen
					/>
				</div>
			)
		}

		{!youtubeEmbed && video && <video class="video" src={video} controls preload="metadata" />}

		{
			category === 'podcast' && episode && (
				<EpisodePlayer
					guid={episode.guid}
					audioUrl={episode.audioUrl}
					title={title}
					cover={playerCover}
					link={`/posts/${post.id}/`}
					durationSec={episode.durationSec}
				/>
			)
		}

		{
			buttons && buttons.length > 0 && (
				<div class="buttons">
					{buttons.map((button: { label: string; url: string; style: 'primary' | 'secondary' }) => (
						<a class={`button button-${button.style}`} href={button.url} target="_blank" rel="noopener noreferrer">
							<PlatformIcon name={getLinkIcon(button.url)} />
							{button.label}
						</a>
					))}
				</div>
			)
		}

		<div class="content">
			<Content />
		</div>

		{showTranscript && <Transcript transcript={transcriptData} transcriptId={transcript.id} mentionsHidden={post.data.mentionsHidden} />}

		{
			animeEntries.length > 0 && (
				<div class="anime-mentions">
					{animeEntries.map((entry) => (
						<AnimeBadge anime={entry} />
					))}
				</div>
			)
		}
	</article>
</Layout>

<script>
	// Из-за <ClientRouter /> в Layout.astro переходы между постами теперь идут
	// без полной перезагрузки страницы (это нужно закреплённому плееру — см.
	// src/components/PlayerBar.astro). Но у всех постов один и тот же
	// собранный файл скрипта, поэтому браузер выполняет его только один раз
	// за сессию — если оставить код на верхнем уровне, лайтбокс/спойлеры/
	// карусель будут работать только у первого открытого поста. Оборачиваем
	// в astro:page-load, это событие срабатывает и при первой загрузке,
	// и после каждого перехода.
	function closeLightbox(overlay: HTMLElement, onKeydown: (event: KeyboardEvent) => void) {
		overlay.remove();
		document.removeEventListener('keydown', onKeydown);
	}

	function initPostInteractions() {
		document.querySelectorAll<HTMLAnchorElement>('.content a.figure-zoom').forEach((link) => {
			link.addEventListener('click', (event) => {
				event.preventDefault();
				const sourceImg = link.querySelector('img');
				if (!sourceImg) return;

				const overlay = document.createElement('div');
				overlay.className = 'lightbox';

				const bigImg = document.createElement('img');
				// .src — то, что браузер выбрал из srcset для превью, необязательно
				// самое крупное; data-full всегда указывает на него явно.
				bigImg.src = sourceImg.dataset.full || sourceImg.src;
				bigImg.alt = sourceImg.alt;
				overlay.appendChild(bigImg);

				const onKeydown = (event: KeyboardEvent) => {
					if (event.key === 'Escape') closeLightbox(overlay, onKeydown);
				};

				overlay.addEventListener('click', () => closeLightbox(overlay, onKeydown));
				document.addEventListener('keydown', onKeydown);
				document.body.appendChild(overlay);
			});
		});

		document.querySelectorAll<HTMLElement>('.gallery-carousel').forEach((carousel) => {
			const track = carousel.querySelector<HTMLElement>('.carousel-track');
			const slides = carousel.querySelectorAll('.carousel-slide');
			if (!track || slides.length === 0) return;

			let index = 0;
			const update = () => {
				track.style.transform = `translateX(-${index * 100}%)`;
			};

			carousel.querySelector('.carousel-prev')?.addEventListener('click', () => {
				index = (index - 1 + slides.length) % slides.length;
				update();
			});
			carousel.querySelector('.carousel-next')?.addEventListener('click', () => {
				index = (index + 1) % slides.length;
				update();
			});
		});

		// Блочный спойлер (абзацы/картинки/галерея) — кнопка с текстом остаётся видна,
		// раскрытое содержимое появляется под ней.
		document.querySelectorAll<HTMLElement>('.spoiler:not(.spoiler-inline)').forEach((spoiler) => {
			const button = spoiler.querySelector<HTMLButtonElement>('.spoiler-toggle');
			const template = spoiler.querySelector<HTMLTemplateElement>('.spoiler-content');
			if (!button || !template) return;

			const openLabel = button.textContent ?? 'Показать спойлер';
			let revealed: HTMLElement | null = null;

			button.addEventListener('click', () => {
				if (!revealed) {
					revealed = document.createElement('div');
					revealed.className = 'spoiler-revealed';
					revealed.appendChild(template.content.cloneNode(true));
					spoiler.appendChild(revealed);
				} else {
					revealed.hidden = !revealed.hidden;
				}

				button.textContent = revealed.hidden ? openLabel : 'Скрыть спойлер';
			});
		});

		// Инлайн-спойлер (слово/фраза) — цветная плашка заменяется текстом на том же
		// месте по клику, повторный клик по тексту прячет его обратно.
		document.querySelectorAll<HTMLElement>('.spoiler-inline').forEach((spoiler) => {
			const button = spoiler.querySelector<HTMLButtonElement>('.spoiler-toggle');
			const template = spoiler.querySelector<HTMLTemplateElement>('.spoiler-content');
			if (!button || !template) return;

			let revealed: HTMLElement | null = null;

			const hide = () => {
				if (revealed) revealed.hidden = true;
				button.hidden = false;
			};

			button.addEventListener('click', () => {
				if (!revealed) {
					revealed = document.createElement('span');
					revealed.className = 'spoiler-revealed';
					revealed.appendChild(template.content.cloneNode(true));
					revealed.addEventListener('click', hide);
					spoiler.insertBefore(revealed, button);
				}

				revealed.hidden = false;
				button.hidden = true;
			});
		});
	}

	document.addEventListener('astro:page-load', initPostInteractions);
</script>

<style>
	.post {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--space-4) var(--space-3);
	}

	.back {
		display: inline-block;
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
		margin-bottom: var(--space-2);
	}

	.back:hover,
	.back:focus-visible {
		color: var(--color-accent-hover);
	}

	h1 {
		margin-bottom: var(--space-1);
	}

	.date {
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
		margin-bottom: var(--space-3);
	}

	.cover {
		width: 100%;
		border-radius: var(--radius-md);
		margin-bottom: var(--space-3);
	}

	.video-wrap {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		margin-bottom: var(--space-3);
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.video-wrap iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.video {
		width: 100%;
		border-radius: var(--radius-md);
		margin-bottom: var(--space-3);
	}

	.buttons {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-3);
	}

	.anime-mentions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-4);
		padding-top: var(--space-3);
		border-top: 1px solid var(--color-border);
	}

	.button {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius-sm);
		font-size: var(--font-size-sm);
		transition:
			background-color var(--transition-fast),
			border-color var(--transition-fast);
	}

	.button-primary {
		background: var(--color-accent);
		color: var(--color-bg);
	}

	.button-primary:hover,
	.button-primary:focus-visible {
		background: var(--color-accent-hover);
		color: var(--color-bg);
	}

	.button-secondary {
		border: 1px solid var(--color-border);
		color: var(--color-text);
	}

	.button-secondary:hover,
	.button-secondary:focus-visible {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.content :global(p) {
		margin: 0 0 var(--space-2);
	}

	.content :global(ul),
	.content :global(ol) {
		margin: 0 0 var(--space-2);
		padding-left: 1.25rem;
	}

	.content :global(blockquote) {
		margin: 0 0 var(--space-2);
		padding-left: var(--space-2);
		border-left: 2px solid var(--color-accent);
		color: var(--color-text-muted);
	}

	/* Запасной стиль для обычной картинки в тексте (![]()) — например, обложки
	   выпуска, которую вставляет робот сверки прямой ссылкой, см.
	   scripts/sync-episodes.mjs. Блок «Изображение с подписью» из редактора
	   получает свои размеры через figure.figure ниже, эта картинка проще. */
	.content :global(p > img) {
		display: block;
		width: 100%;
		/* Обязательно вместе с width: обложка выпуска приходит с атрибутами
		   width/height в разметке (см. src/plugins/remark-episode-cover.mjs) —
		   они держат место, пока картинка грузится, чтобы текст не подпрыгивал.
		   Без height: auto браузер применил бы высоту из атрибута буквально
		   и картинка растянулась бы. */
		height: auto;
		border-radius: var(--radius-md);
		margin: var(--space-3) 0;
	}

	.content :global(figure.figure) {
		margin: var(--space-3) 0;
	}

	.content :global(figure.figure-full) {
		width: 100vw;
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
	}

	.content :global(.figure-zoom) {
		display: block;
		cursor: zoom-in;
	}

	.content :global(.figure-zoom img) {
		width: 100%;
		border-radius: var(--radius-md);
	}

	.content :global(figure.figure-full .figure-zoom img) {
		border-radius: 0;
	}

	.content :global(figcaption) {
		margin-top: var(--space-1);
		padding: 0 var(--space-1);
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
		text-align: center;
	}

	.content :global(figure.figure-full figcaption) {
		max-width: var(--content-width);
		margin-left: auto;
		margin-right: auto;
	}

	.content :global(.gallery-grid) {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-2);
	}

	.content :global(.gallery-item .figure-zoom) {
		aspect-ratio: 1 / 1;
	}

	.content :global(.gallery-item .figure-zoom img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.content :global(.carousel-viewport) {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-md);
	}

	.content :global(.carousel-track) {
		display: flex;
		align-items: flex-start;
		transition: transform var(--transition-fast);
	}

	.content :global(.carousel-slide) {
		flex: 0 0 100%;
	}

	.content :global(.carousel-slide .figure-zoom) {
		aspect-ratio: 4 / 3;
	}

	.content :global(.carousel-slide .figure-zoom img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.content :global(.carousel-slide figcaption) {
		padding: var(--space-1) var(--space-3);
	}

	.content :global(.carousel-prev),
	.content :global(.carousel-next) {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 2.5rem;
		height: 2.5rem;
		border: 0;
		border-radius: var(--radius-full);
		background: rgba(0, 0, 0, 0.5);
		color: #fff;
		font-size: var(--font-size-lg);
		line-height: 1;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.content :global(.carousel-prev) {
		left: var(--space-1);
	}

	.content :global(.carousel-next) {
		right: var(--space-1);
	}

	.content :global(.spoiler) {
		margin: var(--space-3) 0;
	}

	.content :global(.spoiler-toggle) {
		padding: var(--space-1) var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-bg-elevated);
		color: var(--color-accent);
		font-size: var(--font-size-sm);
		cursor: pointer;
		transition: border-color var(--transition-fast);
	}

	.content :global(.spoiler-toggle:hover) {
		border-color: var(--color-accent);
	}

	.content :global(.spoiler-revealed) {
		display: block;
		margin-top: var(--space-2);
		padding: var(--space-2) var(--space-3);
		border-left: 2px solid var(--color-accent);
		background: var(--color-bg-elevated);
		border-radius: var(--radius-sm);
	}

	/* Спойлер на слово/фразу — прямо в строке текста, без своего блока. */
	.content :global(.spoiler-inline) {
		margin: 0;
	}

	.content :global(.spoiler-inline .spoiler-toggle) {
		/* Ширина задана инлайн-стилем (см. remark-spoiler.mjs) — под длину
		   спрятанного текста. Сплошная плашка вместо кнопки с надписью. */
		height: 1em;
		vertical-align: -0.15em;
		padding: 0;
		border: none;
		border-radius: 3px;
		background: var(--color-accent);
	}

	.content :global(.spoiler-inline .spoiler-toggle[hidden]) {
		display: none;
	}

	.content :global(.spoiler-inline .spoiler-revealed) {
		display: inline;
		margin: 0;
		padding: 0 var(--space-1);
		cursor: pointer;
		border-left: none;
		background: var(--color-bg-elevated);
		border-radius: var(--radius-sm);
	}

	/* Без этого атрибут hidden не срабатывает: правила выше задают display
	   с более высоким приоритетом, чем встроенный стиль браузера для [hidden]. */
	.content :global(.spoiler-revealed[hidden]) {
		display: none;
	}

	.content :global(.spoiler-revealed > :first-child) {
		margin-top: 0;
	}

	.content :global(.spoiler-revealed > :last-child) {
		margin-bottom: 0;
	}

	/* Внутри спойлера картинка "во всю ширину" ломала бы разметку (расчёт
	   full-bleed завязан на то, что элемент лежит прямо в колонке текста) —
	   тут просто показываем её в колонку. */
	.content :global(.spoiler-revealed figure.figure-full) {
		width: 100%;
		position: static;
		margin-left: 0;
		margin-right: 0;
	}

	.content :global(.video-wrap) {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		margin: var(--space-3) 0;
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.content :global(.video-wrap iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.content :global(.content-video) {
		display: block;
		width: 100%;
		margin: var(--space-3) 0;
		border-radius: var(--radius-md);
	}

	.content :global(.timecode) {
		font-variant-numeric: tabular-nums;
		border-bottom: 1px dashed var(--color-accent);
	}

	.content :global(.timecode:hover),
	.content :global(.timecode:focus-visible) {
		border-bottom-style: solid;
	}
</style>

<style is:global>
	.lightbox {
