---
// Страница материала. ОДИН ФАЙЛ РИСУЕТ ПЯТЬ РАСКЛАДОК (часть 5 тз/08-дизайн.md,
// макеты Сборка-18/{article,video,podcast,bonus}.html):
//
//   подкаст   — обложка 1:1, кикер, H1, плеер, транскрипт, марки;
//   бонус     — та же шапка, подводка вместо плеера, плашка подписки;
//   видеоэссе — общий заголовочный блок, плеер YouTube 1000, аудиоверсия;
//   статья    — общий заголовочный блок с подводкой, медиаблоки трёх ширин;
//   заметка   — то же, что статья, обычно без медиа.
//
// Разводятся ДВЕ ветки, а не пять: «выпуск» (подкаст и бонус — у них шапка
// с обложкой) и «текст» (всё остальное — у них общий заголовочный блок).
// Остальные различия внутри веток — это наличие или отсутствие блока, а не
// своя вёрстка.
//
// ЗАГОЛОВОЧНЫЙ БЛОК СТАТЬИ, ЗАМЕТКИ И ВИДЕОЭССЕ — ОДИН КОМПОНЕНТ
// (ContentHeader.astro). Двух похожих быть не должно: они разъедутся, и никто
// этого не заметит — две страницы рядом никто не открывает.
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { postDescription } from '../../lib/excerpt.mjs';
import { socialSource, coverSrcs } from '../../lib/postImage.mjs';
import { absoluteUrl, SITE_NAME } from '../../lib/site.mjs';
import { podcastEpisodeSchema, articleSchema, breadcrumbsSchema } from '../../lib/schema.mjs';
import { categories, sectionOf } from '../../content.config';
import { parseTimecodeList } from '../../lib/timecode.mjs';
import { findEpisodeByGuid } from '../../lib/podcastFeed.mjs';
import { formatPostDate } from '../../lib/postDate.mjs';
import { episodeNumber } from '../../lib/postMeta.mjs';
import { animeSearchWords } from '../../lib/animeSearch.mjs';
import AnimeBadge from '../../components/AnimeBadge.astro';
import ContentHeader from '../../components/ContentHeader.astro';
import PostKicker from '../../components/PostKicker.astro';
import EpisodePlayer from '../../components/EpisodePlayer.astro';
import Transcript from '../../components/Transcript.astro';
import { hasUsableTimecodes } from '../../lib/transcript.mjs';
import { applyPostOverrides } from '../../lib/transcriptOverrides.mjs';
import { buildAnimeMatcher } from '../../lib/animeMentions.mjs';
import { makeExceptionFilter } from '../../lib/mentionExceptions.mjs';
import { animeHiddenInPost, animeMentionCountsInPostText, animeMentionedIn, sortAnimeByMentions } from '../../lib/animeMentionIndex.mjs';
import { resolveEpisodeCover } from '../../lib/episodeCover.mjs';
import { isPublished } from '../../lib/publishing.mjs';
import { getPostTiming } from '../../lib/postTiming.mjs';
import { isExternalPost } from '../../lib/externalPost.mjs';
import { getCardMedia } from '../../lib/postCardMedia.mjs';
import BonusPaywall from '../../components/BonusPaywall.astro';
import TimecodeList from '../../components/TimecodeList.astro';
import SocialStrip from '../../components/SocialStrip.astro';
import SupportStrip from '../../components/SupportStrip.astro';

export async function getStaticPaths() {
	// Внешние посты (тз/10, задача 2) сюда НЕ ПОПАДАЮТ, и это главное правило
	// всей задачи: статья лежит на Кинопоиске, показывать нам нечего, а страница
	// вышла бы пустой — заголовок и одна кнопка «читать там». Десятки таких
	// страниц не оценит ни читатель, ни поисковик. Карточка в ленте ведёт сразу
	// наружу (src/components/PostCard.astro), прямой адрес отдаёт 404.
	//
	// Отсюда же растёт их отсутствие в карте сайта: src/pages/sitemap.xml.ts
	// делает ровно ту же проверку, и там написано, почему это не случайность.
	const posts = await getCollection('posts', ({ data }) => isPublished(data) && !isExternalPost(data));

	// Соседние материалы — внутри РАЗДЕЛА, а не по всему сайту: со страницы
	// выпуска логично попасть в соседний выпуск, а не в заметку, случайно
	// вышедшую в тот же день. Раздел тот же, куда ведёт ссылка «← назад»,
	// поэтому бонус ходит по выпускам.
	//
	// Считаем один раз на всю сборку, а не для каждой страницы отдельно:
	// иначе это 145 сортировок одного и того же списка.
	const byDate = [...posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
	const neighbours = new Map();
	// Ссылку делаем только на то, у чего есть страница: список уже отфильтрован
	// от внешних постов, поэтому битой ссылки тут появиться неоткуда.
	const link = (entry) => (entry ? { slug: entry.id, title: entry.data.title } : null);

	// ЗАПАСНОЙ ВАРИАНТ — ВЕСЬ САЙТ, и он нужен не «на всякий случай».
	// В разделе, где опубликован ОДИН материал, соседей нет вовсе, и блок
	// «Предыдущий / Следующий» не рисуется совсем: у единственного видеоэссе
	// сайта низ страницы обрывался. Заказчик увидел это 10 августа 2026
	// и решил: раздел важнее, но пустой хвост хуже соседа из другого раздела.
	const wholeSite = (post) => {
		const index = byDate.findIndex((entry) => entry.id === post.id);
		return { newerPost: link(byDate[index - 1]), olderPost: link(byDate[index + 1]) };
	};

	for (const section of new Set(byDate.map((post) => sectionOf(post.data.category)))) {
		const inSection = byDate.filter((post) => sectionOf(post.data.category) === section);
		inSection.forEach((post, index) => {
			const own = { newerPost: link(inSection[index - 1]), olderPost: link(inSection[index + 1]) };
			// Проверяем ОБА соседа сразу, а не по одному: иначе у материала,
			// первого в своём разделе, «предыдущий» приехал бы из раздела,
			// а «следующего» не было бы вовсе — и читатель решил бы, что ссылка
			// ведёт наугад. Либо пара из раздела, либо пара по сайту.
			neighbours.set(post.id, own.newerPost || own.olderPost ? own : wholeSite(post));
		});
	}

	return Promise.all(
		posts.map(async (post) => ({
			params: { slug: post.id },
			// Аудио отдаёт хостинг подкаста по прямой ссылке из RSS — файлы себе
			// не копируем (см. CLAUDE.md), поэтому ссылку ищем в фиде по audioGuid
			// поста при каждой сборке. Если фид недоступен или выпуск из него
			// пропал — episode будет null, страница просто останется без плеера.
			props: {
				post,
				episode: post.data.audioGuid ? await findEpisodeByGuid(post.data.audioGuid) : null,
				...neighbours.get(post.id),
			},
		})),
	);
}

const { post, episode, olderPost = null, newerPost = null } = Astro.props;
const { Content } = await render(post);

const { title, date, category, cover, bonusLinks, anime } = post.data;

// Расшифровка (тз/05, шаг 5). Ищем сначала по полю `transcript`, если автор его
// заполнил, иначе по audioGuid — у выпусков подкаста файл расшифровки называется
// тем же guid, что и запись в RSS, поэтому вести поле руками не нужно.
// Поле нужно там, где audioGuid нет вовсе (видеоэссе с YouTube в фиде нет).
//
// getEntry вернёт undefined, если расшифровки для этого выпуска ещё нет —
// таких сейчас 36 (эссе и «Врата аниме», их не распознавали, у них свой путь
// через выравнивание сценария по звуку). Страница просто останется без блока.
const transcriptId = post.data.transcript ?? post.data.audioGuid;
const transcript = transcriptId ? await getEntry('transcripts', transcriptId) : undefined;
const showTranscript = transcript && hasUsableTimecodes(transcript.data);

// Правки, сделанные руками в админке: имена голосов и подтверждённые
// исправления названий (тз/05, шаг 6). Сам файл расшифровки не трогается —
// см. src/lib/transcriptOverrides.mjs.
const transcriptData = showTranscript ? applyPostOverrides(transcript.data, post.data) : null;

// Обложка выпуска. Хостинг подкаста отдаёт квадрат 2000×2000 весом около 1 МБ —
// берём сжатую копию из public/episodes/ (см. src/lib/episodeCover.mjs). Если её
// ещё не скачали, вернётся исходная ссылка: тяжело, но не битая картинка.
//
// ЭТА ЖЕ КАРТИНКА СТОИТ ПЕРВОЙ СТРОКОЙ В ТЕЛЕ КАЖДОГО ВЫПУСКА — её вставляет
// робот сверки. В шапке она теперь показана квадратом 1:1, поэтому из текста
// убирается: src/plugins/remark-episode-cover.mjs. Иначе одна и та же обложка
// шла бы на странице дважды подряд.
//
// ПОРЯДОК ДВА ИСТОЧНИКА, И ПОЛЕ АВТОРА ГЛАВНЕЕ. Сначала поле «Обложка»
// у поста, потом обложка выпуска из RSS. У бонуса второго источника нет
// вовсе: в фиде подкаста его не существует, `audioGuid` не заполняется, —
// и без первого рамка оставалась пустым квадратом с линией по краю. Пустая
// рамка читается поломкой вёрстки, а не «картинки нет»: заказчик увидел
// это на первом же опубликованном бонусе 10 августа 2026.
//
// НЕТ НИ ТОЙ, НИ ДРУГОЙ — РАМКИ НЕ РИСУЕТСЯ СОВСЕМ, и заголовок занимает
// всю ширину. Заглушку «изображения нет» сюда не ставим: она отвечает
// на «картинка была, но не загрузилась», а тут её не задавали вовсе.
//
// Картинки из ТЕКСТА в шапку не поднимаются — решение заказчика от
// 10 августа 2026. Первая картинка тела остаётся делом текста; исключение
// одно, и оно ниже: если она совпала с обложкой, из текста её убирают,
// чтобы не стояла дважды подряд.
const heroCover = coverSrcs(cover) ?? (episode?.imageUrl ? resolveEpisodeCover(episode.imageUrl) : null);
// Обложка в плеере — та же, что в шапке: картинка у материала одна.
const playerCover = heroCover?.src ?? null;
const categoryLabel = categories.find((c) => c.id === category)?.label ?? category;
// В чей раздел ведёт ссылка «← назад». У бонуса подпись своя («← Бонус»),
// а раздел чужой — «Подкаст»: своей страницы у скрытой категории нет.
const sectionId = sectionOf(category);
// Выпуски или посты — считаем по РАЗДЕЛУ, а не по категории: бонус лежит
// в разделе выпусков, значит и в поиске он «Выпуски», и шапка у него выпускная.
const isEpisode = sectionId === 'podcast';

// Оглавление выпуска (тз/08, 9.3). Пусто — блока нет, и метки времени
// в тексте работают ровно как работали: у 143 выпусков архива не меняется
// ничего.
//
// Разбираем ЗДЕСЬ, один раз: строки нужны и блоку, и решению «перематывать
// ли ролик». Разбери мы их дважды, предупреждения в лог тоже пошли бы дважды.
const timecodeRows = parseTimecodeList(post.data.timecodes, (message) =>
	console.warn(`[таймкоды] ${post.id}: ${message}`),
);

// Бонус — материал за платной подпиской (тз/10, задача 1). Плашка появляется
// сама у любого поста этой категории, отдельного переключателя нет.
// Кнопки площадок при этом уезжают ВНУТРЬ плашки и обычным списком над текстом
// уже не показываются: два одинаковых набора ссылок на одной странице —
// это не «подстраховались», а «не решили, где они должны быть».
const isBonus = category === 'bonus';
const isVideoEssay = category === 'videoessay';

// Куда перематывает нажатие на строку таймкодов: у видеоэссе — в ролик,
// у всех остальных — в аудиоплеер (тз/08, 9.3). Решение принимается ЗДЕСЬ,
// один раз, и дальше живёт меткой на самом окошке ролика: скрипт нажатий
// не должен знать про категории материала, ему довольно спросить страницу,
// есть ли на ней управляемый ролик.
//
// У видеоэссе с аудиоверсией на странице стоят оба плеера — ТЗ выбирает ролик.
//
// ПРО САМ РОЛИК ТУТ НИЧЕГО НЕ СКАЗАНО, И ЭТО НАРОЧНО. Ролик стоит блоком
// прямо в тексте (`::video`), и разметку ему делает другой файл. Поэтому
// страница говорит только «этот материал перематывает ролик», а какое
// из окошек на ней ролик, разбирается скрипт ниже — он же добавляет ролику
// разрешение `enablejsapi`, без которого управлять им снаружи нельзя.
//
// Прежде тут была вторая дорога: поле «Ссылка на ролик» ставило окошко
// в шапку материала, и разрешение проставлялось ему сразу при сборке.
// Поле снято решением заказчика 15 августа 2026 (было заполнено у нуля
// постов), и дорога осталась одна.
const youtubeSeek = timecodeRows.length > 0 && isVideoEssay;

// Подпись над описанием. У статьи и заметки её нет: там текст и есть материал,
// объявлять его нечем.
//
// У видеоэссе она есть, но только если текст НЕ НАЧИНАЕТСЯ С РОЛИКА. В архиве
// ролик почти всегда вставлен блоком в самое начало текста (`::video{…}`),
// и подпись «О видеоэссе» оказалась бы над плеером, а не над описанием —
// то есть врала бы о том, что под ней. В макете плеер стоит отдельным блоком
// выше, и такого случая просто не возникает.
const bodyStartsWithVideo = /^\s*::video\b/.test(post.body ?? '');
// Скобки вокруг подписи рисует CSS (global.css), тут только слово.
const bodyLabel = isEpisode ? 'о выпуске' : isVideoEssay && !bodyStartsWithVideo ? 'о видеоэссе' : null;

// Подводка. Берётся ТОЛЬКО из своего поля «Описание для карточки» и никогда
// из первого абзаца текста: подставленный первый абзац стоял бы прямо над
// собой же и читался как заедание.
//
// У выпуска подкаста её нет вовсе (§13: «заголовок и плеер — всё»), у видеоэссе
// нет по умолчанию (§12). Остаются статья, заметка и бонус.
const ownDescription = String(post.data.description ?? '').trim() || null;
const lead = isEpisode || isVideoEssay ? null : ownDescription;
const bonusDeck = isBonus ? ownDescription : null;

// «Сколько это займёт» — та же функция, что зовёт карточка в ленте
// (src/components/PostKicker.astro), поэтому числа на карточке и на странице
// разойтись не могут. У выпуска тут будет длительность из RSS, у заметки —
// время чтения, и никогда не оба сразу.
//
// НА СТРАНИЦЕ ВЫПУСКА ДЛИТЕЛЬНОСТЬ НАЗЫВАЕТСЯ ДВАЖДЫ И НЕ БОЛЬШЕ (§13):
// здесь, в верхней строке рядом с датой, и внутри плеера, где это бегущий
// счётчик воспроизведения. В кикере её нет — поэтому PostKicker зовётся
// с `withTiming={false}`. Раньше она стояла в трёх местах подряд, и ни одно
// из них не было главным.
const timing = await getPostTiming(post);

// Марки тайтлов под текстом. Источников ТРИ, и все три обязательны, потому что
// связь двусторонняя: пропусти любой — и на странице тайтла материал есть,
// а на странице материала тайтла нет.
//   1. поле «Тайтлы поста» — то, что отметили руками (тз/03);
//   2. текст самого поста — широкая разметка (хвост 44, часть B этапа 11):
//      раз название в тексте стало ссылкой, марка под текстом обязана быть;
//   3. расшифровка выпуска — то, что прозвучало вслух (тз/05, шаг 5).
//
// Собираются они в этом порядке, повторы убираем, а сверху потом идёт
// сортировка по количеству — она же и оставляет этот порядок там, где считать
// нечего. Спрашиваем про текст поста НЕ СВОИМ кодом, а
// `animeMentionCountsInPostText` — тем же, которым это спрашивает указатель
// для страницы тайтла: две копии ответили бы по-разному, и несогласица вернулась
// бы с другой стороны.
//
// Тайтл может быть размечен в тексте до того, как робот донабрал его в справочник
// (см. тз/03-тайтлы.md) — тогда ссылки ещё нет, getEntry вернёт undefined,
// такие просто не показываем в марках, не ломая страницу.
const animeList = await getCollection('anime');

// Фильтр исключений ОДИН на обе половины — и на живую речь, и на текст поста:
// одно поле, одно правило (см. animeMentionIndex.mjs, хвост 50).
const exceptions = makeExceptionFilter(post.data.mentionsHidden);

const mentionTimes = showTranscript
	? animeMentionedIn(transcriptData, buildAnimeMatcher(animeList, { quotes: 'ignore', speech: true }), exceptions)
	: new Map();

// Счёт, а не список: он нужен порядку марок ниже. Список из него получается
// ключами, поэтому разбор текста тут по-прежнему ОДИН.
const inTextCounts = animeMentionCountsInPostText(post, buildAnimeMatcher(animeList, { quotes: 'apply', speech: false }), exceptions);

// Отменённый тайтл убирается и из отметок руками: поле «Тайтлы поста»
// заполняется САМО при сохранении, поэтому «отметил и тут же отменил» —
// обычное дело. То же самое делает `postsForAnime` на странице тайтла,
// и это одна и та же функция `animeHiddenInPost`, а не две проверки.
const hiddenHere = animeHiddenInPost(post);

// ПОРЯДОК МАРОК — ПО КОЛИЧЕСТВУ УПОМИНАНИЙ В ЭТОМ САМОМ МАТЕРИАЛЕ, СВЕРХУ
// САМЫЕ ЧАСТЫЕ (решение заказчика 15 августа 2026). Правило целиком
// в `sortAnimeByMentions`, второй копии нет — здесь только сбор трёх источников.
// Ничья оставляет прежний порядок, а он и есть порядок этого списка: сначала
// поле «Аниме» так, как его расставил человек, потом найденное в тексте,
// потом прозвучавшее в разговоре.
const animeIds = sortAnimeByMentions(
	[...new Set([...(anime ?? []).map((ref: { id: string }) => ref.id), ...inTextCounts.keys(), ...mentionTimes.keys()])].filter(
		(id) => !hiddenHere.has(id),
	),
	inTextCounts,
	mentionTimes,
);
const animeEntries = (await Promise.all(animeIds.map((id) => getEntry('anime', id)))).filter(Boolean);

// Слова упомянутых тайтлов для поиска — невидимой строкой в конце статьи,
// см. комментарий у самой строки ниже.
const animeSearchField = animeEntries.map((entry) => animeSearchWords(entry!.data)).join(' ');

// ——— Что видно в поиске и в превью при отправке ссылки (тз/06, шаги 7–10) ———

// Описание берём из первого осмысленного абзаца текста, если своего нет —
// заполнять его руками для 143 выпусков архива никто не будет.
// Как отсеивается служебное сверху (обложка, реклама, столбик ссылок) —
// см. src/lib/excerpt.mjs.
const pageDescription = postDescription(post, undefined);

// Из чего сделать превью для соцсетей: своя обложка поста → обложка выпуска
// из RSS → первая картинка в тексте → ничего (тогда достанется общая картинка
// сайта). Порядок и все оговорки — в socialSource, src/lib/postImage.mjs.
//
// Правило считается там, а не здесь, потому что его нужно знать двоим: этой
// странице (она ставит теги) и сборке, которая рисует сам файл превью
// (src/pages/og-sources.json.ts → src/plugins/og-images-integration.mjs).
const ogImage = socialSource({
	cover,
	episodeImageUrl: episode?.imageUrl ?? null,
	body: post.body,
});

const pageUrl = absoluteUrl(`/posts/${post.id}/`);
const ogImageAbsolute = absoluteUrl(ogImage);

// Выпуск размечаем как PodcastEpisode, всё остальное — как Article.
// По разделу, а не по категории: бонус лежит в разделе выпусков.
const schema = isEpisode
	? podcastEpisodeSchema({ url: pageUrl, title, description: pageDescription, image: ogImageAbsolute, date, episode })
	: articleSchema({ url: pageUrl, title, description: pageDescription, image: ogImageAbsolute, date });

// Крошки ведут в тот же раздел, что и ссылка «← назад» над заголовком,
// и подписаны так же — расходиться им нельзя.
const crumbs = breadcrumbsSchema([
	{ name: categoryLabel, path: `/category/${sectionId}/` },
	{ name: title, path: `/posts/${post.id}/` },
]);

// Подписи под плеером (§13). Слева — что играет, справа — подсказка про
// таймкоды, и она появляется ТОЛЬКО там, где таймкоды на странице правда есть:
// обещание, которому нечего исполнить, хуже молчания.
const playerNumber = episodeNumber(post.id);
const playerCaption = isEpisode
	? [SITE_NAME, playerNumber && `выпуск ${playerNumber}`].filter(Boolean).join(' · ')
	: `${SITE_NAME} · аудиоверсия`;
const playerHint = showTranscript ? 'Клик по таймкоду переносит плеер' : null;

const backHref = `/category/${sectionId}/`;
const isoDate = date.toISOString().slice(0, 10);

// ЧТО ПОИСК ПО САЙТУ ПОКАЗЫВАЕТ В РЕЗУЛЬТАТЕ-МАТЕРИАЛЕ (часть 8).
//
// Страница результатов рисуется уже в браузере — из того, что Pagefind
// запомнил про эту страницу. Метастрока результата собирается там из трёх
// готовых фактов: подпись типа, дата и «сколько это займёт». СКЛЕИВАЕТСЯ
// ОНА ТАМ, А НЕ ЗДЕСЬ, и это нарочно: правило «как выглядит метастрока»
// живёт в PostKicker.astro, и вторая его копия строкой в атрибуте разошлась бы
// с первой молча. Здесь только факты по отдельности.
//
// Подпись берём у РАЗДЕЛА (`labelOne`), ровно как PostKicker: у бонуса
// написано «Подкаст», а что он платный — говорит отдельная метка.
const searchLabel = categories.find((c) => c.id === sectionId)?.labelOne ?? sectionId;

// Картинка результата — ТА ЖЕ, ЧТО В КАРТОЧКЕ ЛЕНТЫ, и решает это тот же
// getCardMedia: заглушку не подставляем, нет обложки — результат текстовый.
// Своей копии правила у поиска нет.
const searchMedia = await getCardMedia(post);

const postSearchMeta = [
	`label:${searchLabel}`,
	// Номер нужен группе упоминаний: там над цитатой стоит «Выпуск №106».
	// У бонуса и у статьи номера нет и быть не может (см. postMeta.mjs).
	playerNumber && isEpisode && !isBonus ? `number:${playerNumber}` : null,
	timing?.meta ? `timing:${timing.meta}` : null,
	// Форма картинки: квадрат у выпуска, кадр 16:9 у остального. То же правило,
	// что в PostMedia.astro, — геометрию задаёт материал, а не место.
	`shape:${isEpisode ? 'square' : 'wide'}`,
	searchMedia ? `thumb:${searchMedia.src}` : null,
	isBonus ? 'bonus:1' : null,
	// ПОД ЗАГОЛОВКОМ В ВЫДАЧЕ СТОИТ ОПИСАНИЕ МАТЕРИАЛА, А НЕ ОТРЫВОК PAGEFIND.
	// Отрывок берётся вокруг найденного слова и цепляет вместе с ним служебное
	// начало страницы: «] · №135. Королевские космические силы… О выпуске.
	// Пампам. 12:04 — Новый блок. Транскрипт. Всем привет!» — читать это нельзя.
	// Описание то же самое, что в карточке ленты, в RSS и в превью ссылки:
	// один факт живёт в одном месте (postDescription, src/lib/excerpt.mjs).
	//
	// Цена решения: если слово нашлось в середине текста, отрывка с ним
	// в карточке не будет. Место разговора при этом показывает группа
	// «Упоминания», а ради этого она и заведена.
	//
	// ПРОВЕРКА НА ПУСТО ОБЯЗАТЕЛЬНА: у материала без своего описания и без
	// подходящего первого абзаца `postDescription` возвращает пустоту, и метка
	// уезжала в индекс строкой «undefined» — ровно так она и печаталась
	// в выдаче под заголовком выпуска про Gainax.
	pageDescription ? `desc:${pageDescription}` : null,
].filter(Boolean) as string[];
---

<Layout
	title={title}
	description={pageDescription}
	ogSlug={ogImage ? post.id : null}
	imageAlt={`Обложка: ${title}`}
	type="article"
>
	<JsonLd slot="head" data={schema} />
	<JsonLd slot="head" data={crumbs} />
	<div class="site">
		{/* data-pagefind-body — что берёт в поиск Pagefind (тз/06, шаг 1). Стоит
		    на <article>, поэтому шапка, подвал и закреплённый плеер из Layout.astro
		    в индекс не попадают вовсе: они на каждой странице одинаковые и в выдаче
		    были бы шумом. Страницы БЕЗ этого атрибута (главная, категории, /admin)
		    Pagefind не индексирует совсем — так работает его правило «если атрибут
		    встретился хоть где-то, индексируем только помеченное».

		    Тип и категория — фильтры выдачи (тз/06, шаг 5). «Выпуски» это не
		    отдельная сущность, а категория `podcast`, поэтому тип выводится
		    из категории, а не хранится отдельно. */}
		<article
			class="post"
			data-pagefind-body
			data-pagefind-filter={`type:${isEpisode ? 'Выпуски' : 'Посты'}`}
			data-pagefind-meta={`type:${isEpisode ? 'episode' : 'post'}`}
		>
			{/* Один фильтр и одна метка на элемент — перечислить их через запятую
			    в одном атрибуте НЕЛЬЗЯ, Pagefind примет всю строку за одно значение.
			    Проверено на живом индексе: `type:Выпуски, category:Подкаст` дало
			    фильтр «Выпуски, category:Подкаст». Поэтому лишнее висит на пустых
			    span'ах — они ничего не показывают и в текст страницы не попадают. */}
			<span data-pagefind-filter={`category:${categoryLabel}`} data-pagefind-meta={`category:${categoryLabel}`}></span>
			<span data-pagefind-meta={`date:${formatPostDate(date)}`}></span>
			{postSearchMeta.map((meta) => (
				<span data-pagefind-meta={meta} />
			))}

			{
				isEpisode ? (
					<section class="episode-hero">
						<div class="episode-topline tech" data-pagefind-ignore>
							{/* Подпись и поведение — как у шапки статьи (ContentHeader):
							    ведёт назад по истории, а раздел остаётся запасным путём.
							    Возвращает скрипт макета по метке `data-back`. */}
							<a class="back" href={backHref} data-back>
								← Назад
							</a>
							<span>
								<time datetime={isoDate}>{formatPostDate(date)}</time>
								{timing && ` · ${timing.label}`}
							</span>
						</div>
						<div class:list={['episode-grid', !heroCover && 'without-cover']}>
							{/* Обложка выпуска всегда квадрат и НЕ ОБРЕЗАЕТСЯ (§9):
							    artwork важен целиком. Картинки нет — нет и рамки:
							    пустой квадрат с линией по краю читается поломкой
							    вёрстки. Тогда сетка становится одноколоночной,
							    иначе заголовок встал бы в колонку под обложку. */}
							{heroCover && (
								<div class="episode-cover">
									<img src={heroCover.src} alt={`Обложка: ${title}`} width="360" height="360" />
								</div>
							)}
							<div class="episode-copy">
								<PostKicker post={post} withTiming={false} />
								<h1 data-pagefind-meta="title">{title}</h1>
								{bonusDeck && <p class="episode-deck">{bonusDeck}</p>}
								{/* Плеер лежит в своей обёртке, а не прижимается сам.
								    Обёртка держит и «прижаться к низу», и обязательный
								    зазор от заголовка: `margin-top: auto` при длинном
								    названии схлопывается в ноль, и плеер прилипает
								    к последней строке. Отступ отдан padding'у —
								    его auto-margin не съедает. */}
								{!isBonus && episode && (
									<div class="player-slot">
										<EpisodePlayer
											guid={episode.guid}
											audioUrl={episode.audioUrl}
											title={title}
											cover={playerCover}
											link={`/posts/${post.id}/`}
											durationSec={episode.durationSec}
											caption={playerCaption}
											hint={playerHint}
										/>
									</div>
								)}
							</div>
						</div>
					</section>
				) : (
					<ContentHeader
						backHref={backHref}
						date={date}
						timing={timing?.label ?? null}
						title={title}
						lead={lead}
					/>
				)
			}

			{/* ЗДЕСЬ БЫЛИ ДВА ОКОШКА ВИДЕО В ШАПКЕ — из полей «Ссылка на ролик»
			    и «Своё видео». Оба сняты решением заказчика 15 августа 2026:
			    ролик вставляется кнопкой «Видео» прямо в текст, блоком `::video`,
			    и получает ту же ширину 1000 правилом `.content > .video-wrap`
			    ниже. Вид совпадал нарочно, то есть двери вели в одну комнату,
			    а заполнены поля были у нуля постов из 747. */}

			<section class="post-body">
				{bodyLabel && <h2 class="body-label tech">{bodyLabel}</h2>}
				<div class="content">
					<Content />
				</div>

			</section>

			{/* Оглавление выпуска — ниже описания, до транскрипта (тз/08, 9.3).
			    Пустое поле блока не рисует вовсе. */}
			<TimecodeList rows={timecodeRows} seekYoutube={youtubeSeek} />

			{/* Плашка подписки — сразу за текстом, как в макете: текст выше это
			    тизер, он открыт всем и попадает в поиск, а дальше начинается
			    платное. Марки тайтлов ниже остаются на своём обычном месте,
			    в самом низу страницы, как у всех постов. */}
			{isBonus && <BonusPaywall links={bonusLinks} postId={post.id} />}

			{/* Аудиоверсия видеоэссе — тот же плеер, что у выпуска (§14).
			    Появляется, только если у видеоэссе есть пара в RSS: ролик,
			    выложенный только на YouTube, аудиоверсии не имеет. */}
			{
				isVideoEssay && episode && (
					<section class="audio-section" aria-labelledby="audio-title">
						<h2 class="body-label tech" id="audio-title">
							аудиоверсия
						</h2>
						<EpisodePlayer
							guid={episode.guid}
							audioUrl={episode.audioUrl}
							title={title}
							cover={playerCover}
							link={`/posts/${post.id}/`}
							durationSec={episode.durationSec}
							caption={playerCaption}
							hint={playerHint}
						/>
					</section>
				)
			}

			{
				showTranscript && (
					<div class="transcript-wrap">
						<Transcript transcript={transcriptData} transcriptId={transcript.id} mentionsHidden={post.data.mentionsHidden} />
					</div>
				)
			}

			{/* Заголовок блока одинаковый на всех четырёх страницах материалов:
			    это технический слой, а не подпись под конкретный тип. «В выпуске»
			    и «в видеоэссе» на разных страницах — два текста об одном и том же,
			    и разойтись им проще, чем кажется. */}
			{
				animeEntries.length > 0 && (
					<section class="mentions" aria-labelledby="mentions-title" data-pagefind-ignore>
						<h2 class="mentions-title eyebrow tech" id="mentions-title">упоминается в материале</h2>
						<div class="stamp-grid">
							{animeEntries.map((entry) => (
								<AnimeBadge anime={entry} mentions={mentionTimes.get(entry.id)?.length ?? 0} />
							))}
						</div>
					</section>
				)
			}

			{/* Подписи «Предыдущий / Следующий материал» одинаковы у всех пяти
			    раскладок. В макетах они разные («выпуск», «видеоэссе»), но пятая
			    подпись у категории — это пятая строка, которую придётся держать
			    в согласии с остальными; выигрыш же тут нулевой: куда ведёт
			    ссылка, читателю говорит её собственный заголовок. */}
			{
				(olderPost || newerPost) && (
					<nav class="post-nav" aria-label="Соседние материалы" data-pagefind-ignore>
						{olderPost && (
							<a href={`/posts/${olderPost.slug}/`}>
								{/* Слово «материал» на телефоне уходит от глаза, но остаётся
								    диктору: в колонку шириной 130 px подпись целиком
								    не помещается. */}
								<span class="nav-label tech">← Предыдущий<span class="visually-hidden-sm"> материал</span></span>
								<span class="nav-title">{olderPost.title}</span>
							</a>
						)}
						{newerPost && (
							<a href={`/posts/${newerPost.slug}/`}>
								<span class="nav-label tech">Следующий<span class="visually-hidden-sm"> материал</span> →</span>
								<span class="nav-title">{newerPost.title}</span>
							</a>
						)}
					</nav>
				)
			}
			{/* НЕВИДИМОЕ ПОЛЕ ПОИСКА: НАЗВАНИЯ УПОМЯНУТЫХ ТАЙТЛОВ (11 августа 2026).
			    Марки тайтлов выше помечены `data-pagefind-ignore` — они органы
			    навигации, и в цитате выдачи читались бы мусором. Но вместе с ними
			    из поиска выпадали и сами названия: тайтл, проставленный РУКОЙ
			    в поле «Тайтлы поста», в тексте материала может не встречаться
			    ни разу, и материал не находился по нему вовсе. Заказчик вправе
			    ждать обратного: он проставил тайтл затем, чтобы связь работала.

			    Слова те же, что у страницы тайтла и у внешней статьи, и берутся
			    общей функцией (src/lib/animeSearch.mjs) — вписанный в админку
			    вариант написания обязан действовать во всех трёх местах разом.

			    СТОИТ ПОСЛЕДНИМ, И ЭТО ВАЖНО ДВАЖДЫ. Во-первых, так строка
			    не попадает в начало отрывка выдачи. Во-вторых, у неё свой `id`,
			    и по нему страница поиска отличает совпадение «в тайтлах» от
			    совпадения в тексте: первое ставит материал в выдачу, но цитатой
			    не становится — читать «Блич Bleach блич» незачем. */}
			{animeSearchField && (
				<span id="anime-words" class="visually-hidden" aria-hidden="true">
					{animeSearchField}
				</span>
			)}
		</article>

		{/* ДВА ХВОСТОВЫХ БЛОКА — ЗА ПРЕДЕЛАМИ `<article>`, и это не оформление,
		    а условие: `data-pagefind-body` стоит на самой статье, и всё, что
		    внутри неё, уходит в поисковый индекс как текст материала. Внутри
		    статьи ссылки на площадки превратили бы каждую цитату выдачи
		    в «Telegram · Новости, мысли и новые материалы». У самих блоков
		    вдобавок стоит `data-pagefind-ignore` — на случай, если однажды
		    их поставят внутрь.

		    БОНУСУ ИХ НЕ ДОСТАЁТСЯ: там уже стоит плашка подписки с теми же
		    кнопками площадок, и второй такой же блок читался бы повтором.
		    Так и в макете `bonus.html`. Постов-ссылок на чужие сайты это
		    не касается вовсе — своей страницы у них не создаётся.

		    Отбивку сверху даёт «Соседние материалы»: у неё `margin-bottom`
		    в 72 px, ровно те же, что у обёртки `.article-tail` в макете.
		    Своей отбивки блоки не заводят.

		    ШИРИНА У НИХ САЙТОВАЯ, А НЕ МАТЕРИАЛА — 1320, вровень с подвалом.
		    До 10 августа 2026 они лежали в обёртке шириной 1000, по оси
		    транскрипта, упоминаний и соседних материалов: казалось правильным
		    равнять их по остальному хвосту страницы. Заказчик посмотрел живую
		    страницу и сказал верное — эти блоки относятся не к материалу,
		    а ко всему сайту, как подвал, и колонка материала им не указ.
		    На остальных четырёх страницах они и так стояли прямыми детьми
		    `.site`; узкой была ровно эта. */}
		{
			!isBonus && (
				<>
					<SocialStrip />
					<SupportStrip />
				</>
			)
		}
	</div>
</Layout>

<script>
	// Из-за <ClientRouter /> в Layout.astro переходы между постами теперь идут
	// без полной перезагрузки страницы (это нужно закреплённому плееру — см.
	// src/components/PlayerBar.astro). Но у всех постов один и тот же
	// собранный файл скрипта, поэтому браузер выполняет его только один раз
	// за сессию — если оставить код на верхнем уровне, лайтбокс/спойлеры/
	// карусель будут работать только у первого открытого поста. Оборачиваем
	// в astro:page-load, это событие срабатывает и при первой загрузке,
	// и после каждого перехода.
	function closeLightbox(overlay: HTMLElement, onKeydown: (event: KeyboardEvent) => void) {
		overlay.remove();
		document.removeEventListener('keydown', onKeydown);
	}

	function initPostInteractions() {
		document.querySelectorAll<HTMLAnchorElement>('.content a.figure-zoom').forEach((link) => {
			link.addEventListener('click', (event) => {
				event.preventDefault();
				const sourceImg = link.querySelector('img');
				if (!sourceImg) return;

				const overlay = document.createElement('div');
				overlay.className = 'lightbox';

				const bigImg = document.createElement('img');
				// .src — то, что браузер выбрал из srcset для превью, необязательно
				// самое крупное; data-full всегда указывает на него явно.
				bigImg.src = sourceImg.dataset.full || sourceImg.src;
				bigImg.alt = sourceImg.alt;
				overlay.appendChild(bigImg);

				const onKeydown = (event: KeyboardEvent) => {
					if (event.key === 'Escape') closeLightbox(overlay, onKeydown);
				};

				overlay.addEventListener('click', () => closeLightbox(overlay, onKeydown));
				document.addEventListener('keydown', onKeydown);
				document.body.appendChild(overlay);
			});
		});

		// Карусель галереи. Листание — это ПРОКРУТКА ТРЕКА, а не подмена картинки:
		// трек и так прокручивается пальцем, и вторая, своя механика перемещения
		// разошлась бы с ней — счётчик показывал бы одно, а на экране стояло другое.
		document.querySelectorAll<HTMLElement>('.gallery-carousel').forEach((carousel) => {
			const track = carousel.querySelector<HTMLElement>('.gallery-track');
			const slides = carousel.querySelectorAll<HTMLElement>('.gallery-slide');
			const counter = carousel.querySelector<HTMLElement>('.gallery-count');
			const prev = carousel.querySelector<HTMLButtonElement>('.gallery-btn.prev');
			const next = carousel.querySelector<HTMLButtonElement>('.gallery-btn.next');
			if (!track || slides.length === 0) return;

			const pad = (value: number) => String(value).padStart(2, '0');

			// Какой слайд сейчас, считаем по положению прокрутки: так число
			// одинаково верно и после нажатия стрелки, и после свайпа.
			const current = () => Math.round(track.scrollLeft / track.clientWidth);

			const sync = () => {
				const index = Math.min(Math.max(current(), 0), slides.length - 1);
				if (counter) counter.textContent = `${pad(index + 1)} / ${pad(slides.length)}`;
				// Край — выключенная кнопка, а не бесконечная лента: у ленты
				// не видно, где она кончилась.
				if (prev) prev.disabled = index === 0;
				if (next) next.disabled = index === slides.length - 1;
			};

			const go = (step: number) => {
				track.scrollTo({ left: (current() + step) * track.clientWidth, behavior: 'smooth' });
			};

			prev?.addEventListener('click', () => go(-1));
			next?.addEventListener('click', () => go(1));
			track.addEventListener('scroll', sync, { passive: true });
			sync();
		});

		// Блочный спойлер (абзацы/картинки/галерея) — кнопка между двумя линиями
		// остаётся видна, раскрытое содержимое появляется под ней.
		document.querySelectorAll<HTMLElement>('.spoiler').forEach((spoiler) => {
			const button = spoiler.querySelector<HTMLButtonElement>('.spoiler-toggle');
			const template = spoiler.querySelector<HTMLTemplateElement>('template.spoiler-content');
			const label = spoiler.querySelector<HTMLElement>('.spoiler-toggle .label');
			const mark = spoiler.querySelector<HTMLElement>('.spoiler-toggle .mark');
			if (!button || !template || !label || !mark) return;

			// Автор пишет только существительное, глагол системный — см.
			// src/plugins/remark-spoiler.mjs. Второго места, где записано слово,
			// нет: оно приезжает сюда атрибутом.
			const noun = spoiler.dataset.label || 'спойлер';
			let body: HTMLElement | null = null;

			const sync = (open: boolean) => {
				label.textContent = `${open ? 'Скрыть' : 'Показать'} ${noun}`;
				mark.textContent = open ? '×' : '+';
				button.setAttribute('aria-expanded', String(open));
			};

			button.addEventListener('click', () => {
				if (!body) {
					body = document.createElement('div');
					body.className = 'spoiler-body';
					body.appendChild(template.content.cloneNode(true));
					spoiler.appendChild(body);
					sync(true);
					return;
				}

				body.hidden = !body.hidden;
				sync(!body.hidden);
			});
		});

		// Спойлер на слово или фразу.
		//
		// ТЕКСТ ПЕРЕЕЗЖАЕТ ВНУТРЬ КНОПКИ ОДИН РАЗ, ПРИ ЗАГРУЗКЕ, и дальше стоит
		// на месте: нажатие только снимает с него невидимость. Поэтому строка
		// не прыгает и абзац не переверстывается — а спрятать текст через display
		// значило бы дёргать всю страницу при каждом раскрытии.
		//
		// В разметку страницы текст при этом не попадает: он лежит в <template>,
		// а туда не заглядывают ни поисковый робот, ни индекс поиска по сайту.
		document.querySelectorAll<HTMLElement>('.spoiler-inline').forEach((spoiler) => {
			const button = spoiler.querySelector<HTMLButtonElement>('.spoiler-word');
			const template = spoiler.querySelector<HTMLTemplateElement>('template.spoiler-content');
			if (!button || !template || button.childElementCount > 0) return;

			const revealed = document.createElement('span');
			revealed.appendChild(template.content.cloneNode(true));
			button.appendChild(revealed);
			// Ширину теперь задаёт сам текст. До этой строки её держала оценка
			// по числу букв — иначе плашки не было бы видно вовсе.
			button.style.width = '';

			button.addEventListener('click', () => {
				const open = button.getAttribute('aria-expanded') !== 'true';
				button.setAttribute('aria-expanded', String(open));
				// Раскрытый текст диктор должен прочитать как текст, а не как
				// подпись кнопки: пока подпись стоит, содержимое ею перекрыто.
				if (open) button.removeAttribute('aria-label');
				else button.setAttribute('aria-label', 'Показать скрытый текст');
			});
		});
	}

	/**
	 * Перемотка ролика YouTube — для блока таймкодов у видеоэссе (тз/08, 9.3).
	 *
	 * САМОГО НАЖАТИЯ ЭТОТ КОД НЕ СЛЫШИТ. Обработчик нажатий на `.timecode`
	 * один на весь сайт и живёт в src/components/PlayerBar.astro; здесь только
	 * ответ на вопрос «куда перематывать», выставленный наружу как
	 * `window.__bakaYouTube`. Заведи мы второй обработчик — нажатие
	 * обработалось бы дважды (ровно эти грабли описаны в Transcript.astro).
	 *
	 * СВОЙ ЗАПРОС НА ПЕРЕМОТКУ ЗАПОМИНАЕТСЯ. Библиотека YouTube грузится
	 * с их сервера и готова не сразу; нажатие в первую секунду после открытия
	 * страницы иначе пропало бы молча, а читатель решил бы, что блок не работает.
	 */
	function initYoutubeSeek() {
		const api = window as any;

		// Перематывать ролик или плеер — решает страница, а не этот код:
		// метку ставит блок таймкодов, и только у видеоэссе. Нет метки —
		// убираем прошлый ответ: страница сменилась, и он теперь про чужой ролик.
		const wantsYoutube = document.querySelector('.timecodes[data-seek="youtube"]');

		// Ролик берём ПЕРВЫЙ на странице, каким бы способом его ни вставили:
		// у видеоэссе архива он стоит блоком в тексте, а не в поле шапки.
		const frame = wantsYoutube ? document.querySelector<HTMLIFrameElement>('iframe[src*="youtube.com/embed/"]') : null;

		if (!frame) {
			api.__bakaYouTube = undefined;
			return;
		}

		// Разрешение управлять роликом снаружи. У окошка из шапки оно уже стоит
		// (проставлено при сборке), у окошка из текста — нет: разметку ему делает
		// плагин, который про таймкоды не знает и знать не должен. Ролик в тексте
		// грузится лениво и до сгиба обычно не доходит, поэтому смена адреса тут
		// ничего не стоит.
		if (!/[?&]enablejsapi=1/.test(frame.src)) {
			frame.src += `${frame.src.includes('?') ? '&' : '?'}enablejsapi=1`;
		}

		let player: any = null;
		let pending: number | null = null;

		api.__bakaYouTube = {
			seek(seconds: number) {
				if (player && typeof player.seekTo === 'function') {
					player.seekTo(seconds, true);
					player.playVideo?.();
					return;
				}
				pending = seconds;
			},
		};

		const createPlayer = () => {
			// Переход между страницами без перезагрузки: библиотека уже могла
			// быть создана на прошлой странице, а окошко теперь другое.
			player = new api.YT.Player(frame, {
				events: {
					onReady: () => {
						if (pending === null) return;
						player.seekTo(pending, true);
						player.playVideo?.();
						pending = null;
					},
				},
			});
		};

		if (api.YT?.Player) {
			createPlayer();
			return;
		}

		// Библиотека зовёт эту функцию один раз, когда загрузится. На повторных
		// переходах её уже не будет — поэтому ветка выше проверяет YT первой.
		api.onYouTubeIframeAPIReady = createPlayer;

		if (!document.querySelector('script[src*="youtube.com/iframe_api"]')) {
			const script = document.createElement('script');
			script.src = 'https://www.youtube.com/iframe_api';
			document.head.appendChild(script);
		}
	}

	// БУДИЛЬНИК СВОЕГО ВИДЕО ПЕРЕЕХАЛ В Layout.astro, и это не перестановка
	// ради порядка, а лечение. Скрипт этой страницы приезжает вместе с ней:
	// открыв сайт с главной, браузер видит его впервые уже ПОСЛЕ перехода —
	// то есть в тот самый переход, который и надо было пережить. Скрипт макета
	// стоит на каждой странице и потому подписан на переходы с самого первого
	// открытия сайта. Подробности и вторая причина — там же, в Layout.astro.

	document.addEventListener('astro:page-load', () => {
		initPostInteractions();
		initYoutubeSeek();
	});
</script>

<style>
	/* ——— Шапка выпуска и бонуса (§13) ——— */

	.episode-hero {
		margin: var(--sp-12) 0;
	}

	/* По базовой линии, а не по центру: слева и справа один и тот же
	   технический текст, и он обязан стоять на одной линии букв независимо
	   от того, какой высоты вышли коробки. Подробнее — в ContentHeader.astro,
	   там же живёт та же строка у статьи. */
	.episode-topline {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--sp-2) var(--sp-6);
		margin-bottom: var(--sp-6);
		color: var(--muted);
	}

	.episode-topline .back {
		color: var(--ink);
	}

	.episode-topline .back:hover,
	.episode-topline .back:focus-visible {
		color: var(--accent-text);
	}

	.episode-grid {
		display: grid;
		gap: var(--sp-6);
	}

	/* ОБЛОЖКА НЕ ТЯНЕТСЯ ПО ВЫСОТЕ КОЛОНКИ. Ряд грида по умолчанию растягивает
	   свои ячейки, и это правильно для текстовой колонки (иначе плееру нечего
	   прижимать к низу), но для обложки — беда: заданная высота перебивает
	   `aspect-ratio`, рамка вытягивается в полосу, а квадратная картинка
	   болтается в ней по центру. Видно только на длинном заголовке, когда
	   колонка перерастает обложку. */
	/* РАМКИ У ОБЛОЖКИ НЕТ, И ЭТО НАРОЧНО. Раньше линия в пиксель обводила
	   картинку с фоном; теперь внутри вырезанный персонаж на прозрачном,
	   и рамка обводила бы пустоту вокруг него — а заодно спорила бы
	   с карточками ленты, где никакой рамки нет. Решение заказчика
	   10 августа 2026, тз/12.

	   Правило «место под картинку рисуется, только когда картинка есть»
	   при этом никуда не делось: без обложки колонки не заводится вовсе
	   (`.episode-grid.without-cover`), и пустого квадрата не остаётся. */
	.episode-cover {
		align-self: start;
		width: min(340px, 100%);
		aspect-ratio: 1;
		display: grid;
		place-items: center;
		overflow: hidden;
	}

	.episode-cover img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	/* ФИКСИРОВАННОЙ ВЫСОТЫ У КОЛОНКИ НЕТ И БЫТЬ НЕ ДОЛЖНО (§4.2). Плеер
	   прижимается к низу через margin-top:auto внутри флекса; высоту колонке
	   задаёт сам ряд грида, выровненный по обложке. Поставь тут height: 360px —
	   и длинный заголовок вылезет за край, а короткий оставит дыру. */
	.episode-copy {
		min-width: 0;
		display: flex;
		flex-direction: column;
	}

	.episode-copy h1 {
		margin: 0;
	}

	.episode-copy :global(.kicker) {
		margin-bottom: var(--sp-3);
	}

	/* Зазор от заголовка обязателен на всех ширинах: при длинном названии
	   колонка перерастает обложку, свободного места не остаётся, и плеер
	   встаёт вплотную к последней строке. */
	.player-slot {
		padding-top: var(--sp-8);
	}

	.episode-deck {
		margin: var(--sp-4) 0 0;
		font-family: var(--font-display);
		font-size: var(--card-title);
		line-height: 1.45;
		color: var(--text);
	}

	@media (min-width: 621px) {
		.episode-hero {
			margin-top: var(--sp-16);
		}
	}

	@media (min-width: 821px) {
		.episode-grid {
			grid-template-columns: 300px minmax(0, 1fr);
			gap: var(--sp-8);
			align-items: stretch;
		}

		/* Колонки под обложку нет, когда нет обложки. Уточнение стоит В КАЖДОМ
		   медиазапросе, где задаются колонки, — иначе на одной ширине сетка
		   осталась бы двухколоночной с пустой первой колонкой, и увидеть это
		   можно было бы только глазами на этой ширине. */
		.episode-grid.without-cover {
			grid-template-columns: minmax(0, 1fr);
		}

		.episode-cover {
			width: 300px;
		}

		/* Плеер живёт в своём компоненте (часть 6), поэтому его положение
		   в колонке задаётся отсюда — это композиция страницы, а не устройство
		   плеера. Прижимается обёртка: у самого плеера auto-margin съел бы
		   зазор от заголовка. */
		.player-slot {
			margin-top: auto;
		}
	}

	@media (min-width: 1101px) {
		.episode-hero {
			max-width: var(--wide);
			margin-inline: auto;
			margin-block: var(--sp-16) var(--sp-18);
		}

		.episode-grid {
			grid-template-columns: 360px minmax(0, 1fr);
			gap: var(--sp-12);
		}

		.episode-grid.without-cover {
			grid-template-columns: minmax(0, 1fr);
		}

		.episode-cover {
			width: 360px;
		}
	}

	/* ——— Своё видео в тексте (§14) ——— */

	/* Описание ОДНО, и с 15 августа 2026 место у него тоже одно: блок
	   `::video{video="…"}` прямо в тексте. Прежде их было два — сюда же
	   ходило окошко из поля «Своё видео» в шапке материала, — и до того
	   описаний было два, и они разъехались: у ролика YouTube пропорция
	   стояла, у своего видео не стояла нигде. Поля сняты (были заполнены
	   у нуля постов), окошко в шапке ушло вместе с ними.

	   `aspect-ratio: auto 16 / 9` читается так: пропорцию берём из самого
	   файла, как только браузер вычитает его заголовок, а 16/9 — подпорка
	   на это время. Без подпорки <video> с неизвестными размерами встаёт
	   стандартными 300×150, то есть широкой чёрной полосой в 150 px высотой,
	   и материал выглядит сломанным. */
	.content :global(.content-video) {
		display: block;
		width: 100%;
		aspect-ratio: auto 16 / 9;
		background: var(--ink);
	}

	/* ——— Текст материала ——— */

	/* Контейнер широкий (1240), а колонка чтения задаётся детям. Так медиа
	   получает три ширины из §12 — 700, 1000 и 1240, — не вылезая из потока
	   и не считая ничего от ширины окна. */
	.post-body {
		width: 100%;
		max-width: var(--full);
		margin-inline: auto;
	}

	/* `.body-label` переехал в global.css: подпись блока нужна теперь
	   и оглавлению выпуска, а вид у всех подписей обязан быть один. */

	.content > :global(*) {
		max-width: var(--reading);
		margin-inline: auto;
	}

	/* ВЫСОТА КАРТИНКИ ОГРАНИЧЕНА ЭКРАНОМ (14 августа 2026, решение заказчика).
	   Вертикальный кадр раньше рос во всю свою высоту: ширина колонки задана,
	   высота считалась от пропорции — и постер 2:3 занимал два с половиной
	   экрана, а в карусели приходилось листать вслепую, не видя картинку
	   целиком.

	   Поля по бокам при этом появляются, и это принято сознательно: лучше
	   пустое место слева и справа, чем кадр, который не помещается в глаз.

	   ЧИСЛО ЖИВЁТ ЗДЕСЬ ОДНО НА ТРИ МЕСТА — одиночная картинка, слайд
	   карусели и плитка сетки. Порознь они разъехались бы молча: у каждого
	   свой селектор, и правку внесли бы в тот, который открыт.

	   svh, а не vh: на телефоне адресная строка то есть, то нет, и vh считает
	   по большему из состояний — картинка вылезала бы за экран ровно тогда,
	   когда строка показана. Браузер, не знающий svh, просто не применит
	   ограничение и покажет как раньше. */
	.content {
		--figure-max-h: 80svh;
	}

	/* Медиа шире колонки. Селектор длиннее базового `.content > *`, поэтому
	   побеждает по весу — это и есть механизм трёх ширин. */
	.content > :global(figure.gallery),
	.content > :global(.video-wrap),
	.content > :global(.content-video) {
		max-width: var(--wide);
	}

	.content > :global(figure.figure-full) {
		max-width: var(--full);
	}

	/* ——— Маркировка рекламы (тз/10.7) ———

	   Разметку ставит src/plugins/remark-ad-label.mjs — рядом с первой строкой
	   ТЕКСТА, а не в начале материала. Плагинную разметку стили компонента
	   не видят (Astro метит только то, что написано в самом файле), поэтому
	   все правила блока писаны `:global` — И В МЕДИАЗАПРОСЕ ТОЖЕ: смешаешь
	   с голым классом, и правила разойдутся по весу молча.

	   КАПСЛОКА ТУТ НЕТ, ХОТЯ ЭТО ТЕХНИЧЕСКИЙ СЛОЙ. В строке стоит `erid` —
	   опознавательный код рекламы, и в нём различаются строчные и прописные
	   («LjN8JuJd5»). Капслок меняет только показ, но человек, переписывающий
	   код глазами, получил бы не тот. Так же снят капслок у времени
	   в закреплённой панели плеера: технический слой не значит «всё капсом».

	   Строку можно резать посреди слова, и это осознанно: полоса справа узкая
	   (137 px на 1101), а длинное название рекламодателя иначе вылезло бы
	   из неё прямо на колонку чтения. Разорванное слово тут меньшее зло. */
	.content :global(.ad-mark) {
		margin-block: 0 var(--sp-6);
		color: var(--muted);
		text-transform: none;
		overflow-wrap: anywhere;
	}

	@media (min-width: 1101px) {
		/* ВЫНОСНОЙ БЛОК СПРАВА ОТ КОЛОНКИ ЧТЕНИЯ, и ширина у него посчитана,
		   а не подобрана: свободная полоса справа — это (ширина контейнера
		   минус колонка) пополам, минус зазор до самой колонки. На 1440 это
		   246 px, на 1101 — 137. `float` выбран нарочно: он не занимает высоты
		   в потоке, поэтому текст материала не сдвигается вниз ни на пиксель,
		   а строки абзацев он не трогает вовсе — они лежат в коробке шириной
		   700 по центру и до правой полосы не достают. */
		.content > :global(.ad-mark) {
			float: right;
			width: calc((100% - var(--reading)) / 2 - var(--sp-6));
			max-width: none;
			margin-block: 0;
		}

		/* А ВОТ ШИРОКОЕ МЕДИА ДО ЭТОЙ ПОЛОСЫ ДОСТАЁТ: галерея и видео идут
		   на 1000, картинка «во всю ширину» — на 1240, и правым краем они
		   заезжают ровно туда, где висит маркировка. `clear` уводит их НИЖЕ
		   неё, а не наоборот: пометка обязана быть видимой, и прятаться под
		   картинку ей нельзя. Без плавающего блока эта строчка не делает
		   ничего — на всех остальных постах она пустая формальность. */
		.content > :global(figure.gallery),
		.content > :global(.video-wrap),
		.content > :global(.content-video),
		.content > :global(figure.figure-full) {
			clear: right;
		}

		/* То же самое для всего, что идёт ПОСЛЕ текста материала: транскрипт
		   (1000), плашка подписки (1240), блок марок. У короткой заметки
		   маркировка может оказаться выше самого текста, и тогда она вылезет
		   из него вниз — сюда. Правило одно на все секции и переживёт появление
		   новых: перечислять их поимённо значило бы забыть следующую. */
		.post > :global(*) {
			clear: right;
		}
	}

	/* ВНУТРИ .content НИГДЕ НЕ ПИШЕМ СОКРАЩЁННЫЙ `margin`: он сбросил бы
	   margin-inline:auto выше, и всё содержимое уехало бы к левому краю
	   контейнера в 1240. Только margin-block. */
	.content :global(p) {
		margin-block: 0 var(--sp-6);
		font-size: var(--body-lg);
		line-height: 1.65;
		color: var(--text);
	}

	.content :global(h2) {
		margin-block: var(--sp-12) var(--sp-6);
	}

	/* ОТСТУПЫ У ТРЕТЬЕГО И ПЯТОГО РАЗНЫЕ, И ЭТО ВСЯ ИХ ИЕРАРХИЯ ПО РАЗМЕРУ.
	   Кегль у них одинаковый — ровно 11 px технического слоя, ниже он
	   не опускается, — поэтому «третий крупнее пятого» читается только
	   по воздуху вокруг и по цвету. Сам вид (моно, капслок, трекинг, цвет)
	   лежит в global.css рядом с `.tech`: разметка приезжает из markdown,
	   классов на ней нет, и описание там одно на весь сайт.

	   ЧЕТВЁРТЫЙ ИЗ ЭТОГО СЧЁТА ВЫШЕЛ 14 августа 2026: он поднят до настоящего
	   заголовка в 22 px, и размер у него теперь свой. Воздуха ему дано столько
	   же, сколько третьему, — не для равенства, а потому, что элемент вдвое
	   крупнее прежнего и прежние 24/12 его поджимали. */
	.content :global(h3) {
		margin-block: var(--sp-8) var(--sp-4);
	}

	.content :global(h4) {
		margin-block: var(--sp-8) var(--sp-4);
	}

	.content :global(h5) {
		margin-block: var(--sp-4) var(--sp-2);
	}

	/* МАРКЕР СТОИТ ВНУТРИ КОЛОНКИ ТЕКСТА, А НЕ СЛЕВА ОТ НЕЁ (12 августа 2026).

	   Было `padding-left: 1.25rem` и маркер снаружи — и номера вылезали
	   из колонки в поле страницы. Замер по снимку заказчика (iPhone, 1206
	   физических пикселей на 402 CSS): абзацы начинаются на 19 px от края
	   экрана, а строки списка на 12 px, то есть цифра торчала наружу на 6.
	   Причина не в опечатке: наружный маркер браузер кладёт ЛЕВЕЕ колонки
	   на свою ширину плюс собственный зазор, и 20 px его не вмещают —
	   «1.» просит около 26, а «10.» около 34 (в архиве есть список ровно
	   на десять пунктов).

	   Подобрать отступ побольше — значит поставить число, которого мы
	   не знаем: зазор между маркером и текстом задаёт браузер, у каждого
	   свой, и промах вернулся бы молча. Маркер ВНУТРИ колонки вылезти
	   не может в принципе, и отступ тогда не нужен вовсе: список встаёт
	   по той же левой линии, что и абзацы. На телефоне это ещё и 20 px
	   ширины обратно.

	   Нумерация остаётся браузерной, и это обязательно: в архиве 13 списков
	   с `start` (пост про филлеры целиком набран кусками, начинающимися
	   с третьего, седьмого и так далее). Своя нумерация счётчиком их
	   перенумеровала бы с единицы.

	   Висячего отступа мы при этом лишаемся — вторая строка длинного пункта
	   встаёт под номером, а не под текстом. Цена посчитана: вложенных списков
	   в архиве ноль, пункты короткие. Зазор после номера даёт сам браузер
	   (у десятичной нумерации точка с пробелом), у точки маркированного
	   списка он вписан в знак — см. `list-style-type` в global.css. */
	.content :global(ul),
	.content :global(ol) {
		margin-block: 0 var(--sp-6);
		padding-left: 0;
		list-style-position: inside;
		font-size: var(--body-lg);
		line-height: 1.65;
		color: var(--text);
	}

	.content :global(blockquote) {
		margin-block: 0 var(--sp-6);
		padding-left: var(--sp-4);
		border-left: 2px solid var(--accent-brand);
		color: var(--muted);
	}

	/* Запасной стиль для обычной картинки в тексте (![]()) — например, обложки
	   выпуска у видеоэссе. Блок «Изображение с подписью» из редактора получает
	   свои размеры через figure ниже, эта картинка проще. */
	.content :global(p > img) {
		display: block;
		width: 100%;
		/* Обязательно вместе с width: картинка приходит с атрибутами
		   width/height в разметке (см. src/plugins/remark-episode-cover.mjs) —
		   они держат место, пока картинка грузится, чтобы текст не подпрыгивал.
		   Без height: auto браузер применил бы высоту из атрибута буквально
		   и картинка растянулась бы. */
		height: auto;
	}

	.content :global(figure.figure) {
		margin-block: var(--sp-12);
	}

	.content :global(.figure-zoom) {
		display: block;
		cursor: zoom-in;
	}

	.content :global(.figure-zoom img) {
		width: 100%;
		height: auto;
		/* Выше экрана не растём — см. --figure-max-h. `contain` тут
		   обязателен: без него обрезанная по высоте картинка сожмётся
		   по вертикали, а не впишется. */
		max-height: var(--figure-max-h);
		object-fit: contain;
	}

	/* Подпись — два слоя в одной строке: технический номер и текст подписи
	   (§12). Номер расставляет сборка, см. src/plugins/remark-image-figure.mjs. */
	.content :global(figcaption) {
		margin-block: var(--sp-2) 0;
		font-size: var(--caption);
		line-height: 1.5;
		color: var(--muted);
	}

	.content :global(figcaption b) {
		font-family: var(--font-tech);
		font-size: var(--technical);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin-right: var(--sp-2);
	}

	/* ——— Галерея, режим «сетка»: от двух до четырёх картинок ——— */

	/* ДВЕ КОЛОНКИ НА ЛЮБОЙ ШИРИНЕ, включая телефон — решение заказчика
	   11 августа 2026. Раньше до 620 стояла одна, и четыре картинки шли
	   столбиком почти на весь экран: сетка перестаёт читаться сеткой, и от
	   карусели её отличает только то, что листать не надо. На 390 px плитка
	   выходит 187 px (галерея тут вынесена до краёв экрана, см. медиазапрос
	   ≤620 ниже) — миниатюра, а не марка, и кадр в ней разбирается.
	   Медиазапроса у этого правила больше нет вовсе: одно правило на все
	   ширины разойтись по весу само с собой не может. */
	.content > :global(figure.gallery-grid) {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--sp-2);
		margin-block: var(--sp-12);
	}

	.content :global(.gallery-item) {
		/* ПРОПОРЦИЮ ПЛИТКИ ЗАДАЮТ САМИ КАДРЫ. Число считает сборка
		   (`remark-image-figure.mjs`, медиана пропорций галереи) и кладёт
		   его в `--tile-ratio`; 16:9 остаётся запасным на случай, когда
		   размеров прочитать не вышло.

		   Раньше тут стояло жёсткое 16:9, и вертикальные кадры резались
		   пополам — две страницы манги в заметке про «Человека-паука»
		   показывались широкими полосками. У однородной галереи (а таких
		   подавляющее большинство) медиана равна пропорции кадров, то есть
		   не режется вообще ничего.

		   Плитка всё равно кадрируется: галерея из кадров разной формы
		   ровной сеткой иначе не встанет, а целиком картинка открывается
		   по нажатию. */
		aspect-ratio: var(--tile-ratio, 16 / 9);
		overflow: hidden;
		background: var(--line-soft);
		/* Тот же предел, что у одиночной картинки и слайда, — см. --figure-max-h.
		   Плитка вдвое уже колонки, поэтому упирается в него редко; правило
		   стоит здесь, чтобы не осталось единственного места, где вертикальный
		   кадр по-прежнему тянется без предела. */
		max-height: var(--figure-max-h);
	}

	.content :global(.gallery-item .figure-zoom) {
		height: 100%;
	}

	.content :global(.gallery-item img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Подпись общая на всю галерею — во всю её ширину. */
	.content > :global(figure.gallery-grid figcaption) {
		grid-column: 1 / -1;
	}

	/* ——— Галерея, режим «карусель»: пять картинок и больше ——— */

	.content > :global(figure.gallery-carousel) {
		margin-block: var(--sp-12);
	}

	/* Технический слой над каруселью: слева подпись блока, справа счётчик.
	   Оба обычным весом. Полужирного у подписи блока больше нет нигде —
	   решение заказчика: `[ галерея ]`, `[ таймкоды ]` и «Аудиоверсия» это
	   одна и та же сущность, и разнобой стало видно, как только две подписи
	   сошлись на одном экране. */
	.content :global(.gallery-head) {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--sp-2) var(--sp-4);
		margin-block: 0 var(--sp-3);
		font-family: var(--font-tech);
		font-size: var(--technical);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.content :global(.gallery-count) {
		/* Цифры одной ширины: иначе счётчик дёргается при листании. */
		font-variant-numeric: tabular-nums;
	}

	.content :global(.gallery-stage) {
		position: relative;
	}

	/* ЕДИНСТВЕННОЕ МЕСТО НА САЙТЕ С ГОРИЗОНТАЛЬНЫМ СКРОЛЛОМ (§4.4), и он
	   заперт внутри трека. Слайд занимает всю ширину трека, поэтому на 320 px
	   он читается целиком и своего скролла внутри не заводит. */
	.content :global(.gallery-track) {
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		/* Полосу прокрутки не показываем: о том, что тут листают, говорят
		   стрелки и счётчик, а полоса под картинкой рвёт нижнюю линию блока. */
		scrollbar-width: none;
	}

	.content :global(.gallery-track::-webkit-scrollbar) {
		width: 0;
		height: 0;
	}

	.content :global(.gallery-slide) {
		flex: 0 0 100%;
		scroll-snap-align: start;
	}

	.content :global(.gallery-slide .figure-zoom) {
		/* Рамка держит высоту трека одинаковой, а сама картинка вписывается
		   в неё целиком: §9 требует от слайда исходного соотношения, и обрезать
		   его нельзя — это то, что автор показывает.

		   Пропорция рамки — от кадров галереи, тем же числом, что у плитки
		   сетки. Обрезать оно тут ничего не может (картинка вписывается,
		   не заполняет), но у вертикальной карусели снимает пустые поля
		   по бокам, которые давало жёсткое 16:9. */
		aspect-ratio: var(--tile-ratio, 16 / 9);
		background: var(--line-soft);
		/* Выше экрана слайд не растёт — см. --figure-max-h. Пропорция при этом
		   перестаёт держаться, и по бокам появляется подложка: у вертикальной
		   карусели это возвращает те самые пустые поля, ради снятия которых
		   пропорция и считалась по кадрам. Принято сознательно. */
		max-height: var(--figure-max-h);
	}

	.content :global(.gallery-slide img) {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	/* Стрелки листания. Цель 44, на широком экране выносятся за трек,
	   на узком лежат поверх его краёв.

	   ФОН ПРОСВЕЧИВАЮЩИЙ, И ЭТО ПОПРАВКА К РЕШЕНИЮ ОТ 10 АВГУСТА, А НЕ ЕГО
	   ОТМЕНА. Тогда решалось, снимать ли у кнопки коробку целиком, и ответ
	   «ниже 1121 не снимать» остаётся верным: на светлом кадре стрелка без
	   подложки теряется. Но глухая бумага съедала по 44 px кадра с каждой
	   стороны — на телефоне это пятая часть картинки, что заказчик и увидел
	   11 августа. Вуаль держит стрелку читаемой и показывает кадр насквозь.
	   Размытие — не украшение: без него мелкий рисунок под вуалью спорит
	   с самой стрелкой, а размытый читается фоном. */
	.content :global(.gallery-btn) {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 44px;
		height: 44px;
		border: 1px solid var(--line);
		background: var(--paper-veil);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
		color: var(--ink);
		font-size: var(--h3);
		line-height: 1;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.content :global(.gallery-btn:hover:not(:disabled)) {
		border-color: var(--accent-text);
		color: var(--accent-text);
	}

	.content :global(.gallery-btn:disabled) {
		color: var(--muted);
		border-color: var(--line);
		cursor: default;
	}

	.content :global(.gallery-btn.prev) {
		left: var(--sp-2);
	}

	.content :global(.gallery-btn.next) {
		right: var(--sp-2);
	}

	/* ВЫНОС СТРЕЛОК ЗА ТРЕК НАЧИНАЕТСЯ НЕ С 1101, А С 1121 — и это посчитано,
	   а не выбрано. От 1101 оболочка сайта шириной `100% - 64px`, трек — 1000,
	   значит сбоку от него свободно 32 + (ширина окна − 1064) / 2. Стрелке
	   нужно 58, и это набирается только с 1116 px. Поставь мы 1101 из системы —
	   в полосе 1101…1115 стрелка вылезала бы за край страницы и сама создавала
	   горизонтальный скролл, который на сайте запрещено прятать. */
	@media (min-width: 1121px) {
		.content :global(.gallery-btn.prev) {
			left: -58px;
		}

		.content :global(.gallery-btn.next) {
			right: -58px;
		}

		/* РАМКА СНИМАЕТСЯ ТОЛЬКО ЗДЕСЬ, и это ровно та ширина, с которой кнопки
		   вынесены за картинку на чистую бумагу: там коробка ничего не отделяет
		   и читается лишней. Ниже 1121 кнопки лежат ПОВЕРХ края кадра, и без
		   коробки с бумажным фоном стрелка терялась бы на светлом снимке.
		   Решение заказчика 10 августа 2026. Фон остаётся: он и держит стрелку
		   отдельно от того, что под ней при прокрутке. */
		.content :global(.gallery-btn) {
			border-color: transparent;
		}

		.content :global(.gallery-btn:hover:not(:disabled)) {
			border-color: var(--accent-text);
		}
	}

	/* ——— Спойлер: блок ——— */

	/* Ширину даёт общее правило `.content > *` — читальная колонка, а не экран:
	   спойлер часть текста, и кнопка во всю ширину страницы читалась бы
	   как отдельная секция. */
	.content :global(.spoiler) {
		margin-block: var(--sp-8);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.content :global(.spoiler-toggle) {
		width: 100%;
		min-height: 56px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--sp-4);
		padding: 0;
		border: 0;
		background: transparent;
		font-family: var(--font-tech);
		font-size: var(--technical);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent-text);
		text-align: left;
		cursor: pointer;
		transition: color var(--transition-fast);
	}

	.content :global(.spoiler-toggle:hover) {
		color: var(--ink);
	}

	.content :global(.spoiler-toggle .label) {
		flex: 1;
	}

	.content :global(.spoiler-toggle .mark) {
		font-size: 16px;
		line-height: 1;
	}

	/* Своего `display` у раскрытого куска нет намеренно: он и так блочный,
	   а правило с `display` перебило бы атрибут `hidden` по весу — те самые
	   грабли, что описаны в CLAUDE.md и ловятся scripts/check-hidden.mjs. */
	.content :global(.spoiler-body) {
		padding-block: 0 var(--sp-6);
	}

	.content :global(.spoiler-body > :first-child) {
		margin-block-start: 0;
	}

	.content :global(.spoiler-body > :last-child) {
		margin-block-end: 0;
	}

	/* ——— Спойлер: слово внутри фразы ——— */

	/* Текст затирается плашкой брендового цвета ровно своей длины и остаётся
	   на месте — при раскрытии он лишь становится видимым. Поэтому строка
	   не прыгает и абзац не переверстывается. */
	.content :global(.spoiler-word) {
		position: relative;
		/* Плашка не переносится по словам, значит на узком экране длинная фраза
		   вылезла бы за край и создала горизонтальный скролл — тот самый,
		   который на сайте запрещено прятать. */
		max-width: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		font: inherit;
		color: inherit;
		cursor: pointer;
	}

	/* До того как скрипт перенёс текст внутрь, кнопка пуста — и без своей
	   высоты плашки не было бы видно вовсе. */
	.content :global(.spoiler-word:empty) {
		height: 1em;
		vertical-align: -0.15em;
	}

	.content :global(.spoiler-word > span) {
		visibility: hidden;
	}

	.content :global(.spoiler-word::before) {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--accent-brand);
		transition: opacity var(--transition-fast);
	}

	.content :global(.spoiler-word:hover::before) {
		opacity: 0.82;
	}

	.content :global(.spoiler-word[aria-expanded='true'] > span) {
		visibility: visible;
	}

	.content :global(.spoiler-word[aria-expanded='true']::before) {
		content: none;
	}

	/* Раскрытое слово остаётся помеченным — иначе непонятно, что это было
	   спрятано и что нажатие вернёт плашку обратно. */
	.content :global(.spoiler-word[aria-expanded='true']) {
		background: var(--accent-soft);
		box-shadow: 0 0 0 2px var(--accent-soft);
	}

	.content :global(.video-wrap) {
		position: relative;
		aspect-ratio: 16 / 9;
		margin-block: var(--sp-12);
		background: var(--ink);
	}

	.content :global(.video-wrap iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	/* Вид своего видео описан выше, вместе с видео из шапки. Тут остаётся
	   только отступ: у блока в тексте он свой, у видео в шапке его задаёт
	   секция вокруг. */
	.content :global(.content-video) {
		margin-block: var(--sp-12);
	}

	.content :global(.timecode) {
		font-variant-numeric: tabular-nums;
		color: var(--accent-text);
		border-bottom: 1px dashed var(--accent-text);
	}

	.content :global(.timecode:hover),
	.content :global(.timecode:focus-visible) {
		border-bottom-style: solid;
	}

	/* Вид врезки со ссылками — общий на две врезки, лежит в global.css
	   (`.inset-list`). Своей копии тут нет намеренно: у врезки со ссылками
	   и у оглавления выпуска она была своя, и за одну сессию они разъехались
	   отступами и высотой строки.

	   САМА СТРАНИЦА ВРЕЗОК БОЛЬШЕ НЕ РИСУЕТ. Третьей врезкой были «кнопки
	   материала» из поля `buttons` — фиксированный блок под всем текстом.
	   Поле переделано в «Ссылки площадок» бонусного поста (10.2), а блок убран
	   решением заказчика от 10 августа 2026: своей задачи у него не было,
	   ссылки внутри повествования ставятся кнопкой «Блок ссылок» в редакторе
	   и стоят там, где им место по смыслу, а не в хвосте. Пользовался блоком
	   ноль постов. */

	/* ——— Аудиоверсия, транскрипт, марки, соседние материалы ——— */

	.audio-section {
		width: 100%;
		max-width: var(--reading);
		margin: var(--sp-16) auto 0;
	}

	/* Сам транскрипт переоформляется в части 6 — здесь ему задана только ось. */
	.transcript-wrap {
		width: 100%;
		max-width: var(--wide);
		margin: var(--sp-16) auto 0;
	}

	.mentions {
		width: 100%;
		max-width: var(--wide);
		margin: var(--sp-16) auto 0;
		border-top: 1px solid var(--line);
		padding: var(--sp-8) 0 var(--sp-12);
	}

	/* Вид — общий `.eyebrow` в global.css: это надзаголовок списка, такой же,
	   как «[ из архива ]» на главной. Своим он был чернильным и без скобок,
	   и заказчик увидел разнобой на живом сайте. Здесь остаётся зазор
	   до первой марки — он больше общего. */
	.mentions-title {
		margin: 0 0 var(--sp-6);
	}

	.stamp-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--sp-3);
	}

	@media (min-width: 621px) {
		/* Именно `auto-fill` (§4.5). Со схлопывающим вариантом одинокая марка
		   растянулась бы на всю ширину блока — а одинокая марка тут самый
		   частый случай: у выпуска про один тайтл она ровно одна. Название
		   запрещённого варианта в комментарии не пишем: его находит проверка
		   из раздела 8.4, и с этого дня она врёт. */
		.stamp-grid {
			grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
			justify-content: start;
		}
	}

	/* ОБЁРТКИ У ХВОСТОВЫХ БЛОКОВ БОЛЬШЕ НЕТ. Она сужала их до 1000 —
	   до оси материала — и была ошибкой: блоки относятся ко всему сайту,
	   а не к тексту, рядом с которым стоят. Теперь они прямые дети `.site`
	   и идут вровень с подвалом, как на остальных четырёх страницах. */

	/* ДВЕ КОЛОНКИ НА ЛЮБОЙ ШИРИНЕ, включая телефон (12 августа 2026, решение
	   заказчика). Раньше ниже 821 блок вставал столбиком, и «предыдущий»
	   со «следующим» занимали пол-экрана друг под другом — читалось это
	   двумя разными блоками, а не парой соседей.

	   ОТСТУПЫ ТОЛЬКО ВНУТРЕННИЕ. Стояло `padding: var(--sp-6)` со всех
	   четырёх сторон, и текст левой колонки начинался на 24 px правее
	   края блока — то есть правее заголовка «Упоминается в материале»
	   и правее транскрипта, стоящих ровно над ним. Три хвостовых блока
	   давали три разные вертикали; заказчик увидел это на живой странице
	   10 августа 2026. Левая колонка открывается на оси блока, правая
	   на ней же заканчивается, а воздух остаётся между ними. */
	.post-nav {
		width: 100%;
		max-width: var(--wide);
		margin: 0 auto var(--sp-18);
		border-top: 1px solid var(--line);
		display: grid;
		grid-template-columns: 1fr 1fr;
	}

	.post-nav a {
		min-height: 108px;
		padding: var(--sp-6) var(--sp-6) var(--sp-6) 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: var(--sp-2);
		color: var(--ink);
	}

	/* ЛИНИЯ МЕЖДУ КОЛОНКАМИ ПРЕРЫВИСТАЯ — псевдоэлементом, а не рамкой.
	   Рамка идёт от края коробки до края и упирается в линию над блоком,
	   сходясь с ней углом; в соседнем блоке соцсетей такая же линия
	   не доходит до краёв, и два блока подряд читались по-разному.
	   Заказчик увидел это на живой странице 10 августа 2026.

	   Зазор равен вертикальному полю ссылки — там, где кончается воздух
	   вокруг текста, кончается и линия. Те же числа, что у разделителей
	   в сетке карточек. */
	.post-nav a + a {
		padding: var(--sp-6) 0 var(--sp-6) var(--sp-6);
		position: relative;
		text-align: right;
		align-items: flex-end;
	}

	.post-nav a + a::before {
		content: '';
		position: absolute;
		left: 0;
		top: var(--sp-6);
		bottom: var(--sp-6);
		width: 1px;
		background: var(--line);
	}

	/* НА ТЕЛЕФОНЕ ВОЗДУХ МЕЖДУ КОЛОНКАМИ УЖЕ. При 24 px с каждой стороны
	   на экране 320 колонке остаётся 118 px, и заголовок соседа рассыпается
	   на четыре строки. С 12 остаётся 130. Слово «материал» из подписи
	   там же уходит от глаза (но не от диктора): «← Предыдущий материал» —
	   это 157 px технического слоя, в 130 не помещается. */
	@media (max-width: 620px) {
		.post-nav a {
			padding-right: var(--sp-3);
		}

		.post-nav a + a {
			padding-left: var(--sp-3);
		}
	}

	.nav-label {
		color: var(--muted);
	}

	.nav-title {
		font-family: var(--font-display);
		font-size: var(--card-title);
		line-height: 1.15;
	}

	.post-nav a:hover .nav-title,
	.post-nav a:focus-visible .nav-title {
		color: var(--accent-text);
	}

	/* ——— Медиа до краёв экрана на телефоне (§4.3) ——— */

	/* Считаем от полей страницы, а не от 100vw. Ширина окна включает место
	   под полосу прокрутки (`scrollbar-gutter: stable` в global.css), поэтому
	   100vw вылезает за край документа и даёт горизонтальный скролл — тот
	   самый, который на сайте запрещено прятать. */
	@media (max-width: 620px) {
		.content > :global(figure.gallery),
		.content > :global(figure.figure-full),
		.content > :global(.video-wrap),
		.content > :global(.content-video) {
			max-width: none;
			margin-inline: calc(var(--gutter) * -1);
		}

		/* ВИДЕО В ТЕКСТЕ — ЗАМЕНЯЕМЫЙ ЭЛЕМЕНТ, И ОТРИЦАТЕЛЬНЫЕ ПОЛЯ ЕГО
		   НЕ РАСТЯГИВАЮТ. Остальным здесь довольно `max-width: none`: они
		   обычные блоки, ширина у них `auto`, и поля раздвигают её сами.
		   А у `<video>` выше стоит `width: 100%` — без него он встал бы
		   стандартными 300×150, — и эти сто процентов считаются от колонки.
		   Коробка остаётся шириной с колонку, а поля просто увозят её влево:
		   слева видео упирается в край экрана, справа не дотягивает ровно
		   на одно поле страницы. Ошибки в коде нет никакой, на широком экране
		   не воспроизводится вовсе — заказчик увидел это на телефоне.
		   Ширину поэтому называем числом: колонка плюс оба поля.

		   Прежде тут была оговорка про видео в ШАПКЕ материала: оно сюда
		   не входило, потому что до краёв уходила его обёртка. Шапочного
		   видео больше нет — поля сняты 15 августа 2026, и случай остался
		   один. */
		.content > :global(.content-video) {
			width: calc(100% + var(--gutter) * 2);
		}

		/* Подпись возвращается внутрь полей: до краёв уходит только картинка.
		   `:global` обязан охватывать ВЕСЬ путь, включая figcaption: разметку
		   рисует markdown, метки Astro на ней нет, и селектор с меткой
		   не совпал бы ни с чем. */
		.content > :global(figure.figure-full figcaption),
		.content > :global(figure.gallery figcaption),
		.content > :global(figure.gallery .gallery-head) {
			padding-inline: var(--gutter);
		}
	}
</style>

