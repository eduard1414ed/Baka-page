---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { categories } from '../../content.config';

export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const { title, date, category, cover, youtube, video } = post.data;
const categoryLabel = categories.find((c) => c.id === category)?.label ?? category;
const dateFormatter = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });

function getYoutubeEmbed(url: string) {
	const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([a-zA-Z0-9_-]{11})/);
	return match ? `https://www.youtube.com/embed/${match[1]}` : null;
}

const youtubeEmbed = youtube ? getYoutubeEmbed(youtube) : null;
---

<Layout title={`${title} — Бака!`}>
	<article class="post">
		<a class="back" href={`/category/${category}/`}>← {categoryLabel}</a>
		<h1>{title}</h1>
		<p class="date">{dateFormatter.format(date)}</p>

		{
			cover && (
				<Image
					class="cover"
					src={cover}
					alt=""
					widths={[600, 1200]}
					sizes="(max-width: 700px) 100vw, 700px"
					width={1200}
					height={Math.round(1200 * (cover.height / cover.width))}
				/>
			)
		}

		{
			youtubeEmbed && (
				<div class="video-wrap">
					<iframe
						src={youtubeEmbed}
						title={title}
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
						allowfullscreen
					/>
				</div>
			)
		}

		{!youtubeEmbed && video && <video class="video" src={video} controls preload="none" />}

		<div class="content">
			<Content />
		</div>
	</article>
</Layout>

<script>
	function closeLightbox(overlay: HTMLElement, onKeydown: (event: KeyboardEvent) => void) {
		overlay.remove();
		document.removeEventListener('keydown', onKeydown);
	}

	document.querySelectorAll<HTMLAnchorElement>('.content a.figure-zoom').forEach((link) => {
		link.addEventListener('click', (event) => {
			event.preventDefault();
			const sourceImg = link.querySelector('img');
			if (!sourceImg) return;

			const overlay = document.createElement('div');
			overlay.className = 'lightbox';

			const bigImg = document.createElement('img');
			bigImg.src = sourceImg.src;
			bigImg.alt = sourceImg.alt;
			overlay.appendChild(bigImg);

			const onKeydown = (event: KeyboardEvent) => {
				if (event.key === 'Escape') closeLightbox(overlay, onKeydown);
			};

			overlay.addEventListener('click', () => closeLightbox(overlay, onKeydown));
			document.addEventListener('keydown', onKeydown);
			document.body.appendChild(overlay);
		});
	});
</script>

<style>
	.post {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--space-4) var(--space-3);
	}

	.back {
		display: inline-block;
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
		margin-bottom: var(--space-2);
	}

	.back:hover,
	.back:focus-visible {
		color: var(--color-accent-hover);
	}

	h1 {
		margin-bottom: var(--space-1);
	}

	.date {
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
		margin-bottom: var(--space-3);
	}

	.cover {
		width: 100%;
		border-radius: var(--radius-md);
		margin-bottom: var(--space-3);
	}

	.video-wrap {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		margin-bottom: var(--space-3);
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.video-wrap iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.video {
		width: 100%;
		border-radius: var(--radius-md);
		margin-bottom: var(--space-3);
	}

	.content :global(p) {
		margin: 0 0 var(--space-2);
	}

	.content :global(ul),
	.content :global(ol) {
		margin: 0 0 var(--space-2);
		padding-left: 1.25rem;
	}

	.content :global(blockquote) {
		margin: 0 0 var(--space-2);
		padding-left: var(--space-2);
		border-left: 2px solid var(--color-accent);
		color: var(--color-text-muted);
	}

	.content :global(figure.figure) {
		margin: var(--space-3) 0;
	}

	.content :global(figure.figure-full) {
		width: 100vw;
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
	}

	.content :global(.figure-zoom) {
		display: block;
		cursor: zoom-in;
	}

	.content :global(.figure-zoom img) {
		width: 100%;
		border-radius: var(--radius-md);
	}

	.content :global(figure.figure-full .figure-zoom img) {
		border-radius: 0;
	}

	.content :global(figcaption) {
		margin-top: var(--space-1);
		padding: 0 var(--space-1);
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
		text-align: center;
	}

	.content :global(figure.figure-full figcaption) {
		max-width: var(--content-width);
		margin-left: auto;
		margin-right: auto;
	}
</style>

<style is:global>
	.lightbox {
		position: fixed;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-3);
		background: rgba(0, 0, 0, 0.85);
		cursor: zoom-out;
		z-index: 100;
	}

	.lightbox img {
		max-width: 100%;
		max-height: 100%;
		border-radius: var(--radius-md);
	}
</style>
