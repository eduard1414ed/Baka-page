---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostFeed from '../../components/PostFeed.astro';
import { categories } from '../../content.config';
import { isPublished } from '../../lib/publishing.mjs';

export function getStaticPaths() {
	return categories.map((category) => ({
		params: { category: category.id },
		props: { category },
	}));
}

const { category } = Astro.props;

const posts = (await getCollection('posts', ({ data }) => isPublished(data) && data.category === category.id)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title={`${category.label} — Бака!`}>
	<section class="category">
		<h1>{category.label}</h1>
		<PostFeed posts={posts} activeCategory={category.id} />
	</section>
</Layout>

<style>
	.category {
		max-width: 72rem;
		margin: 0 auto;
		padding: var(--space-4) var(--space-3);
	}
</style>
