---
// Главная — витрина. Она НЕ РАСТЁТ: фиксированный набор слотов, три
// редакционных ряда, и всё. Что в какой слот попадает — раздел 3.2 ТЗ,
// считает src/lib/homeSlots.mjs (там же и развилки на случай нехватки данных).
// Композиция рядов — из макета Сборка-18/index.html.
//
// Баннер и блок с обложкой подкаста и кнопками площадок отсюда убраны:
// в утверждённом макете их нет, страница начинается с фильтров. Ссылки
// на площадки остались в подвале. Файлы картинок лежат в репозитории,
// вернуть блок — несколько строк.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostFeed from '../components/PostFeed.astro';
import PostKicker from '../components/PostKicker.astro';
import PostMedia from '../components/PostMedia.astro';
import AnimeBadge from '../components/AnimeBadge.astro';
import JsonLd from '../components/JsonLd.astro';
import { categoriesShownIn } from '../content.config';
import { isPublished } from '../lib/publishing.mjs';
import { pickHomeSlots } from '../lib/homeSlots.mjs';
import { buildCatalog } from '../lib/animeCatalog.mjs';
import { plural } from '../lib/plural.mjs';
import { getCardMedia } from '../lib/postCardMedia.mjs';
import { postDescription } from '../lib/excerpt.mjs';
import { isExternalPost, postHref } from '../lib/externalPost.mjs';
import { formatShortDate } from '../lib/postDate.mjs';
import { SITE_DESCRIPTION } from '../lib/site.mjs';
import { webSiteSchema } from '../lib/schema.mjs';

const description = SITE_DESCRIPTION;

const posts = (await getCollection('posts', ({ data }) => isPublished(data))).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Какие категории считаются выпуском подкаста, знает content.config —
// оттуда и берём, а не пишем список руками. Бонус попадает сюда сам.
const slots = pickHomeSlots(posts, { podcastCategories: categoriesShownIn('podcast') });

// Картинки и подводки редакционных слотов. Считаются теми же функциями, что
// у карточки в ленте: правило «из чего берётся обложка» и правило «подводка
// обрывается на первом спойлере» должны жить в одном месте на весь сайт.
const featured = [slots.hero, ...slots.sidebar, slots.podcast, slots.second, slots.third].filter(Boolean);

const media = new Map<string, Awaited<ReturnType<typeof getCardMedia>>>();
for (const post of featured) {
	media.set(post.id, await getCardMedia(post));
}

const deckOf = (post: any) => postDescription(post, '', { maxLength: 240 });

// Пост-ссылка на чужой сайт открывается в новой вкладке, а адрес собирает
// postHref: строить `/posts/…/` руками рядом с проверкой на внешний пост
// нельзя, ровно так одно из мест однажды и забудут поправить.
const isExt = (post: any) => isExternalPost(post.data);
const linkOf = (post: any) => ({
	href: postHref(post),
	target: isExt(post) ? '_blank' : undefined,
	rel: isExt(post) ? 'noopener noreferrer' : undefined,
});

// Заметок может не остаться ни одной — тогда блока нет вовсе, а материал
// третьего ряда занимает всю ширину (раздел 3.2 ТЗ).
const hasNotes = slots.notes.length > 0;
const hasThirdRow = Boolean(slots.third) || hasNotes;

// ---------- Блок каталога внизу главной (раздел 7.1a ТЗ) ----------
//
// ТАЙТЛЫ ВЫБИРАЮТСЯ СЛУЧАЙНО, а не по свежести или популярности: смысл блока —
// показать, что каталог большой и разный, а отсортированный список эту мысль
// не передаёт.
//
// МЕХАНИЗМ ДВУХСТУПЕНЧАТЫЙ, потому что сайт статический: при сборке в разметку
// кладётся двенадцать марок, в браузере из них показываются четыре. Так
// читатель видит новую четвёрку при каждом заходе, а весит это двенадцать
// строчек текста, а не двенадцать картинок — у скрытых марок картинки помечены
// ленивой загрузкой и не запрашиваются вовсе. Пул из двенадцати обновляется
// при каждой сборке, то есть при каждой публикации и при ночном прогоне робота.
//
// БЕЗ JAVASCRIPT ПОКАЗЫВАЮТСЯ ПЕРВЫЕ ЧЕТЫРЕ: блок не пустеет и не ломается.
const CATALOG_POOL = 12;
const CATALOG_SHOWN = 4;

const animeList = await getCollection('anime');
const transcripts = await getCollection('transcripts');

// ИЗ ВЫБОРКИ ИСКЛЮЧАЮТСЯ ТАЙТЛЫ БЕЗ ЕДИНОГО УПОМИНАНИЯ. Они попали
// в справочник по касательной, и звать по ним в каталог нечестно: перейдя,
// читатель попадёт на страницу, где нет ничего, кроме описания.
const catalogPool = buildCatalog({ posts, transcripts, animeList }).filter((item) => item.count > 0);

// Перемешиваем честно (Фишер — Йетс), а не сортировкой со случайным
// сравнением: та даёт заметный перекос к началу списка, и первые тайтлы
// справочника попадали бы на главную чаще остальных.
const shuffled = [...catalogPool];
for (let i = shuffled.length - 1; i > 0; i -= 1) {
	const j = Math.floor(Math.random() * (i + 1));
	[shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
}
const catalogMarks = shuffled.slice(0, CATALOG_POOL);
---

{/* Без `title` — у главной заголовок «Бака! — подкаст об аниме» целиком,
    без приписки «— Бака!» вторым разом (см. pageTitle в src/lib/site.mjs). */}
<Layout description={description} imageAlt="Бака! — подкаст об аниме">
	<JsonLd slot="head" data={webSiteSchema()} />

	<div class="site">
		<PostFeed posts={posts} shownIds={slots.shownIds}>
			<Fragment slot="showcase">
				{
					slots.hero && (
						<section class="lead-grid">
							<article class="hero-material">
								{media.get(slots.hero.id) && (
									<div class="image">
										<PostMedia post={slots.hero} media={media.get(slots.hero.id)!} sizes="(max-width: 760px) 100vw, 780px" loading="eager" />
									</div>
								)}
								{/* Метастрока, заголовок и подводка лежат в сетке ПООТДЕЛЬНОСТИ,
								    а не заголовок с метастрокой в общей обёртке. Так подводка
								    встаёт в один ряд с заголовком и начинается на его первой
								    строке. Собери их в обёртку — и подводка выровняется
								    по метастроке, то есть окажется выше заголовка на целую
								    строку технического слоя; на однострочном заголовке
								    в макете это незаметно, на двухстрочном видно сразу. */}
								<div class="hero-copy">
									<PostKicker post={slots.hero} />
									<h1 class="title-lg">
										<a class="stretch" {...linkOf(slots.hero)}>
											{slots.hero.data.title}
											{isExt(slots.hero) && (
												<span class="external" aria-label="откроется на другом сайте">
													↗
												</span>
											)}
										</a>
									</h1>
									{deckOf(slots.hero) && <p class="deck">{deckOf(slots.hero)}</p>}
								</div>
							</article>

							{slots.sidebar.length > 0 && (
								<aside class="sidebar">
									{slots.sidebar.map((post) => (
										<article class="side-item" class:list={{ 'no-image': !media.get(post.id) }}>
											<div>
												<PostKicker post={post} />
												<h2 class="side-title">
													<a class="stretch" {...linkOf(post)}>
														{post.data.title}
														{isExt(post) && (
															<span class="external" aria-label="откроется на другом сайте">
																↗
															</span>
														)}
													</a>
												</h2>
												{/* В макете подводки здесь не было, и на живых материалах
												    это оказалось видно: под коротким заголовком оставалась
												    пустая колонка. Подводка та же, что у остальных карточек,
												    и обрезается теми же тремя строками — своего размера
												    и своего цвета сайдбар не заводит. */}
												{deckOf(post) && <p class="deck">{deckOf(post)}</p>}
											</div>
											{media.get(post.id) && (
									<div class="side-thumb">
										<PostMedia post={post} media={media.get(post.id)!} sizes="112px" />
									</div>
								)}
										</article>
									))}
								</aside>
							)}
						</section>
					)
				}

				{
					(slots.podcast || slots.second) && (
						<section class="feature-row" class:list={{ single: !slots.podcast || !slots.second }}>
							{slots.podcast && (
								<article class="podcast-feature">
									<PostKicker post={slots.podcast} />
									{media.get(slots.podcast.id) && (
									<div class="cover">
										<PostMedia post={slots.podcast} media={media.get(slots.podcast.id)!} sizes="(max-width: 760px) 100vw, 390px" />
									</div>
								)}
									<h2 class="title-md">
										<a class="stretch" {...linkOf(slots.podcast)}>
											{slots.podcast.data.title}
										</a>
									</h2>
									{deckOf(slots.podcast) && <p class="deck">{deckOf(slots.podcast)}</p>}
								</article>
							)}

							{slots.second && (
								<article class="article-feature">
									<div>
										<PostKicker post={slots.second} />
										{/* Средний размер, а не крупный: в макете здесь стоял `title-lg`,
										    но на живой странице он оказывается ВТОРЫМ крупным заголовком
										    экрана и спорит с соседом по ряду — тот набран средним, а стоят
										    они рядом. Крупный кегль остаётся ровно у одного материала
										    главной, самого первого; решение заказчика 9 августа. */}
										<h2 class="title-md">
											<a class="stretch" {...linkOf(slots.second)}>
												{slots.second.data.title}
												{isExt(slots.second) && (
													<span class="external" aria-label="откроется на другом сайте">
														↗
													</span>
												)}
											</a>
										</h2>
										{deckOf(slots.second) && <p class="deck">{deckOf(slots.second)}</p>}
									</div>
									{media.get(slots.second.id) && (
									<div class="image">
										<PostMedia post={slots.second} media={media.get(slots.second.id)!} sizes="(max-width: 760px) 100vw, 560px" />
									</div>
								)}
								</article>
							)}
						</section>
					)
				}

				{
					hasThirdRow && (
						<section class="third-row" class:list={{ 'no-notes': !hasNotes }}>
							{slots.third && (
								<article class="video-feature">
									{media.get(slots.third.id) && (
									<div class="image">
										<PostMedia post={slots.third} media={media.get(slots.third.id)!} sizes="(max-width: 760px) 100vw, 480px" />
									</div>
								)}
									<div>
										<PostKicker post={slots.third} />
										<h2 class="title-md">
											<a class="stretch" {...linkOf(slots.third)}>
												{slots.third.data.title}
												{isExt(slots.third) && (
													<span class="external" aria-label="откроется на другом сайте">
														↗
													</span>
												)}
											</a>
										</h2>
										{deckOf(slots.third) && <p class="deck">{deckOf(slots.third)}</p>}
									</div>
								</article>
							)}

							{hasNotes && (
								<aside class="notes-index">
									<div class="notes-head">
										<span class="section-title tech">[&thinsp;короткие заметки&thinsp;]</span>
									</div>
									{slots.notes.map((post) => (
										<div class="note-row">
											<a {...linkOf(post)}>{post.data.title}</a>
											<span class="note-date tech">{formatShortDate(post.data.date)}</span>
										</div>
									))}
								</aside>
							)}
						</section>
					)
				}
			</Fragment>
		</PostFeed>

		{/* Блок каталога живёт ТОЛЬКО В РЕЖИМЕ «ВСЕ» — про это `data-only-mode`
		    ниже. Он про аниме вообще, а не про выбранный тип материалов, и
		    в отфильтрованной ленте читается чужим хвостом. Прячет его лента
		    по атрибуту, своего имени в её скрипте у блока нет. В макете он
		    остаётся во всех режимах — это решение заказчика. */}
		{
			catalogMarks.length > 0 && (
				<section class="catalog" aria-labelledby="catalog-title" data-only-mode="all">
					{/* В строке ровно один акцент: метка раздела акцентная,
					    ссылка рядом — чернильная. */}
					<div class="catalog-head">
						<span class="section-title tech" id="catalog-title">
							[&thinsp;каталог аниме&thinsp;]
						</span>
						<a class="catalog-link tech" href="/anime/">
							Перейти в каталог <span aria-hidden="true">→</span>
						</a>
					</div>
					<div class="catalog-grid" id="home-catalog" data-shown={CATALOG_SHOWN}>
						{/* Номер по каталогу переехал в надзаголовок марки — туда же,
						    где он стоит у каталожной карточки. Освободившееся место
						    занял год со студией, и порядок тот же, что в каталоге
						    и на странице тайтла: одни и те же факты везде должны
						    читаться одинаково. */}
						{catalogMarks.map((item, position) => (
							<AnimeBadge
								anime={item.entry}
								catalogMeta={[
									[item.entry.data.year, item.entry.data.studio].filter(Boolean).join(' · '),
									`${item.count} ${plural(item.count, ['упоминание', 'упоминания', 'упоминаний'])}`,
								]}
								hidden={position >= CATALOG_SHOWN}
							/>
						))}
					</div>
				</section>
			)
		}
	</div>
</Layout>

<style>
	/* ---------- Общее для редакционных рядов ---------- */

	.deck {
		font-size: var(--body-sm);
		line-height: 1.5;
		color: var(--muted);
		margin: 0;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
		/* КОРОБКА ДОЛЖНА БЫТЬ РОВНО ПО СВОИМ ТРЁМ СТРОКАМ, и это не украшение.
		   Подводка главного материала — ячейка сетки, а ячейка по умолчанию
		   растягивается на высоту всего ряда. Ряд высокий (рядом заголовок),
		   значит коробка высокая, обрезать нечего — а многоточие ограничение
		   всё равно ставит на третьей строке. Получалось «Связан…» посреди
		   фразы, а текст ниже продолжался как ни в чём не бывало.
		   В обычном блоке свойство ничего не меняет. */
		align-self: start;
	}

	/* Обёртки картинок заняты ТОЛЬКО местом: шириной и отступами. Пропорции,
	   обрезка и фон живут в PostMedia.astro — одни на весь сайт. Именно
	   из-за того, что они когда-то стояли здесь, квадратную обложку выпуска
	   обрезало, стоило ему попасть в «широкий» слот. */

	/* Кликается вся плашка материала, но ссылка при этом ОДНА — на заголовке.
	   Второй ссылкой на картинке человек на клавиатуре и в экранном дикторе
	   проходил бы каждый материал дважды. */
	.hero-material,
	.side-item,
	.podcast-feature,
	.article-feature,
	.video-feature {
		position: relative;
	}

	.stretch::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.hero-material a,
	.side-item a,
	.podcast-feature a,
	.article-feature a,
	.video-feature a,
	.note-row a {
		color: var(--ink);
		transition: color var(--transition-fast);
	}

	.hero-material a:hover,
	.side-item a:hover,
	.podcast-feature a:hover,
	.article-feature a:hover,
	.video-feature a:hover,
	.note-row a:hover {
		color: var(--accent-text);
	}

	.external {
		display: inline-block;
		margin-left: 0.2em;
		color: var(--accent-text);
		vertical-align: 0.1em;
		font-size: 0.55em;
	}

	/* Два размера вне общей шкалы — они кодируют редакционный вес материала
	   в номере, а не новый уровень заголовка (§3.2). */
	.title-lg {
		font-family: var(--font-display);
		font-size: var(--home-l);
		line-height: var(--home-l-lh);
		font-weight: 400;
		margin: 0 0 var(--sp-3);
	}

	.title-md {
		font-family: var(--font-display);
		font-size: var(--home-m);
		line-height: var(--home-m-lh);
		font-weight: 400;
		margin: 0 0 var(--sp-3);
	}

	.side-title {
		font-family: var(--font-display);
		font-size: var(--card-title);
		line-height: 1.15;
		font-weight: 400;
		margin: 0 0 var(--sp-3);
	}

	/* ---------- Ряды ---------- */

	/* Линию рисует НАЧАЛО следующего ряда — так между рядами всегда одна.
	   Ряд с `border-top` и `border-bottom` сразу — прямая причина двойных
	   линий на стыке (§5). */
	.lead-grid,
	.feature-row,
	.third-row {
		display: grid;
		gap: var(--sp-6);
		padding: var(--sp-8) 0;
	}

	.feature-row,
	.third-row {
		border-top: 1px solid var(--line);
	}


	/* Расстояния между строками задают сами элементы: метастрока и заголовок
	   несут свои отступы снизу. Общего `row-gap` у сетки нет намеренно — он
	   сложился бы с ними и раздвинул метастроку с заголовком, которые должны
	   стоять вплотную. */
	.hero-copy {
		display: grid;
		padding-top: var(--sp-4);
	}

	.hero-copy .deck {
		margin-top: var(--sp-3);
	}

	.sidebar {
		display: grid;
	}

	.side-item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 112px;
		gap: var(--sp-4);
		padding: var(--sp-6) 0;
		border-top: 1px solid var(--line);
	}

	.side-item.no-image {
		grid-template-columns: minmax(0, 1fr);
	}

	/* Линию перед первой карточкой рисует САМ САЙДБАР, а не она.
	   Правило стояло только на широком экране, и на узком выходили две линии
	   подряд с зазором между ними: одну рисовал сайдбар (он там отделяется
	   от главного материала), вторую — первая карточка. §5 системы это
	   прямо запрещает: между двумя соседними секциями всегда одна линия. */
	.side-item:first-child {
		border-top: 0;
		padding-top: 0;
	}

	.side-thumb {
		width: 112px;
	}

	.podcast-feature .cover {
		margin-bottom: var(--sp-4);
	}

	.article-feature,
	.video-feature {
		display: grid;
		gap: var(--sp-6);
	}


	.notes-index {
		display: grid;
		align-content: start;
	}

	.notes-head {
		margin-bottom: var(--sp-3);
	}

	.section-title {
		font-weight: 600;
		color: var(--accent-text);
	}

	.note-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: var(--sp-6);
		padding: var(--sp-4) 0;
		border-top: 1px solid var(--line);
	}

	.note-row:first-of-type {
		border-top: 0;
	}

	.note-row a {
		font-family: var(--font-display);
		font-size: var(--body-lg);
		line-height: 1.2;
	}

	.note-date {
		color: var(--muted);
	}

	/* ---------- Блок каталога ---------- */

	/* СВОЕЙ ЛИНИИ СВЕРХУ У БЛОКА НЕТ. Над ним всегда стоит кнопка «Показать
	   ещё материалы», а она сама нарисована между двумя линиями — своя граница
	   дала бы вторую линию в тридцати пикселях от первой, что §5 запрещает
	   прямо. Тот же случай уже был у сайдбара главной и у сеток режимов. */
	.catalog {
		padding: var(--sp-12) 0 50px;
	}

	.catalog-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--sp-3) var(--sp-6);
		margin-bottom: var(--sp-6);
	}

	/* Цель 44 набирается отступами, а не min-height: иначе текст ссылки
	   сместился бы относительно метки раздела, и они встали бы на разной
	   высоте при одинаковом кегле. */
	.catalog-link {
		display: inline-flex;
		align-items: center;
		gap: var(--sp-2);
		padding-block: 12px;
		color: var(--ink);
		text-decoration: none;
	}

	.catalog-link:hover {
		color: var(--accent-text);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* Сетка заполняющая, а не схлопывающая (§4.5): одинокая марка не должна
	   растягиваться на всю ширину блока. */
	.catalog-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--sp-3);
	}

	@media (min-width: 621px) {
		.catalog-grid {
			grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
			gap: 14px;
			justify-content: start;
		}
	}

	/* До 761 три ряда — один поток. Вертикальные линии превращаются
	   в горизонтальные, боковые отступы обнуляются: иначе колонки выглядят
	   обрезками десктопной сетки. */
	@media (max-width: 760px) {
		.sidebar,
		.article-feature,
		.notes-index {
			border-top: 1px solid var(--line);
			padding-top: var(--sp-6);
			margin-top: var(--sp-6);
		}

		.side-item {
			grid-template-columns: minmax(0, 1fr) 96px;
		}

		.side-thumb {
			width: 96px;
		}

		.podcast-feature .cover {
			max-width: none;
		}
	}

	@media (min-width: 761px) {
		.lead-grid,
		.feature-row,
		.third-row {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--grid-gap);
			align-items: start;
			padding: var(--sp-12) 0;
		}

		.hero-material {
			grid-column: 1 / 9;
		}

		/* Две колонки и два ряда: метастрока одна наверху, а заголовок
		   и подводка идут вторым рядом бок о бок. Из-за этого верх подводки
		   совпадает с верхом заголовка, а не с метастрокой над ним. */
		.hero-copy {
			grid-template-columns: 2fr 1fr;
			column-gap: var(--grid-gap);
		}

		/* `:global` обязателен: метастроку рисует другой компонент
		   (PostKicker.astro), и её класс носит его метку, а не нашу. */
		.hero-copy > :global(.kicker) {
			grid-column: 1;
			grid-row: 1;
		}

		.hero-copy .title-lg {
			grid-column: 1;
			grid-row: 2;
		}

		.hero-copy .deck {
			grid-column: 2;
			grid-row: 2;
			margin-top: 0;
		}

		/* Колонки с линией тянутся на высоту ряда: иначе линия обрывается
		   по низкой колонке, а не идёт вдоль высокой. */
		.sidebar,
		.article-feature,
		.notes-index {
			align-self: stretch;
		}

		.sidebar {
			grid-column: 9 / 13;
			border-left: 1px solid var(--line);
			padding-left: var(--sp-6);
		}

		.podcast-feature {
			grid-column: 1 / 5;
		}

		.article-feature {
			grid-column: 5 / 13;
			grid-template-columns: 4fr 5fr;
			align-items: center;
			border-left: 1px solid var(--line);
			padding-left: var(--sp-8);
		}

		.video-feature {
			grid-column: 1 / 8;
			grid-template-columns: 1.15fr 0.85fr;
			align-items: center;
		}

		.notes-index {
			grid-column: 8 / 13;
			border-left: 1px solid var(--line);
			padding-left: var(--sp-8);
		}

		/* Заметок не осталось — материал третьего ряда занимает всю ширину.
		   То же и когда во втором ряду выпал один из двух слотов. */
		.third-row.no-notes .video-feature {
			grid-column: 1 / 13;
		}

		.feature-row.single .podcast-feature,
		.feature-row.single .article-feature {
			grid-column: 1 / 13;
			border-left: 0;
			padding-left: 0;
		}
	}
</style>

<script>
	// Вторая ступень блока каталога: из двенадцати марок, положенных в разметку
	// при сборке, показываем четыре — тоже случайные. Так читатель видит новую
	// четвёрку при каждом заходе, хотя страница статическая и лежит в кэше.
	//
	// Скрытые марки не грузят свои картинки вовсе (`loading="lazy"` плюс
	// `hidden`), поэтому запас в двенадцать штук ничего не стоит.
	function setup() {
		const grid = document.getElementById('home-catalog');
		if (!grid) return;

		const marks = Array.from(grid.children) as HTMLElement[];
		const shown = Number(grid.dataset.shown) || 4;
		if (marks.length <= shown) return;

		// Фишер — Йетс, как и при сборке: сортировка со случайным сравнением
		// перекошена к началу списка.
		const order = marks.map((_, index) => index);
		for (let i = order.length - 1; i > 0; i -= 1) {
			const j = Math.floor(Math.random() * (i + 1));
			[order[i], order[j]] = [order[j], order[i]];
		}

		const chosen = new Set(order.slice(0, shown));
		marks.forEach((mark, index) => {
			mark.hidden = !chosen.has(index);
		});
	}

	// Переходы между страницами идут без перезагрузки (ClientRouter), поэтому
	// astro:page-load: оно срабатывает и при первой загрузке, и после возврата
	// на главную — четвёрка обновится и там.
	document.addEventListener('astro:page-load', setup);
</script>
