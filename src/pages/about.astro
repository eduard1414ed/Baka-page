---
// Страница «О подкасте» (тз/06, шаг 5).
//
// ТЕКСТЫ ЛЕЖАТ НЕ ЗДЕСЬ, а в src/content/pages/about.md — и правятся
// в админке, раздел «Страницы» → «О подкасте». В этом файле только вёрстка.
//
// Почему не пост: «О подкасте» не материал в ленте — у неё нет даты,
// и попадать в ленту, RSS и поиск наравне с выпусками она не должна.
// Поэтому отдельная полка `pages`, а в админке — файловая коллекция
// (запись одна и заранее известна, создавать и удалять нечего).
//
// Ссылки на площадки сюда НЕ переехали: они лежат в src/data/platforms.js
// и выводятся ещё на главной и в подвале. Через админку правится текст,
// а не устройство сайта.
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/JsonLd.astro';
import PlatformIcon from '../components/PlatformIcon.astro';
import { platformsOfKind } from '../data/platforms.js';
import { getLinkIcon } from '../lib/linkIcon.mjs';
import { breadcrumbsSchema } from '../lib/schema.mjs';
import { excerptFromBody } from '../lib/excerpt.mjs';
import { getImageVariantSrcs, isOptimizableImage } from '../lib/imageVariants.mjs';
import { SITE_DESCRIPTION } from '../lib/site.mjs';

// Файла может не быть — например, его удалили из админки. Страница тогда
// остаётся с одними ссылками на площадки, но собирается. Ронять сборку
// всего сайта из-за одной страницы нельзя (см. CLAUDE.md).
const page = await getEntry('pages', 'about');
const { Content } = page ? await render(page) : { Content: null };

// Пустые строки списка выбрасываем. В админке строку ведущего очень легко
// добавить и не заполнить, а такая строка рисовала кружок с «?» и пустотой
// рядом — проверка на пустых полях это и поймала.
const hosts = (page?.data.hosts ?? []).filter(
	(host) => host.name?.trim() || host.role?.trim() || host.photo,
);
const supportNote = page?.data.supportNote?.trim();
const contactEmail = page?.data.contactEmail?.trim();

// `Content` существует всегда, даже когда текста нет вовсе, — иначе на странице
// оставался бы пустой блок с отступами.
const hasIntro = Boolean(page?.body?.trim());

const listen = platformsOfKind('listen');
const social = platformsOfKind('social');
const support = platformsOfKind('support');

// Описание для поисковика и превью — из первого абзаца текста, тем же
// модулем, что у постов. Отдельного поля под него нет специально: ещё одно
// поле в админке, которое надо не забыть заполнить, — это поле, которое
// однажды разойдётся с текстом.
const description = excerptFromBody(page?.body ?? '', SITE_DESCRIPTION);

/**
 * Фото ведущего. Загруженные через админку картинки сборка сжимает в webp
 * в двух размерах (src/plugins/optimize-uploads-integration.mjs), поэтому
 * показываем сжатую копию. Кружок маленький — хватает меньшего размера.
 * Если формат несжимаемый (например, уже webp), берём файл как есть.
 */
function hostPhoto(photo: string | undefined) {
	if (!photo) return null;
	return isOptimizableImage(photo) ? getImageVariantSrcs(photo)[0].src : photo;
}
---

<Layout title="О подкасте" description={description}>
	<JsonLd slot="head" data={breadcrumbsSchema([{ name: 'О подкасте', path: '/about/' }])} />

	<article class="about">
		<h1>О подкасте</h1>

		{
			hasIntro && Content && (
				<div class="intro">
					<Content />
				</div>
			)
		}

		{
			hosts.length > 0 && (
				<section class="block">
					<h2>Ведущие</h2>
					<ul class="hosts">
						{hosts.map((host) => {
							const photo = hostPhoto(host.photo);
							// Имени может не быть: в админке строку списка легко добавить
							// и не заполнить. Пустая строка не должна ломать вёрстку.
							const name = host.name?.trim();
							return (
								<li class="host">
									{/* Фото нет — кружок с первой буквой имени. Так блок
									    не разъезжается и не выглядит недоделанным. */}
									{photo ? (
										<img class="host-photo" src={photo} alt={name ?? ''} width="72" height="72" loading="lazy" />
									) : (
										<span class="host-photo host-letter" aria-hidden="true">
											{name?.slice(0, 1) ?? '?'}
										</span>
									)}
									<div>
										{name && (
											<p class="host-name">
												{host.url ? (
													<a href={host.url} target="_blank" rel="noopener noreferrer">
														{name}
													</a>
												) : (
													name
												)}
											</p>
										)}
										{host.role && <p class="host-role">{host.role}</p>}
									</div>
								</li>
							);
						})}
					</ul>
				</section>
			)
		}

		<section class="block">
			<h2>Где слушать</h2>
			<div class="links">
				{
					listen.map((platform) => (
						<a class="link" href={platform.url} target="_blank" rel="noopener noreferrer">
							<PlatformIcon name={getLinkIcon(platform.url)} />
							{platform.label}
						</a>
					))
				}
			</div>
			<p class="note">
				Ещё есть <a href="/rss.xml">лента сайта</a> — в неё попадает всё, что здесь выходит: выпуски, статьи и заметки.
			</p>
		</section>

		{
			social.length > 0 && (
				<section class="block">
					<h2>Где общаемся</h2>
					<div class="links">
						{social.map((platform) => (
							<a class="link" href={platform.url} target="_blank" rel="noopener noreferrer">
								<PlatformIcon name={getLinkIcon(platform.url)} />
								{platform.label}
							</a>
						))}
					</div>
				</section>
			)
		}

		<section class="block">
			<h2>Поддержать</h2>
			{supportNote && <p class="note">{supportNote}</p>}
			<div class="links">
				{
					support.map((platform) => (
						<a class="link link-accent" href={platform.url} target="_blank" rel="noopener noreferrer">
							<PlatformIcon name={getLinkIcon(platform.url)} />
							{platform.label}
						</a>
					))
				}
			</div>
		</section>

		{
			contactEmail && (
				<section class="block">
					<h2>Написать нам</h2>
					<p class="note">
						<a href={`mailto:${contactEmail}`}>{contactEmail}</a> — предложить тему, позвать в гости или договориться
						о рекламе.
					</p>
				</section>
			)
		}
	</article>
</Layout>

<style>
	.about {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--space-4) var(--space-3);
	}

	/* :global — текст приезжает из markdown-файла через <Content />, а до такой
	   разметки обычные стили компонента не достают. */
	.intro :global(p) {
		font-size: var(--font-size-lg);
		color: var(--color-text);
		margin: 0 0 var(--space-2);
	}

	.intro :global(ul),
	.intro :global(ol) {
		margin: 0 0 var(--space-2);
		padding-left: 1.25rem;
	}

	.block {
		margin-top: var(--space-4);
		padding-top: var(--space-3);
		border-top: 1px solid var(--color-border);
	}

	.block h2 {
		font-size: var(--font-size-xl);
	}

	.note {
		color: var(--color-text-muted);
		margin: 0 0 var(--space-2);
	}

	.hosts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-3);
	}

	.host {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.host-photo {
		width: 72px;
		height: 72px;
		flex-shrink: 0;
		border-radius: var(--radius-full);
		object-fit: cover;
	}

	.host-letter {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-border);
		color: var(--color-accent);
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
	}

	.host-name {
		margin: 0;
		font-weight: 600;
	}

	.host-role {
		margin: 0;
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
	}

	.link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		padding: var(--space-1) var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		color: var(--color-text);
		font-size: var(--font-size-sm);
		transition:
			border-color var(--transition-fast),
			color var(--transition-fast);
	}

	.link:hover,
	.link:focus-visible {
		border-color: var(--color-accent);
		color: var(--color-accent-hover);
	}

	.link :global(svg) {
		width: 1.1em;
		height: 1.1em;
	}

	.link-accent {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}
</style>
