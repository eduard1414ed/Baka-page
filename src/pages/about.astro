---
// Страница «О проекте» (тз/10.4; раньше — «О подкасте», тз/06, шаг 5).
//
// АДРЕС ОСТАЁТСЯ `/about/`. Переименовалось название, а не страница: адрес
// стоит в карте сайта и может быть уже проиндексирован, а переименование ради
// красоты ломает чужие ссылки без всякой выгоды.
//
// ТЕКСТЫ ЛЕЖАТ НЕ ЗДЕСЬ, а в src/content/pages/about.md — и правятся
// в админке, раздел «Страницы» → «О проекте». В этом файле только вёрстка.
//
// Почему не пост: «О проекте» не материал в ленте — у неё нет даты,
// и попадать в ленту, RSS и поиск наравне с выпусками она не должна.
// Поэтому отдельная полка `pages`, а в админке — файловая коллекция
// (запись одна и заранее известна, создавать и удалять нечего).
//
// ССЫЛКИ НА ПЛОЩАДКИ СЮДА НЕ ПЕРЕЕХАЛИ, и это касается всех ТРЁХ блоков со
// ссылками — «Слушать подкаст», «Ещё немного нас» и «Поддержать «Баку!»».
// Все три берут один список src/data/platforms.js, оттуда же, откуда его берут
// подвал, страница «Поддержать» и плашка подписки у бонусов. Второй список
// означал бы, что смена ссылки чинится в двух местах, а забывается в одном.
// Через админку правится текст, а не устройство сайта.
//
// ВСЁ, ЧЕГО НЕТ, НЕ РИСУЕТСЯ. Пустое поле — не пустая рамка и не заголовок
// над ничем: очищенный блок исчезает целиком вместе со своей линией. CMS
// пишет в незаполненное поле пустую строку, а не пропускает его, поэтому
// везде проверяется именно содержимое, а не наличие поля.
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/JsonLd.astro';
import PlatformIcon from '../components/PlatformIcon.astro';
import ImageMissing from '../components/ImageMissing.astro';
import SocialStrip from '../components/SocialStrip.astro';
import SupportStrip from '../components/SupportStrip.astro';
import { platformsOfKind } from '../data/platforms.js';
import { getLinkIcon } from '../lib/linkIcon.mjs';
import { breadcrumbsSchema } from '../lib/schema.mjs';
import { excerptFromBody } from '../lib/excerpt.mjs';
import { getImageVariantSrcs, isOptimizableImage } from '../lib/imageVariants.mjs';
import { SITE_DESCRIPTION } from '../lib/site.mjs';

// Файла может не быть — например, его удалили из админки. Страница тогда
// остаётся с одними ссылками на площадки, но собирается. Ронять сборку
// всего сайта из-за одной страницы нельзя (см. CLAUDE.md).
const page = await getEntry('pages', 'about');
const { Content } = page ? await render(page) : { Content: null };

const lead = page?.data.lead?.trim();
const hasBody = Boolean(page?.body?.trim());

// ЧИСЛО ЛЮДЕЙ В КОДЕ НЕ ЗАШИТО: сколько заведено в админке, столько
// и рисуется. Пустые строки списка выбрасываем — строку очень легко добавить
// и не заполнить, а такая строка рисовала бы кружок заглушки рядом с пустотой.
const hosts = (page?.data.hosts ?? []).filter(
	(host) => host.name?.trim() || host.role?.trim() || host.bio?.trim() || host.photo,
);
const hostsNote = page?.data.hostsNote?.trim();
const listenNote = page?.data.listenNote?.trim();
const socialNote = page?.data.socialNote?.trim();
const supportTitle = page?.data.supportTitle?.trim();
const supportNote = page?.data.supportNote?.trim();
const contactText = page?.data.contactText?.trim();
const contactEmail = page?.data.contactEmail?.trim();

// Только «Слушать подкаст»: два других блока со ссылками — общие компоненты,
// и свой вид площадок каждый берёт сам из того же списка.
const listen = platformsOfKind('listen');

// Описание для поисковика и превью — из первой фразы страницы, тем же
// модулем, что у постов. Отдельного поля под него нет специально: ещё одно
// поле в админке, которое надо не забыть заполнить, — это поле, которое
// однажды разойдётся с текстом. Так же сделано у «Поддержать».
const description = lead || excerptFromBody(page?.body ?? '', SITE_DESCRIPTION);

/**
 * Фото человека. Загруженные через админку картинки сборка сжимает в webp
 * в двух размерах (src/plugins/optimize-uploads-integration.mjs), поэтому
 * показываем сжатую копию. Кружок маленький — хватает меньшего размера.
 * Если формат несжимаемый (например, уже webp), берём файл как есть.
 */
function hostPhoto(photo: string | undefined) {
	if (!photo) return null;
	return isOptimizableImage(photo) ? getImageVariantSrcs(photo)[0].src : photo;
}
---

<Layout title="О проекте" description={description}>
	<JsonLd slot="head" data={breadcrumbsSchema([{ name: 'О проекте', path: '/about/' }])} />

	<div class="site">
		<section class="about-hero">
			{/* H1 — «Бака!», а «О проекте» стоит НАД ним надзаголовком: так в макете,
			    и композиция берётся из макета. Название «О проекте» при этом живёт
			    во вкладке браузера, в хлебных крошках и в пункте меню. */}
			<div class="about-title">
				<div class="eyebrow tech">О проекте</div>
				<h1>Бака!</h1>
			</div>

			{
				(lead || hasBody) && (
					<div class="about-copy">
						{/* Вид крупной фразы — общий `.lead` из global.css: точно так же
						    набрана подводка под заголовком любой статьи и первая фраза
						    страницы «Поддержать». */}
						{lead && <p class="lead">{lead}</p>}
						{/* Отдельная обёртка вокруг текста из markdown, а не общее
						    правило на все абзацы блока: правило `.about-copy p` весит
						    больше общего `.lead` и перебило бы ему кегль — крупная
						    фраза молча стала бы обычным абзацем. Ровно эти грабли
						    сработали на «Поддержать» при первой сборке. */}
						{
							hasBody && Content && (
								<div class="about-body">
									<Content />
								</div>
							)
						}
					</div>
				)
			}
		</section>

		{
			hosts.length > 0 && (
				<section class="hosts-section" aria-labelledby="hosts-title">
					{/* Обёртки `.hosts-layout` из макета здесь нет: колонки задаёт
					    сама секция, а её содержимое ложится в дорожки этой же сетки.
					    Так же выправлена страница «Поддержать». */}
					<div class="section-heading-block">
						{hostsNote && <div class="eyebrow tech">{hostsNote}</div>}
						<h2 id="hosts-title">Команда</h2>
					</div>
					<div class="hosts-grid">
						{hosts.map((host) => {
							const photo = hostPhoto(host.photo);
							const name = host.name?.trim();
							const url = host.url?.trim();
							return (
								<article class="host-card">
									{/* ФОТО НЕТ — ПЕРСОНАЖ ОБЩЕЙ ЗАГЛУШКИ, обрезанный
									    по кругу, и БЕЗ подписи «Изображения нет»: 96 px —
									    узкое место, а в узких местах подпись снимается
									    (§9.1 дизайн-системы, четвёртая строка). Пустой
									    кружок не используется: читатель принимает его
									    за поломку вёрстки, а не за отсутствие данных. */}
									<div class="host-photo">
										{photo ? (
											<img src={photo} alt={name ?? ''} width="120" height="120" loading="lazy" />
										) : (
											<ImageMissing compact />
										)}
									</div>
									<div class="host-info">
										{host.role && <div class="host-role tech">{host.role}</div>}
										{name && <h3>{name}</h3>}
										{host.bio && <p>{host.bio}</p>}
										{url && (
											<div class="host-links">
												<a href={url} target="_blank" rel="noopener noreferrer">
													{host.urlLabel?.trim() || 'Ссылка'}
													<span class="ext-arrow" aria-hidden="true">
														↗
													</span>
												</a>
											</div>
										)}
									</div>
								</article>
							);
						})}
					</div>
				</section>
			)
		}

		{
			listen.length > 0 && (
				<section class="link-section" aria-labelledby="listen-title">
					{/* Обёртки `.split-head` из макета тут нет по той же причине,
					    что и на «Поддержать»: макет назначает колонки её ребёнку
					    `.link-section-heading`, а ребёнок обёртки до сетки секции
					    не дотягивается. Заголовок встал бы в одну двенадцатую ширины
					    страницы. Верстаем по CSS макета, а не по его HTML. */}
					<div class="link-section-heading">
						{listenNote && <div class="eyebrow tech">{listenNote}</div>}
						<h2 id="listen-title">Слушать подкаст</h2>
					</div>
					<div class="link-grid">
						{listen.map((platform) => (
							<a class="platform-link" href={platform.url} target="_blank" rel="noopener noreferrer">
								<div class="platform-top">
									{/* Коробка под иконку стоит всегда, даже когда иконки
									    нет: без неё названия площадок встали бы рваным
									    левым краем. Своего фона у пустой коробки нет —
									    это просто воздух, а не серый прямоугольник. */}
									<span class="platform-icon" aria-hidden="true">
										<PlatformIcon name={getLinkIcon(platform.url)} />
									</span>
									{/* `visually-hidden-sm` — на телефоне остаётся один значок,
									    но подпись не исчезает из разметки: без неё ссылка
									    станет безымянной для диктора. Утилита в global.css. */}
									<span class="platform-name visually-hidden-sm">{platform.label}</span>
								</div>
							</a>
						))}
					</div>
				</section>
			)
		}

		{/* ДВА БЛОКА НИЖЕ — ОБЩИЕ КОМПОНЕНТЫ, они же стоят на главной (10.5).
		    Разметка и вид у них общие; страница задаёт только тексты, а состав
		    площадок оба берут сами из platforms.js. Пустой заголовок — не пустая
		    рамка: компонент подставляет свой. */}
		<SocialStrip note={socialNote} />

		<SupportStrip title={supportTitle} note={supportNote} />

		{
			(contactText || contactEmail) && (
				<section class="contact-section" aria-labelledby="contact-title">
					<div class="contact-heading">
						<div class="eyebrow tech">Связаться</div>
						<h2 id="contact-title">Написать нам</h2>
					</div>
					{/* ПАРА ОСТАЛАСЬ ОДНА: абзац и почта. Вторая пара — чат — переехала
					    решением заказчика в блок «Ещё немного нас»: чат это место,
					    куда приходят, а не способ написать нам лично. Правила отбивки
					    между парами вместе с ней не стало: мёртвого кода «на случай,
					    если пара вернётся», не держим. */}
					<div class="contact-copy">
						{contactText && <p>{contactText}</p>}
						{contactEmail && (
							<a class="contact-link" href={`mailto:${contactEmail}`}>
								{contactEmail}
								<span class="ext-arrow" aria-hidden="true">
									↗
								</span>
							</a>
						)}
					</div>
				</section>
			)
		}
	</div>
</Layout>

<style>
	/* Надзаголовок секции — общий `.eyebrow` в global.css: он стоит в шести
	   местах сайта, и описание у него одно. */

	/* --- Хиро --- */

	.about-hero {
		display: grid;
		gap: var(--sp-6);
		padding: var(--sp-12) 0;
	}

	/* НАЗВАНИЕ СТРАНИЦЫ НАБИРАЕТСЯ КЕГЛЕМ ЗАГОЛОВКА БЛОКА, а не своим —
	   то же решение, что принято заказчиком для «Поддержать» 9 августа.
	   Причина видна на живой странице: «Бака!» и «Команда» устроены одинаково
	   (мелкий надзаголовок слева, заголовок под ним), и разный кегль читается
	   не как разные уровни, а как сбой. Выровнено по меньшему.

	   Все три значения — токены, в том числе трекинг: числом он стоял бы
	   второй копией правила `h2` из global.css и разошёлся бы с ним молча. */
	.about-title h1 {
		margin: 0;
		font-size: var(--h2);
		line-height: var(--h2-lh);
		letter-spacing: var(--h2-ls);
	}

	/* Зазор между крупной фразой и текстом под ней задаёт КОНТЕЙНЕР, а не поля
	   абзацев. Правило `.about-copy p` весило бы больше общего `.lead`
	   из global.css и перебило бы ему кегль, интерлиньяж и цвет — вид,
	   вынесенный в одно место, молча перестал бы работать ровно здесь. */
	.about-copy {
		max-width: 720px;
		display: grid;
		gap: var(--sp-6);
	}

	/* Поле у крупной фразы снимает страница: вид её общий, а место
	   в раскладке — дело этой страницы. Кегля и цвета правило не касается. */
	.about-copy > .lead {
		margin: 0;
	}

	/* :global — текст приезжает из markdown-файла через <Content />, а до такой
	   разметки обычные стили компонента не достают. */
	.about-body :global(p) {
		font-size: var(--body-lg);
		line-height: 1.65;
		color: var(--text);
		margin: 0 0 var(--sp-4);
	}

	.about-body :global(p:last-child) {
		margin-bottom: 0;
	}

	/* --- Секции: линию между ними рисует начало следующей --- */

	/* Блока соцсетей и полосы поддержки в этих списках нет: они общие
	   компоненты, и линию с отбивкой каждый рисует себе сам — иначе правило
	   страницы и правило компонента весили бы одинаково, и кто победит,
	   решал бы порядок файлов в сборке. */
	.hosts-section,
	.link-section,
	.contact-section {
		border-top: 1px solid var(--line);
		padding: var(--sp-12) 0;
	}

	.section-heading-block h2,
	.link-section-heading h2,
	.contact-heading h2 {
		margin: 0;
	}

	/* --- Команда --- */

	/* Карточки идут списком сверху вниз, разделённые линиями, а не рядом. */
	.hosts-grid {
		display: grid;
		margin-top: var(--sp-6);
	}

	.host-card {
		display: grid;
		grid-template-columns: 96px minmax(0, 1fr);
		gap: var(--sp-4);
		padding: 22px 0;
	}

	/* Первой карточке линия не нужна: её уже нарисовала сама секция,
	   а двух линий подряд §5 не допускает. */
	.host-card + .host-card {
		border-top: 1px solid var(--line);
	}

	/* Ряд сетки растягивает свои ячейки, и это перебило бы `aspect-ratio`
	   у кружка рядом с длинным рассказом о человеке: круг превратился бы
	   в овал. Растягивается только колонка с текстом. */
	.host-photo {
		width: 96px;
		aspect-ratio: 1;
		align-self: start;
		border-radius: 50%;
		overflow: hidden;
	}

	.host-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* Заглушка разворачивается на весь кружок и обрезается им же:
	   `overflow: hidden` плюс скругление у родителя. Своего вида
	   у заглушки здесь не появляется — он общий, `.img-missing`. */
	.host-photo :global(.img-missing) {
		width: 100%;
		height: 100%;
	}

	.host-info {
		min-width: 0;
	}

	.host-role {
		margin-bottom: var(--sp-2);
		color: var(--accent-text);
	}

	.host-info h3 {
		margin: 0 0 var(--sp-2);
	}

	.host-info p {
		margin: 0 0 var(--sp-3);
		font-size: var(--body-sm);
		line-height: 1.5;
		color: var(--muted);
	}

	.host-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-2) var(--sp-4);
		font-size: var(--caption);
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	/* ЦЕЛЬ 44, А НЕ 12 px ОТСТУПА СВЕРХУ И СНИЗУ, как в макете: это ссылка
	   на отдельной странице, а не строка врезки внутри текста, и исключение
	   части 11 на неё не распространяется. Высота набирается невидимой зоной,
	   вид строки от этого не меняется. Так же сделано на «Поддержать». */
	.host-links a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--ink);
		text-decoration: none;
	}

	.host-links a:hover,
	.host-links a:focus-visible {
		color: var(--accent-text);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* --- Слушать подкаст --- */

	/* Не строка в ряд: при пяти площадках длинные названия переносились
	   внутри колонки и ломали ритм. Список с линиями держит форму
	   при любом числе площадок и любой длине названия. */
	.link-grid {
		display: grid;
		grid-template-columns: 1fr;
		margin-top: var(--sp-6);
	}

	.platform-link {
		display: flex;
		align-items: center;
		gap: var(--sp-3);
		/* Настоящая строка списка: цель нажатия заведомо больше 44 px. */
		min-height: 56px;
		min-width: 0;
		padding-right: var(--sp-4);
		border-top: 1px solid var(--line);
		text-decoration: none;
		color: var(--ink);
	}

	/* Верхнюю границу секции рисует сама секция: первая строка списка
	   своей линии не добавляет, иначе их две. */
	.platform-link:first-child {
		border-top: 0;
	}

	.platform-link:hover .platform-name,
	.platform-link:focus-visible .platform-name {
		color: var(--accent-text);
	}

	.platform-top {
		display: flex;
		align-items: center;
		gap: 10px;
		min-width: 0;
	}

	.platform-icon {
		width: 28px;
		height: 28px;
		flex: 0 0 28px;
		display: grid;
		place-items: center;
		overflow: hidden;
	}

	.platform-name {
		font-size: var(--caption);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		line-height: 1.2;
	}

	/* НА УЗКОМ ЭКРАНЕ ОСТАЮТСЯ ОДНИ ПИКТОГРАММЫ, по три в ряд — решение
	   заказчика: шесть строк с подписями съедали пол-экрана телефона, а логотипы
	   узнаются и без слов.

	   ПОДПИСЬ НЕ `display: none`, А `.visually-hidden`. Убери её из потока
	   совсем — и ссылка останется без имени: экранный диктор прочитает
	   «ссылка», а голосовое управление не сможет её назвать. Утилита прячет
	   от глаза, оставляя тексту голос.

	   Линии перестроены под сетку: своей верхней линии нет у первых ТРЁХ,
	   а не у первой, — иначе над вторым и третьим значком первого ряда легла бы
	   вторая линия сразу под той, которую уже нарисовала секция. */
	@media (max-width: 620px) {
		.link-grid {
			grid-template-columns: repeat(3, 1fr);
			column-gap: var(--sp-2);
		}

		.platform-link {
			justify-content: center;
