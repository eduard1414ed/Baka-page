---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AnimeCard from '../../components/AnimeCard.astro';
import { buildMentionIndex, postsForAnime } from '../../lib/animeMentionIndex.mjs';
import { isPublished } from '../../lib/publishing.mjs';

const posts = await getCollection('posts', ({ data }) => isPublished(data));
const animeList = await getCollection('anime');
const transcripts = await getCollection('transcripts');
const exceptions = await getCollection('mentionExceptions');

// Счётчик считаем ровно тем же кодом, что и список на самой странице тайтла
// (src/pages/anime/[slug].astro) — иначе тут было бы «1 упоминание», а внутри
// три карточки: с этого шага упоминанием считается и название, прозвучавшее
// в расшифровке выпуска, а не только проставленное в поле `anime` поста.
const index = buildMentionIndex({ posts, transcripts, animeList, exceptions });
const mentionCounts = new Map<string, number>(
	animeList.map((entry) => [entry.id, postsForAnime(entry.id, posts, index).length]),
);

function displayTitle(entry: (typeof animeList)[number]) {
	return entry.data.titleRu || entry.data.titleOriginal;
}

const sorted = animeList
	.map((entry) => ({ entry, count: mentionCounts.get(entry.id) ?? 0 }))
	.sort((a, b) => b.count - a.count || displayTitle(a.entry).localeCompare(displayTitle(b.entry), 'ru'));
---

<Layout title="Тайтлы — Бака!" description="Все аниме, которые упоминались в подкасте">
	<section class="anime-index">
		<h1>Тайтлы</h1>
		{
			sorted.length === 0 ? (
				<p class="empty">Пока нет ни одного тайтла.</p>
			) : (
				<div class="grid">
					{sorted.map(({ entry, count }) => (
						<AnimeCard anime={entry} count={count} />
					))}
				</div>
			)
		}
	</section>
</Layout>

<style>
	.anime-index {
		max-width: 72rem;
		margin: 0 auto;
		padding: var(--space-4) var(--space-3);
	}

	.empty {
		color: var(--color-text-muted);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: var(--space-3);
	}
</style>
