---
// Страница тайтла (§17 дизайн-системы, раздел 7.3 ТЗ, макет `anime.html`).
//
// Ради неё и затевался весь справочник: клик по названию в тексте или
// в расшифровке приводит сюда, а здесь собраны все материалы, где тайтл
// обсуждали, вплоть до минуты в разговоре.
//
// НИКАКИХ ПРЕДУПРЕЖДЕНИЙ И СИСТЕМНЫХ СООБЩЕНИЙ. Нет описания — нет абзаца;
// нет русского названия — заголовком идёт оригинальное; нет упоминаний — нет
// блока упоминаний. Читателю нечего чинить, а плашка «⚠ нет русского
// названия», которая тут стояла, была запиской самому себе на видном месте.
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import LoadMore from '../../components/LoadMore.astro';
import { getAnimePosterSrcs, animeSocialSource } from '../../lib/animePoster.mjs';
import { stampVar } from '../../lib/animeStamp.mjs';
import { buildMentionIndex, postsForAnime } from '../../lib/animeMentionIndex.mjs';
import { formatTimecode } from '../../lib/timecode.mjs';
import { isPublished } from '../../lib/publishing.mjs';
import { plural } from '../../lib/plural.mjs';
import { ogUrlForAnime } from '../../lib/ogImage.mjs';
import { latinSearchForms } from '../../lib/translit.mjs';
import JsonLd from '../../components/JsonLd.astro';
import { breadcrumbsSchema } from '../../lib/schema.mjs';

export async function getStaticPaths() {
	const animeList = await getCollection('anime');
	// isPublished, а не просто !data.draft: у поста может стоять отложенная
	// публикация (тз/09), и до её срока своей страницы у него нет — карточка
	// вела бы в никуда.
	const posts = await getCollection('posts', ({ data }) => isPublished(data));
	const transcripts = await getCollection('transcripts');

	// Указатель «тайтл → выпуск → минуты» считаем ОДИН раз на всю сборку,
	// а не заново на каждой странице тайтла: расшифровок 141, страниц тайтлов
	// со временем станут сотни, и перечитывать одно другим вышло бы дорого.
	const index = buildMentionIndex({ posts, transcripts, animeList });

	return animeList.map((entry) => ({
		params: { slug: entry.id },
		props: { entry, mentions: postsForAnime(entry.id, posts, index) },
	}));
}

const { entry, mentions } = Astro.props;
const { titleRu, titleOriginal, year, studio, poster, synopsis, url, source } = entry.data;
const posterSrcs = getAnimePosterSrcs(poster);
const displayTitle = titleRu || titleOriginal;
const sourceLabel = source === 'anilist' ? 'AniList' : 'Shikimori';

// Сколько минут показываем в карточке выпуска. Замер по архиву: у «Наруто»
// 70 выпусков и 547 упоминаний, в медианном выпуске их 2, но в худшем — 45.
// Сорок пять цифр подряд в карточке читать невозможно, поэтому хвост
// сворачивается в ссылку «и ещё N» — она открывает выпуск, подсвечивает
// все упоминания и даёт стрелки, чтобы листать их по одному.
const MAX_TIMES = 8;

/** Сколько упоминаний видно до нажатия «Показать ещё» (§17). */
const FIRST_MENTIONS = 6;

const hiddenMentions = Math.max(0, mentions.length - FIRST_MENTIONS);

/**
 * Разметка Shikimori в описании. Два разных случая, и путать их нельзя:
 *   [[Хокагэ]]  — ссылка на термин, текст внутри нужен;
 *   [波風ミナト]  — японский оригинал имени рядом с русским, читателю он тут
 *                 не нужен и уводит глаз с фразы.
 *
 * Снимается ОДНОЙ функцией и для страницы, и для описания в поисковой выдаче:
 * два места, где чистится одна и та же разметка, разошлись бы молча — ровно
 * так уже разъезжалось снятие markdown (см. CLAUDE.md про plainText.mjs).
 */
function cleanSynopsis(text: string | undefined) {
	if (!text) return '';

	return (
		text
			.replace(/\[\[([^\]]*)\]\]/g, '$1')
			.replace(/\[[^\]]*\]/g, '')
			// После выброшенных скобок остаётся двойной пробел и пробел перед
			// запятой: «шляпница Софи  ведёт», «Хаула , колдуна».
			.replace(/[^\S\n]+([,.;:!?])/g, '$1')
			.replace(/[^\S\n]+/g, ' ')
			.trim()
	);
}

const synopsisParagraphs = cleanSynopsis(synopsis)
	.split(/\n+/)
	.map((line) => line.trim())
	.filter(Boolean);

// Описание страницы тайтла (тз/06, шаг 8). Первое предложение описания плюс
// сколько раз тайтл упоминался — упоминания и есть то, ради чего сюда приходят,
// и в выдаче это отличает нашу страницу от сотни карточек того же аниме
// на других сайтах.
function firstSentence(text: string, max = 130) {
	if (!text) return null;

	const clean = text.replace(/\s+/g, ' ').trim();
	if (!clean) return null;
	if (clean.length <= max) return clean;

	const cut = clean.slice(0, max);
	// Режем по концу предложения, если он есть в пределах куска, иначе по слову.
	const stop = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('! '), cut.lastIndexOf('? '));
	if (stop > max / 2) return cut.slice(0, stop + 1);
	const space = cut.lastIndexOf(' ');
	return `${(space > max / 2 ? cut.slice(0, space) : cut).replace(/[\s,.;:—-]+$/, '')}…`;
}

const mentionsNote =
	mentions.length > 0
		? `${displayTitle} в подкасте «Бака!»: ${mentions.length} ${plural(mentions.length, ['упоминание', 'упоминания', 'упоминаний'])} в выпусках и постах.`
		: `${displayTitle} — карточка тайтла в подкасте «Бака!».`;

const animeDescription = firstSentence(synopsisParagraphs.join(' ')) ?? mentionsNote;

// ЧТО ПОИСК ПО САЙТУ ПОКАЗЫВАЕТ В РЕЗУЛЬТАТЕ-ТАЙТЛЕ (часть 8).
//
// Результаты страница поиска рисует уже в браузере, из того, что Pagefind
// запомнил про страницу. Текста страницы для марки мало: нужны постер,
// оригинальное название, год со студией и число упоминаний — то же, что стоит
// в горизонтальной марке. Всё это метки, а не текст: в индекс они идут строкой
// и в выдачу словами не лезут.
//
// Постер берём МАЛЫЙ (320w) — тот же файл, что грузит марка. Крупный (640w)
// нужен только самой странице тайтла.
const searchMeta = [
	posterSrcs.length > 0 ? `poster:${posterSrcs[0].src}` : null,
	titleRu && titleOriginal !== titleRu ? `original:${titleOriginal}` : null,
	[year, studio].filter(Boolean).length > 0 ? `facts:${[year, studio].filter(Boolean).join(' · ')}` : null,
	`mentions:${mentions.length}`,
].filter(Boolean) as string[];

// НЕВИДИМОЕ ПОЛЕ ПОИСКА — ровно то же, что ищет каталог (часть 7).
//
// Две вещи, которых нет в тексте страницы, а искать по ним надо:
//
// 1. ВАРИАНТЫ НАПИСАНИЯ из админки. Это главное поле тайтла для поиска:
//    «Кейон» через «е», «Клуб лёгкой музыки», падежи. Заказчик вписывает их
//    руками ровно для того, чтобы тайтл находился; каталог по ним искал
//    с части 7, а поиск по сайту про них не знал вовсе — и запрос «кейон»
//    не находил «Кэйон!», хотя этот вариант в карточке записан.
// 2. ЛАТИНИЦА КИРИЛЛИЦЕЙ. Оригинальные названия и студии записаны латиницей:
//    Shikimori других не отдаёт. Без этой строки «гибли» не находил ни одного
//    из трёх тайтлов Ghibli.
//
// Правило одно на два поиска и живёт в одном месте (src/lib/translit.mjs),
// второй копии нет. Строка НЕ ПОКАЗЫВАЕТСЯ читателю и только ДОБАВЛЯЕТ
// совпадения: оригинал остаётся в тексте страницы как есть. Показать её
// нельзя — «Sousou no Frieren» превращается в «соусоу но фрирен», а человек
// пишет «Фрирен».
const latinSource = [titleOriginal, studio].filter(Boolean).join(' ');
const searchExtras = [...(entry.data.aliases ?? []), ...(latinSource ? latinSearchForms(latinSource) : [])]
	.filter(Boolean)
	.join(' ');

const crumbs = breadcrumbsSchema([
	{ name: 'Каталог аниме', path: '/anime/' },
	{ name: displayTitle, path: `/anime/${entry.id}/` },
]);
---

{/* Своя картинка превью у тайтла — постер на бумажном листе. Пространство
    имён у неё отдельное (`/og/anime-<id>.jpg`), иначе тайтл с идентификатором
    вроде `ep-5` перебил бы одноимённый выпуск; правило живёт в ogImage.mjs.
    Постер 2:3 генератор вписывает целиком, не обрезая.

    ЕСЛИ ПОСТЕРА НЕТ, СВОЕГО ПРЕВЬЮ НЕТ ТОЖЕ: страница берёт общую картинку
    сайта. Тег на несуществующий файл — это битая ссылка в мессенджере,
    а «из чего делать превью» решает одна функция на страницу и на сборку. */}
<Layout
	title={displayTitle}
	description={animeDescription}
	ogUrl={animeSocialSource(poster) ? ogUrlForAnime(entry.id) : null}
	imageAlt={displayTitle}
>
	<JsonLd slot="head" data={crumbs} />
	<div class="site">
		{/* Что берёт в поиск Pagefind — см. пояснение в src/pages/posts/[slug].astro.
		    У тайтла в индекс идёт название, оригинальное название и описание;
		    список упоминаний ниже помечен data-pagefind-ignore, иначе заголовки
		    выпусков попали бы ещё и в карточку тайтла и по запросу «Наруто»
		    выдача дублировалась бы сама с собой. */}
		<div data-pagefind-body data-pagefind-filter="type:Тайтлы" data-pagefind-meta="type:anime">
			{/* По одной метке на элемент: перечислить их через запятую в одном
			    атрибуте нельзя, Pagefind примет всю строку за одно значение —
			    это уже проверялось на живом индексе, см. posts/[slug].astro. */}
			{searchMeta.map((meta) => (
				<span data-pagefind-meta={meta} />
			))}
			<div class="breadcrumb tech" data-pagefind-ignore>
				<a href="/anime/">← Все тайтлы</a>
			</div>

			<section class="hero" class:list={{ 'no-poster': posterSrcs.length === 0 }}>
				{
					posterSrcs.length > 0 && (
						<div class="poster-wrap">
							{/* Перфорация по всем четырём сторонам: верх и низ рисует
							    рамка, бока — внутренняя обёртка. Постер не обрезается
							    никогда, поля внутри рамки заливаются цветом марки. */}
							<div class="poster-stamp" style={`--stamp: ${stampVar(entry.id)}`}>
								<div class="poster-inner">
									<img
										src={posterSrcs[posterSrcs.length - 1].src}
										srcset={posterSrcs.map((s) => `${s.src} ${s.width}w`).join(', ')}
										sizes="(max-width: 620px) 280px, (max-width: 1100px) 310px, 350px"
										alt=""
									/>
								</div>
							</div>
						</div>
					)
				}

				<div class="copy">
					{/* ДВЕ СТРОКИ ОБЩЕЙ СЕТКИ, А НЕ ДВА СТОЛБИКА РЯДОМ: название
					    и оригинал стоят на одной базовой линии, техстрока и ссылка
					    на источник — на следующей. Обёртки для этого растворяются
					    через `display: contents`, иначе каждая пара живёт своей
					    жизнью и выравнивать их нечем. */}
					<div class="heading">
						<div class="heading-main">
							<h1>{displayTitle}</h1>
							{
								[year, studio].filter(Boolean).length > 0 && (
									<div class="facts tech">{[year, studio].filter(Boolean).join(' · ')}</div>
								)
							}
						</div>
						<div class="heading-aside">
							{titleRu && titleOriginal !== titleRu && <div class="original">{titleOriginal}</div>}
							{
								url && (
									<a class="external-link" href={url} target="_blank" rel="noopener noreferrer">
										Страница на {sourceLabel} <span aria-hidden="true">↗</span>
									</a>
								)
							}
						</div>
					</div>

					{
						synopsisParagraphs.length > 0 && (
							<div class="synopsis">
								{synopsisParagraphs.map((paragraph) => (
									<p>{paragraph}</p>
								))}
							</div>
						)
					}
				</div>
			</section>

			{/* Тайтл есть в справочнике, а разговоров о нём нет (тз/08, 9.6).
			    Раньше тут не было ничего вовсе, и страница обрывалась на шапке:
			    читатель не мог понять, то ли упоминаний нет, то ли блок
			    не загрузился. Молчание должно говорить о себе вслух.

			    Обещаний не даём: «пока не говорили» — правда, а «скоро
			    поговорим» было бы выдумкой. Причину тоже не называем: она
			    бывает разной — материал ещё черновик, упоминание снято
			    вручную, — и угадывать её на странице нечем. */}
			{
				mentions.length === 0 && (
					<section class="empty-state empty-state--inline" data-pagefind-ignore>
						<div class="tech">Пока тихо</div>
						<p>
							Мы ещё не говорили об этом тайтле в опубликованных материалах. Он в каталоге, потому что кто-то
							из нас его отметил.
						</p>
					</section>
				)
			}

			{
				mentions.length > 0 && (
					<section class="mentions" data-pagefind-ignore>
						<h2 class="mentions-title">Упоминания</h2>
						<div class="mentions-grid" id="mentions-grid">
							{mentions.map(({ post, times }: { post: any; times: number[] }, position: number) => (
								<PostCard post={post} hidden={position >= FIRST_MENTIONS}>
									{/* Отдельного блока для выпусков нет — выпуск идёт обычной
									    карточкой, наравне с постами, а минуты разговора уходят
									    в её краткое описание (тз/05, шаг 5). Ссылка ведёт на
									    страницу выпуска и там прокручивает расшифровку к нужной
									    реплике — разбирает её src/components/Transcript.astro. */}
									{times.length > 0 && (
										<p class="times">
											обсуждали в выпуске на{' '}
											{times.slice(0, MAX_TIMES).map((seconds, i) => (
												<Fragment>
													{i > 0 && ', '}
													<a class="timecode" href={`/posts/${post.id}/#anime=${entry.id}&t=${Math.floor(seconds)}`}>
														{formatTimecode(seconds)}
													</a>
												</Fragment>
											))}
											{times.length > MAX_TIMES && (
												<Fragment>
													{' и '}
													<a class="timecode" href={`/posts/${post.id}/#anime=${entry.id}`}>
														ещё {times.length - MAX_TIMES}
													</a>
												</Fragment>
											)}
										</p>
									)}
								</PostCard>
							))}
						</div>

						<LoadMore
							id="mentions-more"
							controls="mentions-grid"
							more={`Показать ещё упоминания (${hiddenMentions})`}
							less="Свернуть упоминания"
							done="Все упоминания показаны"
							disabled={hiddenMentions === 0}
						/>
					</section>
				)
			}

			{/* Невидимое поле поиска: варианты написания и латиница кириллицей.
			    Стоит последним, чтобы не попадать в начало отрывка выдачи,
			    и спрятано от глаз и от экранного диктора — читать «студио гибли
			    соусоу но фрирен» вслух незачем. Pagefind разбирает разметку,
			    а не стили, и слова из неё в индекс попадают. ПРОВЕРЕНО РАЗБОРОМ
			    СОБРАННОГО ИНДЕКСА, а не предположением. */}
			{searchExtras && (
				<span class="visually-hidden" aria-hidden="true">
					{searchExtras}
				</span>
			)}
		</div>
	</div>
</Layout>

<style>
	.breadcrumb {
		padding: var(--sp-8) 0 var(--sp-6);
		color: var(--muted);
	}

	.breadcrumb a {
		color: var(--ink);
		text-decoration: none;
	}

	.breadcrumb a:hover {
		color: var(--accent-text);
	}

	/* ---------- Постер и заголовок ---------- */

	.hero {
		display: grid;
		gap: var(--sp-8);
		padding-bottom: var(--sp-12);
	}

	/* Ширины из §11.2: 280 на телефоне, 310 на среднем, 350 на широком. */
	.poster-wrap {
		max-width: 280px;
	}

	.poster-stamp {
		--stamp: var(--stamp-1);
		position: relative;
		display: block;
		background: var(--stamp);
	}

	.poster-stamp::before,
	.poster-stamp::after {
		content: '';
		position: absolute;
		z-index: 3;
		left: 0;
		right: 0;
		height: 12px;
		pointer-events: none;
		background: radial-gradient(circle at 6px 0, var(--paper) 5px, transparent 5.5px) 0 0 / 18px 12px repeat-x;
	}

	.poster-stamp::before {
		top: -1px;
	}

	.poster-stamp::after {
		bottom: -1px;
		transform: rotate(180deg);
	}

	.poster-inner {
		position: relative;
		overflow: hidden;
	}

	.poster-inner::before,
	.poster-inner::after {
		content: '';
		position: absolute;
		z-index: 3;
		top: 0;
		bottom: 0;
		width: 12px;
		pointer-events: none;
		background: radial-gradient(circle at 0 6px, var(--paper) 5px, transparent 5.5px) 0 0 / 12px 18px repeat-y;
	}

	.poster-inner::before {
		left: -1px;
	}

	.poster-inner::after {
		right: -1px;
		transform: rotate(180deg);
	}

	/* Постер не обрезается: поля внутри рамки заливаются цветом марки.
	   Пропорция рамки — из замера справочника (`--poster-ratio` в tokens.css),
	   а не 2:3 из ТЗ: иначе у широких постеров сверху остаётся пустая полоса. */
	.poster-stamp img {
		display: block;
		width: 100%;
		aspect-ratio: var(--poster-ratio);
		object-fit: contain;
		object-position: center;
	}

	.copy {
		min-width: 0;
	}

	.heading {
		display: grid;
		gap: var(--sp-3);
		margin-bottom: var(--sp-6);
	}

	.copy h1 {
		margin: 0 0 var(--sp-3);
	}

	.facts {
		color: var(--muted);
	}

	.original {
		margin-bottom: var(--sp-2);
		font-family: var(--font-display);
		font-size: var(--card-title);
		line-height: 1.35;
		font-style: italic;
		color: var(--muted);
	}

	/* Цель 44 набирается отступами сверху и снизу: `min-height` сдвинул бы
	   текст ссылки относительно техстроки, и на широком экране они встали бы
	   на разной высоте. */
	.external-link {
		display: inline-flex;
		align-items: center;
		gap: var(--sp-2);
		padding-block: 12px;
		font-size: var(--caption);
		color: var(--ink);
		text-decoration: none;
	}

	.external-link:hover {
		color: var(--accent-text);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.synopsis p {
		margin: 0 0 var(--sp-4);
		font-size: var(--body-lg);
		line-height: 1.65;
		color: var(--text);
	}

	.synopsis p:last-child {
		margin-bottom: 0;
	}

	@media (min-width: 621px) {
		.poster-wrap {
			max-width: 310px;
		}
	}

	@media (min-width: 821px) {
		.hero {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--grid-gap);
			align-items: start;
			padding-bottom: 58px;
		}

		.poster-wrap {
			grid-column: 1 / 5;
		}

		.copy {
			grid-column: 5 / 13;
		}

		/* Постера нет — текст занимает всю ширину, а не оставляет дыру слева. */
		.hero.no-poster .copy {
			grid-column: 1 / 13;
		}

		/* ДВЕ САМОСТОЯТЕЛЬНЫЕ КОЛОНКИ, А НЕ ОБЩАЯ СЕТКА ИЗ ЧЕТЫРЁХ ЯЧЕЕК.
		   Раньше обёртки растворялись через `display: contents`, и все четыре
		   элемента лежали в одной сетке двумя строками: заголовок с оригиналом
		   в первой, техстрока со ссылкой во второй. На однострочном заголовке
		   это выглядело как в макете, а на трёхстрочном ссылка «Страница
		   на Shikimori» уезжала на всю его высоту вниз и повисала в пустоте
		   в стороне от названия, к которому относится.

		   Теперь слева заголовок с техстрокой, справа оригинал со ссылкой,
		   и каждая колонка живёт своей высотой. Ссылка стоит под оригинальным
		   названием ВСЕГДА — какой бы длины ни был заголовок. */
		.heading {
			grid-template-columns: minmax(0, 1fr) auto;
			column-gap: 42px;
			/* ПО БАЗОВОЙ ЛИНИИ, А НЕ ПО ВЕРХУ КОРОБОК: у заголовка и оригинала
			   разные гарнитуры и кегли, и выравнивание коробок поставило бы
			   их буквы на разной высоте. Так первая строка оригинала встаёт
			   ровно на первую строку заголовка. */
			align-items: baseline;
		}

		/* Длинное оригинальное название иначе съело бы всю ширину у заголовка:
		   колонка `auto` берёт себе целую строку, сколько бы та ни занимала. */
		.heading-aside {
			max-width: 16em;
			text-align: right;
		}

		/* Отступы ссылки НЕ обнуляем, хотя в макете на широком экране они сняты:
		   ими набирается цель нажатия 44 (§8), и без них остаётся строка
		   в двенадцать пикселей высотой. Раньше ссылка стояла в своей ячейке
		   сетки и отступы мешали выравниванию; теперь она просто идёт под
		   оригинальным названием, и мешать им нечему. */
	}

	@media (min-width: 1101px) {
		.poster-wrap {
			max-width: 350px;
		}
	}

	/* ---------- Упоминания ---------- */

	/* Заголовок блока — технический слой, как у «Упоминается в материале»
	   на странице выпуска: это служебная надпись над списком, а не раздел
	   страницы. Своей линии снизу у него нет — её рисует верхняя граница
	   первого ряда карточек, иначе над блоком оказались бы две. */
	.mentions-title {
		margin: 0 0 20px;
		font-family: var(--font-tech);
		font-size: var(--technical);
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink);
	}

	.mentions-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--sp-8) var(--grid-gap);
	}

	@media (min-width: 621px) {
		.mentions-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1101px) {
		.mentions-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	/* Строка минут живёт внутри карточки материала (её <slot />), поэтому
	   размер и цвет у неё карточкины, а не свои. */
	.times {
		margin: var(--sp-3) 0 0;
		font-size: var(--body-sm);
		line-height: 1.6;
		color: var(--muted);
	}

	/* Таймкод — часть предложения, поэтому в гарнитуре текста, а не плашкой:
	   коробок в языке сайта нет. Цель 44 добирается невидимой зоной (§8). */
	.timecode {
		position: relative;
		color: var(--accent-text);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		white-space: nowrap;
	}

	.timecode::after {
		content: '';
		position: absolute;
		inset: -12px -6px;
	}

	.timecode:hover {
		background: var(--accent-soft);
	}
</style>

<script>
	// Упоминания сверх первых шести. Разметка вся на месте, лишние карточки
	// закрыты атрибутом — так их найдёт поиск браузера по странице.
	import { setLoadMoreState } from '../../lib/loadMore.mjs';

	function setup() {
		const grid = document.getElementById('mentions-grid');
		const button = document.getElementById('mentions-more') as HTMLButtonElement | null;
		if (!grid || !button || button.disabled) return;

		const extra = Array.from(grid.children).filter((el) => (el as HTMLElement).hidden) as HTMLElement[];
		if (extra.length === 0) return;

		button.addEventListener('click', () => {
			// Свернуть — та же кнопка на том же месте (§8.1).
			const open = button.getAttribute('aria-expanded') === 'true';
			for (const el of extra) el.hidden = open;
			setLoadMoreState(button, open ? 'more' : 'less');
		});
	}

	document.addEventListener('astro:page-load', setup);
</script>
