---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAnimePosterSrcs } from '../../lib/animePoster.mjs';
import { buildMentionIndex, postsForAnime } from '../../lib/animeMentionIndex.mjs';
import { formatTimecode } from '../../lib/transcript.mjs';
import { isPublished } from '../../lib/publishing.mjs';
import JsonLd from '../../components/JsonLd.astro';
import { breadcrumbsSchema } from '../../lib/schema.mjs';

export async function getStaticPaths() {
	const animeList = await getCollection('anime');
	// isPublished, а не просто !data.draft: у поста может стоять отложенная
	// публикация (тз/09), и до её срока своей страницы у него нет — карточка
	// вела бы в никуда.
	const posts = await getCollection('posts', ({ data }) => isPublished(data));
	const transcripts = await getCollection('transcripts');

	// Указатель «тайтл → выпуск → минуты» считаем ОДИН раз на всю сборку,
	// а не заново на каждой странице тайтла: расшифровок 107, страниц тайтлов
	// со временем станут сотни, и перечитывать одно другим вышло бы дорого.
	const index = buildMentionIndex({ posts, transcripts, animeList });

	return animeList.map((entry) => ({
		params: { slug: entry.id },
		props: { entry, mentions: postsForAnime(entry.id, posts, index) },
	}));
}

const { entry, mentions } = Astro.props;
const { titleRu, titleOriginal, year, studio, poster, synopsis, url, source } = entry.data;
const posterSrcs = getAnimePosterSrcs(poster);
const displayTitle = titleRu || titleOriginal;
const needsTranslation = !titleRu;
const sourceLabel = source === 'anilist' ? 'AniList' : 'Shikimori';

// Сколько минут показываем в карточке выпуска. Замер по архиву: у «Наруто»
// 70 выпусков и 547 упоминаний, в медианном выпуске их 2, но в худшем — 45.
// Сорок пять цифр подряд в карточке читать невозможно, поэтому хвост
// сворачивается в ссылку «и ещё N» — она открывает выпуск, подсвечивает
// все упоминания и даёт стрелки, чтобы листать их по одному.
const MAX_TIMES = 8;

// Описание страницы тайтла (тз/06, шаг 8). Первое предложение описания плюс
// сколько раз тайтл упоминался — упоминания и есть то, ради чего сюда приходят,
// и в выдаче это отличает нашу страницу от сотни карточек того же аниме
// на других сайтах.
//
// Раньше здесь стоял synopsis.slice(0, 160) — он резал посреди слова.
function firstSentence(text: string | undefined, max = 130) {
	if (!text) return null;

	// Разметка Shikimori в описании. Два разных случая, и путать их нельзя:
	//   [[Хокагэ]]        — ссылка на термин, текст внутри нужен;
	//   [波風ミナト]       — японский оригинал имени рядом с русским,
	//                       в строчке выдачи это шум, убираем целиком.
	// На самой странице тайтла описание показывается как есть — там место
	// для подробностей; режем только то, что уйдёт в поисковик и в превью.
	const clean = text
		.replace(/\[\[([^\]]*)\]\]/g, '$1')
		.replace(/\[[^\]]*\]/g, '')
		// После выброшенных скобок остаётся двойной пробел и пробел перед
		// запятой: «шляпница Софи  ведёт», «Хаула , колдуна».
		.replace(/\s+([,.;:!?])/g, '$1')
		.replace(/\s+/g, ' ')
		.trim();

	if (!clean) return null;
	if (clean.length <= max) return clean;
	const cut = clean.slice(0, max);
	// Режем по концу предложения, если он есть в пределах куска, иначе по слову.
	const stop = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('! '), cut.lastIndexOf('? '));
	if (stop > max / 2) return cut.slice(0, stop + 1);
	const space = cut.lastIndexOf(' ');
	return `${(space > max / 2 ? cut.slice(0, space) : cut).replace(/[\s,.;:—-]+$/, '')}…`;
}

// «упоминание / упоминания / упоминаний» — по правилам русского счёта.
function mentionsWord(n: number) {
	const mod100 = n % 100;
	if (mod100 >= 11 && mod100 <= 14) return 'упоминаний';
	const mod10 = n % 10;
	if (mod10 === 1) return 'упоминание';
	if (mod10 >= 2 && mod10 <= 4) return 'упоминания';
	return 'упоминаний';
}

const mentionsNote =
	mentions.length > 0
		? `${displayTitle} в подкасте «Бака!»: ${mentions.length} ${mentionsWord(mentions.length)} в выпусках и постах.`
		: `${displayTitle} — карточка тайтла в подкасте «Бака!».`;

const animeDescription = firstSentence(synopsis) ?? mentionsNote;

const crumbs = breadcrumbsSchema([
	{ name: 'Тайтлы', path: '/anime/' },
	{ name: displayTitle, path: `/anime/${entry.id}/` },
]);
---

{/* Картинка превью не задана нарочно — подставится общая картинка сайта.
    Обложки тайтлов лежат в public/anime/ только в webp (см. animePoster.mjs),
    а телеграм webp-превью разворачивает ненадёжно; отдать ему сломанную
    картинку хуже, чем баннер подкаста. */}
<Layout title={displayTitle} description={animeDescription}>
	<JsonLd slot="head" data={crumbs} />
	{/* Что берёт в поиск Pagefind — см. пояснение в src/pages/posts/[slug].astro.
	    У тайтла в индекс идёт название, оригинальное название и описание;
	    список упоминаний ниже помечен data-pagefind-ignore, иначе заголовки
	    выпусков попали бы ещё и в карточку тайтла и по запросу «Наруто»
	    выдача дублировалась бы сама с собой. */}
	<section
		class="anime-page"
		data-pagefind-body
		data-pagefind-filter="type:Тайтлы"
		data-pagefind-meta="type:anime"
	>
		<a class="back" href="/anime/" data-pagefind-ignore>← Все тайтлы</a>

		<div class="header">
			{
				posterSrcs.length > 0 && (
					<img
						class="poster"
						src={posterSrcs[0].src}
						srcset={posterSrcs.map((s) => `${s.src} ${s.width}w`).join(', ')}
						sizes="220px"
						alt=""
					/>
				)
			}
			<div class="info">
				<h1>{displayTitle}</h1>
				{
					needsTranslation ? (
						<p class="translation-notice">
							⚠ нет русского названия — впишите titleRu в src/content/anime/{entry.id}.json
						</p>
					) : (
						titleOriginal !== titleRu && <p class="original">{titleOriginal}</p>
					)
				}
				<p class="meta">
					{[year, studio].filter(Boolean).join(' · ')}
				</p>
				{
					url && (
						<a class="shikimori-link" href={url} target="_blank" rel="noopener noreferrer">
							Страница на {sourceLabel} →
						</a>
					)
				}
				{synopsis && <p class="synopsis">{synopsis}</p>}
			</div>
		</div>

		<h2 class="mentions-title" data-pagefind-ignore>Упоминания{mentions.length > 0 && ` (${mentions.length})`}</h2>
		<div data-pagefind-ignore>
		{
			mentions.length === 0 ? (
				<p class="empty">Пока нет постов с этим тайтлом.</p>
			) : (
				<div class="grid">
					{mentions.map(({ post, times }: { post: any; times: number[] }) => (
						<PostCard post={post}>
							{/* Отдельного блока для выпусков нет — выпуск идёт обычной
							    карточкой, наравне с постами, а минуты разговора уходят
							    в её краткое описание (тз/05, шаг 5). Ссылка ведёт на
							    страницу выпуска и там подсвечивает все упоминания —
							    разбирает её src/components/Transcript.astro. */}
							{times.length > 0 && (
								<p class="episode-times">
									обсуждали в выпуске на{' '}
									{times.slice(0, MAX_TIMES).map((seconds, i) => (
										<Fragment>
											{i > 0 && ', '}
											<a href={`/posts/${post.id}/#anime=${entry.id}&t=${Math.floor(seconds)}`}>
												{formatTimecode(seconds)}
											</a>
										</Fragment>
									))}
									{times.length > MAX_TIMES && (
										<Fragment>
											{' и '}
											<a href={`/posts/${post.id}/#anime=${entry.id}`}>ещё {times.length - MAX_TIMES}</a>
										</Fragment>
									)}
								</p>
							)}
						</PostCard>
					))}
				</div>
			)
		}
		</div>
	</section>
</Layout>

<style>
	.anime-page {
		max-width: 72rem;
		margin: 0 auto;
		padding: var(--space-4) var(--space-3);
	}

	.back {
		display: inline-block;
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
		margin-bottom: var(--space-3);
	}

	.back:hover,
	.back:focus-visible {
		color: var(--color-accent-hover);
	}

	.header {
		display: flex;
		gap: var(--space-3);
		margin-bottom: var(--space-4);
	}

	.poster {
		width: 220px;
		flex-shrink: 0;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-radius: var(--radius-md);
		background: var(--color-bg-elevated);
	}

	.info {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		min-width: 0;
	}

	.info h1 {
		margin: 0;
	}

	.original {
		color: var(--color-text-muted);
		font-style: italic;
		margin: 0;
	}

	.translation-notice {
		width: fit-content;
		padding: 0.15em 0.6em;
		border-radius: var(--radius-sm);
		background: var(--color-accent-2);
		color: var(--color-bg);
		font-size: var(--font-size-sm);
		margin: 0;
	}

	.meta {
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
		margin: 0;
	}

	.shikimori-link {
		color: var(--color-accent);
		font-size: var(--font-size-sm);
		width: fit-content;
	}

	.shikimori-link:hover,
	.shikimori-link:focus-visible {
		color: var(--color-accent-hover);
	}

	.synopsis {
		color: var(--color-text-muted);
		margin: var(--space-1) 0 0;
	}

	.mentions-title {
		margin-bottom: var(--space-2);
	}

	.empty {
		color: var(--color-text-muted);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: var(--space-3);
	}

	/* Строка живёт внутри карточки поста (<slot /> в PostCard.astro), поэтому
	   отступы повторяют отступы её тела. */
	.episode-times {
		margin: 0;
		padding: 0 var(--space-2) var(--space-2);
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
	}

	.episode-times a {
		color: var(--color-accent);
		font-variant-numeric: tabular-nums;
	}

	.episode-times a:hover,
	.episode-times a:focus-visible {
		color: var(--color-accent-hover);
	}

	@media (max-width: 600px) {
		.header {
			flex-direction: column;
		}

		.poster {
			width: 160px;
		}
	}
</style>
