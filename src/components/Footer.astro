---
// Подвал (§7). Одна строка копирайта — и всё.
//
// Своих призывов подписаться и поддержать здесь нет: это отдельные блоки
// (SocialStrip, SupportStrip), и смешивать их с подвалом нельзя.
//
// ССЫЛОК В ПОДВАЛЕ БОЛЬШЕ НЕТ, и убраны они решением заказчика 10 августа
// 2026. Сначала отсюда ушли разделы сайта — они переехали в меню шапки,
// которого раньше не было; остались площадки подкаста и лента. Заказчик
// посмотрел живую страницу и сказал верное: те же площадки стоят на сайте
// в трёх местах сразу — в блоке «Ещё немного нас», на «О проекте»
// и на «Поддержать», — и четвёртый мелкий их список внизу каждой страницы
// ничего не добавляет.
//
// ВМЕСТЕ С НИМИ УШЛА И ЕДИНСТВЕННАЯ ВИДИМАЯ ССЫЛКА НА `/rss.xml`. Сама лента
// жива и находится программами для чтения: тег `<link rel="alternate">` стоит
// в `<head>` каждой страницы (Layout.astro). Глазами её теперь на сайте
// не найти — это названная цена решения, а не недосмотр.
//
// ОСВОБОДИВШИЙСЯ ПРАВЫЙ УГОЛ ЗАНЯЛА КНОПКА «НАВЕРХ» (ToTop.astro). До этой
// правки она была вынуждена прятаться, как только подвал появлялся на экране,
// иначе накрыла бы ссылки собой. Теперь прятаться не от чего, и кнопка
// работает до самого низа страницы.
import { SITE_NAME, SITE_DESCRIPTION } from '../lib/site.mjs';

const year = new Date().getFullYear();
---

<div class="site">
	<footer class="footer">
		<div>© {year} {SITE_NAME} · {SITE_DESCRIPTION}.</div>
		{/* ССЫЛКА НА СОГЛАШЕНИЕ И ВОЗРАСТНАЯ ПОМЕТКА — вторая строка подвала,
		    решение заказчика 14 августа 2026. Это единственные ссылки, которые
		    сюда вернулись после уборки 10 августа, и вернулись по другой
		    причине: те были дублями блоков со страниц, а эта — единственная
		    дорога к документу.

		    ДЕРЖАТСЯ ВМЕСТЕ И НЕ РАЗЪЕЗЖАЮТСЯ: подпись и пометка — одно целое,
		    разрешать переносу разорвать их нельзя (правило «что тесно — то
		    держат вместе»). */}
		<div class="footer-legal tech">
			<a href="/legal/">Пользовательское соглашение</a>
			<span aria-label="Восемнадцать лет и старше">18+</span>
		</div>
	</footer>
</div>

<style>
	/* Колонок больше нет: содержимое одно. Сетка с одним ребёнком осталась бы
	   описанием раскладки, которой не существует, — а пустое описание живёт
	   дольше и вводит в заблуждение следующего читателя. */
	/* Правый угол занят кнопкой «наверх», и место под неё резервируется здесь.
	   Без этого на ширинах окна 478–562 строка копирайта встаёт одной строкой
	   во всю колонку и заезжает кнопке под низ — полосы этой нет ни в одном
	   списке ширин, нашлась замером. Число живёт у самой кнопки
	   (`--to-top-space` в ToTop.astro): его задаёт тот, кто место занимает.
	   Запасной ноль нужен затем, чтобы уборка кнопки не требовала правки
	   ещё и здесь. */
	.footer {
		padding: var(--sp-8) var(--to-top-space, 0px) 40px 0;
		border-top: 1px solid var(--line);
		font-size: var(--caption);
		line-height: 1.45;
		color: var(--muted);
	}

	/* Вторая строка подвала. Кегль и начертание приходят с `.tech` — своих
	   не назначаем: техслой описан один раз на весь сайт, и вписанное сюда
	   число разошлось бы с ним при первой же правке. Здесь только расстановка.

	   ЗАЗОР ЗАДАЁТ FLEX, а не пробел в разметке: пробел между строчными
	   элементами схлопывается и зависит от кегля, а нам нужно расстояние. */
	/* КАПСЛОК СНЯТ — решение заказчика 14 августа 2026. Утилита `.tech` приносит
	   его вместе с гарнитурой и трекингом, и «ПОЛЬЗОВАТЕЛЬСКОЕ СОГЛАШЕНИЕ»
	   строкой в 11 px выходило тяжелее всего подвала. Снимаем здесь, а не
	   отказом от `.tech`: кегль, гарнитура и трекинг техслоя нужны, лишнее
	   в нём — только регистр.

	   ПЕРЕБИВАЕТ ПО ВЕСУ, А НЕ ПО ПОРЯДКУ. У `.tech` один класс, у этого
	   правила — класс плюс метка компонента, которую дописывает сборщик:
	   вес выше, и перестановка правил местами ничего не сломает. Равный вес
	   тут был бы миной (в проекте стрелял трижды). */
	.footer-legal {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--sp-3);
		margin-top: var(--sp-2);
		text-transform: none;
	}

	/* Пометка и подпись переносу не отдаются: «18+» разорвать нечем, а вот
	   «Пользовательское соглашение» на узком экране разъехалось бы по словам
	   и перестало читаться одной подписью. */
	.footer-legal a,
	.footer-legal span {
		white-space: nowrap;
	}

	.footer-legal a {
		color: var(--muted);
		text-decoration: underline 1px;
		text-underline-offset: 3px;
		transition: color var(--transition-fast);
	}

	.footer-legal a:hover {
		color: var(--accent-text);
	}
</style>
