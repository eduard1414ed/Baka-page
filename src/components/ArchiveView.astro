---
// Страница архива целиком: шапка, вкладки по типу, лента и листание
// (раздел 4.1–4.3 ТЗ, макет Сборка-18/archive.html).
//
// ОДИН КОМПОНЕНТ НА АРХИВ И НА РАЗДЕЛЫ. `/archive/` и `/category/podcast/` —
// это одна и та же страница с разным набором материалов, и отдельной вёрстки
// у раздела быть не должно: две копии разошлись бы сначала шапкой, потом
// пагинацией, и заметить это можно было бы только глазами на шестой странице
// раздела, куда никто не заходит.
//
// АРХИВ ПОКАЗЫВАЕТСЯ ТЕКСТОВОЙ СЕТКОЙ БЕЗ ОБЛОЖЕК, и причина не в экономии.
// Разные форматы дают разную геометрию медиа: квадрат у выпуска, кадр 16:9
// у видео, заметка вообще без картинки. В общем ряду это читается рвано,
// и даже разделительная линия рвётся на сегменты по зазорам сетки. Без обложек
// ряды ровные, в экран помещается втрое больше, а тип материала считывается
// по технической строке — она и так первая в карточке.
//
// Карточка при этом та же самая, что на главной, — вариант `text` компонента
// PostCard.astro. Второго компонента карточки в проекте нет и не заводим.
import PostCard from './PostCard.astro';
import Pagination from './Pagination.astro';
import SectionHead from './SectionHead.astro';
import { visibleCategories } from '../content.config';

interface Props {
	/** Материалы текущей страницы, уже отсортированные и нарезанные. */
	posts: Array<{ id: string; body?: string; data: Record<string, any> }>;
	/** Надзаголовок техническим слоем. */
	eyebrow: string;
	heading: string;
	intro: string;
	/** «143 выпуска · 24 видеоэссе · 61 статья». У пустого раздела пусто. */
	countLine: string;
	/** Раздел, если это страница раздела. Не задан — весь архив. */
	activeCategory?: string;
	/** Адрес первой страницы этого вида: `/archive/` или `/category/note/`. */
	base: string;
	current: number;
	last: number;
}

const { posts, eyebrow, heading, intro, countLine, activeCategory, base, current, last } = Astro.props;
---

{/* Шапка раздела — общий компонент: точно такая же стоит у каталога тайтлов. */}
<SectionHead eyebrow={eyebrow} heading={heading} intro={intro} countLine={countLine} />

{/* Те же вкладки, что фильтры на главной, но здесь это ОБЫЧНЫЕ ССЫЛКИ
    на разделы: у каждого типа свой адрес, на который можно сослаться
    и который найдёт поисковик. Своей линии снизу у вкладок нет — её рисует
    верхняя граница первого ряда карточек, иначе вышли бы две линии
    в тридцати пикселях друг от друга (§5). */}
<nav class="archive-tabs" aria-label="Тип материала">
	<a class="archive-tab" href="/archive/" aria-current={activeCategory ? undefined : 'page'}>Все</a>
	{
		visibleCategories.map((category) => (
			<a
				class="archive-tab"
				href={`/category/${category.id}/`}
				aria-current={category.id === activeCategory ? 'page' : undefined}
			>
				{category.label}
			</a>
		))
	}
</nav>

{
	posts.length === 0 ? (
		<p class="empty">Пока нет материалов.</p>
	) : (
		<section class="list-grid archive-list" aria-label="Материалы">
			{posts.map((post) => (
				<PostCard post={post} variant="text" level={2} />
			))}
		</section>
	)
}

{last > 1 && <Pagination current={current} last={last} base={base} />}

<style>
	/* Шапка раздела — в SectionHead.astro: она общая с каталогом тайтлов. */

	/* Вкладки переносятся, а не скроллятся: карусель прячет часть типов
	   за краем экрана, и о них не догадаться. */
	.archive-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--sp-6);
		padding: var(--sp-2) 0;
		font-size: var(--caption);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.archive-tab {
		position: relative;
		min-height: 44px;
		display: inline-flex;
		align-items: center;
		color: var(--ink);
	}

	.archive-tab:hover {
		color: var(--accent-text);
	}

	/* Активная вкладка отличается не только цветом (§3.3): начертанием
	   и подчёркиванием, а для диктора — `aria-current`. */
	.archive-tab[aria-current='page'] {
		font-weight: 600;
	}

	.archive-tab[aria-current='page']::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 8px;
		height: 1.5px;
		background: var(--ink);
	}

	/* НА ТЕСНОМ ЭКРАНЕ РЯД СЖИМАЕТСЯ, ЧТОБЫ НЕ ПЕРЕНОСИТЬСЯ. Числа и замер —
	   в `PostFeed.astro`, где стоит такой же ряд с тем же составом вкладок:
	   пятерым при зазоре 24 нужен экран 433 px, при зазоре 10 и кегле 11 —
	   353. Меняете тут — поправьте и там; развести эти два ряда нельзя,
	   они одинаковы по замыслу. */
	@media (max-width: 432px) {
		.archive-tabs {
			gap: 0 10px;
			font-size: var(--technical);
		}
	}

	/* Сама сетка — общая (.list-grid в global.css). Странице остаётся
	   только вертикальный ритм. */
	.archive-list {
		padding: var(--sp-6) 0 var(--sp-12);
	}

	.empty {
		color: var(--muted);
		padding: var(--sp-12) 0;
		border-top: 1px solid var(--line);
	}
</style>
