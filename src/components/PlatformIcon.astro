---
// Логотипы площадок. Какое имя какой площадке — решает домен ссылки,
// см. src/lib/linkIcon.mjs; руками иконку никто не выбирает.
//
// ЛОГОТИПЫ НАСТОЯЩИЕ, А НЕ НАРИСОВАННЫЕ НАМИ. Раньше тут лежали пять
// самодельных значков, срисованных «на глаз», — заказчик посмотрел живую
// страницу и назвал их кривыми и неправильными, и был прав: узнаваемый
// логотип нельзя приблизить, его либо взяли настоящим, либо нет.
//
// Откуда что взято:
//   — восемь из Simple Icons (simpleicons.org), это открытый набор
//     официальных логотипов под CC0. Все с системой координат 24×24
//     и одним контуром;
//   — Яндекс Музыка — официальный знак с music.yandex.ru/favicon.svg:
//     в Simple Icons её нет вовсе;
//   — Mave — их собственный значок с mave.stream/favicon.svg, там же
//     и по той же причине.
//
// ЦВЕТ ВСЕГДА `currentColor`. Фирменные цвета сюда не переносятся: логотипы
// стоят строкой в списке, и десять разных ярких пятен спорили бы и друг
// с другом, и с §2 системы, где цвет на сайте один — акцентный.
//
// РАЗМЕР ЗАДАЁТ МЕСТО, А НЕ ИКОНКА, — правило внизу файла.
interface Props {
	name: string | null;
}

const { name } = Astro.props;
