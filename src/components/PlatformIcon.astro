---
interface Props {
	name: string | null;
}

const { name } = Astro.props;
---

{
	name === 'youtube' && (
		<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<rect x="2" y="5" width="20" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="1.6" />
			<path d="M10 8.5l6 3.5-6 3.5z" />
		</svg>
	)
}
{
	name === 'spotify' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
			<circle cx="12" cy="12" r="9.5" />
			<path d="M7 10.2c3.5-1 6.5-1 10 .6" />
			<path d="M7.5 13c2.8-.8 5.2-.8 8 .5" />
			<path d="M8 15.7c2.2-.6 4-.6 6 .4" />
		</svg>
	)
}
{
	name === 'apple' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
			<circle cx="12" cy="12" r="9.5" />
			<circle cx="12" cy="10" r="3" />
			<path d="M12 13v6" stroke-linecap="round" />
		</svg>
	)
}
{
	name === 'boosty' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
			<path d="M12 20.3s-7.5-4.3-7.5-10a4.6 4.6 0 0 1 7.5-3.6A4.6 4.6 0 0 1 19.5 10.3c0 5.7-7.5 10-7.5 10z" />
		</svg>
	)
}
{
	name === 'telegram' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
			<path d="M3 11.8l17-7.3-3 15.4-5.4-4-2.7 2.6-.3-4z" />
			<path d="M20 4.5L9.6 13.5" />
		</svg>
	)
}
{/* Обе взяты из утверждённого макета as is, включая систему координат 48×48:
    перерисовывать их под наши 24×24 значило бы рисовать заново и разойтись
    с макетом в пропорциях. viewBox масштабирует сам. */}
{
	name === 'yandex' && (
		<svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
			<circle cx="24" cy="24" r="18" stroke="currentColor" stroke-width="2" />
			<path d="M28 14v18.5a5.5 5.5 0 1 1-2-4.2V18l10-2.5V13L28 14Z" fill="currentColor" />
		</svg>
	)
}
{
	name === 'mave' && (
		<svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
			<rect x="7" y="7" width="34" height="34" rx="17" stroke="currentColor" stroke-width="2" />
			<path d="M14 31V17h4.4l5.6 8.2 5.6-8.2H34v14h-4V23.4l-5.3 7.6h-1.4L18 23.4V31h-4Z" fill="currentColor" />
		</svg>
	)
}

<style>
	/* РАЗМЕР ЗАДАЁТ МЕСТО, А НЕ ИКОНКА. Раньше тут стояли 1.1em — под кнопки-
	   таблетки старой страницы «О подкасте». В новом макете иконка стоит
	   в коробке 28×28, и своя ширина компонента спорила бы с ней: правило
	   `.platform-icon :global(svg)` со стороны страницы весит ровно столько же,
	   сколько правило `svg` внутри компонента, и кто победит — решал бы порядок
	   файлов в сборке. Компонент рисует, коробку меряет тот, кто ставит. */
	svg {
		width: 100%;
		height: 100%;
		display: block;
	}
</style>
