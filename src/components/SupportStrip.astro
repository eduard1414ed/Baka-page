---
// Полоса поддержки — «Поддержать «Баку!»» на «О проекте» (раздел 10.4 ТЗ)
// и «Бака! — независимый проект» внизу главной (раздел 10.5). ОДИН КОМПОНЕНТ
// НА ДВА МЕСТА: до 10.5 разметка и стили лежали внутри about.astro.
//
// ИМЯ `.support` ЗАНЯТО ЦЕЛОЙ СТРАНИЦЕЙ `/support/`, поэтому блок называется
// `.support-strip` — в макете он `.support`.
//
// РИСУНОК ПЕРСОНАЖА, А НЕ ОБЛОЖКА ПОДКАСТА. Оба макета рисуют тут обложку,
// но 9 августа заказчик заменил её рисунком на «О проекте»; на главной
// побеждает компонент, а не макет — иначе один и тот же блок показывал бы
// на двух страницах разные картинки.
//
// КНОПКИ БЕРУТСЯ ИЗ src/data/platforms.js, своего списка у блока нет: там же
// их берут подвал, «Поддержать» и плашка подписки у бонусов.
import { platformsOfKind } from '../data/platforms.js';

// ТЕКСТ ЖИВЁТ ЗДЕСЬ, А НЕ НА ШЕСТИ СТРАНИЦАХ. Макеты спорили друг с другом:
// на главной и в статье стояло «Бака! — независимый проект», в выпуске,
// видеоэссе, каталоге и на тайтле — «Поддержать «Баку!»». Заказчик выбрал
// второй вариант для ВСЕХ мест 9 августа 2026. Написать его на каждой странице
// значило бы завести шесть копий одной фразы, поэтому он тут значением
// по умолчанию, а страницы не передают ничего.
//
// ОДНО ИСКЛЮЧЕНИЕ — «О проекте»: там оба текста правятся в админке и приходят
// сюда полями. Сейчас они совпадают с этими дословно; правка в админке изменит
// только ту страницу — цена названа заказчику и принята.
const DEFAULT_TITLE = 'Поддержать «Баку!»';
const DEFAULT_NOTE =
	'Подписка помогает нам выпускать подкасты, видеоэссе и тексты — и даёт доступ к бонусным выпускам и дополнительным материалам.';

interface Props {
	/** Заголовок блока. Пусто — берётся общий. */
	title?: string;
	/** Строчка под заголовком. Пусто — берётся общая. */
	note?: string;
}

const { title, note } = Astro.props;

// Проверяется СОДЕРЖИМОЕ, а не наличие: CMS пишет в очищенное поле пустую
// строку, а не пропускает его, и значение по умолчанию у аргумента на пустую
// строку не сработало бы — блок остался бы с пустым заголовком.
// Заголовка блок без заголовка не бывает: пусто — берём общий.
const heading = title?.trim() || DEFAULT_TITLE;

// А У АБЗАЦА «НЕ ПЕРЕДАЛИ» И «ОЧИСТИЛИ» — РАЗНЫЕ СОСТОЯНИЯ. Страница, которая
// не передаёт ничего, получает общий текст; «О проекте» передаёт поле админки,
// и очищенное поле там значит «абзаца быть не должно» — так это и работало
// до части 10.5, и прогон пустых полей на это опирался.
const lead = note === undefined ? DEFAULT_NOTE : note.trim();

const support = platformsOfKind('support');

// В ПОИСК БЛОК НЕ ИДЁТ (`data-pagefind-ignore` на секции) — см. пояснение
// в SocialStrip.astro: обвязка страницы, а не текст материала.
---

{
	support.length > 0 && (
		<section class="support-strip" aria-labelledby="support-title" data-pagefind-ignore>
			{/* Рисунок персонажа на прозрачном фоне: значит `contain`, а не `cover` —
			    обрезать тут нечего, — и никакой заливки под ним, он лежит прямо
			    на бумаге. Проверено замером: средний цвет непрозрачных пикселей
			    120 из 255, на светлом фоне он виден. */}
			<div class="support-img">
				<img src="/baka-character.png" alt="" width="160" height="160" loading="lazy" />
			</div>
			<div class="support-copy">
				<h2 id="support-title">{heading}</h2>
				{lead && <p>{lead}</p>}
			</div>
			<div class="support-links">
				{support.map((platform) => (
					<a class="btn-large" href={platform.url} target="_blank" rel="noopener noreferrer">
						{platform.label}
						<span class="ext-arrow" aria-hidden="true">
							↗
						</span>
					</a>
				))}
			</div>
		</section>
	)
}

<style>
	/* Линию сверху блок рисует себе сам, как и все секции «О проекте»
	   и все редакционные ряды главной. */
	.support-strip {
		display: grid;
		gap: 20px;
		padding: var(--sp-12) 0;
		border-top: 1px solid var(--line);
	}

	/* `align-self` тут не ставится нарочно: на широком экране блок выравнивает
	   свои три колонки по центру, и рисунок должен ехать вместе с ними. */
	.support-img {
		width: 160px;
		aspect-ratio: 1;
	}

	/* `contain`, а не `cover`: у рисунка на прозрачном фоне нет краёв, которые
	   можно обрезать, — обрезка съела бы ему макушку. Рамки и заливки тоже
	   нет: он лежит прямо на бумаге. */
	.support-img img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
	}

	/* Заголовок этого блока — H2, а не H3 как в макете: он такой же заголовок
	   блока, что и «Команда» со «Слушать подкаст», и по смыслу стоит на том же
	   уровне. Кегль при этом взят из макета — `--h3`, — потому что блок узкий
	   и полноразмерный заголовок в нём смотрелся бы вторым хиро. Уровень
	   заголовка решает содержание, кегль решает макет. */
	.support-copy h2 {
		margin: 0 0 var(--sp-2);
		font-size: var(--h3);
	}

	.support-copy p {
		margin: 0;
		font-size: var(--body-sm);
		line-height: 1.5;
		color: var(--muted);
		max-width: 540px;
	}

	.support-links {
		display: grid;
		grid-template-columns: 1fr;
		gap: 10px;
	}

	/* КНОПКИ ТАКИЕ ЖЕ, КАК В ХИРО СТРАНИЦЫ «ПОДДЕРЖАТЬ», а не мельче, как
	   в макете: решение заказчика по живой странице. Это те же четыре кнопки
	   с теми же адресами, и разный размер читался бы не как «тут поменьше»,
	   а как две разные вещи.

	   ВИДА КНОПКИ ЗДЕСЬ НЕТ ВОВСЕ — она берёт общий `.btn-large` в global.css,
	   тот же, что кнопки «Поддержать», плашка бонуса и страница 404. Прежде
	   тут лежала ПОЛНАЯ КОПИЯ его описания: шестнадцать объявлений байт в байт,
	   плюс своё наведение, плюс своя семнадцатка у стрелки — при том что рядом
	   с `.btn-large` в global.css стоит оговорка «трёх одинаковых семнадцаток
	   быть не должно». Четвёртая лежала здесь (доревизия задачи 15, находка 22).
	   Копии совпадали, поэтому расхождения не видел никто, — а блок этот стоит
	   на ШЕСТИ страницах сайта, и любая правка кнопки обошла бы его стороной.

	   Месту остаётся только раскладка: сколько кнопок в ряду и какой он ширины. */
	@media (min-width: 621px) {
		/* Сетка ЗАПОЛНЯЮЩАЯ, а не схлопывающая: пустые дорожки сохраняются,
		   и три кнопки не растягиваются во всю ширину, когда четвёртой нет. */
		.support-links {
			grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
		}
	}

	/* Перелом тут 821, как у остальных секций «О проекте», а не 761, как
	   у блока соцсетей: этот блок не стоит внутри ленты. На главной он последняя
	   секция страницы, ниже каталога, и ритму редакционных рядов не подчиняется. */
	@media (min-width: 821px) {
		/* КОЛОНКА РОВНО ПО РИСУНКУ. В макете колонка 144, и это число ехало
		   сюда дословно, пока рисунок был 144. После замены обложки персонажем
		   рисунок стал 160 и вылезал из своей колонки на 16 px, съедая зазор
		   до текста: 28 превращались в 12. Число одно, и стоит оно теперь
		   рядом с шириной самого рисунка. */
		.support-strip {
			grid-template-columns: 160px minmax(0, 1fr) auto;
			gap: 28px;
			align-items: center;
		}

		.support-links {
			grid-template-columns: repeat(2, minmax(150px, 1fr));
		}
	}
</style>
