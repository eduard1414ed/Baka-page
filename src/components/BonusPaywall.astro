---
// Плашка подписки под бонусным постом (тз/10, задача 1).
//
// Показывается САМА у любого поста категории `bonus`, отдельного переключателя
// нет: бонус по определению лежит за подпиской. Решает это страница поста
// (src/pages/posts/[slug].astro), сюда попадают уже готовые ссылки.
//
// Ни плеера, ни транскрипта, ни метки времени у бонуса нет и не будет: аудио
// у нас не хранится, бонусы живут на платных площадках (CLAUDE.md, «Место
// на сервере»). Метку времени гасит src/lib/postTiming.mjs.
//
// ОФОРМЛЕНИЕ. Структура и порядок блоков взяты из макета заказчика
// (baka_bonus_episode_mockup_v2.html), а цвета, шрифты и отступы — только
// из src/styles/tokens.css. Макет светлый, сайт сейчас тёмный: светлая тема
// придёт на восьмом этапе, и плашка должна переодеться вместе со всем сайтом,
// а не остаться на странице светлым пятном.
import { platformsOfKind } from '../data/platforms.js';

interface Props {
	// Поле «Кнопки» самого поста. Заполнено — показываем его, иначе общий
	// набор площадок поддержки. Исключение нужно ради закрытого телеграм-канала:
	// у разных бонусов он может быть разный, а вбивать Boosty с Patreon
	// в каждый пост руками — верный способ однажды забыть их поправить.
	buttons?: Array<{ label: string; url: string }>;
}

const { buttons } = Astro.props;

const links = buttons && buttons.length > 0 ? buttons : platformsOfKind('support');
---

<section class="paywall" aria-labelledby="paywall-title">
	<div class="frame">
		{/* Подпись разрывает верхнюю границу рамки — так в макете. Это не
		    украшение: она отделяет «дальше платное» от текста-тизера выше,
		    который открыт всем и попадает в поиск. */}
		<span class="hook">Только для подписчиков</span>

		<div class="copy">
			<h2 id="paywall-title">Бонусы доступны платным подписчикам подкаста</h2>
			<p class="lead">
				Подпишитесь на удобной площадке, чтобы послушать этот выпуск и получить доступ ко всему архиву бонусов «Баки!».
			</p>
			<p class="note">После оформления подписки выпуск будет доступен на выбранной площадке.</p>
		</div>

		<div class="actions">
			{
				links.map((link) => (
					<a href={link.url} target="_blank" rel="noopener noreferrer">
						<span class="label">{link.label}</span>
						<span class="arrow" aria-hidden="true">
							↗
						</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.paywall {
		margin-top: var(--space-4);
	}

	.frame {
		position: relative;
		border: 1px solid var(--color-accent);
		border-radius: var(--radius-md);
		background: var(--color-bg-elevated);
		padding: var(--space-4) var(--space-3) var(--space-3);
	}

	/* Фон подписи — цвет страницы, а не рамки: именно им она и «разрывает»
	   верхнюю границу. Отдельного полупрозрачного цвета в токенах нет,
	   и заводить его тут не стали — на восьмом этапе цвета всё равно
	   пересматриваются целиком. */
	.hook {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translate(-50%, -50%);
		padding: 0 var(--space-1);
		background: var(--color-bg);
		color: var(--color-accent);
		font-size: var(--font-size-sm);
		white-space: nowrap;
	}

	h2 {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		margin: 0 0 var(--space-2);
	}

	.lead {
		margin: 0 0 var(--space-2);
	}

	.note {
		margin: 0;
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
	}

	/* auto-fit вместо жёстких четырёх колонок из макета: площадок может быть
	   и две (общий набор), и пять (если у бонуса свои кнопки), а на телефоне
	   они должны сложиться в столбик сами, без отдельных правил под ширину. */
	.actions {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
		gap: var(--space-1);
		margin-top: var(--space-3);
	}

	.actions a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-1);
		padding: var(--space-1) var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-bg);
		color: var(--color-text);
		font-size: var(--font-size-sm);
		transition:
			border-color var(--transition-fast),
			color var(--transition-fast);
	}

	.actions a:hover,
	.actions a:focus-visible {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.arrow {
		color: var(--color-accent);
	}
</style>
