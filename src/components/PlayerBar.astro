---
// Закреплённая панель плеера — единственный экземпляр, живёт в Layout.astro
// на каждой странице (§6.2 ТЗ, макет состояний, блок 07). transition:persist
// (см. Layout.astro и <ClientRouter />) не даёт браузеру пересоздать этот
// <audio> при переходе на другую страницу — именно поэтому звук не прерывается,
// а не какой-то отдельный JS-трюк.
//
// ПОЛОСА ПРОГРЕССА — ЭТО ВЕРХНЯЯ ГРАНИЦА ПАНЕЛИ, а не отдельный элемент над
// ней. Своя линия плюс граница дали бы две линии подряд — то же правило, что
// у секций (§5).
//
// ПОЛОСУ МОЖНО ТАЩИТЬ, и это решение заказчика: сначала она была только
// указателем. Видимая полоса 3, а зона нажатия у ползунка полные 44 — она
// растёт ВВЕРХ, над панелью, и потому не отнимает ни одной кнопки. Как именно
// и чем за это заплачено — в комментарии к `.mini-range` в стилях ниже.
//
// Запускает воспроизведение визуальный плеер на странице выпуска
// (src/components/EpisodePlayer.astro, класс .episode-player) — он несёт данные
// выпуска в data-атрибутах, а сам пересоздаётся заново при каждом переходе
// (в отличие от этого компонента), поэтому слушатели на него навешиваются
// заново каждый раз, см. bindEpisodePlayers() ниже. window.__bakaPlayer —
// общий интерфейс к этому плееру: и .episode-player, и таймкоды
// (src/plugins/remark-timecode.mjs) управляют звуком через него, а не
// напрямую через <audio> — так весь код одного места решает, что считать
// «тем же выпуском» (currentGuid), а что — новой загрузкой.
---

<div id="player-bar" class="miniplayer" hidden transition:persist transition:name="player-bar">
	{/* Полоса видимая 3, а тащить её можно за зону в 44: ползунок лежит поверх,
	    прозрачный, и растёт вверх — над панелью, а не по кнопкам под ней.
	    Подробности и цена — у `.mini-range` в стилях. */}
	<div class="mini-progress">
		<input id="player-range" class="mini-range" type="range" min="0" max="0" step="1" value="0" aria-label="Перемотка" />
		<span class="mini-track" aria-hidden="true"><span id="player-fill" class="mini-fill"></span></span>
	</div>

	<div class="mini-inner">
		<span class="mini-cover">
			<img id="player-cover" alt="" width="44" height="44" />
		</span>

		<span class="mini-copy">
			<a id="player-link" class="mini-title" href="#"></a>
			<span class="mini-time tech">
				<span id="player-time-current">0:00</span> / <span id="player-time-duration">0:00</span>
			</span>
		</span>

		<span class="mini-controls">
			<button id="player-back15" type="button" class="jump-btn" aria-label="Назад на 15 секунд">
				<svg viewBox="0 0 32 32" aria-hidden="true">
					<path d="M10.5 8.2H5.3V3.2"></path>
					<path d="M5.7 8.1A11.3 11.3 0 1 1 5 21.4"></path>
					<text x="16" y="19">15</text>
				</svg>
			</button>

			<button id="player-toggle" type="button" class="play" aria-label="Играть">
				<svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
				<svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true" hidden>
					<rect x="7" y="5" width="4" height="14" rx="1"></rect>
					<rect x="13" y="5" width="4" height="14" rx="1"></rect>
				</svg>
			</button>

			<button id="player-fwd15" type="button" class="jump-btn" aria-label="Вперёд на 15 секунд">
				<svg viewBox="0 0 32 32" aria-hidden="true">
					<path d="M21.5 8.2h5.2V3.2"></path>
					<path d="M26.3 8.1A11.3 11.3 0 1 0 27 21.4"></path>
					<text x="16" y="19">15</text>
				</svg>
			</button>
		</span>

		<span class="speed-wrap">
			<select id="player-rate" class="speed" aria-label="Скорость воспроизведения">
				<option value="0.75">0.75×</option>
				<option value="1" selected>1×</option>
				<option value="1.25">1.25×</option>
				<option value="1.5">1.5×</option>
				<option value="1.75">1.75×</option>
				<option value="2">2×</option>
			</select>
			<span id="player-rate-face" class="speed-face" aria-hidden="true">1×</span>
		</span>

		{/* Крестик рисуем линиями, а не знаком ✕: его нет ни в одной из трёх
		    наших гарнитур, и он уехал бы в системный шрифт. */}
		<button id="player-close" type="button" class="mini-close" aria-label="Закрыть плеер и остановить воспроизведение">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
		</button>
	</div>

	<audio id="player-audio" preload="none"></audio>
</div>

<script>
	const STORAGE_KEY = 'baka-player-state';

	function formatTime(totalSeconds: number): string {
		if (!Number.isFinite(totalSeconds) || totalSeconds < 0) return '0:00';
		const pad = (n: number) => String(n).padStart(2, '0');
		const s = Math.floor(totalSeconds % 60);
		const m = Math.floor(totalSeconds / 60) % 60;
		const h = Math.floor(totalSeconds / 3600);
		return h > 0 ? `${h}:${pad(m)}:${pad(s)}` : `${m}:${pad(s)}`;
	}

	/** Доля проигранного в процентах — ею красится заливка таймлайна. */
	function playedPercent(current: number, total: number): string {
		if (!Number.isFinite(total) || total <= 0) return '0%';
		return `${Math.min(100, Math.max(0, (current / total) * 100))}%`;
	}

	/** Иконка «играть/пауза». Две картинки, а не подмена знака: ⏸ не нарисован
	    ни в одной из трёх наших гарнитур и уехал бы в системный шрифт. */
	function setPlayIcon(button: HTMLElement, playing: boolean) {
		button.querySelector<SVGElement>('.icon-play')?.toggleAttribute('hidden', playing);
		button.querySelector<SVGElement>('.icon-pause')?.toggleAttribute('hidden', !playing);
		button.setAttribute('aria-label', playing ? 'Пауза' : 'Играть');
	}

	function readSavedState(): { guid: string; audio: string; title: string; cover: string; link: string; time: number; rate: number } | null {
		try {
			const raw = localStorage.getItem(STORAGE_KEY);
			return raw ? JSON.parse(raw) : null;
		} catch {
			return null;
		}
	}

	function writeSavedState(state: Record<string, unknown>) {
		try {
			localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
		} catch {
			// приватный режим браузера может запрещать localStorage — просто не запоминаем позицию
		}
	}

	// Однократная настройка: сама панель (#player-bar) пережита через transition:persist,
	// поэтому кнопки внутри неё существуют на странице всегда — навешивать
	// обработчики на них второй раз при следующем переходе не нужно и вредно
	// (дублировались бы клики). Флаг на window переживает клиентскую навигацию.
	function initPlayerOnce() {
		if ((window as any).__bakaPlayerReady) return;
		(window as any).__bakaPlayerReady = true;

		const bar = document.getElementById('player-bar') as HTMLDivElement;
		const audio = document.getElementById('player-audio') as HTMLAudioElement;
		const link = document.getElementById('player-link') as HTMLAnchorElement;
		const cover = document.getElementById('player-cover') as HTMLImageElement;
		const toggle = document.getElementById('player-toggle') as HTMLButtonElement;
		const back15 = document.getElementById('player-back15') as HTMLButtonElement;
		const fwd15 = document.getElementById('player-fwd15') as HTMLButtonElement;
		const fill = document.getElementById('player-fill') as HTMLSpanElement;
		const range = document.getElementById('player-range') as HTMLInputElement;
		const timeCurrent = document.getElementById('player-time-current') as HTMLSpanElement;
		const timeDuration = document.getElementById('player-time-duration') as HTMLSpanElement;
		const rateSelect = document.getElementById('player-rate') as HTMLSelectElement;
		const rateFace = document.getElementById('player-rate-face') as HTMLSpanElement;
		const close = document.getElementById('player-close') as HTMLButtonElement;

		let currentGuid: string | null = null;
		// Виден ли сейчас развёрнутый плеер той же записи. Пока виден, панель
		// не показывается: два одинаковых набора кнопок на одном экране —
		// это выбор без разницы, читатель не понимает, какой из них главный.
		let mainPlayerVisible = false;
		let observer: IntersectionObserver | null = null;
		// Кто из блоков сейчас на экране. Множество, а не флаг: блоков бывает
		// несколько, и «виден хоть один» — это их сумма, а не ответ последнего.
		const видимыеБлоки = new Set<Element>();

		function updateBar() {
			const shouldShow = Boolean(currentGuid) && !mainPlayerVisible;
			bar.hidden = !shouldShow;
			document.body.classList.toggle('has-player', shouldShow);
		}

		// Пересчитывается при каждом переходе между страницами: панель переживает
		// переход, а блоки на странице — нет, и наблюдать надо за новыми.
		//
		// БЛОКОВ ТЕПЕРЬ БЫВАЕТ НЕСКОЛЬКО, И ЭТО ГЛАВНАЯ ПРАВКА ЗДЕСЬ. Раньше
		// спрашивался ОДИН — `querySelector('.episode-player')`, первый на
		// странице. Пока плеер на странице был один, разницы не было; с врезками
		// на материалы на одной странице легко сходятся развёрнутый плеер выпуска
		// и мини-плеер врезки на другой выпуск, а то и два мини-плеера подряд.
		// Первый найденный оказался бы не тем, за кем надо следить, и панель
		// пряталась бы или показывалась невпопад.
		//
		// ПАНЕЛЬ СКРЫТА, ПОКА ВИДЕН ХОТЬ ОДИН блок того же выпуска: показывать
		// её рядом с блоком, где те же кнопки, — это выбор без разницы, читатель
		// не понимает, какой из них главный. Ушли все за край экрана — панель
		// появилась, и звуком по-прежнему можно управлять.
		function watchMainPlayer() {
			observer?.disconnect();
			observer = null;
			видимыеБлоки.clear();
			mainPlayerVisible = false;

			const блоки = [...document.querySelectorAll<HTMLElement>('[data-episode-card]')].filter(
				(блок) => currentGuid && блок.dataset.guid === currentGuid,
			);

			if (блоки.length > 0) {
				// До первого ответа наблюдателя считаем блок видимым: обычный
				// случай — человек только что нажал на нём play, значит блок
				// перед глазами. Иначе панель успевала бы мигнуть и спрятаться.
				mainPlayerVisible = true;
				observer = new IntersectionObserver((entries) => {
					for (const запись of entries) {
						if (запись.isIntersecting) видимыеБлоки.add(запись.target);
						else видимыеБлоки.delete(запись.target);
					}
					mainPlayerVisible = видимыеБлоки.size > 0;
					updateBar();
				});
				for (const блок of блоки) observer.observe(блок);
			}

			updateBar();
		}

		function saveState() {
			if (!currentGuid) return;
			writeSavedState({
				guid: currentGuid,
				audio: audio.src,
				title: link.textContent ?? '',
				cover: cover.src,
				link: link.href,
				time: audio.currentTime,
				rate: audio.playbackRate,
			});
		}

		function clearSavedState() {
			try {
				localStorage.removeItem(STORAGE_KEY);
			} catch {
				// приватный режим браузера — и так нечего чистить
			}
		}

		// Загружает выпуск в плеер. Если это уже играющий выпуск — просто
		// перематывает (не сбрасывая на 0), иначе подставляет новый источник.
		// seekSeconds задаётся кликом по таймкоду в тексте; без него — обычный
		// запуск (с сохранённой позиции, если она была, иначе с начала).
		function loadEpisode(data: DOMStringMap, seekSeconds?: number) {
			const { guid, audio: audioUrl, title: episodeTitle, cover: coverUrl, link: linkUrl } = data;
			if (!guid || !audioUrl) return;

			link.textContent = episodeTitle ?? '';
			if (coverUrl) cover.src = coverUrl;
			if (linkUrl) link.href = linkUrl;

			if (guid === currentGuid) {
				if (typeof seekSeconds === 'number') audio.currentTime = seekSeconds;
				audio.play();
				return;
			}

			currentGuid = guid;
			audio.src = audioUrl;
			setState('loading');
			watchMainPlayer();

			const saved = readSavedState();
			// Скорость — это скорее общая привычка слушателя, чем свойство конкретного
			// выпуска, поэтому применяем последнюю сохранённую при любом новом запуске.
			audio.playbackRate = saved?.rate || 1;
			const resumeAt = typeof seekSeconds === 'number' ? seekSeconds : saved && saved.guid === guid ? saved.time : 0;

			// play() — синхронно, в том же тике клика, иначе браузер перестаёт
			// считать вызов частью действия пользователя и молча блокирует звук
			// (то самое «жмёшь плей — ничего не происходит, жмёшь ещё раз — играет»).
			// Перемотку на сохранённую позицию делаем отдельно, когда придут
			// метаданные — звук уже идёт, просто короткий скачок позиции.
			audio.play();
			if (resumeAt > 0) {
				const onLoaded = () => {
					audio.currentTime = resumeAt;
					audio.removeEventListener('loadedmetadata', onLoaded);
				};
				audio.addEventListener('loadedmetadata', onLoaded);
			}
		}

		// Три состояния развёрнутого плеера из справочника (блок 01). Панель
		// внизу их не показывает: у неё нет ни таймлайна, ни места под текст
		// ошибки, а состояние всё равно видно на странице выпуска.
		//
		// ЗДЕСЬ НАРОЧНО КЛАСС, А НЕ ПРИЗНАК `data-episode-card`. Речь о плашке
		// «не удалось загрузить», а она есть только у развёрнутого плеера:
		// у мини-плеера во врезке места под текст ошибки нет — как и у панели.
		// Спроси мы тут признак, врезка получала бы классы состояния, которые
		// ничего не рисуют, и следующий пошёл бы искать, почему они не видны.
		function setState(state: 'ready' | 'loading' | 'error') {
			document.querySelectorAll<HTMLElement>('.episode-player').forEach((card) => {
				const own = card.dataset.guid === currentGuid;
				card.classList.toggle('is-loading', own && state === 'loading');
				const failed = own && state === 'error';
				card.classList.toggle('is-error', failed);
				card.querySelector<HTMLElement>('.ep-live')?.toggleAttribute('hidden', failed);
				card.querySelector<HTMLElement>('.ep-error')?.toggleAttribute('hidden', !failed);
			});
		}

		let scrubbing = false;

		toggle.addEventListener('click', () => {
			if (audio.paused) audio.play();
			else audio.pause();
		});

		// Пока тащат ползунок, время и заливку рисуем по нему, а не по звуку:
		// иначе они спорили бы друг с другом под рукой.
		range.addEventListener('input', () => {
			scrubbing = true;
			timeCurrent.textContent = formatTime(Number(range.value));
			fill.style.width = playedPercent(Number(range.value), Number(range.max));
		});
		range.addEventListener('change', () => {
			audio.currentTime = Number(range.value);
			scrubbing = false;
		});

		back15.addEventListener('click', () => {
			audio.currentTime = Math.max(0, audio.currentTime - 15);
		});

		fwd15.addEventListener('click', () => {
			audio.currentTime = Math.min(audio.duration || Infinity, audio.currentTime + 15);
		});

		rateSelect.addEventListener('change', () => {
			// Событие ratechange от audio ниже само обновит rateSelect.value —
			// в том числе у всех .episode-player на странице, см. bindEpisodePlayers().
			audio.playbackRate = Number(rateSelect.value);
		});

		// ЗАКРЫТЬ ПАНЕЛЬ — ЭТО ОСТАНОВИТЬ ЗВУК, а не спрятать кнопки. Панель —
		// единственный способ управлять воспроизведением на других страницах,
		// и оставить играющий подкаст без органов управления нельзя.
		// currentGuid обнуляем до audio.pause(), чтобы обработчик pause ниже
		// не успел заново сохранить позицию в тот же момент, когда мы её стираем.
		close.addEventListener('click', () => {
			currentGuid = null;
			audio.pause();
			audio.removeAttribute('src');
			audio.load();
			clearSavedState();
			observer?.disconnect();
			observer = null;
			updateBar();
			// Не все браузеры гарантированно шлют своё событие pause синхронно —
			// досылаем вручную, чтобы .episode-player на странице (см. ниже) сразу
			// сбросили свой вид на «не запущено», а не остались висеть с иконкой паузы.
			audio.dispatchEvent(new Event('pause'));
		});

		audio.addEventListener('play', () => setPlayIcon(toggle, true));
		audio.addEventListener('pause', () => {
			setPlayIcon(toggle, false);
			saveState();
		});
		audio.addEventListener('loadedmetadata', () => {
			range.max = String(Math.floor(audio.duration || 0));
			timeDuration.textContent = formatTime(audio.duration);
		});
		audio.addEventListener('ratechange', () => {
			rateSelect.value = String(audio.playbackRate);
			rateFace.textContent = rateSelect.options[rateSelect.selectedIndex]?.text ?? '1×';
			saveState();
		});
		audio.addEventListener('timeupdate', () => {
			if (!scrubbing) {
				range.value = String(Math.floor(audio.currentTime));
				timeCurrent.textContent = formatTime(audio.currentTime);
				fill.style.width = playedPercent(audio.currentTime, audio.duration);
			}
			// Пишем в localStorage не на каждый тик (несколько раз в секунду),
			// а примерно раз в 5 секунд — достаточно для восстановления позиции.
			if (Math.floor(audio.currentTime) % 5 === 0) saveState();
		});

		// Состояния загрузки и ошибки.
		//
		// ПРОВЕРКА ОШИБКИ НАРОЧНО ПРИДИРЧИВАЯ. Событие `error` у <audio> приходит
		// не только когда всё пропало: браузер шлёт его и на прерванную загрузку
		// (мы сами снимаем src при закрытии панели), и на неудачную первую попытку,
		// после которой он спокойно берёт файл со второго раза, — а выпуск при
		// этом играет. Показанная в такой момент плашка «не удалось загрузить»
		// прямо врёт читателю поверх работающего плеера, и это уже случилось.
		//
		// Поэтому ошибку признаём, только если сошлось всё сразу: выпуск выбран,
		// элемент правда в состоянии ошибки, ошибка не «прервано», и играть
		// при этом нечего — данных не набралось совсем.
		audio.addEventListener('waiting', () => setState('loading'));
		audio.addEventListener('playing', () => setState('ready'));
		audio.addEventListener('canplay', () => setState('ready'));
		audio.addEventListener('loadedmetadata', () => setState('ready'));
		audio.addEventListener('error', () => {
			if (!currentGuid) return;
			const code = audio.error?.code;
			if (!code || code === MediaError.MEDIA_ERR_ABORTED) return;
			if (audio.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) return;
			setState('error');
		});

		// Подстраховка: если вкладку закрыли или перезагрузили во время
		// воспроизведения, событие pause выше может не успеть сработать.
		window.addEventListener('beforeunload', saveState);

		(window as any).__bakaPlayer = {
			load: loadEpisode,
			audio,
			getGuid: () => currentGuid,
			watchMainPlayer,
		};
	}

	// Визуальный плеер на странице выпуска (.episode-player, см.
	// src/components/EpisodePlayer.astro) — часть обычной страницы поста,
	// пересоздаётся заново при каждом переходе (в отличие от самой панели),
	// поэтому слушатели на него навешиваем каждый раз без защиты от
	// повтора. Может показывать выпуск, который сейчас не играет в панели
	// (например, открыли другой пост, пока что-то уже слушали) — тогда его
	// кнопки управляют не звуком напрямую, а запускают этот выпуск через load().
	function bindEpisodePlayers() {
		const api = (window as any).__bakaPlayer as
			| { load: (data: DOMStringMap, seekSeconds?: number) => void; audio: HTMLAudioElement; getGuid: () => string | null }
			| undefined;
		if (!api) return;

		// ПО ПРИЗНАКУ, А НЕ ПО ИМЕНИ КЛАССА. Таких блоков на сайте двое:
		// развёрнутый плеер страницы выпуска (EpisodePlayer.astro) и мини-плеер
		// внутри врезки на материал (src/plugins/remark-post-ref.mjs). Третий
		// появится — впишет себе тот же признак и заработает, не трогая этот файл.
		document.querySelectorAll<HTMLElement>('[data-episode-card]').forEach((card) => {
			const guid = card.dataset.guid;
			if (!guid) return;

			const toggle = card.querySelector<HTMLButtonElement>('.ep-toggle');
			const back15 = card.querySelector<HTMLButtonElement>('.ep-back15');
			const fwd15 = card.querySelector<HTMLButtonElement>('.ep-fwd15');
			const range = card.querySelector<HTMLInputElement>('.ep-range');
			const rateSelect = card.querySelector<HTMLSelectElement>('.ep-rate');
			const rateFace = card.querySelector<HTMLElement>('.speed-face');
			const timeCurrent = card.querySelector<HTMLSpanElement>('.ep-time-current');
			const timeDuration = card.querySelector<HTMLSpanElement>('.ep-time-duration');
			// ОБЯЗАТЕЛЬНЫ ТРОЕ, ОСТАЛЬНЫЕ НЕТ — и это не послабление, а разница
			// между блоками. У мини-плеера во врезке нет ни перемотки ±15,
			// ни выбора скорости: это врезка посреди статьи, а не страница
			// выпуска, и семь целей в ней были бы промахами пальцем. Кнопка,
			// дорожка и текущее время есть у обоих — без них блок не плеер вовсе,
			// и такой блок мы не подключаем, а не «подключаем наполовину».
			if (!toggle || !range || !timeCurrent) return;

			const { audio } = api;
			const isActive = () => api.getGuid() === guid;
			let scrubbing = false;

			const paint = (current: number, total: number) => {
				range.style.setProperty('--played', playedPercent(current, total));
			};

			// Пока выпуск ещё не запущен, показываем длительность из RSS (если она
			// известна) вместо «0:00» — так плеер не выглядит сломанным до клика.
			const fallbackDuration = Number(card.dataset.duration || 0);
			if (fallbackDuration > 0) {
				range.max = String(Math.floor(fallbackDuration));
				if (timeDuration) timeDuration.textContent = formatTime(fallbackDuration);
			}

			toggle.addEventListener('click', () => {
				if (isActive()) {
					if (audio.paused) audio.play();
					else audio.pause();
				} else {
					api.load(card.dataset);
				}
			});

			back15?.addEventListener('click', () => {
				if (isActive()) audio.currentTime = Math.max(0, audio.currentTime - 15);
			});

			fwd15?.addEventListener('click', () => {
				if (isActive()) audio.currentTime = Math.min(audio.duration || Infinity, audio.currentTime + 15);
			});

			range.addEventListener('input', () => {
				scrubbing = true;
				timeCurrent.textContent = formatTime(Number(range.value));
				paint(Number(range.value), Number(range.max));
			});
			range.addEventListener('change', () => {
				if (isActive()) audio.currentTime = Number(range.value);
				else api.load(card.dataset, Number(range.value));
				scrubbing = false;
			});

			rateSelect?.addEventListener('change', () => {
				if (isActive()) audio.playbackRate = Number(rateSelect.value);
				if (rateFace) rateFace.textContent = rateSelect.options[rateSelect.selectedIndex]?.text ?? '1×';
			});

			// Слушатели навешаны на общий <audio> (см. описание компонента выше),
			// а плеер при переходе на другую страницу исчезает вместе с DOM —
			// сам снимает с себя эти слушатели, как только заметит, что его больше
			// нет на странице, а не копится молча до следующей перезагрузки.
			const sync = () => {
				if (!document.body.contains(card)) {
					audio.removeEventListener('play', sync);
					audio.removeEventListener('pause', sync);
					audio.removeEventListener('timeupdate', sync);
					audio.removeEventListener('loadedmetadata', sync);
					audio.removeEventListener('ratechange', sync);
					return;
				}

				if (!isActive()) {
					// Раньше был активным (играл именно этот выпуск), а теперь панель
					// закрыли или переключили на другой — сбрасываем плеер в исходный
					// вид, а не оставляем последнюю иконку и время висеть.
					setPlayIcon(toggle, false);
					if (!scrubbing) {
						range.value = '0';
						timeCurrent.textContent = '0:00';
						paint(0, 1);
					}
					return;
				}

				setPlayIcon(toggle, !audio.paused);
				if (rateSelect) {
					rateSelect.value = String(audio.playbackRate);
					if (rateFace) rateFace.textContent = rateSelect.options[rateSelect.selectedIndex]?.text ?? '1×';
				}
				if (audio.duration) {
					range.max = String(Math.floor(audio.duration));
					if (timeDuration) timeDuration.textContent = formatTime(audio.duration);
				}
				if (!scrubbing) {
					range.value = String(Math.floor(audio.currentTime));
					timeCurrent.textContent = formatTime(audio.currentTime);
					paint(audio.currentTime, audio.duration || Number(range.max));
				}
			};

			audio.addEventListener('play', sync);
			audio.addEventListener('pause', sync);
			audio.addEventListener('timeupdate', sync);
			audio.addEventListener('loadedmetadata', sync);
			audio.addEventListener('ratechange', sync);

			sync();
		});
	}

	// ЕДИНСТВЕННЫЙ НА ВЕСЬ САЙТ ОБРАБОТЧИК НАЖАТИЙ НА ТАЙМКОД. Их два вида —
	// метки времени в тексте выпуска (src/plugins/remark-timecode.mjs) и строки
	// блока таймкодов (src/components/TimecodeList.astro), — и оба носят класс
	// `timecode` с `data-seconds` ровно затем, чтобы второй копии этого кода
	// не появилось. Заведи блок свой обработчик — нажатие сработало бы дважды.
	//
	// Куда перематывать, решает не этот код, а страница: если на ней есть
	// управляемый ролик, она выставляет `__bakaYouTube` (см. posts/[slug].astro).
	// Так обработчику не нужно знать ни про категории материала, ни про то,
	// какие плееры вообще бывают.
	function bindTimecodes() {
		const api = (window as any).__bakaPlayer as { load: (data: DOMStringMap, seekSeconds?: number) => void } | undefined;

		document.querySelectorAll<HTMLElement>('.timecode').forEach((link) => {
			link.addEventListener('click', (event) => {
				const seconds = Number(link.dataset.seconds);
				if (!Number.isFinite(seconds)) return;

				const youtube = (window as any).__bakaYouTube as { seek: (seconds: number) => void } | undefined;
				if (youtube) {
					event.preventDefault();
					youtube.seek(seconds);
					return;
				}

				// И ЗДЕСЬ НАРОЧНО КЛАСС, А НЕ ПРИЗНАК. Таймкод перематывает выпуск
				// ЭТОЙ страницы, а не тот, на который посреди текста стоит врезка:
				// нажатие на «12:04» в расшифровке обязано двигать расшифровку.
				// Спроси мы признак — таймкод мог бы попасть в чужой мини-плеер,
				// и перемотался бы не тот выпуск, причём молча.
				const card = document.querySelector<HTMLElement>('.episode-player');

				// ПЕРЕХОД ОТМЕНЯЕМ ТОЛЬКО ТОГДА, КОГДА ПРАВДА ЕСТЬ ЧТО ПЕРЕМОТАТЬ.
				// Раньше отмена стояла первой строкой, и на странице тайтла это
				// убивало ссылки «обсуждали в выпуске на 12:04»: перематывать там
				// нечего, плеера на странице нет, — нажатие отменялось и никуда
				// не вело. Такой таймкод обязан просто открыть выпуск на нужной
				// минуте, как обычная ссылка.
				if (!api || !card) return;

				event.preventDefault();
				api.load(card.dataset, seconds);
			});
		});
	}

	document.addEventListener('astro:page-load', () => {
		initPlayerOnce();
		bindEpisodePlayers();
		bindTimecodes();
		// Страница сменилась — развёрнутый плеер на ней другой (или его нет),
		// значит и решение «показывать ли панель» надо принять заново.
		(window as any).__bakaPlayer?.watchMainPlayer?.();
	});

	// ПАНЕЛЬ ОБЪЯВЛЯЕТ СЕБЯ СРАЗУ, А НЕ ВНУТРИ ОБРАБОТЧИКА ЗАГРУЗКИ СТРАНИЦЫ.
	//
	// `window.__bakaPlayer` — это дверь, через которую расшифровка узнаёт,
	// что звук вообще есть: нет двери — плашки времени гасятся, кнопка
	// «Следить за плеером» не показывается, нажатие на реплику не перематывает
	// (`Transcript.astro`, «Плеера на странице может не быть вовсе»).
	//
	// Пока дверь открывалась ТОЛЬКО внутри `astro:page-load`, всё решал порядок
	// обработчиков, а он равен порядку тегов `<script>` на странице. В собранной
	// странице выпуска расшифровка идёт ПЕРЕД панелью — значит на ПЕРВОЙ
	// загрузке она спрашивала плеер раньше, чем тот объявлялся, и оставалась
	// мёртвой. При хождении по сайту беды не видно: переходы идут без
	// перезагрузки, дверь висит на `window` и переживает их, поэтому вторая
	// и все следующие страницы работают. Ломается ровно та, которую открыли
	// первой, — по ссылке из мессенджера, из поиска, из письма.
	//
	// Модули исполняются ПОСЛЕ разбора разметки и ДО `astro:page-load`, а сама
	// панель стоит в макете на каждой странице — значит здесь она уже есть,
	// и открывать дверь можно прямо сейчас. Вызов внутри обработчика оставлен:
	// он защищён своим флагом и второй раз ничего не делает.
	//
	// Проверяется `node scripts/transcript-player-order.test.mjs` на НАСТОЯЩИХ
	// собранных скриптах; `--selftest` меняет порядок и обязан покраснеть.
	initPlayerOnce();
</script>

<style>
	.miniplayer {
		position: fixed;
		z-index: 60;
		left: 0;
		right: 0;
		bottom: 0;
		background: var(--paper);
		border-top: 1px solid var(--line);
	}

	/* [hidden] и .miniplayer одинаково «весомы» для браузера (оба — один
	   селектор), а объявлено это в CSS позже — без этого правила панель была бы
	   видна всегда, атрибут hidden ничего не перебивал бы. */
	.miniplayer[hidden] {
		display: none;
	}

	/* Полоса ложится ровно на верхнюю границу панели и заменяет её собой:
	   двух линий подряд тут быть не должно. */
	.mini-progress {
		position: absolute;
		top: -1px;
		left: 0;
		right: 0;
		height: 3px;
	}

	.mini-track {
		position: absolute;
		inset: 0;
		background: var(--line);
		pointer-events: none;
	}

	.mini-fill {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 0;
		background: var(--accent-brand);
	}

	/* Ручка едет вместе с концом заливки — считать её положение отдельно
	   не нужно, а значит и разъехаться им не с чем. */
	.mini-fill::after {
		content: '';
		position: absolute;
		right: -7px;
		top: 50%;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--accent-brand);
		transform: translateY(-50%);
	}

	/* Прозрачный ползунок поверх полосы: видно дорожку, а тащат его.
	   Выше своей дорожки нарочно — 3 пикселя пальцем не взять.

	   ЗОНА 44, И РАСТЁТ ОНА ВВЕРХ, А НЕ ВНИЗ. Накладкой `::after`, как у кнопок
	   ±15, тут не обойтись: ползунок надо ТАЩИТЬ, а накладка поверх перехватила
	   бы перетаскивание и он умер бы совсем. Значит расти должен сам `input`,
	   прозрачными полями — видимая полоса остаётся тонкой.

	   Растёт НЕСИММЕТРИЧНО. Внутрь панели уходит 10 px — ровно её верхнее поле
	   на узком экране (на широком там 12), поэтому кнопок, обложки и названия
	   зона не задевает вовсе, и все шесть целей панели остаются по 44.
	   Остальные 34 ложатся над панелью: там пусто. Цена названа заказчику
	   и принята 10 августа 2026 — полоса 34 px над панелью перехватывает
	   нажатия и свайпы у того, что проезжает под ней при прокрутке, пока
	   панель открыта.

	   Отсчёт от `.mini-progress` (высота 3, стоит на `top: -1`): её нижний край
	   на 2 px ниже границы панели, значит `bottom: -8` даёт край зоны на 10 px
	   внутри панели, а `height: 44` поднимает верх на 34 px над ней. */
	.mini-range {
		appearance: none;
		-webkit-appearance: none;
		position: absolute;
		left: 0;
		right: 0;
		bottom: -8px;
		z-index: 1;
		width: 100%;
		height: 44px;
		margin: 0;
		opacity: 0;
		background: transparent;
		cursor: pointer;
	}

	/* Сам ползунок прозрачный, поэтому фокус показывает видимая дорожка. */
	.mini-range:focus-visible ~ .mini-track {
		outline: 2px solid var(--accent-text);
		outline-offset: 2px;
	}

	.mini-inner {
		width: 100%;
		max-width: var(--site);
		margin-inline: auto;
		padding: 10px var(--gutter);
		display: grid;
		grid-template-columns: 44px minmax(0, 1fr) auto auto;
		align-items: center;
		gap: var(--sp-3);
	}

	/* Плашки за картинкой нет — та же причина, что в PostMedia.astro:
	   обложка выпуска это вырезанный персонаж на прозрачном фоне. */
	.mini-cover {
		width: 44px;
		height: 44px;
		display: grid;
		place-items: center;
		overflow: hidden;
	}

	.mini-cover img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.mini-copy {
		min-width: 0;
	}

	/* Одна строка с обрезкой: панель не должна расти в высоту от длинного
	   названия — вместе с ней подпрыгивала бы вся страница под ней. */
	.mini-title {
		display: block;
		font-family: var(--font-display);
		font-size: var(--body-md);
		line-height: 1.2;
		color: var(--ink);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.mini-title:hover,
	.mini-title:focus-visible {
		color: var(--accent-text);
	}

	.mini-time {
		display: block;
		margin-top: 2px;
		letter-spacing: 0.04em;
		text-transform: none;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.mini-controls {
		display: flex;
		align-items: center;
		gap: var(--sp-2);
	}

	/* Круглая кнопка в панели меньше, чем на странице: 44 — это цель целиком,
	   а не «уменьшили и ладно». */
	.miniplayer .play {
		width: 44px;
		height: 44px;
	}

	.miniplayer .play svg {
		width: 16px;
		height: 16px;
	}

	/* До 621 в панели остаются обложка, название, пауза и закрыть. Семь целей
	   в полосе высотой 64 — это промахи пальцем; перемотка и скорость всё равно
	   есть на самой странице выпуска. */
	.miniplayer .jump-btn,
	.miniplayer .speed-wrap {
		display: none;
	}

	.mini-close {
		width: 44px;
		height: 44px;
		display: grid;
		place-items: center;
		border: 0;
		background: transparent;
		color: var(--muted);
	}

	.mini-close svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
	}

	.mini-close:hover,
	.mini-close:focus-visible {
		color: var(--ink);
	}

	@media (min-width: 621px) {
		.mini-inner {
			grid-template-columns: 44px minmax(0, 1fr) auto auto auto;
			gap: var(--sp-4);
			padding: 12px var(--gutter);
		}

		.miniplayer .jump-btn {
			display: grid;
		}

		.miniplayer .speed-wrap {
			display: inline-grid;
		}

		.mini-copy {
			display: flex;
			align-items: baseline;
			gap: var(--sp-4);
		}

		.mini-time {
			margin-top: 0;
			white-space: nowrap;
		}
	}
</style>

<style is:global>
	/* Панель перекрывает низ страницы — освобождаем место под ней, иначе она
	   закрывает подвал и конец текста. */
	body.has-player {
		padding-bottom: 76px;
	}

	@media (min-width: 621px) {
		body.has-player {
			padding-bottom: 80px;
		}
	}
</style>
