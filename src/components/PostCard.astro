---
import { categories } from '../content.config';
import { getYoutubeThumbnailUrl } from '../lib/youtube.mjs';
import { getPostTiming } from '../lib/postTiming.mjs';
import { coverSrcs } from '../lib/postImage.mjs';

interface Props {
	post: { id: string; body?: string; data: Record<string, any> };
}

const { post } = Astro.props;
const { title, date, category, cover, noCover, youtube, video } = post.data;

const categoryLabel = categories.find((c) => c.id === category)?.label ?? category;

const dateFormatter = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });

function excerpt(text: string | undefined, length = 140) {
	if (!text) return '';
	const plain = text
		.replace(/!\[[^\]]*\]\([^)]*\)/g, '')
		.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
		.replace(/[#>*_`~-]/g, '')
		.replace(/\s+/g, ' ')
		.trim();
	return plain.length > length ? `${plain.slice(0, length).trim()}…` : plain;
}

// Галочка «Без обложки» перебивает всё: и саму обложку, и кадр с ютюба.
// Это осознанный выбор автора — короткая заметка должна выглядеть заголовком
// в строку, а не карточкой с картинкой. Отличается от «обложка не задана»:
// там картинку просто не выбрали, и кадр с ютюба остаётся уместным.
const coverImage = noCover ? null : coverSrcs(cover);
const youtubeThumbnail = !noCover && youtube ? getYoutubeThumbnailUrl(youtube) : null;
const isVideo = Boolean(youtubeThumbnail || (video && !noCover));

// «Сколько это займёт» — время чтения у постов, длительность у выпусков
// и видеоэссе. Что именно, решает src/lib/postTiming.mjs, тот же файл зовёт
// и страница поста. null = показывать нечего, причины перечислены там же.
const timing = await getPostTiming(post);
---

{/*
	Карточка — <article> со ссылкой внутри, а не одна большая ссылка, как было
	раньше. Причина: странице тайтла нужно дописать в карточку выпуска строку
	«обсуждали в выпуске на 12:04, 34:20» с кликабельными таймкодами (тз/05,
	шаг 5), а вложить ссылку в ссылку нельзя — браузер такую разметку чинит
	по-своему и часть ссылок просто перестаёт работать. Всё, что кликается
	отдельно, уходит в <slot /> за пределы ссылки на пост.
*/}
<article class="card">
	<a class="card-link" href={`/posts/${post.id}/`}>
		{
			coverImage ? (
				<img
					class="media"
					src={coverImage.src}
					srcset={coverImage.srcset}
					sizes="(max-width: 700px) 100vw, 400px"
					alt=""
					loading="lazy"
					width="800"
					height="450"
				/>
			) : youtubeThumbnail ? (
				<span class="media-wrap">
					<img class="media" src={youtubeThumbnail} alt="" loading="lazy" width="480" height="360" />
					<span class="play" aria-hidden="true">
						▶
					</span>
				</span>
			) : video ? (
				<span class="media video-placeholder" aria-hidden="true">
					▶ Видео
				</span>
			) : null
		}
		<div class="body">
			<span class="category">{categoryLabel}</span>
			<h3 class="title">{title}</h3>
			<span class="date">
				{dateFormatter.format(date)}
				{timing && <span class="timing">{timing.label}</span>}
			</span>
			{!coverImage && !isVideo && <p class="excerpt">{excerpt(post.body)}</p>}
		</div>
	</a>
	<slot />
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		background: var(--color-bg-elevated);
		border-radius: var(--radius-md);
		overflow: hidden;
		border: 1px solid var(--color-border);
		transition: border-color var(--transition-fast);
	}

	/* focus-within, а не focus-visible: рамку теперь носит <article>,
	   а фокус попадает на ссылку внутри него. */
	.card:hover,
	.card:focus-within {
		border-color: var(--color-accent);
	}

	.card-link {
		display: flex;
		flex-direction: column;
		color: var(--color-text);
	}

	.card-link:hover,
	.card-link:focus-visible {
		color: var(--color-text);
	}

	.media,
	.media-wrap :global(.media) {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.media-wrap {
		position: relative;
		display: block;
	}

	.play {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: var(--font-size-xl);
		color: #fff;
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
	}

	.video-placeholder {
		aspect-ratio: 16 / 9;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-bg);
		color: var(--color-text-muted);
		font-size: var(--font-size-lg);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-2);
	}

	.category {
		color: var(--color-accent);
		font-size: var(--font-size-sm);
	}

	.title {
		margin: 0;
		font-size: var(--font-size-lg);
	}

	.date {
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
	}

	/* Точка-разделитель нарисована псевдоэлементом, а не вписана в текст:
	   у коротких постов и у видеоэссе без аудиоверсии метки нет, и висящая
	   точка после даты выглядела бы опечаткой. */
	.timing::before {
		content: '·';
		margin: 0 0.35em;
	}

	.excerpt {
		color: var(--color-text-muted);
		margin: var(--space-1) 0 0;
	}
</style>
