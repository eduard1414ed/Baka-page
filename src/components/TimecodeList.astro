---
// Оглавление выпуска или видеоэссе (тз/08, раздел 9.3).
//
// УСТРОЕН КАК ВРЕЗКА, а не как таблица и не как плитки: линии сверху и снизу
// всего блока, слева технический столбец, справа текст. Своих рамок у строк
// нет — плиток в языке сайта не бывает (§5 дизайн-системы).
//
// ВИД ВРЕЗКИ ОБЩИЙ С БЛОКОМ ССЫЛОК (`.inset-list` в global.css). Своего
// описания у оглавления было ровно одну сессию, и за неё они успели разъехаться
// отступами и высотой строки — заказчик увидел это раньше проверки.
//
// ЦЕЛЬ НАЖАТИЯ МЕНЬШЕ 44×44, И ЭТО РЕШЕНИЕ ЗАКАЗЧИКА. ТЗ требовало набрать 44
// отступами, но на живой странице строки разъехались так, что список перестал
// читаться оглавлением. Врезка со ссылками — то же исключение, и теперь они
// заодно: две врезки на одной странице обязаны выглядеть одинаково.
//
// РАЗБОРА ТУТ ТОЖЕ НЕТ: строки приходят готовыми. Правила разбора живут
// в src/lib/timecode.mjs, потому что тем же разбором будет пользоваться разовый
// скрипт по архиву — две копии правил разошлись бы молча.
//
// ВТОРОЙ МЕХАНИКИ ПЕРЕМОТКИ ТУТ НЕТ. Строка получает класс `timecode`
// и `data-seconds` — ровно то же, что метка времени в тексте выпуска, —
// и её подхватывает единственный на весь сайт обработчик нажатий
// в src/components/PlayerBar.astro (bindTimecodes). Появись у блока свой
// обработчик, нажатие обрабатывалось бы дважды.
import type { TimecodeRow } from '../lib/timecode.mjs';

interface Props {
	/** Готовые строки — их разобрал `parseTimecodeList` на странице. */
	rows: TimecodeRow[];
	/**
	 * Перематывать ролик, а не аудиоплеер (видеоэссе). Решает страница —
	 * она одна знает категорию материала; блок только передаёт это скрипту
	 * меткой на себе, чтобы тому не пришлось знать про категории вовсе.
	 */
	seekYoutube?: boolean;
}

const { rows, seekYoutube = false } = Astro.props;
---

{
	rows.length > 0 && (
		<section class="timecodes" aria-labelledby="timecodes-title">
			{/* Подпись НАД линией блока — как у аудиоверсии над плеером.
			    Класс общий: подпись блока в тексте материала обязана выглядеть
			    одинаково, где бы ни стояла. Скобки рисует CSS (global.css),
			    руками их тут писать не надо — иначе выйдут двойные. */}
			<h2 class="body-label tech" id="timecodes-title">
				таймкоды
			</h2>

			{/* Вид врезки — общий с блоком ссылок (`.inset-list` в global.css).
			    Список, а не набор абзацев: это оглавление, и диктор должен
			    назвать, сколько в нём пунктов. Блок НЕ сворачивается, сколько
			    бы тем ни было: прятать половину оглавления значит отменять
			    его смысл. */}
			<ol class="inset-list timecodes-rows">
				{rows.map((row) => (
					<li>
						{/* Кнопка, а не ссылка: никуда не ведёт, а перематывает.
						    Кликается ВСЯ СТРОКА — промахнуться мимо восьми
						    символов времени легко, мимо строки нет. */}
						<button type="button" class="timecode inset-row tc-row" data-seconds={row.seconds}>
							{/* Само время в поиск не идёт: в цитате выдачи столбик
							    чисел читается мусором. Тема остаётся — это текст
							    материала, и раньше она была в теле выпуска. */}
							<span class="tc-time" data-pagefind-ignore>
								{row.time}
							</span>
							<span class="tc-theme">{row.title}</span>
						</button>
					</li>
				))}
			</ol>
		</section>
	)
}

<style>
	.timecodes {
		width: 100%;
		max-width: var(--reading);
		margin: var(--sp-12) auto 0;
	}

	/* Столбец времени уже, чем столбец названий площадок у второй врезки:
	   ширина держится переменной ровно затем, чтобы это различие не стало
	   вторым описанием строки целиком. */
	.timecodes-rows {
		--inset-col: 72px;
		/* Своё поле у списка убираем: отступы блока задаёт `.inset-list`.
		   `margin` сокращённой записью не пишем — она сбросила бы боковые
		   поля, которыми врезка центрируется. */
		margin-block: 0;
		padding-inline: 0;
		list-style: none;
	}

	/* Сброс кнопки. Гарнитуру наследуем, а кегль и интерлиньяж НЕ трогаем:
	   их задаёт `.inset-row`, и сокращённая запись `font` сбила бы их
	   вместе с гарнитурой. */
	.tc-row {
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font-family: inherit;
		text-align: left;
		cursor: pointer;
	}

	.tc-time {
		font-family: var(--font-tech);
		font-size: var(--technical);
		letter-spacing: 0.08em;
		/* Цифры одной ширины: иначе столбец гуляет на «9:05» и «1:02:11». */
		font-variant-numeric: tabular-nums;
		color: var(--accent-text);
	}

	/* Подчёркивание только при наведении — иначе список рябит. */
	.tc-row:hover .tc-theme,
	.tc-row:focus-visible .tc-theme {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}
</style>
