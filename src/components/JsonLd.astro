---
// Структурированная разметка Schema.org (тз/06, шаг 10) — невидимый блок данных
// в <head>, по которому поисковик понимает, ЧТО перед ним: выпуск подкаста,
// статья или страница внутри раздела.
//
// Формат JSON-LD, а не микроразметка атрибутами прямо в вёрстке: разметка
// не размазана по шаблону и не сломается, когда на восьмом этапе будут менять
// дизайн. Так же рекомендует сам Google.
//
// Пишется через set:html с JSON.stringify. Экранировать `<` обязательно:
// без этого строка `</script>` внутри данных закрыла бы тег раньше времени —
// классическая дыра, через которую в страницу попадает чужой код.
interface Props {
	data: unknown;
}

const { data } = Astro.props;
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<script type="application/ld+json" is:inline set:html={json} />
