---
import { getAnimePosterSrcs } from '../lib/animePoster.mjs';
import { plural } from '../lib/plural.mjs';

interface Props {
	anime: { id: string; data: Record<string, any> };
	count: number;
}

const { anime, count } = Astro.props;
const { titleRu, titleOriginal, year, poster } = anime.data;
const posterSrcs = getAnimePosterSrcs(poster);
const displayTitle = titleRu || titleOriginal;
const needsTranslation = !titleRu;

// Формы числительного подбирает общий src/lib/plural.mjs — тот же, что считает
// «143 выпуска» в шапке архива. Своя копия правила тут была и убрана: правило
// одно, а копии разъезжаются молча, на числах вроде 111 и 114.
const mentionForms: [string, string, string] = ['упоминание', 'упоминания', 'упоминаний'];
---

<a class="card" href={`/anime/${anime.id}/`}>
	{
		posterSrcs.length > 0 ? (
			<img
				class="poster"
				src={posterSrcs[0].src}
				srcset={posterSrcs.map((s) => `${s.src} ${s.width}w`).join(', ')}
				sizes="(max-width: 700px) 45vw, 220px"
				alt=""
				loading="lazy"
			/>
		) : (
			<span class="poster poster-placeholder" aria-hidden="true">
				?
			</span>
		)
	}
	<div class="body">
		<h3 class="title">{displayTitle}</h3>
		{needsTranslation && <span class="badge">нужен перевод</span>}
		<span class="meta">
			{year}
			{count > 0 && ` · ${count} ${plural(count, mentionForms)}`}
		</span>
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		color: var(--color-text);
		background: var(--color-bg-elevated);
		border-radius: var(--radius-md);
		overflow: hidden;
		border: 1px solid var(--color-border);
		transition: border-color var(--transition-fast);
	}

	.card:hover,
	.card:focus-visible {
		border-color: var(--color-accent);
		color: var(--color-text);
	}

	.poster {
		width: 100%;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		background: var(--color-bg);
	}

	.poster-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: var(--font-size-xl);
		color: var(--color-text-muted);
	}

	.body {
		display: flex;
		flex-direction: column;
		/* Новая шкала §3.5: те же 8 и 16 пикселей, что были, но под новыми
		   именами. Каталог переверстывается в части 7, до неё карточка
		   остаётся прежней на вид. */
		gap: var(--sp-2);
		padding: var(--sp-4);
	}

	.title {
		margin: 0;
		font-size: var(--font-size-base);
		line-height: 1.3;
	}

	.meta {
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
	}

	.badge {
		display: inline-block;
		width: fit-content;
		padding: 0.1em 0.5em;
		border-radius: var(--radius-full);
		background: var(--color-accent-2);
		color: var(--color-bg);
		font-size: var(--font-size-sm);
	}
</style>
