---
import { getAnimePosterSrcs } from '../lib/animePoster.mjs';

interface Props {
	anime: { id: string; data: Record<string, any> };
	count: number;
}

const { anime, count } = Astro.props;
const { titleRu, titleOriginal, year, poster } = anime.data;
const posterSrcs = getAnimePosterSrcs(poster);
const displayTitle = titleRu || titleOriginal;
const needsTranslation = !titleRu;

function pluralizeMentions(n: number) {
	const mod10 = n % 10;
	const mod100 = n % 100;
	if (mod10 === 1 && mod100 !== 11) return 'упоминание';
	if ([2, 3, 4].includes(mod10) && ![12, 13, 14].includes(mod100)) return 'упоминания';
	return 'упоминаний';
}
---

<a class="card" href={`/anime/${anime.id}/`}>
	{
		posterSrcs.length > 0 ? (
			<img
				class="poster"
				src={posterSrcs[0].src}
				srcset={posterSrcs.map((s) => `${s.src} ${s.width}w`).join(', ')}
				sizes="(max-width: 700px) 45vw, 220px"
				alt=""
				loading="lazy"
			/>
		) : (
			<span class="poster poster-placeholder" aria-hidden="true">
				?
			</span>
		)
	}
	<div class="body">
		<h3 class="title">{displayTitle}</h3>
		{needsTranslation && <span class="badge">нужен перевод</span>}
		<span class="meta">
			{year}
			{count > 0 && ` · ${count} ${pluralizeMentions(count)}`}
		</span>
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		color: var(--color-text);
		background: var(--color-bg-elevated);
		border-radius: var(--radius-md);
		overflow: hidden;
		border: 1px solid var(--color-border);
		transition: border-color var(--transition-fast);
	}

	.card:hover,
	.card:focus-visible {
		border-color: var(--color-accent);
		color: var(--color-text);
	}

	.poster {
		width: 100%;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		background: var(--color-bg);
	}

	.poster-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: var(--font-size-xl);
		color: var(--color-text-muted);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-2);
	}

	.title {
		margin: 0;
		font-size: var(--font-size-base);
		line-height: 1.3;
	}

	.meta {
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
	}

	.badge {
		display: inline-block;
		width: fit-content;
		padding: 0.1em 0.5em;
		border-radius: var(--radius-full);
		background: var(--color-accent-2);
		color: var(--color-bg);
		font-size: var(--font-size-sm);
	}
</style>
