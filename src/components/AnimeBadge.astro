---
// Горизонтальная марка аниме (§11.3 дизайн-системы, в макетах
// `.anime-stamp-horizontal`). Высота 168, постер 112×168 слева вплотную,
// перфорация по всем четырём сторонам.
//
// Форм у марки ровно две, третьей не бывает: вертикальная каталожная
// (AnimeCard.astro, часть 7) и вот эта. Эта стоит в блоках «Упоминается»
// под материалами и на главной — выглядит везде одинаково, меняются только
// содержимое, количество и цвет.
//
// ПОСТЕР НЕ ОБРЕЗАЕТСЯ НИКОГДА: `object-fit: contain`. Постеры в справочнике
// хранятся строго 2:3 (так отдают и Shikimori, и AniList), поэтому полей
// при этом не возникает. Квадратная картинка в поле постера — ошибка данных,
// а не повод включать обрезку: обрезка съедает название и лицо, то есть ровно
// то, ради чего постер и нарисован.
import { getAnimePosterSrcs } from '../lib/animePoster.mjs';
import { plural } from '../lib/plural.mjs';

interface Props {
	anime: { id: string; data: Record<string, any> };
	/** Сколько раз тайтл прозвучал в расшифровке этого материала. */
	mentions?: number;
}

const { anime, mentions = 0 } = Astro.props;
const { titleRu, titleOriginal, year, studio } = anime.data;

const posterSrcs = getAnimePosterSrcs(anime.data.poster);
const displayTitle = titleRu || titleOriginal;

// Мета под названием: оригинал, год со студией и — если материал расшифрован —
// сколько раз тайтл в нём прозвучал. Пустые куски выпадают, лишних точек
// не остаётся: у тайтла может не быть ни года, ни студии, а у AniList
// не бывает русского названия.
const metaParts = [
	// Оригинал не повторяем, если он же и стоит заголовком (нет titleRu).
	titleRu ? titleOriginal : null,
	[year, studio].filter(Boolean).join(' '),
	mentions > 0 ? `${mentions} ${plural(mentions, ['фрагмент', 'фрагмента', 'фрагментов'])}` : null,
].filter(Boolean);

// Цвет марки — по имени тайтла, а не по месту в ряду. Ряд должен быть
// разноцветным, но один и тот же тайтл обязан выглядеть одинаково везде,
// где попадается: иначе «Фрирен» на странице выпуска и «Фрирен» на главной
// читались бы как две разные вещи. Значения — в tokens.css.
const STAMP_COLORS = 4;
const stampIndex = [...anime.id].reduce((sum, char) => sum + char.charCodeAt(0), 0) % STAMP_COLORS;
---

<a class="stamp" href={`/anime/${anime.id}/`} style={`--stamp: var(--stamp-${stampIndex + 1})`}>
	{/* Перфорация: верх и низ рисуют псевдоэлементы, бока — эти два спана.
	    Псевдоэлементов у элемента всего два, а сторон четыре. */}
	<span class="perf-side perf-left" aria-hidden="true"></span>
	<span class="perf-side perf-right" aria-hidden="true"></span>
	<span class="media">
		{/* Заглушки «изображения нет» тут пока нет — она в части 9 вместе
		    с самим рисунком персонажа. До тех пор место постера остаётся
		    залитым цветом марки: пропорция 2:3 сохраняется, ряд не ломается. */}
		{posterSrcs.length > 0 && <img src={posterSrcs[0].src} alt="" loading="lazy" width="112" height="168" />}
	</span>
	<span class="copy">
		<span class="kicker tech">Аниме</span>
		<span class="title">{displayTitle}</span>
		{metaParts.length > 0 && <span class="meta">{metaParts.join(' · ')}</span>}
		<span class="arrow" aria-hidden="true">→</span>
	</span>
</a>

<style>
	.stamp {
		--stamp: var(--stamp-1);
		position: relative;
		display: grid;
		grid-template-columns: 112px minmax(0, 1fr);
		height: 168px;
		background: var(--stamp);
		color: var(--ink);
		overflow: hidden;
	}

	.stamp::before,
	.stamp::after {
		content: '';
		position: absolute;
		z-index: 5;
		left: 0;
		right: 0;
		height: 10px;
		pointer-events: none;
		background: radial-gradient(circle at 5px 0, var(--paper) 4px, transparent 4.5px) 0 0 / 16px 10px repeat-x;
	}

	.stamp::before {
		top: -1px;
	}

	.stamp::after {
		bottom: -1px;
		transform: rotate(180deg);
	}

	.perf-side {
		position: absolute;
		z-index: 5;
		top: 0;
		bottom: 0;
		width: 10px;
		pointer-events: none;
		background: radial-gradient(circle at 0 5px, var(--paper) 4px, transparent 4.5px) 0 0 / 10px 16px repeat-y;
	}

	.perf-left {
		left: -1px;
	}

	.perf-right {
		right: -1px;
		transform: rotate(180deg);
	}

	.media {
		width: 112px;
		height: 168px;
		display: grid;
		place-items: center;
		overflow: hidden;
		background: var(--stamp);
	}

	.media img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
	}

	.copy {
		position: relative;
		min-width: 0;
		padding: 20px 30px 18px 18px;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.kicker {
		margin-bottom: var(--sp-2);
		font-weight: 600;
		color: var(--accent-text);
	}

	/* Высота марки фиксирована (это медиаповерхность, а не текстовый блок),
	   поэтому заголовок в четыре строки её сломал бы. */
	.title {
		font-family: var(--font-display);
		font-size: var(--card-title);
		line-height: 1.15;
		margin-bottom: var(--sp-2);
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}

	.meta {
		font-size: var(--caption);
		line-height: 1.45;
		color: var(--muted);
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
	}

	.arrow {
		position: absolute;
		right: 14px;
		bottom: 14px;
		font-size: 20px;
		line-height: 1;
		color: var(--accent-text);
	}

	.stamp:hover .title,
	.stamp:focus-visible .title {
		color: var(--accent-text);
	}
</style>
