---
// Горизонтальная марка аниме (§11.3 дизайн-системы, в макетах
// `.anime-stamp-horizontal`). Высота 168, постер слева вплотную,
// перфорация по всем четырём сторонам.
//
// Форм у марки ровно две, третьей не бывает: вертикальная каталожная
// (AnimeCard.astro, часть 7) и вот эта. Эта стоит в блоках «Упоминается»
// под материалами и на главной — выглядит везде одинаково, меняются только
// содержимое, количество и цвет.
//
// ПОСТЕР НЕ ОБРЕЗАЕТСЯ НИКОГДА: `object-fit: contain`.
//
// ШИРИНА КОЛОНКИ ПОСТЕРА — НЕ 112 ИЗ §11.3, и это не вольность. Число 112
// в системе выведено из «постеры хранятся строго 2:3»; замер всего справочника
// показал, что это не так: ширина у всех 225, а высота гуляет от 314 до 338.
// В рамке 112×168 постер не дотягивал до верха и низа на 5–12 px — по-разному
// у каждой марки, и ряд читался неряшливо.
//
// Колонка считается от высоты марки и `--poster-ratio` (tokens.css) — ширины
// под САМЫЙ широкий реальный постер. Число живёт в одном месте на обе формы
// марки и на страницу тайтла: разойдись копии, полоса пустоты вернулась бы
// в одну из них молча. Остаток у узких постеров уходит вправо, к тексту,
// где читается полем.
//
// Обрезать нельзя: обрезка съедает название и лицо, то есть ровно то,
// ради чего постер и нарисован.
import { getAnimePosterSrcs } from '../lib/animePoster.mjs';
import { stampVar } from '../lib/animeStamp.mjs';
import { plural } from '../lib/plural.mjs';

interface Props {
	anime: { id: string; data: Record<string, any> };
	/** Сколько раз тайтл прозвучал в расшифровке этого материала. */
	mentions?: number;
	/** Строки меты вместо обычной: блок каталога на главной ставит номер с годом
	    и число упоминаний ОТДЕЛЬНЫМИ строками. Одной строкой перенос рвал её
	    как придётся, и цифра оставалась на строке выше своего слова:
	    «CAT. 011 · 2014 · 1 / упоминание». */
	catalogMeta?: string[] | null;
	/** Марка лежит в разметке, но не показана: блок каталога на главной кладёт
	    двенадцать марок, а показывает четыре. У скрытой картинка не грузится
	    вовсе — в этом весь смысл двухступенчатого механизма. */
	hidden?: boolean;
}

const { anime, mentions = 0, catalogMeta = null, hidden = false } = Astro.props;
const { titleRu, titleOriginal, year, studio } = anime.data;

const posterSrcs = getAnimePosterSrcs(anime.data.poster);
const displayTitle = titleRu || titleOriginal;

// Мета под названием: оригинал, год со студией и — если материал расшифрован —
// сколько раз тайтл в нём прозвучал. Пустые куски выпадают, лишних точек
// не остаётся: у тайтла может не быть ни года, ни студии, а у AniList
// не бывает русского названия.
const metaParts = [
	// Оригинал не повторяем, если он же и стоит заголовком (нет titleRu).
	titleRu ? titleOriginal : null,
	[year, studio].filter(Boolean).join(' '),
	mentions > 0 ? `${mentions} ${plural(mentions, ['фрагмент', 'фрагмента', 'фрагментов'])}` : null,
].filter(Boolean);

// Каждая строка меты выводится своим элементом, а не склеивается в одну:
// перенос внутри строки рвал её по любому пробелу, и число отрывалось
// от своего слова.
const metaLines = catalogMeta ?? (metaParts.length > 0 ? [metaParts.join(' · ')] : []);

// Цвет марки выбирает общий src/lib/animeStamp.mjs: то же правило работает
// у вертикальной каталожной марки, и двух копий у него быть не должно.
---

<a class="stamp" href={`/anime/${anime.id}/`} style={`--stamp: ${stampVar(anime.id)}`} hidden={hidden}>
	{/* Перфорация: верх и низ рисуют псевдоэлементы, бока — эти два спана.
	    Псевдоэлементов у элемента всего два, а сторон четыре. */}
	<span class="perf-side perf-left" aria-hidden="true"></span>
	<span class="perf-side perf-right" aria-hidden="true"></span>
	<span class="media">
		{/* Заглушки «изображения нет» тут пока нет — она в части 9 вместе
		    с самим рисунком персонажа. До тех пор место постера остаётся
		    залитым цветом марки: ширина колонки сохраняется, ряд не ломается. */}
		{posterSrcs.length > 0 && <img src={posterSrcs[0].src} alt="" loading="lazy" width="120" height="168" />}
	</span>
	<span class="copy">
		<span class="kicker tech">Аниме</span>
		<span class="title">{displayTitle}</span>
		{/* В блоке каталога на главной под названием стоит строка каталога
		    (номер, год, число упоминаний), а не оригинал со студией: там марка
		    приглашает в каталог, а не поясняет, о чём был выпуск. */}
		{
			metaLines.length > 0 && (
				<span class="meta">
					{metaLines.map((line) => (
						<span>{line}</span>
					))}
				</span>
			)
		}
		<span class="arrow" aria-hidden="true">→</span>
	</span>
</a>

<style>
	/* `:not([hidden])` обязателен: блок каталога на главной прячет восемь марок
	   из двенадцати атрибутом, а `[hidden]` весит один селектор против правила
	   компонента с меткой области стилей — без уточнения `display: grid`
	   перебил бы его, и на главной вывалились бы все двенадцать. Те же грабли
	   в проекте срабатывали трижды, см. CLAUDE.md. */
	.stamp:not([hidden]) {
		--stamp: var(--stamp-1);
		position: relative;
		display: grid;
		grid-template-columns: calc(168px * var(--poster-ratio)) minmax(0, 1fr);
		height: 168px;
		background: var(--stamp);
		color: var(--ink);
		overflow: hidden;
	}

	.stamp::before,
	.stamp::after {
		content: '';
		position: absolute;
		z-index: 5;
		left: 0;
		right: 0;
		height: 10px;
		pointer-events: none;
		background: radial-gradient(circle at 5px 0, var(--paper) 4px, transparent 4.5px) 0 0 / 16px 10px repeat-x;
	}

	.stamp::before {
		top: -1px;
	}

	.stamp::after {
		bottom: -1px;
		transform: rotate(180deg);
	}

	.perf-side {
		position: absolute;
		z-index: 5;
		top: 0;
		bottom: 0;
		width: 10px;
		pointer-events: none;
		background: radial-gradient(circle at 0 5px, var(--paper) 4px, transparent 4.5px) 0 0 / 10px 16px repeat-y;
	}

	.perf-left {
		left: -1px;
	}

	.perf-right {
		right: -1px;
		transform: rotate(180deg);
	}

	.media {
		width: calc(168px * var(--poster-ratio));
		height: 168px;
		display: grid;
		place-items: center;
		overflow: hidden;
		background: var(--stamp);
	}

	/* Остаток ширины уходит ВПРАВО, к тексту: постер обязан стоять вплотную
	   к левому краю марки (§11.3). Центрирование оставило бы полоску фона
	   и слева, и край марки перестал бы читаться. */
	.media img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: left center;
	}

	.copy {
		position: relative;
		min-width: 0;
		padding: 20px 30px 18px 18px;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.kicker {
		margin-bottom: var(--sp-2);
		font-weight: 600;
		color: var(--accent-text);
	}

	/* Высота марки фиксирована (это медиаповерхность, а не текстовый блок),
	   поэтому заголовок в четыре строки её сломал бы. */
	.title {
		font-family: var(--font-display);
		font-size: var(--card-title);
		line-height: 1.15;
		margin-bottom: var(--sp-2);
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}

	/* Строки идут одна под другой, каждая переносится сама по себе. Высота
	   марки фиксирована, лишнее срезает `overflow` у неё же. */
	.meta {
		display: grid;
		gap: 2px;
		font-size: var(--caption);
		line-height: 1.45;
		color: var(--muted);
	}

	.arrow {
		position: absolute;
		right: 14px;
		bottom: 14px;
		font-size: 20px;
		line-height: 1;
		color: var(--accent-text);
	}

	.stamp:hover .title,
	.stamp:focus-visible .title {
		color: var(--accent-text);
	}
</style>
