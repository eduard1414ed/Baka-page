---
// Расшифровка выпуска на странице поста (тз/05, шаг 5).
// Структура и поведение — по референсу из сессии; цвета, шрифты и отступы
// только из src/styles/tokens.css, чужой дизайн не копируем. Отделка — этап 8.
//
// Текст отдаётся целиком в HTML, без подгрузки по частям. Померено на архиве:
// самая тяжёлая страница — 186 КБ сырого HTML, но Cloudflare сжимает на лету,
// и до браузера доходит 37 КБ. Это меньше одной картинки в посте, дробить
// нечего. Заодно «слежение за плеером» видит все реплики в DOM сразу,
// а не спотыкается на границе подгруженного.
//
// Свёрнутый вид — окно фиксированной высоты со своей полосой прокрутки
// (как на референсе), чистый CSS. Это удобство чтения, чтобы транскрипт не
// отодвигал подвал на два экрана, а не экономия трафика.
import { getCollection } from 'astro:content';
import { groupReplicas, UNKNOWN_SPEAKER } from '../lib/transcript.mjs';
import { formatTimecode } from '../lib/timecode.mjs';
import { plural } from '../lib/plural.mjs';
import { buildAnimeMatcher, splitByMentions } from '../lib/animeMentions.mjs';
import { makeExceptionFilter } from '../lib/mentionExceptions.mjs';

interface Props {
	transcript: {
		speakers: Record<string, string>;
		replicas: { start: number; end: number; speaker: string; text: string }[];
	};
	// Имя файла расшифровки: нужно для якорей и ссылок на минуты.
	transcriptId: string;
	// Что убрано из упоминаний руками — строка из поля поста
	// (см. src/lib/mentionExceptions.mjs).
	mentionsHidden?: string;
}

const { transcript, transcriptId, mentionsHidden } = Astro.props;

// Разметка названий тайтлов внутри расшифровки (тз/05, шаг 5).
//
// ДВА РАЗНЫХ ПРАВИЛА, их легко перепутать:
//   1. ССЫЛКОЙ становится только ПЕРВОЕ упоминание тайтла в выпуске — иначе
//      в выпуске про «K-On!», где название звучит 17 раз, текст превратился бы
//      в синее месиво. Так же ведёт себя разметка в постах (remark-anime.mjs).
//   2. Помечены при этом ВСЕ упоминания до единого (класс .tr-anime): по ним
//      считаются таймкоды для страницы тайтла и по ним же листают стрелки,
//      когда на выпуск пришли по ссылке «обсуждали на 12:04».
//
// Убранное руками в админке сюда не попадает вовсе — остаётся обычным текстом.
// Ссылкой становится первое ВИДИМОЕ упоминание.
// Строка статистики в шапке блока: «28:05 · 2 голоса». Считается по самой
// расшифровке, а не берётся из RSS: длительность звука и длина расшифровки —
// разные числа (распознавание кончается там, где кончилась речь), и подставить
// сюда чужое было бы неправдой.
const lastEnd = transcript.replicas.length > 0 ? transcript.replicas[transcript.replicas.length - 1].end : 0;
const voiceCount = new Set(
	transcript.replicas.map((replica: { speaker: string }) => transcript.speakers?.[replica.speaker] ?? replica.speaker),
).size;
const statLine = `${formatTimecode(lastEnd)} · ${voiceCount} ${plural(voiceCount, ['голос', 'голоса', 'голосов'])}`;

const animeList = await getCollection('anime');
// Живая речь: галочка «только в кавычках» тут не действует — кавычек
// в разговоре не бывает (см. src/lib/animeMentions.mjs).
const matcher = buildAnimeMatcher(animeList, { quotes: 'ignore', speech: true });
const exceptions = makeExceptionFilter(mentionsHidden);
const linked = new Set<string>();

// Разметку ищем по репликам (block.parts), а не по склеенному тексту блока:
// номер вхождения в реплике — половина якоря для исключений.
// Якорь для поиска по сайту (тз/06, шаг 4). Pagefind запоминает КАЖДЫЙ элемент
// с `id` и его позицию в тексте страницы — значит по найденному слову можно
// вычислить, в каком блоке оно стоит, и достать таймкод. Отдельный индекс
// по репликам поэтому не нужен вовсе: 24 900 записей превратились бы
// в 24 900 файлов в сборке, а у Cloudflare лимит 20 000 (см. CLAUDE.md).
//
// Секунды прячем прямо в id, чтобы /search не пришлось скачивать ничего
// сверх того, что Pagefind и так отдаёт. Совпадения возможны (два блока
// в одну и ту же секунду) — id обязан быть уникальным, поэтому дубли
// получают приписку; разбор на стороне поиска берёт только цифры до дефиса.
const seenAnchors = new Set<string>();
const blocks = groupReplicas(transcript).map((block: any) => ({
	...block,
	anchorId: ((base) => {
		let id = base;
		for (let n = 2; seenAnchors.has(id); n += 1) id = `${base}-${n}`;
		seenAnchors.add(id);
		return id;
	})(`t${Math.floor(block.start)}`),
	// data-seconds у упоминания — начало блока, то же число, что на плашке
	// рядом. По нему ссылка со страницы тайтла находит нужное упоминание.
	seconds: Math.floor(block.start),
	parts: block.parts.map((part: any) => ({
		...part,
		segments: splitByMentions(part.text, matcher, part.index, exceptions).map((segment: any) => {
			if (!segment.animeId) return segment;
			const isFirst = !linked.has(segment.animeId);
			linked.add(segment.animeId);
			return { ...segment, isFirst };
		}),
	})),
}));

// ЧЬИМ ГОЛОСОМ СКАЗАНА РЕПЛИКА — ДЛЯ ПОИСКА ПО САЙТУ (часть 8).
//
// В результате-упоминании над цитатой стоит имя голоса. Взять его поиску
// неоткуда: Pagefind запоминает у якоря только элемент, id и позицию, а текст —
// лишь у заголовков. Поэтому карта «секунда → имя» уходит одной меткой.
//
// Строка компактная нарочно: у длинного выпуска блоков под две сотни, и это
// примерно килобайт на выпуск — против 140 КБ самого текста в том же куске
// индекса. Скачивается она только вместе с показанным результатом.
//
// Имя пишем не у каждого блока, а только там, где голос сменился: у блока,
// оторвавшегося от предыдущего по длине, имя то же самое. Разбор на стороне
// поиска берёт ближайшее слева — то же правило, что с самими якорями.
//
// КЛЮЧ — ЯКОРЬ, А НЕ СЕКУНДА. Два блока могут начаться в одну и ту же секунду
// (в архиве такие есть), и по секунде их не различить: у выпуска ep-106 подряд
// идут «232=Эд» и «232=Гость». Якорь для того и уникален.
const speakerMap = blocks
	.filter((block: any) => !block.continues)
	.map((block: any) => `${block.anchorId}=${block.name}`)
	.join('|');
---

<section class="transcript" aria-labelledby="transcript-title">
	<span data-pagefind-meta={`speakers:${speakerMap}`}></span>
	<div class="tr-head">
		<div>
			<h2 id="transcript-title">Транскрипт</h2>
			{/* Приписка в поиск не идёт: иначе по запросу «ошибки» находился бы весь
			    архив разом. */}
			<p class="tr-note" data-pagefind-ignore>Расшифровано автоматически, ошибки возможны. Таймкоды синхронизированы с плеером.</p>
		</div>
		<div class="tr-stat tech" data-pagefind-ignore>{statLine}</div>
	</div>

	<div class="tr-tools" data-pagefind-ignore>
		<input
			class="tr-search"
			type="search"
			placeholder="Поиск по транскрипту"
			autocomplete="off"
			aria-label="Поиск по транскрипту"
		/>
		<div class="tr-steps">
			<button class="tr-step" type="button" data-dir="-1" aria-label="Предыдущее совпадение" disabled>↑</button>
			<button class="tr-step" type="button" data-dir="1" aria-label="Следующее совпадение" disabled>↓</button>
		</div>
		<span class="tr-count" role="status" aria-live="polite"></span>
		<button class="tr-follow" type="button" aria-pressed="false" hidden>Следить за плеером</button>
	</div>

	{/* Появляется, когда на страницу пришли по ссылке «обсуждали в выпуске на 12:04».
	    Само название тайтла при этом вписывается в поле поиска выше — чтобы
	    сразу было видно, что стрелки живые и есть что листать. Здесь его
	    поэтому не повторяем, а объясняем, чем этот режим отличается от поиска. */}
	<p class="tr-hits" hidden data-pagefind-ignore>
		<span>Показаны все упоминания тайтла — листайте стрелками ↑↓</span>
		<button class="tr-hits-off" type="button">✕ обычный поиск</button>
	</p>

	{/* Подписи колонок — только на широком экране, где колонки и есть.
	    На телефоне колонка одна, и подписывать нечего. */}
	{/* В поиск не идут: это подписи колонок, а не текст выпуска. Без этого
	    слово «Реплика» вставало в самое начало расшифровки и попадало
	    в цитату первого же результата — «…Реплика. Всем привет!». */}
	<div class="tr-labels tech" aria-hidden="true" data-pagefind-ignore>
		<div>Голос · время</div>
		<div>Реплика</div>
	</div>

	<div class="tr-body">
		{
			blocks.map((block: any) => (
				<div class="tr-block" id={block.anchorId} data-start={block.start} data-end={block.end}>
					<div class="tr-side">
						{/* У блока, оторвавшегося от предыдущего по порогу длины, имя
						    не повторяем — это та же речь, просто с новым таймкодом. */}
						{/* «Спикер не определён» пишем прямо в имени, без значков
						    и приписок: это состояние данных, а не ошибка, которую
						    читатель может исправить. */}
						{/* ИМЯ ГОЛОСА В ПОИСК НЕ ИДЁТ. Оно стоит в тексте страницы перед
						    каждой репликой, и цитата в выдаче поиска ловила его серединой:
						    «не сделал ничего толкового после Наруто. Эд. Ну, справедливости
						    ради…» — читатель принимает имя за часть речи. Плюс запрос «Эд»
						    находил бы каждый выпуск архива, ничего этим не сообщая.
						    Само имя от этого не теряется: в выдаче оно стоит над цитатой,
						    и приезжает туда меткой `speakers` (см. выше). */}
						{!block.continues && (
							<span
								class:list={['tr-name', block.name === UNKNOWN_SPEAKER && 'is-unknown']}
								data-pagefind-ignore
							>
								{block.name}
							</span>
						)}
						{/* Сама плашка в поиск не идёт: иначе текст страницы был бы
						    прошит сотнями «12:04», и они лезли бы в выдачу. Таймкод
						    от этого не теряется — он в id блока выше. */}
						<button type="button" class="tr-time" data-seconds={block.start} data-pagefind-ignore>
							{formatTimecode(block.start)}
						</button>
					</div>
					<p class="tr-text">{block.parts.map((part: any, partIndex: number) => (
						<Fragment>
							{/* Реплики склеены пробелом — ровно как в block.text. */}
							{partIndex > 0 && ' '}
							{part.segments.map((segment: any) =>
								!segment.animeId ? (
									segment.text
								) : segment.isFirst ? (
									<a
										class="anime-mention tr-anime"
										href={`/anime/${segment.animeId}`}
										data-anime={segment.animeId}
										data-seconds={block.seconds}
										data-replica={part.index}
										data-offset={segment.offset}
									>
										{segment.text}
									</a>
								) : (
									<span
										class="tr-anime"
										data-anime={segment.animeId}
										data-seconds={block.seconds}
										data-replica={part.index}
										data-offset={segment.offset}
									>
										{segment.text}
									</span>
								),
							)}
						</Fragment>
					))}</p>
				</div>
			))
		}
	</div>

	{/* Метка конца расшифровки — пустая, на странице её не видно. Нужна
	    поиску по сайту: якорь блока говорит, где расшифровка НАЧАЛАСЬ, а без
	    этой метки слово, найденное в плашках тайтлов под транскриптом, поиск
	    приписал бы последнему блоку и позвал бы человека на чужую минуту. */}
	<span id="tend"></span>

	<div class="tr-actions" data-pagefind-ignore>
		<button class="tr-expand tech" type="button" aria-expanded="false">Развернуть транскрипт целиком ↓</button>
		<span class="tr-hint">Нажмите на время слева, чтобы перейти к фрагменту.</span>
	</div>
</section>

<script>
	// Ищем без учёта регистра и без разницы между «е» и «ё»: распознавание
	// сплошь пишет «Унесенные» там, где в названии «Унесённые», и поиск по
	// правильному написанию иначе ничего бы не находил. Замена один символ
	// на один, поэтому позиции найденного не сбиваются. То же правило в
	// src/lib/animeMentions.mjs, где по названиям ищут при сборке.
	function fold(text: string): string {
		return text.toLowerCase().replace(/ё/g, 'е');
	}

	type PlayerApi = {
		load: (data: DOMStringMap, seekSeconds?: number) => void;
		audio: HTMLAudioElement;
		getGuid: () => string | null;
	};

	function initTranscript(section: HTMLElement) {
		const input = section.querySelector<HTMLInputElement>('.tr-search');
		const steps = section.querySelectorAll<HTMLButtonElement>('.tr-step');
		const counter = section.querySelector<HTMLElement>('.tr-count');
		const body = section.querySelector<HTMLElement>('.tr-body');
		const expand = section.querySelector<HTMLButtonElement>('.tr-expand');
		const follow = section.querySelector<HTMLButtonElement>('.tr-follow');
		const hits = section.querySelector<HTMLElement>('.tr-hits');
		const hitsOff = section.querySelector<HTMLButtonElement>('.tr-hits-off');
		if (!input || !counter || !body || !expand || !follow || !hits || !hitsOff) return;

		const paragraphs = Array.from(section.querySelectorAll<HTMLElement>('.tr-text'));
		// Текст абзаца при подсветке не меняется (меняется только обёртка <mark>),
		// поэтому свёрнутый вид можно посчитать один раз и потом только читать —
		// вместо fold() на 477 абзацах при каждом нажатии клавиши.
		const folded = new Map(paragraphs.map((p) => [p, fold(p.textContent ?? '')]));

		// Общий механизм «перебор найденного стрелками» — им пользуются оба режима:
		// текстовый поиск (совпадения — созданные скриптом <mark>) и режим
		// упоминаний тайтла (совпадения — размеченные при сборке .tr-anime).
		let matches: HTMLElement[] = [];
		let current = -1;
		// Только те абзацы, в которых подсветка реально что-то поменяла —
		// чтобы не перебирать все 477 при каждом нажатии клавиши.
		let touched: HTMLElement[] = [];

		function clearHighlights() {
			// <mark> убираем распаковкой, а НЕ переписыванием textContent абзаца:
			// внутри абзаца теперь живут размеченные названия тайтлов (.tr-anime),
			// и переписывание текста стёрло бы их вместе с подсветкой.
			for (const p of touched) {
				p.querySelectorAll('mark').forEach((mark) => mark.replaceWith(...mark.childNodes));
				// Соседние текстовые узлы после распаковки склеиваем обратно в один,
				// иначе следующий поиск не найдёт слово, разорванное прошлой подсветкой.
				p.normalize();
			}
			touched = [];

			section.querySelectorAll('.tr-anime.is-hit').forEach((el) => el.classList.remove('is-hit'));
			section.querySelectorAll('.is-current').forEach((el) => el.classList.remove('is-current'));
			hits.hidden = true;

			matches = [];
			current = -1;
			counter.textContent = '';
			steps.forEach((step) => (step.disabled = true));
		}

		// Показать совпадение. Пока транскрипт свёрнут, у окна своя полоса
		// прокрутки — двигаем её, страницу не трогаем совсем (иначе при каждом
		// переходе к следующему совпадению страница прыгала бы под руками).
		//
		// СВЁРНУТОСТЬ ОПРЕДЕЛЯЕМ ПО КЛАССУ, А НЕ ПО ИЗМЕРЕННОЙ ВЫСОТЕ. У окна
		// стоит `content-visibility: auto`, и пока оно за кромкой экрана, его
		// содержимое не разложено: `scrollHeight` в этот момент равен видимой
		// высоте, и проверка «есть ли что прокручивать» отвечала бы «нет» —
		// вместо прокрутки внутри окна дёргалась бы вся страница.
		function reveal(element: HTMLElement, smooth = true) {
			if (!section.classList.contains('is-expanded')) {
				const rect = element.getBoundingClientRect();
				const bodyRect = body!.getBoundingClientRect();
				body!.scrollTop += rect.top - bodyRect.top - body!.clientHeight / 2;
			} else {
				element.scrollIntoView({ block: 'center', behavior: smooth ? 'smooth' : 'auto' });
			}
		}

		function setCurrent(index: number) {
			if (matches.length === 0) return;
			matches[current]?.classList.remove('is-current');
			current = (index + matches.length) % matches.length;
			matches[current].classList.add('is-current');
			counter!.textContent = `${current + 1} из ${matches.length}`;
			reveal(matches[current]);
		}

		// Подсветка внутри одного текстового узла. Работаем именно по узлам,
		// а не по абзацу целиком, чтобы не задеть размеченные названия тайтлов.
		// Цена решения: совпадение, попавшее наполовину внутрь названия
		// («в Наруто», где «Наруто» — ссылка), не найдётся. Это редкий случай.
		function highlightNode(node: Text, needle: string) {
			const text = node.data;
			const haystack = fold(text);
			let at = haystack.indexOf(needle);
			if (at === -1) return false;

			const fragment = document.createDocumentFragment();
			let cursor = 0;

			while (at !== -1) {
				if (at > cursor) fragment.append(text.slice(cursor, at));
				const mark = document.createElement('mark');
				// Из исходного текста, а не из запроса — сохраняем регистр и «ё».
				mark.textContent = text.slice(at, at + needle.length);
				fragment.append(mark);
				matches.push(mark);
				cursor = at + needle.length;
				at = haystack.indexOf(needle, cursor);
			}

			if (cursor < text.length) fragment.append(text.slice(cursor));
			node.replaceWith(fragment);
			return true;
		}

		function search(query: string) {
			clearHighlights();

			const needle = fold(query.trim());
			// Один символ подсветил бы пол-транскрипта — ждём, пока наберут два.
			if (needle.length < 2) return;

			for (const paragraph of paragraphs) {
				if (!(folded.get(paragraph) ?? '').includes(needle)) continue;

				// Список узлов собираем ДО правок: highlightNode заменяет узел,
				// и обход на ходу пропустил бы часть абзаца.
				const walker = document.createTreeWalker(paragraph, NodeFilter.SHOW_TEXT);
				const nodes: Text[] = [];
				for (let node = walker.nextNode(); node; node = walker.nextNode()) nodes.push(node as Text);

				let hit = false;
				for (const node of nodes) hit = highlightNode(node, needle) || hit;
				if (hit) touched.push(paragraph);
			}

			steps.forEach((step) => (step.disabled = matches.length === 0));
			if (matches.length === 0) {
				counter!.textContent = 'ничего не найдено';
				return;
			}
			setCurrent(0);
		}

		input.addEventListener('input', () => search(input.value));

		// Enter — к следующему совпадению, Shift+Enter — к предыдущему,
		// не отрывая рук от клавиатуры.
		input.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter') return;
			event.preventDefault();
			if (matches.length > 0) setCurrent(current + (event.shiftKey ? -1 : 1));
		});

		steps.forEach((step) => {
			step.addEventListener('click', () => {
				if (matches.length > 0) setCurrent(current + Number(step.dataset.dir));
			});
		});

		expand.addEventListener('click', () => {
			const opened = section.classList.toggle('is-expanded');
			expand.setAttribute('aria-expanded', String(opened));
			expand.textContent = opened ? 'Свернуть транскрипт ↑' : 'Развернуть транскрипт целиком ↓';
		});

		// Возврат к обычному поиску. Поле чистим здесь, а не в clearHighlights():
		// туда мы заходим и из самого поиска на каждое нажатие клавиши, там
		// стирать набранное нельзя.
		hitsOff.addEventListener('click', () => {
			input.value = '';
			clearHighlights();
		});

		// Режим упоминаний тайтла: пришли со страницы /anime/<slug> по ссылке
		// вида /posts/ep-102/#anime=naruto&t=716 — подсвечиваем ВСЕ упоминания
		// этого тайтла и даём те же стрелки, что у поиска.
		//
		// Листаем именно по размеченным упоминаниям, а не по текстовому поиску:
		// распознавание пишет «Фринен» вместо «Фрирен», текстовое совпадение такие
		// места пропустит, а разметка по справочнику — нет (тз/05, шаг 5).
		function showMentions(animeId: string, seconds: number) {
			clearHighlights();

			const found = Array.from(section.querySelectorAll<HTMLElement>('.tr-anime')).filter(
				(el) => el.dataset.anime === animeId,
			);
			if (found.length === 0) return;

			matches = found;
			found.forEach((el) => el.classList.add('is-hit'));
			hits!.hidden = false;

			// Название — в поле поиска: иначе поле пустое, стрелки активны, и по
			// экрану не понять, что листать есть что.
			//
			// Берём название ТАК, КАК ОНО НАПИСАНО В ТРАНСКРИПТЕ, а не из
			// справочника: в ep-134 в справочнике «Кэйон!», а в тексте звучит
			// «K-On!» — увидев в поле «Кэйон!», вы решили бы, что поиск врёт.
			//
			// Значение присваиваем напрямую: событие input от этого не
			// срабатывает, поэтому обычный текстовый поиск не запускается
			// и подсветку упоминаний не сбивает. А стоит начать печатать —
			// поиск перехватит управление, это и нужно.
			input!.value = found[0].textContent ?? '';
			steps.forEach((step) => (step.disabled = false));

			// К транскрипту страница уже подведена вызывающей стороной — здесь
			// остаётся встать на нужное упоминание (или на первое, если таймкод
			// не совпал).
			const at = Number.isFinite(seconds) ? found.findIndex((el) => Number(el.dataset.seconds) === seconds) : -1;
			setCurrent(at === -1 ? 0 : at);
		}

		// Плеера на странице может не быть вовсе — например, если фид подкаста
		// в момент сборки не ответил (см. getStaticPaths в pages/posts/[slug].astro).
		// Тогда плашки не притворяются кликабельными, а текст остаётся на месте:
		// читать расшифровку можно и без звука.
		const playerCard = document.querySelector<HTMLElement>('.episode-player');
		const api = (window as any).__bakaPlayer as PlayerApi | undefined;

		if (!playerCard || !api) {
			section.querySelectorAll<HTMLButtonElement>('.tr-time').forEach((button) => {
				button.disabled = true;
			});
		} else {
			// ПЕРЕМАТЫВАЕТ ВЕСЬ БЛОК, А НЕ ТОЛЬКО ПЛАШКА ВРЕМЕНИ: читатель целится
			// в реплику, которую хочет услышать, а не в четыре цифры сбоку от неё.
			// Плашка остаётся кнопкой — она нужна тем, кто ходит с клавиатуры,
			// и она же объясняет, что блок кликабельный.
			//
			// Через делегирование, а не слушателем на каждом из сотен блоков.
			// Свой класс .tr-time, а НЕ .timecode из remark-timecode.mjs: те
			// PlayerBar.astro ловит сам, и на общем классе клик обработался бы дважды.
			section.classList.add('is-playable');
			section.addEventListener('click', (event) => {
				const target = event.target as HTMLElement;
				// Ссылка на тайтл ведёт на страницу тайтла, а не перематывает.
				if (target.closest('a')) return;
				const block = target.closest<HTMLElement>('.tr-block');
				if (!block) return;
				// Человек выделял текст, а не тыкал в реплику: уводить плеер
				// в этот момент — значит наказать за попытку скопировать цитату.
				if ((window.getSelection()?.toString() ?? '').length > 0) return;
				api.load(playerCard.dataset, Number(block.dataset.start));
			});

			bindFollow(section, body, follow, api, playerCard, reveal);
		}

		// Оба перехода по ссылке ниже сначала подводят к транскрипту саму страницу,
		// а потом мотают окно внутри. Между этим нужен кадр отрисовки: пока окно
		// было за кромкой экрана, `content-visibility: auto` не раскладывал его
		// содержимое, и измерять положение реплики было бы не по чему. Два кадра,
		// а не один: обработчики кадра выполняются ДО пересчёта раскладки,
		// поэтому на первом мерить ещё рано.
		const afterPaint = (run: () => void) => requestAnimationFrame(() => requestAnimationFrame(run));

		// Ссылка со страницы тайтла. Разбираем после того, как плеер уже привязан:
		// переход должен и подсветить упоминания, и завести выпуск с этой минуты.
		const link = location.hash.match(/^#anime=([^&\s]+)(?:&t=(\d+))?$/);
		if (link) {
			const animeId = decodeURIComponent(link[1]);
			const seconds = Number(link[2]);
			section.scrollIntoView({ block: 'start' });
			afterPaint(() => showMentions(animeId, seconds));
			// Клик по ссылке — действие пользователя, а переход между страницами
			// сайта идёт без перезагрузки (<ClientRouter />), поэтому браузер обычно
			// разрешает звук. Если всё же заблокирует — транскрипт всё равно
			// прокручен и подсвечен, останется нажать play.
			if (playerCard && api && Number.isFinite(seconds)) api.load(playerCard.dataset, seconds);
		}

		// Ссылка из поиска по сайту: /posts/ep-102/#t=730&q=слово (тз/06, шаг 4).
		//
		// СВОЕЙ МЕХАНИКИ ПЕРЕХОДА ЗДЕСЬ НЕТ — вся работа делается тем же кодом,
		// что и раньше: подсветку и стрелки даёт search() (поиск внутри выпуска,
		// тз/05), прокрутку — reveal(), перемотку — api.load(). Вторая копия
		// этих правил разъехалась бы с первой, как уже бывало в этом проекте.
		const fromSearch = location.hash.match(/^#t=(\d+)(?:&q=(.*))?$/);
		if (fromSearch) {
			const seconds = Number(fromSearch[1]);
			const query = fromSearch[2] ? decodeURIComponent(fromSearch[2]) : '';

			// Блок ищем по id (он же якорь Pagefind), а если таймкод сдвинулся
			// после пересчёта расшифровки — по ближайшему data-start. Не нашли
			// вовсе — не беда: подсветка и звук всё равно отработают.
			const target =
				document.getElementById(`t${seconds}`) ??
				Array.from(section.querySelectorAll<HTMLElement>('.tr-block')).find(
					(block) => Math.floor(Number(block.dataset.start)) === seconds,
				) ??
				null;

			section.scrollIntoView({ block: 'start' });

			afterPaint(() => {
				if (query) {
					input.value = query;
					search(query);
				}

				// Совпадений на странице может быть много; встаём на то, что внутри
				// нужного блока, а не на первое сверху — за ним человек и пришёл.
				const at = target ? matches.findIndex((mark) => target.contains(mark)) : -1;
				if (at !== -1) setCurrent(at);
				else if (target) reveal(target, false);
			});

			if (playerCard && api) api.load(playerCard.dataset, seconds);
		}
	}

	// Режим «Следить за плеером»: подсветка звучащего сейчас блока и автопрокрутка
	// за ним (тз/05, шаг 5). Все реплики уже в DOM, подгрузки частями нет —
	// поэтому искать нужный блок можно прямо по разметке.
	function bindFollow(
		section: HTMLElement,
		body: HTMLElement,
		follow: HTMLButtonElement,
		api: PlayerApi,
		playerCard: HTMLElement,
		reveal: (element: HTMLElement, smooth?: boolean) => void,
	) {
		const guid = playerCard.dataset.guid;
		const blocks = Array.from(section.querySelectorAll<HTMLElement>('.tr-block'));
		if (!guid || blocks.length === 0) return;

		const starts = blocks.map((block) => Number(block.dataset.start));
		follow.hidden = false;

		let following = false;
		let playing = -1;

		// Двоичный поиск: последний блок, который начался не позже текущей секунды.
		// Линейный перебор на 500 блоках четыре раза в секунду тоже не заметен,
		// но у самого длинного выпуска блоков 192, а транскриптов ещё будет сотня.
		function blockAt(seconds: number) {
			let low = 0;
			let high = starts.length - 1;
			let found = -1;
			while (low <= high) {
				const middle = (low + high) >> 1;
				if (starts[middle] <= seconds) {
					found = middle;
					low = middle + 1;
				} else {
					high = middle - 1;
				}
			}
			return found;
		}

		function setPlaying(index: number) {
			if (index === playing) return;
			blocks[playing]?.classList.remove('is-playing');
			playing = index;
			if (index < 0) return;
			blocks[index].classList.add('is-playing');
			if (following) reveal(blocks[index]);
		}

		// СЛЕЖЕНИЕ УПРАВЛЯЕТ ТОЛЬКО АВТОПРОКРУТКОЙ, а не подсветкой. Подсветка
		// звучащей реплики нужна всегда: без неё, читая транскрипт под звук,
		// невозможно понять, где ты сейчас, — а это единственное, ради чего
		// расшифровка стоит рядом с плеером.
		function setFollowing(on: boolean) {
			following = on;
			follow.setAttribute('aria-pressed', String(on));
			follow.classList.toggle('is-on', on);
			follow.textContent = on ? 'Слежу за плеером' : 'Следить за плеером';

			// Включили на ходу — сразу подводим к тому месту, где сейчас звук.
			if (on && api.getGuid() === guid) reveal(blocks[playing] ?? blocks[0]);
		}

		follow.addEventListener('click', () => setFollowing(!following));

		// Прокрутил колесом или пальцем — слежение выключается, чтобы текст
		// не выдёргивало обратно. Ловим именно wheel/touchmove, а не scroll:
		// scroll срабатывает и от нашей собственной автопрокрутки, и слежение
		// выключало бы само себя на первом же шаге.
		const stop = () => {
			if (following) setFollowing(false);
		};
		body.addEventListener('wheel', stop, { passive: true });
		body.addEventListener('touchmove', stop, { passive: true });

		// Слушатель висит на общем <audio> (он переживает переходы между
		// страницами), а транскрипт при переходе исчезает вместе с DOM —
		// снимаем слушатель сами, как только заметим, что нас больше нет
		// на странице. Тот же приём, что у карточек плеера в PlayerBar.astro.
		const onTime = () => {
			if (!document.body.contains(section)) {
				api.audio.removeEventListener('timeupdate', onTime);
				return;
			}
			// Подсвечиваем всегда, пока играет ЭТОТ выпуск; прокручиваем — только
			// при включённом слежении (решает setPlaying).
			if (api.getGuid() !== guid) {
				setPlaying(-1);
				return;
			}
			setPlaying(blockAt(api.audio.currentTime));
		};

		api.audio.addEventListener('timeupdate', onTime);
	}

	// Как и в pages/posts/[slug].astro: из-за <ClientRouter /> переходы идут без
	// перезагрузки, собранный скрипт браузер выполняет один раз за сессию —
	// поэтому навешиваемся на astro:page-load, оно срабатывает и при первой
	// загрузке, и после каждого перехода.
	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll<HTMLElement>('.transcript').forEach(initTranscript);
	});
</script>

<style>
	/* Линия обычная. §5 отводил началу транскрипта «сильную» чернильную линию
	   как акцент — решением заказчика от 9 августа 2026 линия на сайте одна,
	   и §5 приведён в соответствие. Ось задаёт страница (.transcript-wrap,
	   1000), здесь только вертикальный ритм. */
	.transcript {
		padding-top: 34px;
		border-top: 1px solid var(--line);
	}

	.tr-head {
		margin-bottom: var(--sp-6);
	}

	/* Отступ считается от букв, а не от коробки: у Literata нижние выносные
	   уходят примерно на 0.19 em ниже строки, и от восьми пикселей до приписки
	   оставалось около двух — заголовок с ней слипался. Та же поправка стоит
	   у заголовка страницы тайтла. */
	.tr-head h2 {
		margin: 0 0 calc(var(--sp-2) + 0.19em);
	}

	.tr-note {
		margin: 0;
		font-size: var(--caption);
		line-height: 1.45;
		color: var(--muted);
	}

	.tr-stat {
		margin-top: var(--sp-3);
		color: var(--muted);
	}

	.tr-tools {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: var(--sp-2);
		align-items: center;
		margin-bottom: 18px;
	}

	.tr-search {
		appearance: none;
		-webkit-appearance: none;
		min-height: 44px;
		min-width: 0;
		padding: 0 13px;
		border: 1px solid var(--line);
		background: transparent;
		color: var(--ink);
		font-size: var(--body-md);
	}

	/* Замена снятому `outline` двойная — цвет рамки плюс внутренняя тень, как
	   у поля поиска по сайту (`.s-input`). Одного цвета мало: рамки контролов
	   бледные по решению 9 августа (1.57:1), и с клавиатуры фокус не виден.
	   Поля с таким фокусом три, вид у них один — правится везде сразу. */
	.tr-search:focus {
		outline: none;
		border-color: var(--accent-text);
		box-shadow: inset 0 0 0 1px var(--accent-text);
	}

	/* Своя крестик-кнопка у поля поиска в вебките — лишняя: очистка тут ничего
	   не сбрасывает, подсветку снимает событие ввода. */
	.tr-search::-webkit-search-decoration,
	.tr-search::-webkit-search-cancel-button,
	.tr-search::-webkit-search-results-button {
		-webkit-appearance: none;
	}

	.tr-steps {
		display: flex;
		gap: var(--sp-2);
	}

	.tr-step {
		width: 44px;
		height: 44px;
		border: 1px solid var(--line);
		background: transparent;
		color: var(--ink);
	}

	.tr-step:hover:not(:disabled),
	.tr-step:focus-visible:not(:disabled) {
		border-color: var(--accent-text);
		color: var(--accent-text);
	}

	.tr-step:disabled {
		color: var(--muted);
		cursor: default;
	}

	.tr-count {
		grid-column: 1 / -1;
		color: var(--muted);
		font-size: var(--caption);
		font-variant-numeric: tabular-nums;
	}

	.tr-follow {
		grid-column: 1 / -1;
		justify-self: start;
		min-height: 44px;
		padding: 0 14px;
		border: 1px solid var(--line);
		background: transparent;
		color: var(--ink);
		font-size: var(--caption);
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.tr-follow:hover,
	.tr-follow:focus-visible {
		border-color: var(--accent-text);
		color: var(--accent-text);
	}

	/* Включённое слежение видно с одного взгляда — иначе непонятно, почему
	   текст едет сам. Не только цветом: рамка и заливка вместе. */
	.tr-follow.is-on {
		border-color: var(--accent-text);
		background: var(--accent-soft);
		color: var(--accent-text);
	}

	/* `:not([hidden])` обязателен по той же причине, что и у плашки ошибки
	   в плеере: атрибут весит один селектор, правило компонента — два,
	   и `display: flex` его перебивает. Без этого строка «показаны все
	   упоминания тайтла» висела бы всегда, вместе с кнопкой возврата
	   к поиску, которому нечего возвращать. */
	.tr-hits:not([hidden]) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--sp-2);
		margin: 0 0 var(--sp-4);
		color: var(--muted);
		font-size: var(--caption);
	}

	.tr-hits-off {
		min-height: 44px;
		border: 0;
		background: transparent;
		padding: 0;
		color: var(--accent-text);
		font-size: var(--caption);
	}

	.tr-labels {
		display: none;
	}

	/* ВЕСЬ ТРАНСКРИПТ ЛЕЖИТ В РАЗМЕТКЕ, свёрнут только высотой окна.
	   Три правила, и все три нарушить легко:

	   — окно прокручивается САМО. Переход по таймкоду и «Следить за плеером»
	     мотают его внутри, а не разворачивают: человек свернул окно намеренно,
	     и подменять его решение автоматикой нельзя;
	   — прятать через `display: none` тоже нельзя — тогда поиск браузера
	     (Ctrl+F) перестанет находить в свёрнутой части;
	   — высота в `em`, а не в пикселях: при увеличении шрифта окно растёт
	     вместе с текстом, и на зуме 200 % в нём всё так же видно несколько
	     реплик, а не полторы строки.

	   `content-visibility` снимает стоимость отрисовки нижних реплик, не убирая
	   их из документа: у выпуска на 900 реплик это разница, которую видно. */
	.tr-body {
		max-height: 34em;
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-width: thin;
		content-visibility: auto;
		contain-intrinsic-size: auto 34em;
	}

	.transcript.is-expanded .tr-body {
		max-height: none;
		overflow-y: visible;
	}

	/* Слева у каждого блока пустая колонка в 12 px — в ней рисуется полоска
	   у звучащей сейчас реплики. Полоска не должна ни налезать на текст,
	   ни сдвигать его при появлении, поэтому место под неё занято всегда. */
	.tr-block {
		padding: 18px 0 18px var(--sp-3);
		border-bottom: 1px solid var(--line-soft);
	}

	/* Реплика, которая звучит прямо сейчас. Отмечается не только цветом
	   (§3.3): полоска слева, подложка под текстом и акцентное имя. */
	.tr-block.is-playing {
		box-shadow: inset 3px 0 0 var(--accent-brand);
	}

	/* Перематывает ВЕСЬ блок, а не только плашка времени. Класс вешает скрипт
	   и только когда плеер на странице есть: без него курсор обещал бы
	   действие, которого не будет. */
	.transcript.is-playable .tr-block {
		cursor: pointer;
	}

	.transcript.is-playable .tr-block:hover {
		box-shadow: inset 3px 0 0 var(--line-strong);
	}

