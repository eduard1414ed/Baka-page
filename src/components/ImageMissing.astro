---
// Заглушка «изображения нет» для разметки, которую делает сборка.
//
// Своих стилей у компонента нет НАРОЧНО: вид описан один раз в global.css
// (`.img-missing`), потому что ту же заглушку рисуют ещё два скрипта — выдача
// поиска и обработчик не загрузившихся картинок. Заведи компонент свои стили,
// они достались бы только ему, и три заглушки стали бы выглядеть по-разному.
//
// Разметку тоже не пишем здесь: она в src/lib/imageMissing.mjs, общая на всех.
import { imageMissingHtml } from '../lib/imageMissing.mjs';

interface Props {
	/** Узкое место — марка, карточка каталога: подпись прячется. */
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<Fragment set:html={imageMissingHtml({ compact })} />
