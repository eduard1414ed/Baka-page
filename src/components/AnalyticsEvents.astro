---
// СОБЫТИЯ ДЛЯ ЦЕЛЕЙ: плеер, транскрипт, поиск, тайтлы, уходы на площадки.
//
// СТОИТ ОТДЕЛЬНО ОТ Analytics.astro НАРОЧНО. Тот отвечает на вопрос «кто
// пришёл и что открыл» и обязан работать всегда; этот — на вопрос «что человек
// сделал». Сломайся здесь что-нибудь — счёт посещаемости не пострадает.
//
// ПЛЕЕР, ТРАНСКРИПТ И ПОИСК ЭТОТ КОД НЕ ТРОГАЕТ ВОВСЕ. Он ничего у них
// не вызывает и ничего им не передаёт — только подписывается на события,
// которые они и так порождают. Это прямое условие заказчика («не сломай
// плеер»), и выполнено оно устройством, а не аккуратностью: у кода нет
// способа помешать, потому что он никуда не пишет.
//
// ЗА ЧТО ЦЕПЛЯЕМСЯ (замер по сборке 26 августа 2026):
//   #player-audio   — ОДИН <audio> на весь сайт, лежит в общем макете внутри
//                     панели с transition:persist, есть на 1409 страницах
//                     из 1414 (остальные пять — админка и служебные);
//   .anime-mention  — название тайтла, поставленное разметкой в тексте
//                     (src/plugins/remark-anime.mjs). Тот же класс носят
//                     названия внутри расшифровки, но у них рядом .tr-anime —
//                     этим они и различаются, в параметре цели;
//   .tr-block, .timecode, .tr-expand, .tr-search — органы транскрипта.
//                     Перемотка считается по ВСЕЙ реплике (.tr-block внутри
//                     .is-playable), потому что так мотает и сам сайт;
//   .s-input, .results-count, .empty-state — поиск по сайту;
//   #catalog-search, #catalog-count, #catalog-empty — поиск по каталогу
//                     тайтлов. ТРЕТЬЕ ПОЛЕ ПОИСКА, найдено замером по сборке,
//                     а не чтением: глазами его пропустили.
//
// НАЖАТИЯ ЛОВИМ НА ДОКУМЕНТЕ, А НЕ НА ЭЛЕМЕНТАХ. Переходы между страницами
// идут без перезагрузки, элементы при этом пересоздаются — подписка на них
// умирала бы при каждом переходе, и чинилась бы это подпиской на
// astro:page-load, то есть вторым механизмом. Документ переходы не меняют.
//
// СПИСОК ПЛОЩАДОК БЕРЁТСЯ ИЗ src/data/platforms.js. Второго такого списка
// тут нет и быть не должно: сменится ссылка Boosty — цель обязана поехать
// за ней сама.
---

<script>
	import { YM_ID, GA_ID, считаемЭтотАдрес } from '../lib/analytics.mjs';
	import { platformsOfKind } from '../data/platforms.js';

	const w = window as any;

	// Тот же засов, что у счётчика: скрипт переживает переходы, и без него
	// каждый переход подписывался бы на всё заново, а события уходили бы
	// по два, по три раза. В отчёте это выглядит как рост.
	if (!w.__бакаСобытия && считаемЭтотАдрес(location.hostname)) {
		w.__бакаСобытия = true;

		// ── ОТПРАВКА ────────────────────────────────────────────────────────
		//
		// ИМЯ ОДНО НА ДВА СЕРВИСА. У Метрики это идентификатор цели (она
		// принимает только заведённые заранее — незнакомое выбрасывает молча),
		// у Google — имя события. Совпадение имён не украшение: иначе один
		// и тот же поступок звался бы в двух отчётах по-разному.
		//
		// ПАРАМЕТРЫ — ЛАТИНИЦЕЙ. Метрика приняла бы что угодно, а Google
		// требует букв, цифр и подчёркиваний, и русское имя параметра просто
		// потеряет. Пишем так, как принимают оба.
		//
		// ВСЁ ОБЁРНУТО В try. Счётчик — чужой код, загруженный из сети;
		// он может не доехать вовсе (заблокирован, нет сети, отказал домен).
		// Необработанная ошибка в обработчике нажатия способна оборвать
		// обработку самого нажатия — то есть сломать кнопку. Этого нельзя.
		function цель(имя: string, параметры?: Record<string, unknown>) {
			try {
				if (YM_ID && typeof w.ym === 'function') w.ym(YM_ID, 'reachGoal', имя, параметры);
				if (GA_ID && typeof w.gtag === 'function') w.gtag('event', имя, параметры ?? {});
			} catch {
				/* аналитика не имеет права мешать сайту работать */
			}
		}

		// ── ПЛЕЕР ───────────────────────────────────────────────────────────
		//
		// СЧИТАЕМ ПРОСЛУШАННОЕ, А НЕ ДОКУДА ДОЕХАЛ ПОЛЗУНОК. Разница
		// принципиальная: увёл ползунок на конец — «дослушал» не засчитывается.
		// Складываем шаги времени между соседними сигналами и отбрасываем те,
		// что больше двух секунд: браузер шлёт сигнал раза четыре в секунду,
		// поэтому большой шаг — это перемотка, а не слушание.
		const ПОРОГИ: Array<[number, string]> = [
			[25, 'player_25'],
			[50, 'player_50'],
			[90, 'player_90'],
		];

		let источник = '';
		let прослушано = 0;
		let прошлоеВремя = 0;
		const пройдено = new Set<number>();

		/** Кто сейчас в панели. Название и адрес берём из её же ссылки. */
		function выпуск(): Record<string, unknown> {
			const ссылка = document.getElementById('player-link') as HTMLAnchorElement | null;
			const название = ссылка?.textContent?.trim();
			let адрес = '';
			try {
				адрес = ссылка?.href ? new URL(ссылка.href).pathname : '';
			} catch {
				адрес = '';
			}
			return { episode: название || 'неизвестно', path: адрес };
		}

		function слушатьПлеер(audio: HTMLAudioElement) {
			if ((audio as any).__бакаПодписан) return;
			(audio as any).__бакаПодписан = true;

			// `playing`, а не `play`: первое значит «звук пошёл», второе —
			// только «нажали». У выпуска, который не смог загрузиться,
			// `play` придёт, а слушать будет нечего.
			audio.addEventListener('playing', () => {
				if (audio.currentSrc !== источник) {
					источник = audio.currentSrc;
					прослушано = 0;
					пройдено.clear();
					цель('player_start', выпуск());
				}
				прошлоеВремя = audio.currentTime;
			});

			audio.addEventListener('timeupdate', () => {
				const сейчас = audio.currentTime;
				const шаг = сейчас - прошлоеВремя;
				прошлоеВремя = сейчас;
				if (шаг > 0 && шаг <= 2) прослушано += шаг;

				const длина = audio.duration;
				if (!Number.isFinite(длина) || длина <= 0) return;
				const доля = (прослушано / длина) * 100;
				for (const [порог, имя] of ПОРОГИ) {
					if (доля >= порог && !пройдено.has(порог)) {
						пройдено.add(порог);
						цель(имя, выпуск());
					}
				}
			});
		}

		function найтиПлеер() {
			const audio = document.getElementById('player-audio') as HTMLAudioElement | null;
			if (audio) слушатьПлеер(audio);
		}
		найтиПлеер();
		// Панель переживает переходы через transition:persist, поэтому обычно
		// подписываться заново не нужно. Спрашиваем всё равно: это стоит один
		// поиск по идентификатору, а цена ошибки — молчащий плеер в отчётах.
		// Повторной подписки не будет, её отсекает метка на самом элементе.
		document.addEventListener('astro:page-load', найтиПлеер);

		// ── НАЖАТИЯ ─────────────────────────────────────────────────────────

		const платные = platformsOfKind('support').map((p: any) => p.url);
		const слушать = platformsOfKind('listen').map((p: any) => p.url);

		// СРАВНИВАЕМ ПО НАЧАЛУ АДРЕСА, А НЕ ПО ДОМЕНУ. По домену ссылка
		// на любой ролик YouTube из текста считалась бы «ушёл слушать
		// подкаст», а t.me/tribute не отличался бы от обычного канала.
		// Начало адреса площадки при этом накрывает и внутренние страницы:
		// boosty.to/bakapodcast ловит и посты, и корень.
		const начинается = (адрес: string, список: string[]) => список.some((u) => адрес.startsWith(u));

		document.addEventListener('click', (событие) => {
			const цельНажатия = событие.target as Element | null;
			if (!цельНажатия || typeof цельНажатия.closest !== 'function') return;

			// Транскрипт: развернуть целиком.
			if (цельНажатия.closest('.tr-expand')) {
				цель('transcript_open', { path: location.pathname });
				return;
			}

			// ПЕРЕМОТКА ИЗ РАСШИФРОВКИ СЧИТАЕТСЯ ПО ВСЕЙ РЕПЛИКЕ, А НЕ ПО ПЛАШКЕ
			// ВРЕМЕНИ. Так устроен сам транскрипт: мотает нажатие в любое место
			// блока, потому что читатель целится в реплику, которую хочет
			// услышать, а не в четыре цифры сбоку. Считай мы одну плашку —
			// цель показывала бы малую долю перемоток и врала бы в меньшую
			// сторону, а понять это по числам было бы нельзя.
			// НАЙДЕНО ПРИЁМКОЙ 26 августа 2026: заказчик прошёл по всем восьми
			// пунктам, а «нажал таймкод» осталось пустым.
			//
			// УСЛОВИЕ ПОВТОРЯЕТ ПРАВИЛО САЙТА ДОСЛОВНО (Transcript.astro):
			// не считается нажатие по ссылке (она ведёт на тайтл, а не мотает),
			// не считается выделение текста (человек копировал цитату),
			// и всё это только там, где плеер есть — в расшифровке без звука
			// блоки не кликабельны вовсе.
			const блок = цельНажатия.closest('.tr-block') as HTMLElement | null;
			if (
				блок &&
				блок.closest('.is-playable') &&
				!цельНажатия.closest('a') &&
				((window.getSelection?.()?.toString() ?? '').length === 0)
			) {
				цель('transcript_seek', {
					path: location.pathname,
					place: 'transcript',
					seconds: Number(блок.dataset.start ?? 0),
				});
				return;
			}

			// Строка списка таймкодов и метки времени в тексте выпуска —
			// их ловит PlayerBar своим кодом, у них общий класс .timecode.
			const метка = цельНажатия.closest('.timecode') as HTMLElement | null;
			if (метка) {
				цель('transcript_seek', {
					path: location.pathname,
					place: 'timecodes',
					seconds: Number(метка.dataset.seconds ?? 0),
				});
				return;
			}

			// Название тайтла. Один и тот же класс стоит и в тексте материала,
			// и в расшифровке — различаем параметром, а не двумя целями:
			// поступок один и тот же, разное только место.
			const тайтл = цельНажатия.closest('.anime-mention') as HTMLAnchorElement | null;
			if (тайтл) {
				цель('anime_link', {
					place: тайтл.classList.contains('tr-anime') ? 'transcript' : 'text',
					target: тайтл.getAttribute('href') ?? '',
					path: location.pathname,
				});
				return;
			}

			// Уход на площадку. Ссылки на площадки открываются в новой вкладке
			// (проверено по сборке), поэтому страница не выгружается и событие
			// успевает уйти. Ловим на всплытии, как и всё остальное: свой
			// обработчик, поставленный раньше роутера, тут не нужен — мы
			// ничего не отменяем.
			const ссылка = цельНажатия.closest('a[href]') as HTMLAnchorElement | null;
			if (!ссылка) return;
			const адрес = ссылка.href;
			if (начинается(адрес, платные)) цель('go_support', { target: адрес, path: location.pathname });
			else if (начинается(адрес, слушать)) цель('go_listen', { target: адрес, path: location.pathname });
		});

		// ── ПОИСК ПО САЙТУ ──────────────────────────────────────────────────
		//
		// СОБЫТИЕ ОДНО НА ЗАКОНЧЕННЫЙ ЗАПРОС, А НЕ НА БУКВУ. Выдача живая:
		// человек печатает «Волкйбол», и адрес меняется восемь раз. Google
		// сейчас записывает КАЖДОЕ такое изменение отдельным просмотром —
		// в его отчётах и лежат обрывки «Волкй», «Огляничь». Мы ждём паузы.
		//
		// И ЖДЁМ НЕ ТОЛЬКО ПАУЗЫ В НАБОРЕ, НО И ВЫДАЧИ. Поиск идёт в браузере
		// и отвечает не мгновенно; спроси число находок сразу после паузы —
		// получишь прошлое число или пустоту. Поэтому проверка повторяется,
		// пока страница не покажет результат, но не больше шести раз:
		// без предела мёртвый поиск опрашивался бы вечно.
		const ЖДАТЬ = 1200;
		const ПОВТОРОВ = 6;
		let таймерПоиска: ReturnType<typeof setTimeout> | undefined;
		let сказанный = '';
		let таймерТранскрипта: ReturnType<typeof setTimeout> | undefined;
		let сказанныйВТранскрипте = '';
		let таймерКаталога: ReturnType<typeof setTimeout> | undefined;

		// ПОИСКОВ НА САЙТЕ ТРИ, А НЕ ОДИН, И ТРЕТИЙ НАХОДИТСЯ ТОЛЬКО ЗАМЕРОМ.
		// Кроме страницы /search/ и поиска внутри расшифровки есть поиск
		// по каталогу тайтлов (#catalog-search на /anime/). Каталог — вторая
		// по посещаемости страница сайта, и пропустить его значило бы завести
		// счёт поиска мимо половины поисков.
		function подходитПоле(поле: any): boolean {
			if (!поле || !поле.classList) return false;
			return поле.classList.contains('s-input') || поле.classList.contains('tr-search') || поле.id === 'catalog-search';
		}

		/**
		 * Каталог фильтруется НА МЕСТЕ, без похода в сеть, поэтому ответ готов
		 * сразу и переспрашивать выдачу не нужно — в отличие от поиска
		 * по сайту, который ищет в скачанном указателе.
		 */
		let сказанныйВКаталоге = '';
		function проверитьКаталог() {
			const поле = document.getElementById('catalog-search') as HTMLInputElement | null;
			if (!поле) return;
			const запрос = поле.value.trim();
			if (!запрос || запрос === сказанныйВКаталоге) return;
			сказанныйВКаталоге = запрос;

			const пустота = document.getElementById('catalog-empty');
			const счётчик = document.getElementById('catalog-count');
			const пусто = Boolean(пустота && !пустота.hidden);
			const найдено = пусто ? 0 : Number((счётчик?.textContent ?? '').replace(/[^\d]/g, '')) || 0;

			цель('site_search', { query: запрос, found: найдено, place: 'catalog' });
			if (найдено === 0) цель('site_search_empty', { query: запрос, place: 'catalog' });
		}

		function проверитьПоиск(осталось: number) {
			const поле = document.querySelector<HTMLInputElement>('.s-input');
			if (!поле) return;
			const запрос = поле.value.trim();
			if (!запрос || запрос === сказанный) return;

			const мета = document.querySelector<HTMLElement>('.results-meta');
			const пустота = document.querySelector<HTMLElement>('.empty-state');
			const счётчик = document.querySelector<HTMLElement>('.results-count');

			const пусто = Boolean(пустота && !пустота.hidden);
			const естьВыдача = Boolean(мета && !мета.hidden);

			if (!пусто && !естьВыдача) {
				// Выдача ещё не готова. Спросим ещё раз, если попытки остались.
				if (осталось > 0) таймерПоиска = setTimeout(() => проверитьПоиск(осталось - 1), 500);
				return;
			}

			const найдено = пусто ? 0 : Number((счётчик?.textContent ?? '').replace(/[^\d]/g, '')) || 0;
			сказанный = запрос;
			// ПОМЕТКА МЕСТА ЕСТЬ У ОБОИХ ПОИСКОВ, И ЭТО НЕ УКРАШЕНИЕ:
			// пустая клетка в отчёте против заполненной читается поломкой,
			// а не «это другой поиск».
			цель('site_search', { query: запрос, found: найдено, place: 'site' });
			if (найдено === 0) цель('site_search_empty', { query: запрос, place: 'site' });
		}

		// Событие `input` всплывает, поэтому подписки на само поле не нужно:
		// поле пересоздаётся при переходах, документ — нет.
		document.addEventListener('input', (событие) => {
			const поле = событие.target as HTMLElement | null;
			if (!подходитПоле(поле)) return;

			if ((поле as HTMLElement).classList.contains('s-input')) {
				clearTimeout(таймерПоиска);
				таймерПоиска = setTimeout(() => проверитьПоиск(ПОВТОРОВ), ЖДАТЬ);
				return;
			}

			if ((поле as HTMLElement).id === 'catalog-search') {
				clearTimeout(таймерКаталога);
				таймерКаталога = setTimeout(проверитьКаталог, ЖДАТЬ);
				return;
			}

			// Поиск внутри расшифровки. Тут выдачи ждать не надо — она
			// считается на месте, — поэтому довольно паузы в наборе.
			clearTimeout(таймерТранскрипта);
			таймерТранскрипта = setTimeout(() => {
				const значение = (поле as HTMLInputElement).value.trim();
				if (!значение || значение === сказанныйВТранскрипте) return;
				сказанныйВТранскрипте = значение;
				цель('transcript_search', { query: значение, path: location.pathname });
			}, ЖДАТЬ);
		});

		// Переход на другую страницу — новый разговор: те же слова, набранные
		// заново, надо считать заново.
		document.addEventListener('astro:page-load', () => {
			сказанный = '';
			сказанныйВТранскрипте = '';
			сказанныйВКаталоге = '';
		});
	}
</script>
