---
// Площадки подкаста: строка с кнопкой и раскрывающаяся под ней панель.
// ТЗ — тз/тз-площадки-подкаста.md, макет «бака-площадки-в-плеере.html»,
// вариант 2 («колонки с волосяной линией»), утверждён 31 августа 2026.
//
// ОДИН КОМПОНЕНТ НА ТРИ МЕСТА, и второго заводить нельзя (§2 системы):
// строка подписи плеера выпуска (EpisodePlayer.astro, он же стоит
// у аудиоверсии видеоэссе), индекс подкаста и плашка «не удалось загрузить
// аудио» — там раньше висела ОДНА ссылка на первую площадку списка,
// решением заказчика 31 августа 2026 её заменяет этот же набор.
//
// ВЕРХНИЙ РЯД КОМПОНЕНТА НА СТРАНИЦЕ ВЫПУСКА И ЕСТЬ СТРОКА ПОДПИСИ ПЛЕЕРА.
// Слева в него отдаётся «бака! · выпуск №152» через <slot>, справа встаёт
// кнопка раскрытия. Панель — СОСЕД строки внутри одной коробки, а не её
// потомок: поэтому она раскрывается внутрь плеера, между строкой подписи
// и нижней линией, и наружу не выпадает ничего (ТЗ §4).
//
// ЧИСЛА СТРОКИ ВЗЯТЫ У ЖИВОГО САЙТА, А НЕ У МАКЕТА, И ЭТО ОСОЗНАННО.
// Макет и ТЗ описывают строку как flex с переносом, зазором 16 и отступом
// сверху 16; на сайте с самого начала стоит зазор 24, отступ 12 и грид
// вместо переноса на ≤620. Ведут себя оба одинаково — на телефоне кнопка
// уходит на свою строку, — расходятся только два числа и способ. Чинить
// расхождение в этой задаче заказчик не поручал; названо и оставлено.

import { platformsOfKind } from '../data/platforms.js';

interface Props {
	/**
	 * Идентификатор панели: `aria-controls` кнопки обязан на неё указывать,
	 * а компонентов на странице бывает несколько.
	 *
	 * СПРАШИВАЕТСЯ У ВЫЗЫВАЮЩЕГО, А НЕ ГЕНЕРИТСЯ ЗДЕСЬ. Случайное значение
	 * при сборке — это расхождение двух копий сайта (правило проекта:
	 * основной адрес и зеркало обязаны собираться байт в байт).
	 */
	id: string;
}

const { id } = Astro.props;

// Площадки берутся из общего списка сайта, своего здесь нет и быть не может:
// тот же список читают «О проекте» и разбор нажатий в счётчике. Порядок —
// тот, что записан в файле.
const listen = platformsOfKind('listen');
---

<div class="platforms">
	<div class="pf-row tech">
		<slot />

		{/* Это <button>, а не ссылка: он ничего не открывает, а раскрывает
		    (§22 системы, ТЗ §3). Подпись набрана строчными нарочно —
		    капслок ей даёт `.tech` у родителя, как и всему техническому
		    слою сайта; своего `text-transform` кнопка не заводит. */}
		<button type="button" class="pf-disc" aria-expanded="false" aria-controls={id}>
			Слушать в приложении <span class="pf-chevron" aria-hidden="true">↓</span>
		</button>
	</div>

	<div class="pf-panel" id={id}>
		<div class="pf-grid">
			{listen.map((platform) => (
				<a
					class="pf-cell tech"
					href={platform.url}
					target="_blank"
					rel="noopener noreferrer"
				>
					{platform.label}
					{/* СТРЕЛКА НАРУЖНАЯ И БЕРЁТСЯ ОБЩИМ КЛАССОМ, А НЕ ОПИСЫВАЕТСЯ
					    ЗДЕСЬ ЗАНОВО. `.ext-arrow` живёт в global.css одним домом
					    на пять мест: она уже разъезжалась по цвету, пока
					    описаний было пять. Он же ЯВНО назначает ей Inter —
					    знака ↗ в Literata не нарисовано вовсе, и без этого
					    браузер уходил по списку шрифтов дальше и на айфоне
					    доходил до эмодзи. Размер у каждого места свой. */}
					<span class="ext-arrow" aria-hidden="true">↗</span>
				</a>
			))}
		</div>

		{/* Строка RSS приезжает шагом 4. */}
	</div>
</div>

<script>
	// Переходы по сайту идут без перезагрузки (<ClientRouter />), собранный
	// скрипт браузер выполняет один раз за сессию — поэтому навешиваемся
	// на `astro:page-load`: оно приходит и при первом открытии страницы,
	// и после каждого перехода. Тот же приём у транскрипта и у панели плеера.
	function initPlatforms(root: HTMLElement) {
		const disc = root.querySelector<HTMLButtonElement>('.pf-disc');
		const panel = root.querySelector<HTMLElement>('.pf-panel');
		if (!disc || !panel) return;

		disc.addEventListener('click', () => {
			// Состояние спрашивается У РАЗМЕТКИ, а не хранится в переменной:
			// после перехода без перезагрузки узлы новые, а замыкание осталось
			// бы от прежней страницы.
			const opened = disc.getAttribute('aria-expanded') === 'true';
			disc.setAttribute('aria-expanded', String(!opened));
			panel.classList.toggle('is-open', !opened);
		});
	}

	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll<HTMLElement>('.platforms').forEach(initPlatforms);
	});
</script>

<style>
	/* ——— Строка: подпись слева, кнопка справа ——— */

	.pf-row {
		display: grid;
		gap: var(--sp-1);
		margin-top: var(--sp-3);
		color: var(--muted);
	}

	/* Кнопка в гриде растянулась бы на всю колонку вместе со своей невидимой
	   зоной нажатия — и панель раскрывалась бы от нажатия где угодно правее
	   подписи. У соседних <span> это незаметно, у кнопки это беда. */
	.pf-disc {
		justify-self: start;
	}

	@media (min-width: 621px) {
		.pf-row {
			display: flex;
			justify-content: space-between;
			/* Выравнивание по центру — не косметика: без него кнопка тянется
			   по высоте всей строки, а вместе с ней и зона нажатия ниже. */
			align-items: center;
			gap: var(--sp-6);
		}
	}

	/* ——— Кнопка раскрытия ———

	   Гарнитуру, кегль, трекинг и капслок кнопка наследует от `.tech`
	   у родителя: `button { font: inherit }` стоит в базе, а трекинг
	   и капслок наследуются сами. Здесь остаётся только то, чем кнопка
	   отличается от обычного текста строки. */
	.pf-disc {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		position: relative;
		padding: 0;
		border: 0;
		background: none;
		color: var(--accent-text);
	}

	/* ЗОНА НАЖАТИЯ 44, И ОНА ДОБИРАЕТСЯ НЕВИДИМОЙ НАКЛАДКОЙ (§25, ТЗ §3).
	   Арифметика: технический слой 11 px при межстрочном 1.35 даёт 14.85,
	   плюс по 15 сверху и снизу — 44.85. Сама строка подписи ниже 44,
	   растить её нельзя: она стоит внутри плеера и раздвинула бы его.
	   По бокам −8 — из макета; шире цель, но соседей у кнопки справа нет. */
	.pf-disc::after {
		content: '';
		position: absolute;
		left: -8px;
		right: -8px;
		top: -15px;
		bottom: -15px;
	}

	/* ДЛИТЕЛЬНОСТЬ ТОЛЬКО ИЗ ТОКЕНА, СВОЕГО ЧИСЛА ЗДЕСЬ БЫТЬ НЕ МОЖЕТ:
	   при `prefers-reduced-motion` токен обнуляется глобально, а вписанные
	   руками миллисекунды это обнуление обошли бы, и шеврон крутился бы
	   у человека, который движение отключил. */
	.pf-chevron {
		display: inline-block;
		transition: transform var(--transition-fast);
	}

	.pf-disc[aria-expanded='true'] .pf-chevron {
		transform: rotate(180deg);
	}

	/* ——— Панель ———

	   ВИДИМОСТЬ И РАСКЛАДКА В РАЗНЫХ СЕЛЕКТОРАХ (§2.1). Эти два правила
	   не задают ни `grid-template`, ни `flex-direction`, ни `gap`: сетка
	   площадок живёт ниже, на вложенном элементе, и приезжает шагом 3.
	   Совмещать их запрещено — четыре селектора режима перебивают по весу
	   почти любое правило раскладки, и раскладка молча перестаёт включаться.

	   ПРЯЧЕМ `display: none`, А НЕ ПРОЗРАЧНОСТЬЮ: в свёрнутом виде ссылки
	   площадок не должны ловиться табом (ТЗ §8). У транскрипта сделано
	   иначе — там прячут высотой, чтобы поиск браузера находил в свёрнутой
	   части; здесь требование обратное, и оба верны для своего блока. */
	.pf-panel {
		display: none;
		margin-top: var(--sp-4);
	}

	.pf-panel.is-open {
		display: block;
	}

	/* ——— Сетка площадок ———

	   РАСКЛАДКА ЖИВЁТ ЗДЕСЬ, НА ВЛОЖЕННОМ ЭЛЕМЕНТЕ, а видимость — выше,
	   у самой панели (§2.1). Сведи их в один селектор — и раскладка молча
	   перестала бы включаться, перебитая по весу.

	   `auto-fill`, и НИКОГДА `auto-fit` (§4.5). `auto-fit` схлопывает пустые
	   дорожки, и единственная площадка растянулась бы во всю ширину плеера.

	   ЗАЗОР ТОЛЬКО МЕЖДУ КОЛОНКАМИ. Междурядного нет нарочно: ряды разделяет
	   линия под каждой ячейкой, и зазор оторвал бы линию от того, что она
	   закрывает. */
	.pf-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		column-gap: var(--sp-6);
	}

	/* ЛИНИЯ ПРИНАДЛЕЖИТ ЯЧЕЙКЕ, А НЕ РЯДУ, И ЭТО ВИДНО.

	   При `auto-fill` последний ряд заполняется не целиком, и его нижняя
	   линия обрывается, не доходя до правого края. ЭТО НЕ ДЕФЕКТ И ЧИНИТЬ
	   ЭТО НЕЛЬЗЯ: дорисовка до края дала бы линию под пустотой — под местом,
	   где ссылки нет. Решение заказчика, записано в ТЗ отдельным пунктом.

	   Гарнитуру, кегль, трекинг и капслок даёт `.tech`; цвет свой, потому
	   что базовая ссылка на сайте акцентная, а название площадки чернильное.
	   Наведение и фокус ведут В акцент — тот же ход, что у строки площадки
	   на «О проекте» (`.platform-link`), второго языка для этого не заводим. */
	.pf-cell {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--sp-3);
		/* Дети грида с текстом обязаны уметь сжиматься (§4.2). */
		min-width: 0;
		min-height: 44px;
		border-bottom: 1px solid var(--line);
		color: var(--ink);
	}

	.pf-cell:hover,
	.pf-cell:focus-visible {
		color: var(--accent-text);
	}

	/* Размер стрелки — здесь, цвет и гарнитура — в общем классе. */
	.pf-cell .ext-arrow {
		font-size: 12px;
	}
</style>
