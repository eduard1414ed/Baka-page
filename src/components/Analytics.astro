---
// СЧЁТЧИКИ ПОСЕЩАЕМОСТИ: ЯНДЕКС.МЕТРИКА И GOOGLE ANALYTICS.
//
// Стоит ОДИН РАЗ в общем макете (src/layouts/Layout.astro) и попадает на все
// страницы сайта разом. Второй копии заводить нельзя: два счётчика на одной
// странице считают один визит дважды, и разъедутся они молча.
//
// В АДМИНКУ НЕ ПОПАДАЕТ, и для этого ничего не сделано специально: `/admin/`
// это обычный файл в `public/`, макета он не использует вовсе. Проверяется
// поиском по собранной странице админки, а не рассуждением.
//
// НОМЕРА СЧЁТЧИКОВ ЗДЕСЬ НЕ ЛЕЖАТ — они в src/lib/analytics.mjs, там же
// объяснены настройки. Пустой номер = счётчик не подключается, и решает это
// сам скрипт: разметки у компонента нет вовсе, только скрипт.
---

<script>
	// ── ЧТО ЗДЕСЬ ПРОИСХОДИТ ────────────────────────────────────────────────
	//
	// Три задачи, и каждая решена не так, как в готовом коде из панели.
	//
	// 1. САЙТ ПЕРЕКЛЮЧАЕТ СТРАНИЦЫ БЕЗ ПЕРЕЗАГРУЗКИ (<ClientRouter />). Готовый
	//    код обоих сервисов отправляет просмотр ОДИН РАЗ, при загрузке. У нас
	//    человек открыл главную, прочёл четыре поста и ушёл — счётчик записал бы
	//    ОДНУ страницу и «отказ». Поэтому у Метрики стоит `defer: true`
	//    (её родная настройка для таких сайтов, проверено по документации
	//    Яндекса, раздел про SPA), у Google — `send_page_view: false`,
	//    и просмотр отправляем сами на каждом переходе.
	//
	// 2. ЧУЖИЕ СКРИПТЫ НЕ ДОЛЖНЫ ЗАДЕРЖИВАТЬ ПОКАЗ СТРАНИЦЫ. Они начинают
	//    грузиться только ПОСЛЕ того, как страница полностью показана
	//    (событие `load`), и в свободную минуту браузера. Всё, что случилось
	//    до этого, не теряется: и `ym(...)`, и `gtag(...)` до загрузки
	//    складывают вызовы в очередь, а настоящий скрипт её разбирает.
	//
	// 3. СВОЙ ПРЕДПРОСМОТР В СТАТИСТИКУ НЕ ИДЁТ. Счётчики работают только
	//    на живых адресах; на `localhost` не срабатывает ничего.
	//
	// ВЫПОЛНЯЕТСЯ РОВНО ОДИН РАЗ ЗА ОТКРЫТИЕ САЙТА, И ЭТО ЗАПЕРТО ЗАЩЁЛКОЙ,
	// А НЕ ОБЕЩАНИЕМ. Сборщик вкладывает этот скрипт прямо в каждую страницу
	// (проверено разбором dist/: `<script type="module">` длиной около 1,2 КБ,
	// отдельного файла нет). Запустит ли <ClientRouter /> вложенный скрипт
	// заново при переходе — внутреннее дело Astro, оно может измениться
	// с обновлением. А цена ошибки высокая и НЕЗАМЕТНАЯ: каждый переход
	// подписывался бы на события ещё раз, и просмотры удваивались бы,
	// утраивались — в отчётах это выглядит как «сайт растёт».
	// Защёлка на `window` переживает переход (страница-то не перезагружалась)
	// и делает вопрос ненужным.
	import { YM_ID, GA_ID, YM_WEBVISOR, считаемЭтотАдрес } from '../lib/analytics.mjs';

	if (!(window as any).__бакаСчётчики && считаемЭтотАдрес(location.hostname)) {
		(window as any).__бакаСчётчики = true;
		// ── Очереди. Ставятся ДО загрузки чужих скриптов ────────────────────
		//
		// `ym.l` — время создания очереди, Метрика по нему считает, сколько
		// человек ждал. Без него в отчёте о скорости будет мусор.
		const w = window as any;

		if (YM_ID) {
			w.ym =
				w.ym ||
				function () {
					(w.ym.a = w.ym.a || []).push(arguments);
				};
			w.ym.l = 1 * (new Date() as any);
			w.ym(YM_ID, 'init', {
				// Не отправлять просмотр самой при запуске — отправим сами.
				defer: true,
				// Карта кликов: куда на странице нажимают. Это НЕ Вебвизор,
				// записи поведения тут нет, и в панели она отдельная.
				clickmap: true,
				// Считать нажатия по ссылкам наружу. У нас их много —
				// на выпуски, на площадки, на источники в текстах.
				trackLinks: true,
				// Не считать отказом визит длиннее 15 секунд. Для сайта,
				// где страницу открывают ЧИТАТЬ, это обязательная поправка:
				// без неё человек, прочитавший статью и ушедший, — «отказ».
				accurateTrackBounce: true,
				// Вебвизор — решение заказчика, см. src/lib/analytics.mjs.
				webvisor: YM_WEBVISOR,
			});
		}

		if (GA_ID) {
			w.dataLayer = w.dataLayer || [];
			w.gtag =
				w.gtag ||
				function () {
					w.dataLayer.push(arguments);
				};
			w.gtag('js', new Date());
			w.gtag('config', GA_ID, {
				// Просмотр отправляем сами, на каждом переходе.
				send_page_view: false,
			});
		}

		// ── ОТПРАВКА ПРОСМОТРА ──────────────────────────────────────────────
		//
		// РЕШАЕТ АДРЕС, А НЕ СОБЫТИЕ. Первый просмотр отправляется сразу,
		// не дожидаясь `astro:page-load`, — иначе достаточно одной поломки
		// в чужом событии, чтобы не посчиталось НИЧЕГО и никто об этом
		// не узнал. А `astro:page-load` приходит и при обычном открытии
		// страницы тоже, то есть на первый просмотр придут ДВА вызова.
		// Поэтому вызов один и тот же, а повтор отсекается по адресу:
		// сколько раз ни спроси — просмотр уйдёт один.
		let последний: string | null = null;

		function отметить() {
			const url = location.href;
			if (url === последний) return;
			const откуда = последний;
			последний = url;

			// ОТКУДА ПРИШЛИ. При переходе внутри сайта `document.referrer`
			// НЕ МЕНЯЕТСЯ (страница-то не перезагружалась) — он так и остаётся
			// тем, с которого открыли вкладку. Оставь его как есть, и в отчёте
			// «источники» каждый внутренний переход выглядел бы новым приходом
			// из поиска. Поэтому со второго просмотра подставляем предыдущую
			// страницу сами, а на первом молчим — там браузерный referrer
			// настоящий, и сервисы возьмут его сами.
			if (YM_ID) {
				w.ym(YM_ID, 'hit', url, {
					title: document.title,
					...(откуда ? { referer: откуда } : {}),
					// ПАРАМЕТР ВИЗИТА «Адрес сайта» — ЭТИМ РАЗДЕЛЯЮТСЯ ЗЕРКАЛО
					// И ОСНОВНОЙ АДРЕС. Счётчик один на обе копии (иначе один
					// человек, перешедший с зеркала на основной, считался бы
					// двумя), а в отчёте «Параметры визитов» видно, кого
					// сколько. У Google для этого есть готовое измерение
					// «Имя хоста», своего параметра ему не нужно.
					params: { 'Адрес сайта': location.hostname },
				});
			}

			if (GA_ID) {
				w.gtag('event', 'page_view', {
					page_location: url,
					page_title: document.title,
					page_referrer: откуда ?? document.referrer,
				});
			}
		}

		отметить();
		document.addEventListener('astro:page-load', отметить);

		// ── ЗАГРУЗКА ЧУЖИХ СКРИПТОВ — В ПОСЛЕДНЮЮ ОЧЕРЕДЬ ───────────────────
		//
		// Ждём, пока страница покажется целиком (`load`), и потом первой
		// свободной минуты браузера. У ожидания есть ПРЕДЕЛ (1 секунда):
		// на слабом телефоне свободной минуты можно не дождаться вовсе,
		// и без предела счётчик не загрузился бы никогда.
		function загрузить(src: string) {
			const script = document.createElement('script');
			script.async = true;
			script.src = src;
			document.head.appendChild(script);
		}

		function позвать() {
			const дело = () => {
				if (YM_ID) загрузить('https://mc.yandex.ru/metrika/tag.js');
				if (GA_ID) загрузить(`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`);
			};
			if ('requestIdleCallback' in window) w.requestIdleCallback(дело, { timeout: 1000 });
			else setTimeout(дело, 200);
		}

		if (document.readyState === 'complete') позвать();
		else window.addEventListener('load', позвать, { once: true });
	}
</script>
