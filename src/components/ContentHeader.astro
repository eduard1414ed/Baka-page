---
// Заголовочный блок статьи, заметки и видеоэссе. В макетах это `.content-header`
// (article.html и video.html), в дизайн-системе — §12.
//
// ОДИН КОМПОНЕНТ НА ТРИ РАСКЛАДКИ, И ЭТО ГЛАВНОЕ В НЁМ. У статьи и видеоэссе
// совпадают ось (700), метастрока, кегль H1 и вертикальные отступы; отличается
// ровно одна вещь — необязательная подводка, которой у видеоэссе нет. Разведи
// это на два похожих компонента — и они разойдутся: сначала отступом снизу,
// потом порядком даты и длительности, и заметить это будет некому, потому что
// две страницы рядом никто не открывает.
//
// Выпуск подкаста и бонус сюда НЕ ходят: у них своя шапка с обложкой 1:1
// и плеером (§13), общего с этой у неё только текст ссылки «← назад».
import { formatPostDate } from '../lib/postDate.mjs';

interface Props {
	/** Куда ведёт «← Назад», когда возвращаться некуда: раздел материала.
	    Подпись у ссылки одна на весь сайт и живёт в разметке ниже. */
	backHref: string;
	date: Date;
	/** «6 мин читать» или «19 мин смотреть». null — показывать нечего. */
	timing?: string | null;
	title: string;
	/** Подводка. Есть только у статьи и заметки, и только если её написали. */
	lead?: string | null;
}

const { backHref, date, timing = null, title, lead = null } = Astro.props;
---

<header class="content-header">
	{/* data-pagefind-ignore на всей метастроке: дата и «6 мин читать» — это
	    подписи, а не текст материала. Без него они попадали бы в выдачу поиска
	    обрывком вроде «…6 мин читать Ёдзи Такэсигэ — один из главных…». */}
	<div class="content-meta tech" data-pagefind-ignore>
		{/* «Назад» ведёт НАЗАД, а не в раздел: раздел был неожиданностью —
		    человек пришёл с главной, а уходил в «Заметки». Возвращает его
		    скрипт макета (одно место на весь сайт, помечено `data-back`),
		    а адрес в ссылке остаётся запасным путём: с него начинали сеанс,
		    возвращаться некуда. */}
		<a class="back" href={backHref} data-back>← Назад</a>
		<div class="content-meta-right">
			<time datetime={date.toISOString().slice(0, 10)}>{formatPostDate(date)}</time>
			{
				timing && (
					<Fragment>
						<span class="meta-dot" aria-hidden="true">
							·
						</span>
						<span>{timing}</span>
					</Fragment>
				)
			}
		</div>
	</div>
	<h1 data-pagefind-meta="title">{title}</h1>
	{lead && <p class="lead">{lead}</p>}
</header>

<style>
	.content-header {
		width: 100%;
		max-width: var(--reading);
		margin: var(--sp-12) auto var(--sp-8);
	}

	/* МЕТАСТРОКА В РЯД НА ЛЮБОЙ ШИРИНЕ, А ПЕРЕНОС РЕШАЕТ САМА РАСКЛАДКА
	   (12 августа 2026).

	   Раньше ниже 621 она вставала в столбик, и довод был: «← Заметки» плюс
	   дата с длительностью не помещаются в строку на 320 px. Довод устарел
	   в тот день, когда подпись ссылки стала короткой — «← Назад» вместо
	   названия раздела: замер по 21 собранной странице дал самую длинную
	   метастроку 338.7 px, и на телефоне заказчика (393) она влезает
	   с запасом. Но не на всяком: на 320 и 360 не влезает по-прежнему,
	   а на 375 запас 0.3 px, то есть первая же дата вроде «29 сентября 2026»
	   его съест.

	   Поэтому не назначаем новую точку перелома числом — её пришлось бы
	   пересчитывать при каждой правке подписи. `flex-wrap: wrap` роняет
	   правую половину на вторую строку ровно тогда, когда она не поместилась,
	   и это в точности прежний столбик. ТА ЖЕ РАСКЛАДКА У ШАПКИ ВЫПУСКА
	   (`.episode-topline` в posts/[slug].astro) — там она с самого начала
	   такая, и статья была отставшей половиной.

	   Боковой зазор здесь `--sp-4`, а не `--sp-6` как у выпуска: при
	   `space-between` он ничего не раздвигает (половины и так разъехались
	   по краям) и работает только порогом переноса, а 8 лишних пикселей
	   порога — это ровно та разница, из-за которой строка на телефоне
	   перескочит на две. */
	.content-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--sp-2) var(--sp-4);
		margin-bottom: var(--sp-4);
		color: var(--muted);
	}

	.back {
		color: var(--ink);
	}

	.back:hover,
	.back:focus-visible {
		color: var(--accent-text);
	}

	/* ПО БАЗОВОЙ ЛИНИИ, А НЕ ПО ЦЕНТРУ. Слева ссылка со стрелкой, справа дата
	   с длительностью — это две строки одного текста, и человек читает их
	   по одной линии букв. `center` выравнивает КОРОБКИ: стоит их высотам
	   разойтись на пиксель (другая гарнитура у стрелки, округление строки),
	   и текст встаёт на разной высоте. Выглядит как съехавшая вёрстка,
	   а причина невидима. */
	.content-meta-right {
		display: flex;
		align-items: baseline;
		gap: var(--sp-2);
	}

	/* Точка-разделитель отдельным элементом, а не псевдоэлементом: когда
	   длительности нет, её не должно остаться висеть после даты. */
	.meta-dot {
		color: var(--line);
	}

	.content-header h1 {
		margin: 0;
	}

	/* Вид крупного абзаца — общий `.lead` в src/styles/global.css: тот же
	   абзац стоит на странице «Поддержать», и двух описаний у него быть
	   не должно. Здесь остаётся только зазор от заголовка. */
	.lead {
		margin: var(--sp-4) 0 0;
	}

	/* На широком экране от метастроки до заголовка воздуха больше — это всё,
	   что осталось от прежнего медиазапроса: раскладку он больше не трогает. */
	@media (min-width: 621px) {
		.content-meta {
			margin-bottom: var(--sp-6);
		}
	}

	@media (min-width: 1101px) {
		.content-header {
			margin: var(--sp-16) auto var(--sp-12);
		}
	}
</style>
