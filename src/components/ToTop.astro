---
// Кнопка «наверх» (тз/10.6). Один экземпляр на весь сайт, живёт в Layout.astro.
//
// ЭТОГО ЭЛЕМЕНТА НЕТ НИ В ОДНОМ МАКЕТЕ — решение заказчика от 10 августа 2026.
// Поэтому вид у неё не перенесён, а СОБРАН ИЗ ТОКЕНОВ: технический слой 11 px
// прописными, фон бумаги, контур той же линией `--line`, что у рамок контролов,
// наведение `--accent-text`. Ни скругления, ни тени — плиток в языке сайта нет
// (§1 дизайн-системы). Ни одного нового размера, цвета или формы она не вводит,
// и записана отдельным пунктом в дизайн-системе, чтобы следующая приёмка
// не принесла её как самодеятельность.
//
// ПОЯВЛЯЕТСЯ, КОГДА НЕ ВИДНО ШАПКИ. Не «после двух экранов» и не «после 600
// пикселей»: порог в пикселях означал бы разное на телефоне и на мониторе,
// а «шапка ушла за верхний край» проверяется однозначно и объясняет себя сам.
//
// ПРЯЧЕТСЯ, КОГДА ВИДЕН ПОДВАЛ, и это не украшение. Кнопка закреплена в том же
// правом нижнем углу, где у подвала стоят ссылки на площадки и RSS, — домотав
// страницу до низа, она накрыла бы их собой и съела нажатие. Выбрано заказчиком
// 10 августа 2026 из трёх названных вариантов; цена названа: в самом низу
// страницы кнопки нет. Там, впрочем, прямо перед глазами подвал, а до шапки
// от него один рывок колесом.
//
// НАД МИНИ-ПЛЕЕРОМ, И СВОЕГО СЛЕЖЕНИЯ ЗА ПЛЕЕРОМ ЗДЕСЬ НЕТ. Панель уже
// объявляет о себе классом `body.has-player` (см. PlayerBar.astro) — кнопке
// довольно одного правила CSS. Второй механизм слежения за тем же состоянием
// разъехался бы с первым молча.
//
// В ПОИСК НЕ ИДЁТ дважды: она лежит за пределами `data-pagefind-body` (тот
// стоит на самой статье) и вдобавок помечена `data-pagefind-ignore` — на случай
// если однажды переедет внутрь. То же правило, что у хвостовых блоков со
// ссылками. В печать не идёт правилом `@media print` ниже.
---

<button id="to-top" class="to-top tech" type="button" hidden data-pagefind-ignore>Наверх ↑</button>

<script>
	// Наблюдатель пересоздаётся на каждой странице: сама кнопка переход
	// не переживает (transition:persist у неё нет), а шапка и подвал —
	// новые элементы, и следить надо за ними, а не за ушедшими.
	let watcher: IntersectionObserver | null = null;

	function bindToTop() {
		const button = document.getElementById('to-top') as HTMLButtonElement | null;
		if (!button) return;

		// ПЕРВЫЙ `header` на странице, а не единственный: у статьи, заметки
		// и видеоэссе заголовочный блок — тоже `<header>` (ContentHeader.astro),
		// и он идёт ВТОРЫМ. Шапка сайта стоит в разметке раньше всего
		// остального, поэтому «первый» — это правило, а не совпадение.
		// Подвал на странице один, но берём последний по той же причине.
		const headers = document.querySelectorAll('header');
		const footers = document.querySelectorAll('footer');
		const header = headers[0] ?? null;
		const footer = footers[footers.length - 1] ?? null;

		watcher?.disconnect();
		watcher = null;

		// До первого ответа наблюдателя считаем, что видно и то и другое:
		// страница открывается сверху, шапка перед глазами. Иначе кнопка
		// успевала бы мигнуть на первом кадре каждой страницы.
		let headerSeen = Boolean(header);
		let footerSeen = Boolean(footer);

		const update = () => {
			button.hidden = headerSeen || footerSeen;
		};
		update();

		if (!header && !footer) return;

		watcher = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				if (entry.target === header) headerSeen = entry.isIntersecting;
				if (entry.target === footer) footerSeen = entry.isIntersecting;
			}
			update();
		});
		if (header) watcher.observe(header);
		if (footer) watcher.observe(footer);

		button.addEventListener('click', () => {
			// ПЛАВНОСТЬ РЕШАЕТ ОДНО МЕСТО — `scroll-behavior` у `html`
			// в global.css, и там же она снимается при «уменьшить движение».
			// Написать здесь `behavior: 'smooth'` значило бы ПЕРЕБИТЬ это
			// правило и увезти анимацию тем, кто попросил её не показывать:
			// явное значение в скрипте сильнее любого CSS. Пустое `top: 0`
			// спрашивает стили, и ответ у них уже правильный.
			window.scrollTo({ top: 0 });
		});
	}

	document.addEventListener('astro:page-load', bindToTop);
</script>

<style>
	/* `display` тут не задан НАРОЧНО. Кнопка и так строчно-блочная, содержимое
	   браузер центрует ей сам, а правило с `display` весило бы больше сброса
	   `[hidden]{display:none}` из global.css — и кнопка висела бы на экране
	   всегда, при совершенно правильной разметке. Эти грабли в проекте
	   срабатывали трижды; проще не заводить спора вовсе, чем выигрывать его
	   уточнением `:not([hidden])`. */
	.to-top {
		position: fixed;
		/* Ниже закреплённой панели плеера (60): пересекаться им негде, но если
		   однажды придётся, главной остаётся панель — она управляет звуком. */
		z-index: 50;
		right: var(--gutter);
		bottom: var(--gutter);
		/* Цель нажатия целиком, без добора накладкой: это отдельная кнопка,
		   а не ссылка внутри строки текста, и исключение части 11 сюда
		   не распространяется. По ширине выходит около 90 px — подпись
		   и стрелка. */
		min-height: 44px;
		padding: 0 var(--sp-3);
		border: 1px solid var(--line);
		background: var(--paper);
		color: var(--ink);
		transition:
			border-color var(--transition-fast),
			color var(--transition-fast);
	}

	.to-top:hover,
	.to-top:focus-visible {
		border-color: var(--accent-text);
		color: var(--accent-text);
	}

	@media print {
		.to-top {
			display: none;
		}
	}
</style>

<style is:global>
	/* ПОДНИМАЕТСЯ НАД ПАНЕЛЬЮ ПЛЕЕРА, И ЧИСЛА ТУТ СЧИТАНЫ, А НЕ ВЗЯТЫ НА ГЛАЗ.
	   Мешает не сама панель, а невидимая зона перемотки: ползунок `.mini-range`
	   растёт ВВЕРХ на 34 px над панелью во всю её ширину (см. комментарий
	   к нему в PlayerBar.astro). Встань кнопка в эту полосу — она отняла бы
	   у перемотки правый край, то есть конец выпуска, а перетаскивание туда
	   дотаскивают часто.
	     до 621:  панель 1 + 10 + 44 + 10 = 65, зона перемотки кончается на 98;
	     от 621:  панель 1 + 12 + 44 + 12 = 69, зона кончается на 102.
	   Отсюда и оба числа. Видимый зазор от панели получается те самые 34 px —
	   это не воздух «на глаз», а ровно высота зоны, в которую нельзя вставать.

	   Правило живёт в глобальном блоке, потому что `body.has-player` ставит
	   не этот компонент, а панель плеера: в scoped-блоке Astro приписала бы
	   свою метку и к `body`. */
	body.has-player .to-top {
		bottom: 98px;
	}

	@media (min-width: 621px) {
		body.has-player .to-top {
			bottom: 102px;
		}
	}
</style>
