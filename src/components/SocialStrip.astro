---
// Блок соцсетей — «Ещё немного нас» (раздел 10.4 ТЗ) и он же «Бака! в других
// местах» на главной (раздел 10.5). ОДИН КОМПОНЕНТ НА ДВА МЕСТА, и второго
// быть не должно: до 10.5 разметка и стили лежали внутри about.astro, и первое
// же желание поставить блок на главную означало бы копию, которая разъедется
// молча — так уже разъехались пять описаний стрелки ↗.
//
// СОСТАВ РЕШАЕТ СПИСОК ПЛОЩАДОК, А НЕ МАКЕТ. Макет рисует Telegram, YouTube
// и TikTok, но в src/data/platforms.js YouTube помечен `listen` (его место —
// в «Слушать подкаст»), зато среди соцсетей появился чат. Правило принято
// заказчиком на «О проекте», здесь оно же. Своего списка блок не хранит.
//
// ОТБИВКА И ПЕРЕЛОМ — ЕДИНСТВЕННОЕ, ЧТО ЗАВИСИТ ОТ МЕСТА. В ленте главной блок
// стоит среди редакционных рядов, и отбивка у него рядовая, как у соседей;
// на «О проекте» он секция страницы со своей. Это переключает признак `inFeed`,
// и оба случая описаны ЗДЕСЬ, в одном файле: правило страницы весило бы ровно
// столько же, сколько правило компонента, и кто победит, решал бы порядок
// файлов в сборке.
import { platformsOfKind } from '../data/platforms.js';

// ТЕКСТЫ ЖИВУТ ЗДЕСЬ, А НЕ НА ШЕСТИ СТРАНИЦАХ. Во всех макетах, где стоит этот
// блок, надзаголовок и заголовок одни и те же; написать их на каждой странице
// значило бы завести шесть копий двух строчек. Исключение — «О проекте»:
// там надзаголовок правится в админке и приходит сюда полем.
const DEFAULT_NOTE = 'Бака! в других местах';

interface Props {
	/** Надзаголовок над заголовком. `''` — строчки нет вовсе (так очищенное
	    поле админки на «О проекте» и значит), не передан — берётся общий. */
	note?: string;
	/** Заголовок блока. Одинаков везде; пусто — берётся общий. */
	title?: string;
	/** Блок стоит внутри ленты главной, а не отдельной секцией страницы. */
	inFeed?: boolean;
}

const { note, title, inFeed = false } = Astro.props;

const heading = title?.trim() || 'Ещё немного нас';
const eyebrow = note === undefined ? DEFAULT_NOTE : note.trim();

const social = platformsOfKind('social');

// В ПОИСК БЛОК НЕ ИДЁТ (`data-pagefind-ignore` на секции). Он стоит на страницах
// материалов и тайтлов, а те индексируются целиком — и «Telegram · Новости,
// мысли и новые материалы» лезло бы в цитату выдачи у каждого выпуска, а запрос
// «телеграм» находил бы весь сайт разом. Это обвязка, а не текст материала:
// так же помечены навигация и блок упоминаний.
---

{
	social.length > 0 && (
		<section
			class="social-strip"
			class:list={{ 'in-feed': inFeed }}
			aria-labelledby="social-title"
			data-pagefind-ignore
		>
			<div class="social-intro">
				{eyebrow && <div class="eyebrow tech">{eyebrow}</div>}
				<h2 id="social-title">{heading}</h2>
			</div>
			{social.map((platform) => (
				<a class="social-link" href={platform.url} target="_blank" rel="noopener noreferrer">
					<span class="social-name">
						<span>{platform.label}</span>
						<span class="social-arrow ext-arrow" aria-hidden="true">
							↗
						</span>
					</span>
					{/* Описание живёт у самой площадки в platforms.js, а не в админке:
					    второй список площадок с подписями разошёлся бы с этим при первом
					    же переименовании. Площадка без описания рисуется одной строкой
					    названия. */}
					{platform.desc && <span class="social-desc">{platform.desc}</span>}
				</a>
			))}
		</section>
	)
}

<style>
	/* НА УЗКОМ ЭКРАНЕ БЛОК СЖАТ ДО ТРЁХ ССЫЛОК В РЯД, БЕЗ ОПИСАНИЙ.
	   Решение заказчика 10 августа 2026: столбиком из трёх строк с описаниями
	   блок занимал почти весь экран телефона, а сказать ему нужно немного —
	   вот три места, где нас можно найти.

	   Линию сверху блок рисует себе сам — так же, как её рисуют себе секции
	   «О проекте» и редакционные ряды главной. Двух линий на стыке от этого
	   не выходит: у соседей снизу линии нет. */
	/* СТОЛБЦЫ РАВНЫЕ, НО С ПОЛОМ ПО СОДЕРЖИМОМУ — `flex: 1 1 0` вместо трёх
	   долей грида. Разница видна ровно там, где кончается место: доля грида
	   сжимает ячейку насильно, и подпись со стрелкой в ней ломались; гибкая
	   ячейка ниже своего содержимого не сжимается, а весь блок переносится
	   на вторую строку целиком. То есть не помещается — переносится ссылка,
	   а не рвётся её подпись. Зазора между столбцами нет: на экране 320 три
	   пары занимают 238 px из 284, и весь остаток — это воздух после каждой. */
	.social-strip {
		display: flex;
		flex-wrap: wrap;
		column-gap: 0;
		row-gap: 0;
		padding: var(--sp-8) 0;
		border-top: 1px solid var(--line);
	}

	/* ЛИНИЮ НАД РЯДОМ РИСУЕТ ШАПКА БЛОКА, А НЕ САМИ ССЫЛКИ. Раньше её рисовал
	   каждый `.social-link` своим `border-top`, и в столбик это давало по линии
	   на строчку. В ряду те же три границы разорвались бы на три отрезка
	   по зазорам сетки — ровно та беда, из-за которой в архиве линии рисуются
	   псевдоэлементом. Здесь достаточно одной непрерывной: она принадлежит
	   шапке. Вертикальных между столбцами нет нарочно — они встретились бы
	   с этой углом, а углы превращают блок в таблицу (§5). */
	.social-intro {
		flex: 1 0 100%;
		padding-bottom: 20px;
		border-bottom: 1px solid var(--line);
	}

	.social-intro h2 {
		margin: 0;
		font-size: var(--h3);
		line-height: 1.12;
	}

	.social-link {
		flex: 1 1 0;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--sp-2);
		/* Цель нажатия набирается высотой самой строки: 18 + 18 сверху и снизу
		   плюс текст — заведомо больше 44 px даже без описания. */
		padding: 18px 0;
		text-decoration: none;
	}

	/* ПОДПИСЬ И СТРЕЛКА — ОДНО НЕРАЗРЫВНОЕ ЦЕЛОЕ, и это правка по живому сайту.
	   Сначала они стояли `space-between`, то есть расталкивались по краям своего
	   столбца, а перенос между ними был разрешён: на узком экране стрелка
	   уходила под подпись, причём у разных ссылок по-разному — у «TIKTOK»
	   оставалась в строке, у соседей падала вниз. Разнобой заказчик увидел
	   первым же взглядом.

	   Теперь `nowrap` держит пару вместе целиком — вместе с пробелом внутри
	   «НАШ ЧАТ», который тоже мог разорваться, — а зазор до стрелки задан
	   числом, а не остатком ширины. Меры по файлу `Inter-Variable.woff2`
	   в начертании 600: пара «TELEGRAM ↗» — 90 px, все три вместе 238 px
	   при 284 доступных на экране 320. Помещаются с запасом, и `overflow-wrap`
	   до слов не добирается: при `nowrap` он не действует вовсе. */
	.social-name {
		display: flex;
		gap: var(--sp-1);
		white-space: nowrap;
		font-size: var(--caption);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink);
	}

	/* Только кегль: цвет и начертание приходят из общего `.ext-arrow`.
	   Повтори их тут — и через сессию они разойдутся с остальными четырьмя
	   стрелками, а заметить это будет некому. */
	.social-arrow {
		font-size: 16px;
	}

	/* Описания на узком экране нет: блок сжат до трёх имён в ряд, и объяснять
	   ему нечем — места нет. Из разметки строчка при этом не убрана: она
	   принадлежит площадке (`desc` в platforms.js), а не экрану, и на широком
	   возвращается правилом в медиазапросе ниже. */
	.social-desc {
		display: none;
		font-size: var(--body-sm);
		line-height: 1.5;
		color: var(--muted);
	}

	/* ПЕРЕЛОМ 761, А НЕ 821, И ЭТО ОДНО ЧИСЛО НА ОБЕ СТРАНИЦЫ.
	   Дизайн-система знает три брейкпоинта — 621, 821, 1101, — и блок стоял
	   на 821 с части 10.4. Но редакционные ряды главной ломаются на 761 (это
	   исключение системы, заведённое ещё для сеток фильтра), и в полосе
	   761–820 блок оказывался единственным столбиком среди колонок: в ленте
	   это читается выпадением из ритма, а не решением.
	   Цена названа заказчику и принята 9 августа 2026: на «О проекте» блок
	   теперь делится на колонки на 60 px раньше соседних секций. Второго числа
	   тут быть не может — иначе у одного блока два описания раскладки. */
	@media (min-width: 761px) {
		/* Сетка возвращается: здесь у блока двенадцать колонок и описания
		   под подписями, а пара «подпись — стрелка» снова расходится по краям
		   своей колонки, как в макете. Места на это тут заведомо хватает. */
		.social-strip {
			display: grid;
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--grid-gap);
			align-items: start;
		}

		.social-name {
			justify-content: space-between;
			gap: var(--sp-4);
			white-space: normal;
		}

		.social-intro {
			grid-column: 1 / 4;
			padding: 0 var(--sp-6) 0 0;
			/* Линия шапки — только для сжатого ряда: здесь её роль играют
			   вертикальные границы столбцов, и вместе они дали бы угол. */
			border-bottom: 0;
		}

		.social-link {
			grid-column: span 3;
			min-height: 78px;
			padding: var(--sp-1) 18px var(--sp-1) 22px;
			border-left: 1px solid var(--line);
			transition: background var(--transition-fast);
		}

		.social-link:hover,
		.social-link:focus-visible {
			background: var(--accent-soft);
		}

		/* Описание возвращается: в колонке 3/12 ему есть где встать. */
		.social-desc {
			display: block;
			max-width: 18em;
		}

		/* В ЛЕНТЕ ОТБИВКА РЯДОВАЯ, как у соседних редакционных рядов: у них
		   `--sp-8` на узком экране и `--sp-12` на широком. На узком блок и так
		   совпадает с ними, поэтому число тут одно. Своя отбивка выдала бы
		   блок гостем в ленте — ровно то, чего требует избежать раздел 3 ТЗ. */
		.social-strip.in-feed {
			padding: var(--sp-12) 0;
		}
	}
</style>
