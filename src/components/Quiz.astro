---
// Тело теста: вопросы и варианты (сессия «Тесты-3»). Правила —
// тз/ТЗ-тесты.md, §4; вид — тз/макеты-тесты.html, экран 3, вариант A.
//
// СТОИТ РЯДОМ С ТЕКСТОМ МАТЕРИАЛА, А НЕ ВНУТРИ НЕГО (`.content`). Правила
// текста статьи (`.content p / ul / h2` в posts/[slug].astro) ставят любому
// абзацу и списку внутри себя кегль 18, отступы и точку «•», и перебить их
// можно только наращиванием веса — дизайн-система (§2.1) называет это
// признаком беды, а проект — открытой дырой «страничные правила
// дотягиваются внутрь компонентов». Отдельным блоком под текстом спорить
// не с кем: вступление остаётся текстом статьи, вопросы — свои.
//
// БЕЗ СКРИПТА СТРАНИЦА ПОКАЗЫВАЕТ ВОПРОСЫ И ВАРИАНТЫ ТЕКСТОМ (ТЗ §4) —
// так их видят поисковики. Пояснения к вопросам и реплики лежат
// в `<template>`: туда не заглядывают ни поиск по сайту, ни поисковый робот,
// и ответы викторины не попадают цитатами в выдачу (решение заказчика
// 9 октября 2026). Какой вариант верный — меткой `data-correct` у варианта:
// метки поиск не читает.
//
// ЗНАЧКИ ✓ И ✗ — SVG ПРЯМО В РАЗМЕТКЕ, не знаки шрифта: в урезанных шрифтах
// сайта их нет, и на айфоне на их место встал бы цветной эмодзи (ТЗ §4).
interface Image {
	src: string;
	srcset: string | null;
	alt: string;
	ratio: number | null;
}

interface Props {
	kind: 'quiz' | 'personality';
	total: number;
	/** Название теста — подпись блока результата (его скринят без страницы). */
	title: string;
	questions: {
		n: number;
		text: string;
		images: Image[];
		options: { text: string; correct: boolean; reply: string }[];
		explanationHtml: string;
	}[];
	results: {
		slug: string;
		title: string;
		image: Image | null;
		textHtml: string;
		from: number | null;
		to: number | null;
		postsHtml: string;
	}[];
}

const { kind, total, title, questions, results } = Astro.props;

// Слово через дефис («VHS-полка», «что-то») в заголовке результата не рвём
// по строкам (ТЗ §4): такие слова уходят в неразрывную обёртку.
const withNobr = (text: string) => text.split(/(\S+-\S+)/).map((part, i) => ({ part, nobr: i % 2 === 1 }));

// Блоки результатов в этой сессии — только у викторины: подсчёт личностного
// теста — сессия «Тесты-4», до неё его результат показать нечем.
const shownResults = kind === 'quiz' ? results : [];

// Четыре картинки — два ряда по две (2 × 2), остальные — одним рядом.
const rowsOf = (images: Image[]) => (images.length === 4 ? [images.slice(0, 2), images.slice(2)] : [images]);
---

<div class="test" data-kind={kind} data-total={total}>
	{
		questions.map((q) => (
			<section class="q" id={`q-${q.n}`} data-n={q.n} aria-labelledby={`q-${q.n}-text`}>
				<span class="q-count tech" data-pagefind-ignore>
					Вопрос {q.n} из {total}
				</span>
				<h2 class="q-text" id={`q-${q.n}-text`}>
					{q.text}
				</h2>
				{q.images.length > 0 && (
					<div class="q-media" data-count={q.images.length}>
						{rowsOf(q.images).map((row) => (
							<div class="q-row">
								{row.map((img) => (
									<img
										src={img.src}
										srcset={img.srcset ?? undefined}
										sizes={img.srcset ? '(min-width: 740px) 700px, 100vw' : undefined}
										alt={img.alt}
										style={`--r: ${img.ratio ?? 1}`}
										loading="lazy"
										decoding="async"
									/>
								))}
							</div>
						))}
					</div>
				)}
				<div class="q-options" role="group" aria-labelledby={`q-${q.n}-text`}>
					{q.options.map((o) => (
						<div class="opt" data-correct={o.correct ? '' : undefined}>
							<button type="button" class="opt-btn">
								<span class="opt-text">{o.text}</span>
								<span class="opt-state">
									<svg class="i-v" viewBox="0 0 24 24" aria-hidden="true">
										<path d="M4.5 12.5l5 5L19.5 7" />
									</svg>
									<svg class="i-x" viewBox="0 0 24 24" aria-hidden="true">
										<path d="M6 6l12 12M18 6L6 18" />
									</svg>
									<span class="opt-label tech" />
								</span>
							</button>
							{o.correct && q.explanationHtml && (
								<template class="opt-extra">
									<Fragment set:html={q.explanationHtml} />
								</template>
							)}
							{o.reply && (
								<template class="opt-extra">
									<p>{o.reply}</p>
								</template>
							)}
						</div>
					))}
				</div>
			</section>
		))
	}

	{/* ФИНАЛ (ТЗ §4). Пусто, пока последний вопрос не отвечен; потом здесь
	    либо подсказка про пропущенные вопросы, либо блок результата.
	    `aria-live` — чтобы диктор прочитал подсказку, появившуюся не там,
	    где стоит фокус. */}
	<div class="test-end" aria-live="polite" data-pagefind-ignore></div>

	{/* БЛОКИ РЕЗУЛЬТАТОВ ЛЕЖАТ В `<template>`: в поиск и к поисковикам тексты
	    результатов не идут (решение заказчика 9 октября 2026), а на место
	    их ставит скрипт по числу верных. Картинки внутри шаблона сборка
	    всё равно видит и сжимает: она ищет адреса по всему тексту страницы. */}
	{
		shownResults.map((r) => (
			<template class="result-tpl" data-slug={r.slug} data-from={r.from ?? ''} data-to={r.to ?? ''}>
				<section class="result" aria-label="Ваш результат" tabindex="-1">
					<span class="rcard-test tech">[&thinsp;Тест&thinsp;]</span>
					<p class="rcard-name">{title}</p>
					<div class:list={['rcard-body', r.image && 'has-img', kind === 'quiz' && 'has-score']}>
						{r.image && (
							<img
								class="rcard-img"
								src={r.image.src}
								srcset={r.image.srcset ?? undefined}
								sizes={r.image.srcset ? '(min-width: 621px) 180px, 104px' : undefined}
								alt=""
							/>
						)}
						{kind === 'quiz' && (
							<p class="rcard-score">
								<span class="rcard-score-n" />
								&nbsp;из&nbsp;{total}
							</p>
						)}
						<h2 class="rcard-title">
							{withNobr(r.title).map(({ part, nobr }) => (nobr ? <span class="nobr">{part}</span> : part))}
						</h2>
					</div>
					{r.textHtml && <div class="rcard-text" set:html={r.textHtml} />}
					{/* Кнопки «Поделиться результатом» пока нет — она появится
					    в сессии «Тесты-5». Места под неё не держим: «Пройти ещё
					    раз» стоит одна. */}
					<div class="result-actions">
						<button type="button" class="quiz-btn" data-again>
							Пройти ещё раз
						</button>
					</div>
					{r.postsHtml && (
						<div class="result-group">
							<span class="eyebrow tech">ещё по теме</span>
							<Fragment set:html={r.postsHtml} />
						</div>
					)}
				</section>
			</template>
		))
	}
</div>

<style>
	/* Колонка чтения, как у текста над ним. Сверху 48 — как в макете
	   от вступления до первого вопроса. Снизу 64 — столько же отделяет
	   у статьи текст от хвоста («Упоминается в материале» и т. п.); без них
	   линия «Предыдущий / Следующий» прилипала к рамке последнего варианта. */
	.test {
		width: 100%;
		max-width: var(--reading);
		margin: var(--sp-12) auto var(--sp-16);
	}

	/* Начало вопроса отмечает подпись «Вопрос 1 из 12», линии над вопросом
	   нет: §5 дизайн-системы — начало блока отмечается ровно один раз. */
	.q + .q {
		margin-top: var(--sp-16);
	}

	/* Скрипт прокручивает к вопросу («К вопросу 2 ↑», «Пройти ещё раз»)
	   и к результату. Без запаса подпись вставала вплотную к краю экрана. */
	.q,
	.result {
		scroll-margin-top: var(--sp-6);
	}

	.q-count {
		display: block;
		color: var(--accent-text);
		margin-bottom: var(--sp-2);
	}

	.q-text {
		margin: 0;
		font-size: var(--h3);
		line-height: 1.15;
		letter-spacing: normal;
		color: var(--ink);
	}

	/* ——— Картинки вопроса: ряды одной высоты, ничего не режется ———
	   У каждой картинки доля в ряду равна её пропорции (--r = ширина /
	   высота), поэтому высота у всех в ряду одна, а ширины разные. */
	.q-media {
		margin-top: var(--sp-4);
		display: grid;
		gap: var(--sp-2);
	}

	.q-row {
		display: flex;
		gap: var(--sp-2);
		align-items: flex-start;
	}

	.q-row img {
		flex: var(--r) 1 0;
		min-width: 0;
		width: 0;
		height: auto;
		aspect-ratio: var(--r);
		object-fit: contain;
	}

	/* Одна картинка — не шире колонки и не выше 360 (на компьютере 420),
	   по левому краю, как всё на странице материала. */
	.q-media[data-count='1'] img {
		flex: none;
		width: auto;
		max-width: 100%;
		max-height: 360px;
	}

	@media (min-width: 621px) {
		.q-media[data-count='1'] img {
			max-height: 420px;
		}
	}

	/* ——— Варианты: каждый в своей рамке, 8 px между (ТЗ §4, вариант A) ———
	   Группа кнопок, а не список: по смыслу это выбор, а не перечень. */
	.q-options {
		margin-top: var(--sp-6);
	}

	.opt {
		border: 1px solid var(--line);
		transition: border-color var(--transition-fast);
	}

	.opt + .opt {
		margin-top: var(--sp-2);
	}

	.opt-btn {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: start;
		column-gap: var(--sp-3);
		width: 100%;
		min-height: 48px;
		padding: var(--sp-3) var(--sp-4);
		border: 0;
		background: transparent;
		color: var(--ink);
		font-family: var(--font-body);
		font-size: var(--body-md);
		line-height: 1.5;
		text-align: left;
		transition: color var(--transition-fast);
	}

	.opt-btn[aria-disabled='true'] {
		cursor: default;
	}

	.opt-text {
		min-width: 0;
	}

	/* Справа — значок состояния и подпись техническим слоем. До ответа пусто. */
	.opt-state {
		display: none;
		align-items: center;
		gap: var(--sp-2);
		padding-top: 2px;
		line-height: 20px;
		white-space: nowrap;
	}

	.opt-state svg {
		width: 20px;
		height: 20px;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: square;
	}

	/* НА ТЕЛЕФОНЕ ПОДПИСИ У ЗНАЧКА НЕТ — только значок и цвет рамки (журнал
	   Тесты-М). Убрана от глаза, а не из разметки: диктору «верно» или «ваш
	   ответ» нужнее, чем зрячему, — цвета он не видит. */
	@media (max-width: 620px) {
		.opt-label {
			position: absolute;
			width: 1px;
			height: 1px;
			margin: -1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
	}

	/* Наведение — рамка и текст акцентом. Фокус с клавиатуры рисует общая
	   обводка сайта (global.css, `:focus-visible`), своей не заводим. */
	.opt:has(.opt-btn:hover:not([aria-disabled='true'])) {
		border-color: var(--accent-text);
	}

	.opt-btn:hover:not([aria-disabled='true']) .opt-text,
	.opt-btn:focus-visible:not([aria-disabled='true']) .opt-text {
		color: var(--accent-text);
	}

	/* ——— Состояния после ответа (ТЗ §4, макет, экран 3) ———
	   Цвета «верно / неверно» — исключение из палитры, только для тестов
	   (tokens.css, `--test-*`). Цвет никогда не говорит один: рядом всегда
	   значок ✓ или ✗ и, на компьютере, подпись. */
	/* Остальные варианты приглушены. Цветные исключены ЯВНО, а не тем, что
	   их правило стоит ниже: вес у них одинаковый, и равный вес решался бы
	   порядком в файле (урок CLAUDE.md «равный вес — это тоже перевес»). */
	.q.is-answered .opt:not(.is-right, .is-wrong) .opt-btn {
		color: var(--muted);
	}

	.opt.is-right {
		background: var(--test-correct-bg);
		border-color: var(--test-correct-line);
	}

	.opt.is-right .opt-btn {
		color: var(--test-correct-text);
	}

	.opt.is-right .opt-state {
		display: flex;
		color: var(--test-correct-icon);
	}

	.opt.is-wrong {
		background: var(--test-wrong-bg);
		border-color: var(--test-wrong-line);
	}

	.opt.is-wrong .opt-btn {
		color: var(--test-wrong-text);
	}

	.opt.is-wrong .opt-state {
		display: flex;
		color: var(--test-wrong-icon);
	}

	/* В разметке оба значка, показывается нужный. */
	.opt-state .i-x,
	.opt.is-wrong .i-v {
		display: none;
	}

	.opt.is-wrong .i-x {
		display: block;
	}

	/* ПОЯСНЕНИЕ — ПОД ТЕКСТОМ ВЕРНОГО ВАРИАНТА, ВНЕ КНОПКИ: в нём бывают
	   ссылки, а ссылку внутрь кнопки класть нельзя (журнал Тесты-М).
	   Его ставит скрипт из `<template>`, поэтому метки компонента на нём
	   нет — правила писаны `:global` внутри своего `.test`. */
	.test :global(.opt-extra) {
		padding: 0 var(--sp-4) var(--sp-4);
		font-size: var(--body-sm);
		line-height: 1.5;
		color: var(--text);
	}

	.test :global(.opt-extra p) {
		margin: 0;
	}

	.test :global(.opt-extra p + p) {
		margin-top: var(--sp-2);
	}

	/* Обычная ссылка — акцентом и подчёркнутая, как в макете. Ссылку на тайтл
	   не трогаем: у неё свой вид на весь сайт (global.css, `.anime-mention`). */
	.test :global(.opt-extra a:not(.anime-mention)) {
		color: var(--accent-text);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	/* ——— Финал: пропущенный вопрос (ТЗ §4, макет, экран 4) ——— */
	.test-end:empty {
		display: none;
	}

	.test-end :global(.quiz-left) {
		margin-top: var(--sp-16);
		padding: var(--sp-6);
		border: 1px solid var(--line);
	}

	.test-end :global(.quiz-left-text) {
		margin: 0 0 var(--sp-4);
		font-family: var(--font-display);
		font-size: var(--h3);
		line-height: 1.25;
		color: var(--ink);
	}

	.test-end :global(.quiz-left-links) {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-3);
	}

	/* Кнопка теста: «К вопросу N ↑» и «Пройти ещё раз». Рамка 1 px `--line`,
	   углы прямые, 44 в высоту — как варианты ответа. Капслока нет: это
	   обычная подпись Inter, как в макете. Стоит и в подсказке (её рисует
	   скрипт, метки компонента на ней нет), и в шаблоне результата — отсюда
	   `:global` внутри своего `.test`. */
	.test :global(.quiz-btn) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--sp-2);
		min-height: 44px;
		padding: 0 var(--sp-4);
		border: 1px solid var(--line);
		background: transparent;
		color: var(--ink);
		font-family: var(--font-body);
		font-size: var(--body-sm);
		text-decoration: none;
		transition:
			color var(--transition-fast),
			border-color var(--transition-fast);
	}

	.test :global(.quiz-btn:hover),
	.test :global(.quiz-btn:focus-visible) {
		border-color: var(--accent-text);
		color: var(--accent-text);
	}

	/* ——— Блок результата (ТЗ §4, «Финал»; макет, экран 5) ———
	   Без рамки и без логотипа, по левому краю. Начало отмечает подпись,
	   снизу 64 воздуха (их даёт `.test`). Всё до кнопки влезает в один
	   экран телефона — его скринят. */
	.result {
		margin-top: var(--sp-16);
	}

	/* Фокус сюда ставит скрипт, чтобы диктор начал читать с результата.
	   Это не элемент управления, и обводка вокруг всего блока читалась бы
	   поломкой; у кнопок внутри обводка своя, общая. */
	.result:focus {
		outline: none;
	}

	.rcard-test {
		display: block;
		color: var(--accent-text);
	}

	.rcard-name {
		margin: var(--sp-1) 0 0;
		font-family: var(--font-display);
		font-size: var(--card-title);
		line-height: 1.15;
		color: var(--ink);
	}

	.rcard-body {
		display: grid;
		gap: var(--sp-2) var(--sp-4);
		margin-top: var(--sp-6);
		align-items: center;
		grid-template-areas: 'score' 'title';
	}

	.rcard-body:not(.has-score) {
		grid-template-areas: 'title';
	}

	.rcard-body.has-img.has-score {
		grid-template-columns: 104px minmax(0, 1fr);
		grid-template-areas: 'img score' 'title title';
	}

	.rcard-body.has-img:not(.has-score) {
		grid-template-columns: 104px minmax(0, 1fr);
		grid-template-areas: 'img title';
	}

	.rcard-img {
		grid-area: img;
		width: 104px;
		max-height: 150px;
		height: auto;
		object-fit: contain;
	}

	.rcard-score {
		grid-area: score;
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--h1);
		line-height: var(--h1-lh);
		letter-spacing: var(--h1-ls);
		color: var(--ink);
	}

	.rcard-title {
		grid-area: title;
		margin: 0;
		font-size: var(--h2);
		line-height: var(--h2-lh);
		letter-spacing: var(--h2-ls);
		color: var(--ink);
	}

	.nobr {
		white-space: nowrap;
	}

	@media (min-width: 621px) {
		.rcard-img {
			width: 180px;
			max-height: 260px;
		}

		.rcard-body.has-img.has-score {
			grid-template-columns: 180px minmax(0, 1fr);
			grid-template-rows: auto 1fr;
			grid-template-areas: 'img score' 'img title';
			column-gap: var(--sp-8);
			align-items: start;
		}

		.rcard-body.has-img:not(.has-score) {
			grid-template-columns: 180px minmax(0, 1fr);
			column-gap: var(--sp-8);
			align-items: start;
		}
	}

	/* Текст результата — разметка из админки, метки компонента на ней нет. */
	.rcard-text {
		margin-top: var(--sp-4);
		font-size: var(--body-lg);
		line-height: 1.6;
		color: var(--text);
	}

	.rcard-text :global(p) {
		margin: 0;
	}

	.rcard-text :global(p + p) {
		margin-top: var(--sp-4);
	}

	.result-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-3);
		margin-top: var(--sp-6);
	}

	/* На телефоне кнопки во всю ширину, одна под другой (макет). */
	@media (max-width: 620px) {
		.result-actions {
			display: grid;
		}
	}

	/* «Ещё по теме» — врезки «Наш материал», тот же блок, что `::material`
	   в статье. Подпись у группы ОДНА, над всеми врезками (макет, экран 5):
	   свою подпись каждая врезка рисует сама, и здесь она спрятана, иначе
	   «[ ещё по теме ]» стояло бы над каждой. Поля врезки (48 сверху и
	   снизу — отбивка от абзацев статьи) тут заменены на 16 между соседями:
	   абзацев вокруг нет, рядом только такие же врезки. */
	.result-group {
		margin-top: var(--sp-12);
	}

	.result-group > .eyebrow {
		display: block;
		color: var(--accent-text);
		margin-bottom: var(--sp-3);
	}

	.result-group :global(.post-ref) {
		margin-block: 0;
	}

	.result-group :global(.post-ref + .post-ref) {
		margin-top: var(--sp-4);
	}

	.result-group :global(.post-ref > .body-label) {
		display: none;
	}
</style>

<script>
	// ПРОХОЖДЕНИЕ ВИКТОРИНЫ (ТЗ §4, макет, экран 3). Личностный тест
	// в этой сессии не нажимается: его подсчёт — сессия «Тесты-4».
	//
	// ЗАПУСК НА `astro:page-load`, А НЕ ОДИН РАЗ. Переходы по сайту идут без
	// перезагрузки (ClientRouter), и скрипт компонента браузер выполняет один
	// раз за сеанс: тест, открытый переходом с главной, иначе не нажимался бы.
	// Событие приходит и при первой загрузке, и после каждого перехода.
	//
	// ОТВЕТ НЕ МЕНЯЕТСЯ. Варианты отвеченного вопроса помечаются
	// `aria-disabled`, а не настоящим `disabled`: выключенная кнопка теряет
	// фокус, и человек с клавиатуры улетал бы в начало страницы. Фокус
	// остаётся на выбранном варианте, остальные выходят из обхода по Tab.

	const ПОДПИСЬ = { верно: 'верно', верныйОтвет: 'верный ответ', вашОтвет: 'ваш ответ' };

	function ответить(вопрос: HTMLElement, выбран: HTMLElement) {
		if (вопрос.classList.contains('is-answered')) return;
		вопрос.classList.add('is-answered');

		const варианты = [...вопрос.querySelectorAll<HTMLElement>('.opt')];
		const верный = варианты.find((вариант) => вариант.hasAttribute('data-correct'));

		for (const вариант of варианты) {
			const кнопка = вариант.querySelector<HTMLButtonElement>('.opt-btn');
			if (!кнопка) continue;
			кнопка.setAttribute('aria-disabled', 'true');
			if (вариант !== выбран) кнопка.tabIndex = -1;
		}

		const подписать = (вариант: HTMLElement, слово: string) => {
			const подпись = вариант.querySelector('.opt-label');
			if (подпись) подпись.textContent = слово;
		};

		if (верный) {
			верный.classList.add('is-right');
			подписать(верный, выбран === верный ? ПОДПИСЬ.верно : ПОДПИСЬ.верныйОтвет);

			// Пояснение — из `<template>` под кнопку верного варианта.
			const шаблон = верный.querySelector<HTMLTemplateElement>('template.opt-extra');
			if (шаблон && !верный.querySelector('div.opt-extra')) {
				const пояснение = document.createElement('div');
				пояснение.className = 'opt-extra';
				пояснение.append(шаблон.content.cloneNode(true));
				верный.append(пояснение);
			}
		}

		if (выбран !== верный) {
			выбран.classList.add('is-wrong');
			подписать(выбран, ПОДПИСЬ.вашОтвет);
		}

		вопрос.dataset.score = выбран === верный ? '1' : '0';
	}

	const НП = '\u00a0'; // неразрывный пробел — кодом, не знаком (урок CLAUDE.md)

	/** Плавно — если человек не просил систему обходиться без движения. */
	const плавно = (): ScrollBehavior =>
		matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

	/** «2», «2 и 5», «2, 5 и 7». */
	function перечислить(номера: string[]) {
		return номера.length === 1 ? номера[0] : `${номера.slice(0, -1).join(', ')} и${НП}${номера.at(-1)}`;
	}

	/**
	 * Что показать внизу после очередного ответа (ТЗ §4, «Финал»):
	 *   последний вопрос ещё не отвечен — ничего, человек идёт по тесту;
	 *   отвечен, но какие-то пропущены — подсказка и кнопки к ним;
	 *   отвечены все — блок результата.
	 */
	function обновитьФинал(тест: HTMLElement) {
		const конец = тест.querySelector<HTMLElement>('.test-end');
		const вопросы = [...тест.querySelectorAll<HTMLElement>('.q')];
		if (!конец || вопросы.length === 0) return;

		const пропущены = вопросы.filter((вопрос) => !вопрос.classList.contains('is-answered'));
		if (пропущены.length === 0) return показатьРезультат(тест, конец, вопросы);

		if (!вопросы.at(-1)!.classList.contains('is-answered')) {
			конец.replaceChildren();
			return;
		}

		const номера = пропущены.map((вопрос) => вопрос.dataset.n ?? '');
		const текст =
			номера.length === 1
				? `Остался вопрос${НП}${номера[0]}. Ответьте на${НП}него${НП}—${НП}и${НП}появится результат.`
				: `Остались вопросы ${перечислить(номера)}. Ответьте на${НП}них${НП}—${НП}и${НП}появится результат.`;

		const блок = document.createElement('div');
		блок.className = 'quiz-left';
		const абзац = document.createElement('p');
		абзац.className = 'quiz-left-text';
		абзац.textContent = текст;
		const ссылки = document.createElement('div');
		ссылки.className = 'quiz-left-links';
		for (const номер of номера) {
			const ссылка = document.createElement('a');
			ссылка.className = 'quiz-btn';
			ссылка.href = `#q-${номер}`;
			ссылка.dataset.go = номер;
			ссылка.textContent = `К вопросу${НП}${номер}${НП}↑`;
			ссылки.append(ссылка);
		}
		блок.append(абзац, ссылки);
		конец.replaceChildren(блок);
	}

	function показатьРезультат(тест: HTMLElement, конец: HTMLElement, вопросы: HTMLElement[]) {
		const счёт = вопросы.reduce((сумма, вопрос) => сумма + Number(вопрос.dataset.score ?? 0), 0);
		const шаблоны = [...тест.querySelectorAll<HTMLTemplateElement>('template.result-tpl')];
		const шаблон = шаблоны.find((t) => {
			const от = t.dataset.from === '' ? NaN : Number(t.dataset.from);
			const до = t.dataset.to === '' ? NaN : Number(t.dataset.to);
			return счёт >= от && счёт <= до;
		});

		// Счёт не попал ни в один диапазон — бывает только у черновика:
		// опубликованный с такой бедой не пропустит проверка при сборке
		// (scripts/check-quizzes.mjs). Говорим автору прямо, а не подставляем
		// соседний результат молча.
		if (!шаблон) {
			const абзац = document.createElement('p');
			абзац.className = 'quiz-left-text';
			абзац.textContent = `Для счёта ${счёт} нет результата — проверьте диапазоны «от» и «до» в админке.`;
			const блок = document.createElement('div');
			блок.className = 'quiz-left';
			блок.append(абзац);
			конец.replaceChildren(блок);
			return;
		}

		const результат = шаблон.content.cloneNode(true) as DocumentFragment;
		const число = результат.querySelector('.rcard-score-n');
		if (число) число.textContent = String(счёт);
		конец.replaceChildren(результат);

		// Тайтлы результата — блок под текстом материала (posts/[slug].astro),
		// по метке, которую блок ставит себе сам.
		document.querySelectorAll<HTMLElement>('[data-result-mentions]').forEach((блок) => {
			блок.hidden = блок.dataset.resultMentions !== шаблон.dataset.slug;
		});

		const блок = конец.querySelector<HTMLElement>('.result');
		блок?.scrollIntoView({ behavior: плавно(), block: 'start' });
		блок?.focus({ preventScroll: true });
	}

	/** «Пройти ещё раз»: всё как при открытии страницы, и к первому вопросу. */
	function сбросить(тест: HTMLElement) {
		тест.querySelectorAll<HTMLElement>('.q').forEach((вопрос) => {
			вопрос.classList.remove('is-answered');
			delete вопрос.dataset.score;
		});
		тест.querySelectorAll<HTMLElement>('.opt').forEach((вариант) => {
			вариант.classList.remove('is-right', 'is-wrong');
			вариант.querySelector('div.opt-extra')?.remove();
			const подпись = вариант.querySelector('.opt-label');
			if (подпись) подпись.textContent = '';
			const кнопка = вариант.querySelector<HTMLButtonElement>('.opt-btn');
			кнопка?.removeAttribute('aria-disabled');
			кнопка?.removeAttribute('tabindex');
		});
		тест.querySelector('.test-end')?.replaceChildren();
		document.querySelectorAll<HTMLElement>('[data-result-mentions]').forEach((блок) => (блок.hidden = true));
		кВопросу(тест, '1');
	}

	/** Плавно к вопросу и фокус на его первый вариант: клавиатура продолжает
	    с нужного места (ТЗ §4). */
	function кВопросу(тест: HTMLElement, номер: string) {
		const вопрос = тест.querySelector<HTMLElement>(`#q-${номер}`);
		if (!вопрос) return;
		вопрос.scrollIntoView({ behavior: плавно(), block: 'start' });
		вопрос.querySelector<HTMLButtonElement>('.opt-btn')?.focus({ preventScroll: true });
	}

	function запустить() {
		document.querySelectorAll<HTMLElement>('.test[data-kind="quiz"]').forEach((тест) => {
			// Один обработчик на тест: страница, вернувшаяся из истории,
			// приезжает с уже помеченным тестом — второй обработчик засчитал бы
			// нажатие дважды.
			if (тест.dataset.ready) return;
			тест.dataset.ready = '1';

			тест.addEventListener('click', (событие) => {
				const цель = событие.target as Element;

				const кВопросуN = цель.closest<HTMLElement>('[data-go]');
				if (кВопросуN) {
					событие.preventDefault();
					кВопросу(тест, кВопросуN.dataset.go ?? '');
					return;
				}

				if (цель.closest('[data-again]')) {
					сбросить(тест);
					return;
				}

				const кнопка = цель.closest<HTMLButtonElement>('.opt-btn');
				if (!кнопка || кнопка.getAttribute('aria-disabled') === 'true') return;
				const вопрос = кнопка.closest<HTMLElement>('.q');
				const вариант = кнопка.closest<HTMLElement>('.opt');
				if (!вопрос || !вариант || вопрос.classList.contains('is-answered')) return;
				ответить(вопрос, вариант);
				обновитьФинал(тест);
			});
		});
	}

	document.addEventListener('astro:page-load', запустить);
</script>
