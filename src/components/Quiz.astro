---
// Тело теста: вопросы и варианты (сессия «Тесты-3»). Правила —
// тз/ТЗ-тесты.md, §4; вид — тз/макеты-тесты.html, экран 3, вариант A.
//
// СТОИТ РЯДОМ С ТЕКСТОМ МАТЕРИАЛА, А НЕ ВНУТРИ НЕГО (`.content`). Правила
// текста статьи (`.content p / ul / h2` в posts/[slug].astro) ставят любому
// абзацу и списку внутри себя кегль 18, отступы и точку «•», и перебить их
// можно только наращиванием веса — дизайн-система (§2.1) называет это
// признаком беды, а проект — открытой дырой «страничные правила
// дотягиваются внутрь компонентов». Отдельным блоком под текстом спорить
// не с кем: вступление остаётся текстом статьи, вопросы — свои.
//
// БЕЗ СКРИПТА СТРАНИЦА ПОКАЗЫВАЕТ ВОПРОСЫ И ВАРИАНТЫ ТЕКСТОМ (ТЗ §4) —
// так их видят поисковики. Пояснения к вопросам и реплики лежат
// в `<template>`: туда не заглядывают ни поиск по сайту, ни поисковый робот,
// и ответы викторины не попадают цитатами в выдачу (решение заказчика
// 9 октября 2026). Какой вариант верный — меткой `data-correct` у варианта:
// метки поиск не читает.
//
// ЗНАЧКИ ✓ И ✗ — SVG ПРЯМО В РАЗМЕТКЕ, не знаки шрифта: в урезанных шрифтах
// сайта их нет, и на айфоне на их место встал бы цветной эмодзи (ТЗ §4).
interface Image {
	src: string;
	srcset: string | null;
	alt: string;
	ratio: number | null;
}

interface Props {
	kind: 'quiz' | 'personality';
	total: number;
	questions: {
		n: number;
		text: string;
		images: Image[];
		options: { text: string; correct: boolean; reply: string }[];
		explanationHtml: string;
	}[];
}

const { kind, total, questions } = Astro.props;

// Четыре картинки — два ряда по две (2 × 2), остальные — одним рядом.
const rowsOf = (images: Image[]) => (images.length === 4 ? [images.slice(0, 2), images.slice(2)] : [images]);
---

<div class="test" data-kind={kind} data-total={total}>
	{
		questions.map((q) => (
			<section class="q" id={`q-${q.n}`} data-n={q.n} aria-labelledby={`q-${q.n}-text`}>
				<span class="q-count tech" data-pagefind-ignore>
					Вопрос {q.n} из {total}
				</span>
				<h2 class="q-text" id={`q-${q.n}-text`}>
					{q.text}
				</h2>
				{q.images.length > 0 && (
					<div class="q-media" data-count={q.images.length}>
						{rowsOf(q.images).map((row) => (
							<div class="q-row">
								{row.map((img) => (
									<img
										src={img.src}
										srcset={img.srcset ?? undefined}
										sizes={img.srcset ? '(min-width: 740px) 700px, 100vw' : undefined}
										alt={img.alt}
										style={`--r: ${img.ratio ?? 1}`}
										loading="lazy"
										decoding="async"
									/>
								))}
							</div>
						))}
					</div>
				)}
				<div class="q-options" role="group" aria-labelledby={`q-${q.n}-text`}>
					{q.options.map((o) => (
						<div class="opt" data-correct={o.correct ? '' : undefined}>
							<button type="button" class="opt-btn">
								<span class="opt-text">{o.text}</span>
								<span class="opt-state">
									<svg class="i-v" viewBox="0 0 24 24" aria-hidden="true">
										<path d="M4.5 12.5l5 5L19.5 7" />
									</svg>
									<svg class="i-x" viewBox="0 0 24 24" aria-hidden="true">
										<path d="M6 6l12 12M18 6L6 18" />
									</svg>
									<span class="opt-label tech" />
								</span>
							</button>
							{o.correct && q.explanationHtml && (
								<template class="opt-extra">
									<Fragment set:html={q.explanationHtml} />
								</template>
							)}
							{o.reply && (
								<template class="opt-extra">
									<p>{o.reply}</p>
								</template>
							)}
						</div>
					))}
				</div>
			</section>
		))
	}
</div>

<style>
	/* Колонка чтения, как у текста над ним. Сверху 48 — как в макете
	   от вступления до первого вопроса. Снизу 64 — столько же отделяет
	   у статьи текст от хвоста («Упоминается в материале» и т. п.); без них
	   линия «Предыдущий / Следующий» прилипала к рамке последнего варианта. */
	.test {
		width: 100%;
		max-width: var(--reading);
		margin: var(--sp-12) auto var(--sp-16);
	}

	/* Начало вопроса отмечает подпись «Вопрос 1 из 12», линии над вопросом
	   нет: §5 дизайн-системы — начало блока отмечается ровно один раз. */
	.q + .q {
		margin-top: var(--sp-16);
	}

	.q-count {
		display: block;
		color: var(--accent-text);
		margin-bottom: var(--sp-2);
	}

	.q-text {
		margin: 0;
		font-size: var(--h3);
		line-height: 1.15;
		letter-spacing: normal;
		color: var(--ink);
	}

	/* ——— Картинки вопроса: ряды одной высоты, ничего не режется ———
	   У каждой картинки доля в ряду равна её пропорции (--r = ширина /
	   высота), поэтому высота у всех в ряду одна, а ширины разные. */
	.q-media {
		margin-top: var(--sp-4);
		display: grid;
		gap: var(--sp-2);
	}

	.q-row {
		display: flex;
		gap: var(--sp-2);
		align-items: flex-start;
	}

	.q-row img {
		flex: var(--r) 1 0;
		min-width: 0;
		width: 0;
		height: auto;
		aspect-ratio: var(--r);
		object-fit: contain;
	}

	/* Одна картинка — не шире колонки и не выше 360 (на компьютере 420),
	   по левому краю, как всё на странице материала. */
	.q-media[data-count='1'] img {
		flex: none;
		width: auto;
		max-width: 100%;
		max-height: 360px;
	}

	@media (min-width: 621px) {
		.q-media[data-count='1'] img {
			max-height: 420px;
		}
	}

	/* ——— Варианты: каждый в своей рамке, 8 px между (ТЗ §4, вариант A) ———
	   Группа кнопок, а не список: по смыслу это выбор, а не перечень. */
	.q-options {
		margin-top: var(--sp-6);
	}

	.opt {
		border: 1px solid var(--line);
		transition: border-color var(--transition-fast);
	}

	.opt + .opt {
		margin-top: var(--sp-2);
	}

	.opt-btn {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: start;
		column-gap: var(--sp-3);
		width: 100%;
		min-height: 48px;
		padding: var(--sp-3) var(--sp-4);
		border: 0;
		background: transparent;
		color: var(--ink);
		font-family: var(--font-body);
		font-size: var(--body-md);
		line-height: 1.5;
		text-align: left;
		transition: color var(--transition-fast);
	}

	.opt-btn:disabled {
		cursor: default;
	}

	.opt-text {
		min-width: 0;
	}

	/* Справа — значок состояния и подпись техническим слоем. До ответа пусто. */
	.opt-state {
		display: none;
		align-items: center;
		gap: var(--sp-2);
		padding-top: 2px;
		line-height: 20px;
		white-space: nowrap;
	}

	.opt-state svg {
		width: 20px;
		height: 20px;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: square;
	}

	/* НА ТЕЛЕФОНЕ ПОДПИСИ У ЗНАЧКА НЕТ — только значок и цвет рамки (журнал
	   Тесты-М). Убрана от глаза, а не из разметки: диктору «верно» или «ваш
	   ответ» нужнее, чем зрячему, — цвета он не видит. */
	@media (max-width: 620px) {
		.opt-label {
			position: absolute;
			width: 1px;
			height: 1px;
			margin: -1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
	}

	/* Наведение — рамка и текст акцентом. Фокус с клавиатуры рисует общая
	   обводка сайта (global.css, `:focus-visible`), своей не заводим. */
	.opt:has(.opt-btn:hover:not(:disabled)) {
		border-color: var(--accent-text);
	}

	.opt-btn:hover:not(:disabled) .opt-text,
	.opt-btn:focus-visible .opt-text {
		color: var(--accent-text);
	}
</style>
