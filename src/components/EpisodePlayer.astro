---
// Плеер выпуска на странице поста (§13 дизайн-системы, макет podcast.html).
// Тот же компонент стоит и в блоке «Аудиоверсия» у видеоэссе (§14) — второго
// плеера в проекте нет и заводить нельзя.
//
// Сам ничего не умеет играть: это разметка с данными в data-атрибутах, вся
// логика — в src/components/PlayerBar.astro, bindEpisodePlayers(). Дублирует
// закреплённую панель намеренно (тз/04): управляет тем же звуком, оба
// показывают одно состояние одновременно.
//
// ГЛАВНОЕ ЗДЕСЬ — ЦЕЛИ НАЖАТИЯ (§8). Видимый размер меньше 44, зона захвата
// обязана быть 44, и добирается она невидимой зоной:
//   ±15    — 36 видимых, псевдоэлемент `inset: -4px` добирает до 44;
//   скорость — плашка 34 видимая, поверх неё прозрачный select на всю ячейку 44;
//   таймлайн — полоса 3, но сам ползунок высотой 44: его тащат пальцем,
//              и 3 пикселя для этого не годятся никак.
//
// ПОЛЗУНОК ОСТАЛСЯ НАСТОЯЩИМ `<input type="range">`, а не собран из дивов,
// как в макете. Своя ручка на дивах — это заново написанные стрелки клавиатуры,
// роль для диктора, шаг, объявление позиции вслух; ничего из этого дизайн
// не отменяет, а нативный ползунок даёт это даром. Дизайну важен вид и размер
// цели — и то и другое стилями достижимо.
import { platformsOfKind } from '../data/platforms.js';

interface Props {
	guid: string;
	audioUrl: string;
	title: string;
	cover?: string | null;
	link: string;
	durationSec?: number | null;
	/** Левая подпись под плеером: «Бака! · выпуск №135». */
	caption?: string | null;
	/** Правая подпись. Есть только там, где таймкоды на странице действительно есть. */
	hint?: string | null;
}

const { guid, audioUrl, title, cover, link, durationSec, caption = null, hint = null } = Astro.props;

// Куда отправить человека, если звук не отдался. Первая площадка «где слушать»
// из общего списка — своего поля у поста под это нет и заводить его не за чем.
const fallbackPlatform = platformsOfKind('listen')[0];
---

{/* data-pagefind-ignore — плеер в поиск не берём (тз/06, шаг 1). Иначе в текст
    страницы попадали бы кнопки скоростей и счётчик времени, и в выдаче
    вылезало бы «−150.75×1×1.25×1.5×1.75×2×+15  0:00 / 0:00». Проверено
    на первом же пробном индексе — ровно это и вылезло. */}
<div
	class="episode-player"
	aria-label="Аудиоплеер"
	data-pagefind-ignore
	data-guid={guid}
	data-audio={audioUrl}
	data-title={title}
	data-cover={cover ?? ''}
	data-link={link}
	data-duration={durationSec ?? ''}
>
	{/* Обёртка нужна, чтобы «живой» плеер прятался и показывался ОДНИМ атрибутом
	    `hidden`: своих правил раскладки у неё нет, поэтому `[hidden]`
	    из global.css срабатывает без уточнений (§2.1). У самой плашки ошибки
	    ниже правило раскладки есть, и там уточнение обязательно — см. стили. */}
	<div class="ep-live">
		<div class="ep-main">
			<button type="button" class="ep-toggle play" aria-label="Воспроизвести">
				<svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
				<svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true" hidden>
					<rect x="7" y="5" width="4" height="14" rx="1"></rect>
					<rect x="13" y="5" width="4" height="14" rx="1"></rect>
				</svg>
			</button>

			<div class="ep-timeline">
				<div class="ep-time-row">
					<span class="ep-time-current">0:00</span>
					<span class="ep-time-duration">0:00</span>
				</div>
				{/* Полоса 3 px, сам ползунок высотой 44 — зона захвата целиком его.
				    Обёртка нужна только затем, чтобы полоску «идёт загрузка»
				    можно было положить ровно на линию таймлайна: её середина
				    и есть середина обёртки. */}
				<div class="ep-progress">
					<input class="ep-range" type="range" min="0" max="0" step="1" value="0" aria-label="Перемотка" />
				</div>
			</div>

			<div class="ep-tools">
				<button type="button" class="ep-back15 jump-btn" aria-label="Назад на 15 секунд">
					<svg viewBox="0 0 32 32" aria-hidden="true">
						<path d="M10.5 8.2H5.3V3.2"></path>
						<path d="M5.7 8.1A11.3 11.3 0 1 1 5 21.4"></path>
						<text x="16" y="19">15</text>
					</svg>
				</button>

				{/* Прозрачный select лежит поверх видимой плашки 34: плашка рисует,
				    select ловит нажатие и открывает родной список браузера. */}
				<span class="speed-wrap">
					<select class="ep-rate speed" aria-label="Скорость воспроизведения">
						<option value="0.75">0.75×</option>
						<option value="1" selected>1×</option>
						<option value="1.25">1.25×</option>
						<option value="1.5">1.5×</option>
						<option value="1.75">1.75×</option>
						<option value="2">2×</option>
					</select>
					<span class="speed-face" aria-hidden="true">1×</span>
				</span>

				<button type="button" class="ep-fwd15 jump-btn" aria-label="Вперёд на 15 секунд">
					<svg viewBox="0 0 32 32" aria-hidden="true">
						<path d="M21.5 8.2h5.2V3.2"></path>
						<path d="M26.3 8.1A11.3 11.3 0 1 0 27 21.4"></path>
						<text x="16" y="19">15</text>
					</svg>
				</button>
			</div>
		</div>

		{
			(caption || hint) && (
				<div class="ep-caption tech">
					<span>{caption}</span>
					<span>{hint}</span>
				</div>
			)
		}
	</div>

	{/* Третье состояние из справочника (блок 01): аудио не отдалось. Случай
	    не выдуманный — фид подкаста уже один раз не ответил. Показываем, что
	    делать дальше, а не пустой плеер, который молча не играет. */}
	<div class="ep-error" hidden>
		<p>Не удалось загрузить аудио. Попробуйте обновить страницу или послушать выпуск на площадке.</p>
		{
			fallbackPlatform && (
				<a class="ep-error-link" href={fallbackPlatform.url} target="_blank" rel="noopener noreferrer">
					Слушать на площадке «{fallbackPlatform.label}» <span aria-hidden="true">↗</span>
				</a>
			)
		}
	</div>
</div>

<style>
	.episode-player {
		width: 100%;
		padding: 18px 0 16px;
		border-top: 1px solid var(--ink);
		border-bottom: 1px solid var(--ink);
	}

	.ep-main {
		display: grid;
		grid-template-columns: 54px minmax(0, 1fr);
		gap: var(--sp-4);
		align-items: center;
	}

	/* Кнопка «играть», ±15 и скорость описаны в базе (src/styles/global.css):
	   тот же контрол стоит в закреплённой панели, и двух описаний у него
	   быть не должно. Здесь остаётся только то, что относится к раскладке
	   этого плеера. */

	.ep-timeline {
		min-width: 0;
	}

	.ep-time-row {
		display: flex;
		justify-content: space-between;
		gap: var(--sp-3);
		margin-bottom: var(--sp-2);
		font-family: var(--font-tech);
		font-size: var(--technical);
		letter-spacing: 0.04em;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	/* Ползунок: видимая полоса 3, высота элемента 44 — вся она и есть зона
	   захвата. Проигранная часть рисуется градиентом по переменной `--played`,
	   её ставит скрипт (PlayerBar.astro): у ползунка в вебките нет отдельного
	   слоя заливки, а два разных способа для двух браузеров разъехались бы. */
	.ep-range {
		--played: 0%;
		appearance: none;
		-webkit-appearance: none;
		display: block;
		width: 100%;
		height: 44px;
		margin: 0;
		background: transparent;
		cursor: pointer;
	}

	.ep-range::-webkit-slider-runnable-track {
		height: 3px;
		background: linear-gradient(to right, var(--accent-brand) 0 var(--played), var(--line-strong) var(--played) 100%);
	}

	.ep-range::-webkit-slider-thumb {
		appearance: none;
		-webkit-appearance: none;
		width: 14px;
		height: 14px;
		margin-top: -5.5px;
		border: 0;
		border-radius: 50%;
		background: var(--accent-brand);
	}

	.ep-range::-moz-range-track {
		height: 3px;
		background: linear-gradient(to right, var(--accent-brand) 0 var(--played), var(--line-strong) var(--played) 100%);
	}

	.ep-range::-moz-range-thumb {
		width: 14px;
		height: 14px;
		border: 0;
		border-radius: 50%;
		background: var(--accent-brand);
	}

	/* На узком экране инструменты уходят на свою строку: втискивать их
	   в один ряд с ползунком — это промахи пальцем. */
	.ep-tools {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		gap: var(--sp-2);
		padding-top: var(--sp-2);
	}

	.ep-caption {
		display: grid;
		gap: var(--sp-1);
		margin-top: var(--sp-3);
		color: var(--muted);
	}

	/* `:not([hidden])` тут обязателен, и это не перестраховка. Атрибут `hidden`
	   весит один селектор, а правило компонента в Astro всегда длиннее
	   (`.ep-error[data-astro-cid-…]`) — и `display: grid` побеждает. Разметка
	   при этом правильная, атрибут на месте, а плашка «не удалось загрузить»
	   висит на странице всегда, поверх исправно играющего плеера. Ровно это
	   и случилось. */
	.ep-error:not([hidden]) {
		display: grid;
		gap: var(--sp-4);
		justify-items: start;
		padding: var(--sp-6) 0;
	}

	.ep-error p {
		margin: 0;
		max-width: 52ch;
		font-size: var(--body-md);
		line-height: 1.6;
		color: var(--text);
	}

	.ep-error-link {
		min-height: 44px;
		display: inline-flex;
		align-items: center;
		gap: var(--sp-2);
		padding: 0 14px;
		border: 1px solid var(--line);
		color: var(--ink);
		font-size: var(--caption);
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.ep-error-link:hover,
	.ep-error-link:focus-visible {
		border-color: var(--accent-text);
		color: var(--accent-text);
	}

	.ep-progress {
		position: relative;
		overflow: hidden;
	}

	/* Загрузка: заливка не показывает позицию, а ходит туда-сюда — «идёт, ждите».
	   Ляжет ровно на линию таймлайна: полоса в ползунке отцентрована по его
	   высоте, значит середина обёртки — это она и есть.
	   Под prefers-reduced-motion анимация снимается общим правилом
	   из global.css, и полоска просто стоит на месте. */
	.episode-player.is-loading .ep-progress::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 0;
		width: 32%;
		height: 3px;
		margin-top: -1.5px;
		background: var(--accent-brand);
		animation: ep-buffer 1.4s ease-in-out infinite;
	}

	@keyframes ep-buffer {
		0% {
			transform: translateX(-110%);
		}
		100% {
			transform: translateX(340%);
		}
	}

	@media (min-width: 621px) {
		.ep-main {
			grid-template-columns: 54px minmax(0, 1fr) auto;
		}

		.ep-tools {
			grid-column: auto;
			padding-top: 0;
		}

		.ep-caption {
			display: flex;
			justify-content: space-between;
			gap: var(--sp-6);
		}
	}
</style>
