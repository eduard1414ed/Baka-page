---
import PostCard from './PostCard.astro';
import { visibleCategories } from '../content.config';

interface Props {
	posts: Array<{ id: string; body?: string; data: Record<string, any> }>;
	activeCategory?: string;
}

const { posts, activeCategory } = Astro.props;
---

<nav class="tabs" aria-label="Категории">
	<a href="/" class:list={['tab', { active: !activeCategory }]}>
		Все
	</a>
	{
		visibleCategories.map((c) => (
			<a href={`/category/${c.id}/`} class:list={['tab', { active: c.id === activeCategory }]}>
				{c.label}
			</a>
		))
	}
</nav>

{
	posts.length === 0 ? (
		<p class="empty">Пока нет постов.</p>
	) : (
		<div class="grid">
			{posts.map((post) => (
				<PostCard post={post} />
			))}
		</div>
	)
}

<style>
	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
		margin-bottom: var(--space-3);
	}

	.tab {
		padding: var(--space-1) var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
		transition:
			border-color var(--transition-fast),
			color var(--transition-fast);
	}

	.tab:hover,
	.tab:focus-visible {
		border-color: var(--color-accent);
		color: var(--color-accent-hover);
	}

	.tab.active {
		border-color: var(--color-accent);
		color: var(--color-text);
	}

	.empty {
		color: var(--color-text-muted);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: var(--space-3);
	}
</style>
