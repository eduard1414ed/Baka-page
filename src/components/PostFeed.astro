---
// Лента материалов главной: фильтры, сетки по режимам и подборка «Из архива»
// (раздел 3.3 и 3.4 ТЗ, §10.2 дизайн-системы).
//
// Вкладки переключают режим прямо на странице, без перехода. Режим «Все»
// показывает редакционные ряды, которые страница передаёт в слот `showcase`;
// режим типа — 12 самых свежих материалов этого типа. Ниже кнопка,
// раскрывающая подборку «Из архива», и ссылка в архив.
//
// РАЗДЕЛЫ ЭТОТ КОМПОНЕНТ БОЛЬШЕ НЕ РИСУЕТ. До части 4 он умел работать
// и лентой раздела — те же вкладки, но ссылками, — а теперь раздел это
// отфильтрованный архив (ArchiveView.astro), и вторая ветка убрана целиком.
// Держать её «на всякий случай» значило бы иметь два места, где верстается
// один и тот же список, и однажды они разойдутся.
//
// ГЛАВНАЯ ЛОВУШКА ЭТОГО ФАЙЛА (§2.1 дизайн-системы): селектор, который
// показывает или прячет карточку, НЕ ЗАДАЁТ ЕЙ РАСКЛАДКУ. В макете режим
// делал и то и другое сразу — `[data-mode="note"] .archive-card[data-type="note"]
// { display:block }` — и четыре селектора давали вес, который перебивал
// раскладку карточки: она объявляла себе `display:grid`, а в браузере
// оставалась блоком.
//
// Здесь этой битвы нет по устройству: у КАЖДОГО режима своя сетка, и прячется
// она атрибутом `hidden`, а не селектором. Карточек правила видимости
// не касаются вовсе, поэтому спорить с раскладкой нечему.
import PostCard from './PostCard.astro';
import LoadMore from './LoadMore.astro';
import { visibleCategories, categoriesShownIn } from '../content.config';
import { ARCHIVE_BASE } from '../lib/archive.mjs';

interface Props {
	posts: Array<{ id: string; body?: string; data: Record<string, any> }>;
	/** Что уже заняли редакционные ряды: эти материалы не должны повториться
	    в подборке «Из архива». */
	shownIds?: string[];
}

const { posts, shownIds } = Astro.props;

/** Сколько материалов показывает режим типа. Раздел 3.3 ТЗ. */
const PER_MODE = 12;

/** Сколько текстовых карточек раскрывает кнопка. Раздел 3.4 ТЗ. */
const OLDER_COUNT = 9;

const inCategory = (id: string) => {
	// Не `data.category === id`, а список: раздел «Подкаст» показывает
	// и выпуски, и приписанные к нему бонусы (см. content.config.ts).
	const shown = categoriesShownIn(id);
	return (post: (typeof posts)[number]) => shown.includes(post.data.category);
};

// Режимы фильтра: 12 самых свежих материалов каждого типа.
const modes = visibleCategories.map((category) => {
	const own = posts.filter(inCategory(category.id));
	return {
		id: category.id,
		label: category.label,
		// Подпись ссылки в архив у этого режима: «Все подкасты в архиве».
		// Множественное число берётся из `labelMany` — из `label` его не вывести:
		// раздел подкаста называется «Подкаст», в единственном числе.
		archiveLabel: `Все ${category.labelMany} в архиве`,
		archiveHref: `/category/${category.id}/`,
		top: own.slice(0, PER_MODE),
		// «Из архива» в режиме типа — следующие ПОСЛЕ показанных выше
		// в этом же режиме. Считать от редакционных рядов здесь нельзя:
		// выше в этом режиме стоят совсем другие материалы, и половина
		// подборки оказалась бы повтором того, что уже на экране.
		older: own.slice(PER_MODE, PER_MODE + OLDER_COUNT),
	};
});

// «Из архива» в режиме «Все» — следующие по хронологии после всех, кого
// разобрали редакционные ряды.
const olderAll = posts.filter((post) => !shownIds?.includes(post.id)).slice(0, OLDER_COUNT);

// Кнопка выключена, когда раскрывать нечего изначально (§8.1 дизайн-системы).
const nothingToShow = olderAll.length === 0;
---

<nav class="filters" aria-label="Фильтр материалов">
	<div class="filters-inner">
		<span class="filters-label tech">Материалы</span>
		{/* Подпись и адрес ссылки «в архив» висят на самой вкладке, а не лежат
		    отдельным списком в скрипте. Строки приходят из content.config.ts,
		    и второго места, где их надо было бы держать в согласии со списком
		    категорий, не появляется. */}
		<div class="filter-group">
			<button
				class="filter-btn active"
				type="button"
				data-filter="all"
				aria-pressed="true"
				data-archive-label="Весь архив"
				data-archive-href={ARCHIVE_BASE}
			>
				Все
			</button>
			{
				modes.map((mode) => (
					<button
						class="filter-btn"
						type="button"
						data-filter={mode.id}
						aria-pressed="false"
						data-archive-label={mode.archiveLabel}
						data-archive-href={mode.archiveHref}
					>
						{mode.label}
					</button>
				))
			}
		</div>
	</div>
</nav>

{/* Режим «Все» — не карточная сетка, а редакционные ряды. Их собирает
    страница: это композиция главной, а не лента. */}
<div class="all-layout" id="all-layout">
	<slot name="showcase" />
</div>

{
	modes.map((mode) => (
		<div class="archive-grid" data-mode={mode.id} hidden>
			{mode.top.map((post) => (
				<PostCard post={post} level={2} />
			))}
		</div>
	))
}

<LoadMore
	id="load-more"
	controls="older-materials"
	more="Показать ещё материалы"
	less="Свернуть архив"
	done="Все материалы показаны"
	disabled={nothingToShow}
/>

<section class="older-materials" id="older-materials" aria-label="Ранее опубликованные материалы" hidden>
	<div class="section-head">
		<span class="section-title tech">[&thinsp;из архива&thinsp;]</span>
	</div>
	<div class="list-grid" data-mode="all">
		{olderAll.map((post) => <PostCard post={post} variant="text" />)}
	</div>
	{
		modes.map((mode) => (
			<div class="list-grid" data-mode={mode.id} hidden>
				{mode.older.map((post) => (
					<PostCard post={post} variant="text" />
				))}
			</div>
		))
	}

	{/* Вход в архив — В КОНЦЕ РАСКРЫТОЙ ПОДБОРКИ, а не рядом с кнопкой
	    «Показать ещё». Кнопка разворачивает следующие девять материалов
	    тут же, ссылка уводит на другую страницу; стой они рядом, читателю
	    пришлось бы выбирать между двумя похожими действиями, не понимая
	    разницы. А в конце подборки ссылка отвечает на уже возникший вопрос:
	    «а дальше?»

	    ССЫЛКА ОДНА НА ВСЕ ТИПЫ: подпись и адрес меняются по текущему режиму
	    фильтра. Пять отдельных ссылок в пять разделов пришлось бы читать
	    и выбирать, а нужна из них всегда ровно одна — та, что соответствует
	    тому, что человек сейчас видит. */}
	<LoadMore id="archive-link" href={ARCHIVE_BASE} label="Весь архив" labelId="archive-link-label" />
</section>

<style>
	/* ---------- Фильтры ---------- */

	/* ПЕРЕНОСЯТСЯ, А НЕ СКРОЛЛЯТСЯ. Горизонтальная карусель на узком экране
	   прячет часть вкладок за краем: их не видно, и о них не догадаться. */
	.filters {
		border-bottom: 1px solid var(--line);
	}

	.filters-inner {
		min-height: 56px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0 var(--sp-6);
		padding: var(--sp-2) 0;
	}

	.filters-label {
		display: flex;
		align-items: center;
		font-weight: 600;
		color: var(--muted);
	}

	.filter-group {
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--sp-6);
	}

	/* Цель не меньше 44 по высоте (§8). Рамки у вкладки нет: коробок
	   в языке сайта не осталось, активная помечается подчёркиванием.

	   МОНОШИРИННОГО НАЧЕРТАНИЯ ТУТ НЕТ, и это важно. У кнопок стоял класс
	   технического слоя, и он приводил с собой гарнитуру: вкладки главной
	   набирались IBM Plex Mono, а точно такие же вкладки архива — Inter.
	   Один и тот же ряд выглядел на двух страницах по-разному. В макетах
	   у `.filter-btn` и у `.archive-tab` гарнитура не задана вовсе, то есть
	   обе берут основную; капслок, кегль и трекинг — здесь, ниже.
	   Моноширинной остаётся только подпись «Материалы» слева: она подпись
	   блока, а не вкладка. */
	.filter-btn {
		position: relative;
		min-height: 44px;
		display: inline-flex;
		align-items: center;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--ink);
		font-size: var(--caption);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: normal;
	}

	.filter-btn:hover {
		color: var(--accent-text);
	}

	/* Активное состояние никогда не обозначается только цветом (§3.3):
	   к начертанию добавляется подчёркивание. */
	.filter-btn.active {
		font-weight: 600;
	}

	.filter-btn.active::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 8px;
		height: 1.5px;
		background: var(--ink);
	}

	@media (min-width: 821px) {
		.filters-label {
			padding-right: var(--sp-6);
			border-right: 1px solid var(--line);
		}

		.filter-group {
			gap: 0 var(--sp-8);
		}
	}

	.all-layout {
		padding-top: var(--sp-6);
	}

	/* ---------- Сетки режимов ---------- */

	/* Раскладку задаёт РЕЖИМ КОНТЕЙНЕРА, видимость — атрибут `hidden`
	   (правило `[hidden]` лежит в global.css). Пересекаться им негде.

	   `:not([hidden])` тут обязателен, и это не перестраховка. Без него
	   `display: grid` перебивает `[hidden]` по весу — у правила компонента
	   селектор длиннее, — и все четыре сетки режимов вываливаются на страницу
	   сразу. Ошибка тихая: разметка правильная, атрибут на месте, а в браузере
	   лента вчетверо длиннее, чем должна быть. */
	.archive-grid:not([hidden]) {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--sp-8) var(--grid-gap);
		padding: var(--sp-12) 0 var(--sp-4);
	}

	/* Линию над первой карточкой рисует панель фильтров, а не сама карточка.
	   Тут та же беда, что была у сайдбара главной: панель закрывается своей
	   линией снизу, карточка открывается своей сверху, между ними только
	   отступ — и на узком экране получаются две линии подряд, что §5 системы
	   запрещает прямо.

	   Только до 761: выше сетка становится двух- и трёхколонной, и линии над
	   карточками первого ряда идут в ряд, как и задумано. Снять её у одной
	   из трёх — вот тогда ряд и выглядел бы сломанным. */
	@media (max-width: 760px) {
		.archive-grid > :global(.archive-card:first-child) {
			border-top: 0;
			padding-top: 0;
		}
	}

	@media (min-width: 761px) {
		.archive-grid[data-mode='podcast'],
		.archive-grid[data-mode='videoessay'],
		.archive-grid[data-mode='article'] {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.archive-grid[data-mode='note'] {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (min-width: 1101px) {
		.archive-grid[data-mode='podcast'] {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.empty {
		color: var(--muted);
		padding: var(--sp-12) 0;
	}

	/* Кнопка «Показать ещё» — общий компонент LoadMore.astro, стили в базе:
	   она стоит и здесь, и в каталоге, и на странице тайтла. */

	/* ---------- Подборка «Из архива» ---------- */

	.older-materials {
		padding: var(--sp-8) 0 var(--sp-3);
	}

	.section-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--sp-3) var(--sp-6);
		margin-bottom: var(--sp-6);
	}

	.section-title {
		font-weight: 600;
		color: var(--accent-text);
	}

	/* Сетка текстовых карточек живёт в global.css: ею выложена и подборка
	   здесь, и вся страница архива. Трёх копий одной сетки быть не должно. */
</style>

<script>
	// Переключение режимов и раскрытие подборки «Из архива».
	//
	// Слушатели висят на document и ищут элементы в момент события — так же,
	// как в шапке. Переходы между страницами идут без перезагрузки (ClientRouter
	// в Layout.astro), лента при переходе заменяется новой, а этот модуль
	// выполняется один раз за сеанс. Привяжись мы к конкретным кнопкам —
	// после первого же перехода фильтр перестал бы работать.
	import { setLoadMoreState } from '../lib/loadMore.mjs';

	function syncLoadMore() {
		const button = document.getElementById('load-more') as HTMLButtonElement | null;
		const older = document.getElementById('older-materials');
		if (!button || !older) return;

		const active = older.querySelector('.list-grid:not([hidden])');
		const empty = !active || active.childElementCount === 0;

		// Раскрывать нечего — закрываем то, что было раскрыто в прошлом режиме,
		// иначе на экране осталась бы пустая шапка «[ из архива ]».
		if (empty) older.hidden = true;

		// Три состояния переключает общий src/lib/loadMore.mjs: подписи
		// и стрелка у кнопки одни на весь сайт.
		setLoadMoreState(button, empty ? 'done' : older.hidden ? 'more' : 'less');
	}

	// Ссылка в архив ведёт туда же, куда сейчас смотрит фильтр: в режиме «Все» —
	// в весь архив, в режиме типа — в его раздел. Подпись и адрес берём
	// с самой вкладки: строки собраны на сервере из списка категорий,
	// и второго их списка в скрипте не заводим.
	function syncArchiveLink(button: HTMLElement) {
		const link = document.getElementById('archive-link') as HTMLAnchorElement | null;
		const label = document.getElementById('archive-link-label');
		if (!link || !label) return;

		const href = button.dataset.archiveHref;
		const text = button.dataset.archiveLabel;
		if (href) link.setAttribute('href', href);
		if (text) label.textContent = text;
	}

	function applyMode(mode: string) {
		document.querySelectorAll<HTMLElement>('.filter-btn[data-filter]').forEach((button) => {
			const on = button.dataset.filter === mode;
			button.classList.toggle('active', on);
			button.setAttribute('aria-pressed', String(on));
			if (on) syncArchiveLink(button);
		});

		const showcase = document.getElementById('all-layout');
		if (showcase) showcase.hidden = mode !== 'all';

		document.querySelectorAll<HTMLElement>('.archive-grid[data-mode]').forEach((grid) => {
			grid.hidden = grid.dataset.mode !== mode;
		});

		document.querySelectorAll<HTMLElement>('.list-grid[data-mode]').forEach((grid) => {
			grid.hidden = grid.dataset.mode !== mode;
		});

		syncLoadMore();
	}

	document.addEventListener('click', (event) => {
		const target = event.target instanceof Element ? event.target : null;
		if (!target) return;

		const filter = target.closest<HTMLElement>('.filter-btn[data-filter]');
		if (filter?.dataset.filter) {
			applyMode(filter.dataset.filter);
			return;
		}

		const button = target.closest<HTMLButtonElement>('#load-more');
		if (!button || button.disabled) return;

		const older = document.getElementById('older-materials');
		if (!older) return;

		older.hidden = !older.hidden;
		syncLoadMore();
	});
</script>
