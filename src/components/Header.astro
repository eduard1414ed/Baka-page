---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
---

<header class="header">
	<a href="/" class="logo-link" aria-label="Бака! — на главную">
		<Image
			src={logo}
			alt="Бака! Подкаст об аниме"
			widths={[220, 440]}
			sizes="220px"
			width={220}
			height={Math.round(220 * (logo.height / logo.width))}
		/>
	</a>

	{/* Отделка шапки — этап 8, здесь только двери к страницам, на которые иначе
	    можно было бы попасть лишь по прямому адресу. */}
	{/* Со слэшем на конце: без него Astro отдаёт переадресацию на «/search/»,
	    то есть каждый заход в поиск стоил бы лишнего похода в сеть. Так же
	    записаны ссылки на «/anime/» и «/category/…/» в остальном коде. */}
	<nav class="nav" aria-label="Разделы сайта">
		<a href="/about/" class="nav-link">О подкасте</a>
		<a href="/search/" class="nav-link">Поиск</a>
	</nav>
</header>

<style>
	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		padding: var(--space-3) var(--space-3) 0;
		max-width: var(--content-width);
		margin: 0 auto;
	}

	.nav {
		display: flex;
		gap: var(--space-2);
	}

	.nav-link {
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: var(--font-size-sm);
		transition: color var(--transition-fast);
	}

	.nav-link:hover {
		color: var(--color-accent);
	}

	.logo-link {
		display: inline-block;
	}

	.logo-link :global(img) {
		width: 220px;
		height: auto;
		aspect-ratio: 220 / 55;
	}
</style>
