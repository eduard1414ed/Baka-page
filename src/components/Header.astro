---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
---

<header class="header">
	<a href="/" class="logo-link" aria-label="Бака! — на главную">
		<Image
			src={logo}
			alt="Бака! Подкаст об аниме"
			widths={[220, 440]}
			sizes="220px"
			width={220}
			height={Math.round(220 * (logo.height / logo.width))}
		/>
	</a>
</header>

<style>
	.header {
		display: flex;
		align-items: center;
		padding: var(--space-3) var(--space-3) 0;
		max-width: var(--content-width);
		margin: 0 auto;
	}

	.logo-link {
		display: inline-block;
	}

	.logo-link :global(img) {
		width: 220px;
		height: auto;
		aspect-ratio: 220 / 55;
	}
</style>
