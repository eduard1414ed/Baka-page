---
// Кнопка «Показать ещё» — ОДИН КОМПОНЕНТ НА ВЕСЬ САЙТ (§8.1 дизайн-системы):
// главная, каталог, страница тайтла. Всегда по центру, между двумя линиями,
// без рамки, цель не меньше 44.
//
// У неё ровно три состояния, и путать их нельзя:
//
//   активное    — «Показать ещё <тип> ↓», догружает следующую порцию;
//   развёрнутое — «Свернуть <тип> ↑», ТА ЖЕ кнопка на том же месте;
//   выключенное — «Все <тип> показаны», `disabled`, цвет приглушённый.
//
// ОТДЕЛЬНОЙ КНОПКИ «СВЕРНУТЬ» РЯДОМ НЕ СУЩЕСТВУЕТ. Меняются подпись и стрелка,
// положение остаётся: вторая кнопка — это второй элемент, который придётся
// отдельно верстать, отдельно чинить и который на телефоне окажется в третьем
// месте экрана.
//
// Три подписи приезжают в разметку атрибутами (`data-more`, `data-less`,
// `data-done`), а переключает их общий src/lib/loadMore.mjs. Так у каждой
// ленты остаётся только её собственное дело — какие карточки показывать, —
// а правила самой кнопки лежат в одном месте.
//
// КОМПОНЕНТ БЫВАЕТ И КНОПКОЙ, И ССЫЛКОЙ: «Свернуть архив» разворачивает блок
// на месте, «Весь архив →» уводит на другую страницу. Выглядеть они обязаны
// одинаково, поэтому у ссылки явно сняты подчёркивание и цвет ссылки.
//
// Стили лежат в src/styles/global.css рядом с контролами плеера — по той же
// причине: компонент один, а мест, где он стоит, четыре.

interface Props {
	id?: string;
	/** Задан — компонент рисуется ссылкой, а не кнопкой. */
	href?: string;
	/** Подпись ссылки. Кнопка берёт подпись из состояния. */
	label?: string;
	/** Идентификатор подписи — нужен тому, кто меняет её на месте. */
	labelId?: string;
	/** Подписи трёх состояний кнопки. */
	more?: string;
	less?: string;
	done?: string;
	/** Что кнопка раскрывает: `aria-controls`. */
	controls?: string;
	/** Раскрывать нечего изначально — выключенное состояние. */
	disabled?: boolean;
}

const { id, href, label, labelId, more, less, done, controls, disabled = false } = Astro.props;
---

<div class="load-more-wrap">
	{
		href ? (
			<a class="load-more tech" id={id} href={href}>
				<span class="load-more-label" id={labelId}>
					{label}
				</span>
				<span class="down" aria-hidden="true">
					→
				</span>
			</a>
		) : (
			<button
				class="load-more tech"
				id={id}
				type="button"
				aria-expanded="false"
				aria-controls={controls}
				disabled={disabled}
				data-more={more}
				data-less={less}
				data-done={done}
			>
				<span class="load-more-label" id={labelId}>
					{disabled ? done : more}
				</span>
				{/* Стрелка живёт отдельным элементом: у выключенного состояния
				    её нет вовсе, а у развёрнутого она смотрит вверх. */}
				<span class="down" aria-hidden="true">
					{disabled ? '' : '↓'}
				</span>
			</button>
		)
	}
</div>
