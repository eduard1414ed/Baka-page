---
// Блок результата теста (ТЗ-тесты §4, «Финал»; макет, экран 5). Сессия
// «Тесты-5а» вынесла его из Quiz.astro, где он жил внутри шаблона
// `<template class="result-tpl">`.
//
// ОДИН КОМПОНЕНТ НА ДВА МЕСТА, И ЭТО ГЛАВНОЕ В НЁМ. Блок рисует тест
// (в шаблоне, на место его ставит скрипт Quiz.astro) и страница результата
// (`page`, posts/[slug]/[result].astro, ТЗ §5). Две копии разметки
// разъехались бы молча: страницу результата и тест рядом никто не открывает.
//
// НА СТРАНИЦЕ РЕЗУЛЬТАТА (`page`) у блока нет названия теста (оно в заголовке
// страницы), подписи `[ ТЕСТ ]`, кнопок и «ещё по теме». Строка счёта лежит
// спрятанной (`hidden`), а блок — без `has-score`: число берётся из ссылки
// (`?score=9`), и показывает его скрипт страницы, только если число годное.
// Без скрипта и без годного числа блок выглядит как у личностного теста.
//
// Прятать его разметку от поиска — дело того, кто его ставит: тест кладёт
// блок в `<template>`, туда поиск не заглядывает.
interface Image {
	src: string;
	srcset: string | null;
	alt: string;
	ratio: number | null;
}

interface Props {
	/** Название теста — подпись блока (его скринят без страницы).
	    На странице результата (`page`) не нужно: оно в заголовке страницы. */
	testTitle?: string;
	/** Сколько вопросов — для строки «9 из 12». */
	total: number;
	/** Есть ли строка счёта (у викторины есть, у личностного нет). Само
	    число ставит скрипт теста в `.rcard-score-n`. */
	withScore: boolean;
	result: {
		title: string;
		image: Image | null;
		textHtml: string;
		postsHtml: string;
		from?: number | null;
		to?: number | null;
	};
	/** Блок для страницы результата (ТЗ §5), а не для теста. */
	page?: boolean;
	/** Адрес страницы этого результата, `/posts/<тест>/<результат>/` —
	    куда ведёт «Поделиться результатом». Нужен только тесту. */
	sharePath?: string;
}

const { testTitle = '', total, withScore, result: r, page = false, sharePath = '' } = Astro.props;

// Слово через дефис («VHS-полка», «что-то») в заголовке результата не рвём
// по строкам (ТЗ §4): такие слова уходят в неразрывную обёртку.
const withNobr = (text: string) => text.split(/(\S+-\S+)/).map((part, i) => ({ part, nobr: i % 2 === 1 }));

// КАРТИНКА РЕЗУЛЬТАТА: вертикальная и квадратная — слева от заголовка
// (макет, экран 5, «Мушиси»: 104 px на телефоне, 180 на компьютере);
// ШИРОКАЯ — над заголовком во всю колонку (решение заказчика 9 октября
// 2026, Тесты-4). Слева в 180 px широкая обложка выходила полоской высотой
// в сотню пикселей. Пропорцию не знаем (файла нет на диске) — слева, как
// в макете.
const imgPlace = (img: Image | null) => (!img ? null : (img.ratio ?? 0) > 1 ? 'img-top' : 'img-side');
---

<section
	class:list={['result', page && 'is-page']}
	aria-label={page ? 'Результат' : 'Ваш результат'}
	tabindex={page ? undefined : '-1'}
	data-score-from={page && withScore ? (r.from ?? '') : undefined}
	data-score-to={page && withScore ? (r.to ?? '') : undefined}
	data-share-path={page ? undefined : sharePath}
	data-share-text={page ? undefined : `Мой результат в тесте «${testTitle}» — ${r.title}`}
>
	{
		!page && (
			<>
				<span class="rcard-test tech">[&thinsp;Тест&thinsp;]</span>
				<p class="rcard-name">{testTitle}</p>
			</>
		)
	}
	<div class:list={['rcard-body', imgPlace(r.image), withScore && !page && 'has-score']}>
		{r.image && (
			<img
				class="rcard-img"
				src={r.image.src}
				srcset={r.image.srcset ?? undefined}
				sizes={
					!r.image.srcset
						? undefined
						: imgPlace(r.image) === 'img-top'
							? '(min-width: 740px) 700px, 100vw'
							: '(min-width: 621px) 180px, 104px'
				}
				alt=""
			/>
		)}
		{withScore && (
			<p class="rcard-score" hidden={page}>
				<span class="rcard-score-n" />
				&nbsp;из&nbsp;{total}
			</p>
		)}
		<h2 class="rcard-title">
			{withNobr(r.title).map(({ part, nobr }) => (nobr ? <span class="nobr">{part}</span> : part))}
		</h2>
	</div>
	{r.textHtml && <div class="rcard-text" set:html={r.textHtml} />}
	{/* «ПОДЕЛИТЬСЯ РЕЗУЛЬТАТОМ» — ОДНА КНОПКА (ТЗ §5, решение заказчика
	    в Тесты-М), над «Пройти ещё раз»: на телефоне обе во всю ширину одна
	    под другой, на компьютере в ряд. Что она делает — скрипт Quiz.astro,
	    `поделиться`; под кнопками строка, куда он пишет, что вышло. Вид
	    кнопок — `.quiz-btn` в Quiz.astro. */}
	{
		!page && (
			<>
				<div class="result-actions">
					<button type="button" class="quiz-btn quiz-btn--main" data-share>
						Поделиться результатом
					</button>
					<button type="button" class="quiz-btn" data-again>
						Пройти ещё раз
					</button>
				</div>
				<p class="result-note" aria-live="polite" />
			</>
		)
	}
	{!page && r.postsHtml && (
		<div class="result-group">
			<span class="eyebrow tech">ещё по теме</span>
			<Fragment set:html={r.postsHtml} />
		</div>
	)}
</section>

<style>
	/* Без рамки и без логотипа, по левому краю. Начало отмечает подпись,
	   снизу 64 воздуха (их даёт `.test` в Quiz.astro). Всё до кнопки влезает
	   в один экран телефона — его скринят.
	   Скрипт теста прокручивает к результату: без запаса сверху подпись
	   вставала вплотную к краю экрана. */
	.result {
		margin-top: var(--sp-16);
		scroll-margin-top: var(--sp-6);
	}

	/* Фокус сюда ставит скрипт, чтобы диктор начал читать с результата.
	   Это не элемент управления, и обводка вокруг всего блока читалась бы
	   поломкой; у кнопок внутри обводка своя, общая. */
	.result:focus {
		outline: none;
	}

	/* На странице результата блок стоит сразу под заголовочным блоком
	   страницы — своя подпись не отмечает начало, отбивку даёт шапка
	   (макет, экран 6). */
	.result.is-page,
	.is-page .rcard-body {
		margin-top: 0;
	}

	.rcard-test {
		display: block;
		color: var(--accent-text);
	}

	.rcard-name {
		margin: var(--sp-1) 0 0;
		font-family: var(--font-display);
		font-size: var(--card-title);
		line-height: 1.15;
		color: var(--ink);
	}

	.rcard-body {
		display: grid;
		gap: var(--sp-2) var(--sp-4);
		margin-top: var(--sp-6);
		align-items: center;
		grid-template-areas: 'score' 'title';
	}

	.rcard-body:not(.has-score) {
		grid-template-areas: 'title';
	}

	.rcard-body.img-side.has-score {
		grid-template-columns: 104px minmax(0, 1fr);
		grid-template-areas: 'img score' 'title title';
	}

	.rcard-body.img-side:not(.has-score) {
		grid-template-columns: 104px minmax(0, 1fr);
		grid-template-areas: 'img title';
	}

	/* Широкая картинка — над всем остальным, по левому краю. Потолок
	   высоты тот же, что у одиночной картинки вопроса (360, на компьютере
	   420): почти квадратная во всю колонку иначе вытолкнула бы кнопки
	   из первого экрана телефона, а его скринят. */
	.rcard-body.img-top.has-score {
		grid-template-areas: 'img' 'score' 'title';
	}

	.rcard-body.img-top:not(.has-score) {
		grid-template-areas: 'img' 'title';
	}

	.rcard-body.img-top {
		align-items: start;
	}

	.rcard-img {
		grid-area: img;
		height: auto;
		object-fit: contain;
	}

	.img-side .rcard-img {
		width: 104px;
		max-height: 150px;
	}

	.img-top .rcard-img {
		width: auto;
		max-width: 100%;
		max-height: 360px;
		margin-bottom: var(--sp-2);
	}

	.rcard-score {
		grid-area: score;
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--h1);
		line-height: var(--h1-lh);
		letter-spacing: var(--h1-ls);
		color: var(--ink);
	}

	.rcard-title {
		grid-area: title;
		margin: 0;
		font-size: var(--h2);
		line-height: var(--h2-lh);
		letter-spacing: var(--h2-ls);
		color: var(--ink);
	}

	.nobr {
		white-space: nowrap;
	}

	@media (min-width: 621px) {
		.img-side .rcard-img {
			width: 180px;
			max-height: 260px;
		}

		.img-top .rcard-img {
			max-height: 420px;
		}

		.rcard-body.img-side.has-score {
			grid-template-columns: 180px minmax(0, 1fr);
			grid-template-rows: auto 1fr;
			grid-template-areas: 'img score' 'img title';
			column-gap: var(--sp-8);
			align-items: start;
		}

		.rcard-body.img-side:not(.has-score) {
			grid-template-columns: 180px minmax(0, 1fr);
			column-gap: var(--sp-8);
			align-items: start;
		}
	}

	/* Текст результата — разметка из админки, метки компонента на ней нет. */
	.rcard-text {
		margin-top: var(--sp-4);
		font-size: var(--body-lg);
		line-height: 1.6;
		color: var(--text);
	}

	.rcard-text :global(p) {
		margin: 0;
	}

	.rcard-text :global(p + p) {
		margin-top: var(--sp-4);
	}

	.result-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-3);
		margin-top: var(--sp-6);
	}

	/* На телефоне кнопки во всю ширину, одна под другой (макет). */
	@media (max-width: 620px) {
		.result-actions {
			display: grid;
		}
	}

	/* Что вышло у «Поделиться»: «ссылка скопирована» или ссылка текстом,
	   если браузер копировать не дал (макет, экран 5). Пусто — строки нет. */
	.result-note {
		margin: var(--sp-3) 0 0;
		font-size: var(--body-sm);
		line-height: 1.5;
		color: var(--muted);
	}

	.result-note:empty {
		display: none;
	}

	/* Ссылка, которую не удалось скопировать: поле только для чтения —
	   его содержимое выделяется целиком одним касанием (скрипт выделяет его
	   сам), и длинный адрес не рвёт строку. Поле ставит скрипт — метки
	   компонента на нём нет. */
	.result-note :global(input) {
		display: block;
		width: 100%;
		margin-top: var(--sp-2);
		padding: var(--sp-2) var(--sp-3);
		border: 1px solid var(--line);
		background: transparent;
		color: var(--ink);
		font-family: var(--font-body);
		font-size: var(--body-sm);
	}

	/* «Ещё по теме» — врезки «Наш материал», тот же блок, что `::material`
	   в статье. Подпись у группы ОДНА, над всеми врезками (макет, экран 5):
	   свою подпись каждая врезка рисует сама, и здесь она спрятана, иначе
	   «[ ещё по теме ]» стояло бы над каждой. Поля врезки (48 сверху и
	   снизу — отбивка от абзацев статьи) тут заменены на 16 между соседями:
	   абзацев вокруг нет, рядом только такие же врезки. */
	.result-group {
		margin-top: var(--sp-12);
	}

	.result-group > .eyebrow {
		display: block;
		color: var(--accent-text);
		margin-bottom: var(--sp-3);
	}

	.result-group :global(.post-ref) {
		margin-block: 0;
	}

	.result-group :global(.post-ref + .post-ref) {
		margin-top: var(--sp-4);
	}

	.result-group :global(.post-ref > .body-label) {
		display: none;
	}
</style>
