---
// Шапка большого раздела: надзаголовок, H1, подводка и строка счёта под ней.
// Так устроены и архив с разделами, и каталог тайтлов — вёрстка у них одна
// и та же, вплоть до того, в каких колонках сетки что лежит.
//
// ОДИН КОМПОНЕНТ, А НЕ ДВА ПОХОЖИХ. Копии разъехались бы молча: сначала
// отступом сверху, потом местом строки счёта, — и заметить это можно было бы,
// только открыв обе страницы рядом.
//
// ДЛИНА ПОДВОДКИ — ЧАСТЬ ВЁРСТКИ, а не свободный текст. Она стоит в правой
// колонке и держит высоту всей шапки: 55–95 знаков занимают две строки
// на широком экране и три на узком. Выйдет за диапазон — шапка станет выше
// или ниже соседних, и при переходе между разделами список под ней прыгнет.
// Про это же написано у самих текстов, в content.config.ts.
//
// И ЭТО НЕ ОПИСАНИЕ ДЛЯ ПОИСКОВИКА. Тот пишется для выдачи и живёт в метатеге;
// здесь человек читает страницу. Тексты разные, длина у них разная, и однажды
// они уже были одним полем — от этого шапка и прыгала.

interface Props {
	/** Надзаголовок техническим слоем: «Всё, что мы сделали». */
	eyebrow: string;
	heading: string;
	intro: string;
	/** «6 выпусков · 1 видеоэссе» или «Всего: 13 тайтлов». */
	countLine: string;
	/** Идентификатор строки счёта: каталог переписывает её при поиске. */
	countId?: string;
}

const { eyebrow, heading, intro, countLine, countId } = Astro.props;
---

<section class="page-head">
	<div>
		<div class="eyebrow tech">{eyebrow}</div>
		<h1>{heading}</h1>
	</div>
	{/* Строка счёта выводится ВСЕГДА, даже когда считать нечего. У пустого
	    раздела в ней пусто, но место под неё занято: иначе шапка такого
	    раздела на строку ниже соседних, и при переходе по вкладкам список
	    под ней прыгает. */}
	<div class="page-intro section-intro">
		<p>{intro}</p>
		<div class="page-count tech" id={countId}>{countLine}</div>
	</div>
</section>

<style>
	.page-head {
		display: grid;
		gap: var(--sp-4);
		padding: var(--sp-12) 0 var(--sp-8);
		border-bottom: 1px solid var(--line);
	}

	.eyebrow {
		font-weight: 600;
		color: var(--accent-text);
		margin-bottom: var(--sp-3);
	}

	.page-head h1 {
		margin: 0;
	}

	/* Кегль, интерлиньяж и цвет подводки — в общем `.section-intro`
	   (src/styles/global.css): та же подводка стоит на странице поиска,
	   и двух описаний у неё быть не должно. Здесь остаётся только место
	   в сетке и отступ до строки счёта. */
	.page-intro {
		min-width: 0;
	}

	.page-intro p {
		margin: 0 0 var(--sp-4);
	}

	/* Ровно одна строка технического слоя, даже когда она пустая: пустой блок
	   сам по себе схлопнулся бы в нулевую высоту, и место осталось бы
	   незанятым. */
	.page-count {
		color: var(--muted);
		min-height: calc(var(--technical) * 1.35);
	}

	@media (min-width: 821px) {
		.page-head {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--grid-gap);
			align-items: end;
			padding-top: var(--sp-16);
		}

		.page-head > div:first-child {
			grid-column: 1 / 8;
		}

		.page-intro {
			grid-column: 8 / 13;
		}
	}
</style>
