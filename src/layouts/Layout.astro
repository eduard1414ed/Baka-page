---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PlayerBar from '../components/PlayerBar.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Подкаст об аниме и о том, что скрывается между кадрами' } =
	Astro.props;
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Переходы между страницами без полной перезагрузки — без этого плеер
		     физически не может пережить переход на другую страницу, см. тз/04. -->
		<ClientRouter />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<PlayerBar />
	</body>
</html>
