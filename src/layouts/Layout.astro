---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PlayerBar from '../components/PlayerBar.astro';
import ToTop from '../components/ToTop.astro';
import Analytics from '../components/Analytics.astro';
import AnalyticsEvents from '../components/AnalyticsEvents.astro';
import { SITE_NAME, SITE_DESCRIPTION, SITE_LANG, SITE_LOCALE, pageTitle, absoluteUrl } from '../lib/site.mjs';
import { OG_DEFAULT, ogUrlForPost } from '../lib/ogImage.mjs';
import '../styles/global.css';

interface Props {
	/** Название страницы БЕЗ приписки «— Бака!»: её добавляет сам макет.
	    Не задано — берётся заголовок сайта целиком (так у главной). */
	title?: string;
	description?: string;
	/** Имя материала, если у него есть своя картинка превью. Не задано —
	    страница получает общую картинку сайта. */
	ogSlug?: string | null;
	/** Готовый адрес превью для страниц, которые не материалы: у тайтлов своё
	    пространство имён, и собирает его тот же src/lib/ogImage.mjs. */
	ogUrl?: string | null;
	imageAlt?: string;
	/** article у поста, website у всего остального. */
	type?: 'website' | 'article';
	/** Закрыть страницу от поисковиков. */
	noindex?: boolean;
	/** У страницы нет одного своего адреса — не объявлять канонический.
	    Случай ровно один: страница 404. Она отдаётся по ЛЮБОМУ ненайденному
	    адресу, и строчка «настоящий адрес этой страницы — /404/» была бы
	    неправдой, а заодно просьбой к поисковику её завести. Со страницей
	    поиска не путать: та закрыта `noindex`, но живёт по своему адресу,
	    и канонический ей нужен. */
	noCanonical?: boolean;
}
// Разметка Schema.org приезжает в <head> через именованный слот `head`,
// а не через свойство: так страница пишет её обычным <JsonLd slot="head" />.

const {
	title,
	description = SITE_DESCRIPTION,
	ogSlug = null,
	ogUrl = null,
	imageAlt = '',
	type = 'website',
	noindex = false,
	noCanonical = false,
} = Astro.props;

const documentTitle = pageTitle(title);

// Картинка превью — её рисует сборка (src/plugins/og-images-integration.mjs)
// В ФОРМЕ САМОЙ ОБЛОЖКИ: квадратная обложка даёт квадратное превью, кадр 16:9 —
// превью 16:9. Своя у материалов с обложкой, у остальных общая: логотип
// на бумаге, и вот она как раз полосой 1200×630.
//
// ФОРМАТ ОБЯЗАТЕЛЬНО JPEG, а не webp, в который Astro пережимает картинки
// по умолчанию: телеграм webp-превью разворачивает ненадёжно, а телеграм —
// главная площадка подкаста. Проверено по документации и баг-репортам,
// см. статус/этап-6-seo.md.
const ogImage = absoluteUrl(ogUrl ?? (ogSlug ? ogUrlForPost(ogSlug) : OG_DEFAULT));

// Канонический адрес: «вот настоящий адрес этой страницы, остальные — копии».
// Закрывает сразу два случая: www.bakapodcast.com, который показывает тот же
// сайт, и адреса с хвостом вроде ?utm_source=telegram или #t=730 из поиска
// по расшифровке — для поисковика это тоже были бы отдельные страницы.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang={SITE_LANG}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{documentTitle}</title>
		<meta name="description" content={description} />

		{/* Иконки и манифест — полный набор из раздела 8.1 подготовки к реализации.
		    Знак: хирагана ば на светлой плашке, дакутэн красный. Заменил букву «Б»
		    11 августа 2026 по решению заказчика; исходники набора и его описание
		    лежат в папке `favicon/` в корне проекта, на сайт она не идёт.

		    ПОРЯДОК ССЫЛОК ВАЖЕН: `.ico` первым как запасной, браузеры с поддержкой
		    SVG берут второй `link` и получают выворотку в тёмной теме — она
		    объявлена внутри самого файла. До этого набора ссылки на SVG тут
		    не было НАРОЧНО: в папке лежала другая, чужая картинка, и SVG перебивал
		    бы ей утверждённую иконку. Теперь оба файла рисуют один знак,
		    и причина отпала. */}
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
		<link rel="manifest" href="/site.webmanifest" />

		{!noCanonical && <link rel="canonical" href={canonical} />}
		{noindex && <meta name="robots" content="noindex, follow" />}
		<meta name="generator" content={Astro.generator} />

		{/* Превью при отправке ссылки в телеграм, вконтакт и прочие мессенджеры. */}
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content={SITE_LOCALE} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={documentTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		{/* РАЗМЕРА ЗДЕСЬ БОЛЬШЕ НЕТ, И ЭТО НЕ ПОТЕРЯ. Раньше тут стояло 1200×630
		    у каждой страницы — единый размер для всех превью. Теперь превью
		    повторяет форму обложки, а форму эту знает только сборочный шаг,
		    который рисует файлы уже ПОСЛЕ того, как эта страница записана:
		    любое число, поставленное здесь, было бы неправдой у большинства
		    материалов. Теги необязательные, соцсети берут размер из самой
		    картинки; неверный размер хуже отсутствующего — по нему рисуют
		    место под картинку до её загрузки. */}
		{imageAlt && <meta property="og:image:alt" content={imageAlt} />}

		{/* ВСЕГДА `summary_large_image`, в том числе у квадратных обложек выпусков.
		    Здесь стояло `summary` — казалось, что широкая карточка срежет квадрату
		    верх и низ. На деле вышло хуже: ТЕЛЕГРАМ ПО ЭТОМУ ТЕГУ РЕШАЕТ, ПОКАЗЫВАТЬ
		    ЛИ КАРТИНКУ ВООБЩЕ, и при `summary` не показал никакой. Проверено
		    на живых ссылках: у выпуска картинки не было, у статьи с
		    `summary_large_image` — была. Телеграм для нас главная площадка,
		    и он показывает картинку как есть, не обрезая её до полосы. */}
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — лента постов`} href="/rss.xml" />

		<slot name="head" />

		<!-- Переходы между страницами без полной перезагрузки — без этого плеер
		     физически не может пережить переход на другую страницу, см. тз/04. -->
		<ClientRouter />

		<!-- Счётчики посещаемости — ЕДИНСТВЕННОЕ МЕСТО НА ВЕСЬ САЙТ.
		     Стоит ПОСЛЕ <ClientRouter />, и это не случайно: счётчик считает
		     переходы по событию `astro:page-load`, которое роутер и рассылает.
		     Сам компонент — только скрипт, разметки он не добавляет ни байта. -->
		<Analytics />

		<!-- События для целей: плеер, транскрипт, поиск, тайтлы, уходы
		     на площадки. СТОИТ ПОСЛЕ <Analytics />, И ЭТО НЕ ПОРЯДОК ДЛЯ КРАСОТЫ:
		     очереди `ym` и `gtag` заводит тот компонент, а этот в них пишет.
		     Поменяй местами — первые события уйдут в никуда, и молча. -->
		<AnalyticsEvents />
	</head>
	<body>
		{/* Первый фокусируемый элемент страницы. Без него человек на клавиатуре
		    каждый раз проходит логотип, четыре пункта меню и поиск, прежде чем
		    добраться до текста, — и так на каждой странице. Видна только в фокусе,
		    проверяется одним нажатием Tab. */}
		<a class="skip-link" href="#main">Перейти к содержимому</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<ToTop />
		<PlayerBar />
	</body>
</html>

<script>
	// КАРТИНКА БЫЛА, НО НЕ ЗАГРУЗИЛАСЬ → ЗАГЛУШКА ВЕЗДЕ (тз/08, раздел 9.5).
	// Пустое место читатель принимает за поломку вёрстки, рисунок — за честный
	// ответ. Слушатель один на весь сайт: случиться это может с обложкой,
	// постером и превью, а не только там, где мы этого ждали.
	import { imageMissingHtml, IMAGE_MISSING_SRC } from '../lib/imageMissing.mjs';

	// `error` не всплывает — ловим на погружении, иначе до нас он не дойдёт.
	// Флаг `once` не годится: картинок много, и каждая может подвести своя.
	document.addEventListener(
		'error',
		(event) => {
			const target = event.target as HTMLElement | null;
			if (!(target instanceof HTMLImageElement)) return;

			// Не загрузился сам рисунок заглушки — заменять его на себя же
			// значило бы зациклиться.
			if (target.src.endsWith(IMAGE_MISSING_SRC)) return;

			// Размер меряем ДО подмены: после неё элемента уже нет, а заглушке
			// нужно занять ровно то же место, иначе страница дёрнется.
			// Узкой считаем колонку меньше 200 px — марка, карточка каталога,
			// строка выдачи: там подпись всё равно не поместилась бы.
			const box = target.getBoundingClientRect();
			const ratio = box.width > 0 && box.height > 0 ? box.width / box.height : null;

			const wrapper = document.createElement('div');
			wrapper.innerHTML = imageMissingHtml({ compact: box.width > 0 && box.width < 200 });

			const missing = wrapper.firstElementChild as HTMLElement | null;
			if (!missing) return;

			// Занять место ушедшей картинки. Пропорцию берём её же: у постера
			// и у обложки 16:9 она разная, а рамка вокруг не всегда своя.
			missing.style.width = '100%';
			if (ratio) missing.style.aspectRatio = String(ratio);

			target.replaceWith(missing);
		},
		true,
	);

	// «НАЗАД» В ШАПКЕ МАТЕРИАЛА ВЕДЁТ НАЗАД, А НЕ В РАЗДЕЛ.
	//
	// Раньше ссылка вела в раздел материала, и это сбивало: человек приходил
	// с главной или из поиска, а «назад» уводило его в «Заметки», где он
	// не был. Теперь она возвращает туда, откуда пришли.
	//
	// КОД ЖИВЁТ В МАКЕТЕ, И ЭТО НЕ ПРИДИРКА. Шапок две — у статьи
	// (`ContentHeader.astro`) и у выпуска (`posts/[slug].astro`), — а слушатель
	// один: он висит на документе, который переходы ClientRouter не меняют,
	// поэтому переподписываться после перехода не нужно вовсе. Скрипт самой
	// страницы для этого не годится: он приезжает вместе со страницей.
	//
	// ССЫЛКА ОСТАЁТСЯ НАСТОЯЩЕЙ ССЫЛКОЙ — раздел материала в её адресе. Это
	// не украшение, а запасной путь для того, у кого возвращаться некуда:
	// пришёл из поиска Гугла прямо на статью, и история пуста. Плюс работает
	// средняя кнопка мыши и «открыть в новой вкладке» — их мы не перехватываем.
	//
	// ЕСТЬ ЛИ КУДА ВОЗВРАЩАТЬСЯ — СПРАШИВАЕМ ДВУМЯ СПОСОБАМИ, и оба нужны.
	// Внутри сайта переходы идут без перезагрузки, `document.referrer` при
	// этом НЕ меняется и остаётся тем, с которого вкладку открыли, — значит
	// один referrer отвечал бы «некуда» после любого перехода по сайту.
	// Счётчик ведёт сам ClientRouter (`history.state.index`), и он же
	// правильно уменьшает его при возврате. Это внутренность Astro: пропадёт
	// она — поведение вернётся к прежнему (уход в раздел), но не сломается.
	function canGoBack() {
		const index = (history.state as { index?: number } | null)?.index;
		if (typeof index === 'number' && index > 0) return true;

		// Полная загрузка по внутренней ссылке: истории один шаг, но он наш.
		try {
			return Boolean(document.referrer) && new URL(document.referrer).origin === location.origin;
		} catch {
			return false;
		}
	}

	// СЛУШАЕМ В ФАЗЕ ПЕРЕХВАТА, И БЕЗ ЭТОГО НЕ РАБОТАЕТ ВОВСЕ. ClientRouter
	// ловит клики по внутренним ссылкам своим обработчиком, стоящим в <head>,
	// то есть раньше нашего, и ставит клику `preventDefault` — он уводит
	// на страницу раздела переходом без перезагрузки. Первая редакция этого
	// кода на `defaultPrevented` выходила, и кнопка честно называлась «Назад»,
	// а вела по-прежнему в раздел; заметил заказчик на живом сайте.
	// Перехват идёт до всплытия у всех, поэтому мы оказываемся первыми,
	// а роутер потом видит наш `preventDefault` и по ссылке не идёт —
	// он проверяет его тем же условием (проверено по его собранному коду).
	document.addEventListener(
		'click',
		(event) => {
			if (event.defaultPrevented) return;
			// Не наше: средняя кнопка, «открыть в новой вкладке», перетаскивание.
			if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

			const target = event.target as Element | null;
			if (!target?.closest?.('[data-back]')) return;
			if (!canGoBack()) return;

			event.preventDefault();
			history.back();
		},
		true,
	);

	// СВОЁ ВИДЕО ПОСЛЕ ПЕРЕХОДА БЕЗ ПЕРЕЗАГРУЗКИ НАДО РАЗБУДИТЬ.
	//
	// Переходы по сайту идут через <ClientRouter />: страница не грузится
	// заново, её разметка разбирается отдельно и переставляется в живой
	// документ. Картинке это безразлично, а <video> — нет: он приезжает уже
	// решившим, что грузить ему нечего, и сам за файлом не идёт. На экране
	// это чёрный прямоугольник с нулём на таймере: плеер есть, кнопки есть,
	// а длительности нет и нажатие ничего не делает.
	//
	// ПРИЗНАК РОВНО ЭТОТ: с главной не работает, F5 на той же странице лечит.
	// Из-за него ошибку дважды списывали на сеть и на HTTP/3.
	//
	// ЧИНИЛОСЬ ЭТО УЖЕ ДВАЖДЫ И ОБА РАЗА НЕ ДО КОНЦА. Причин было две,
	// и лечили только одну.
	//
	// ПЕРВАЯ: КОД ЖИЛ НЕ ТАМ. Он стоял в скрипте самой страницы материала,
	// а тот приезжает вместе со страницей — то есть впервые исполняется уже
	// внутри перехода, который и надо пережить. Подписаться на переход,
	// начавшийся раньше тебя, нельзя. Скрипт макета лежит на каждой странице
	// и подписан с самого первого открытия сайта, каким бы оно ни было.
	//
	// ВТОРАЯ: ВОПРОС БЫЛ ЗАДАН СЛИШКОМ УЗКО. Спрашивали ровно `networkState
	// === NETWORK_EMPTY` — «не начинал грузить». Но элемент, разобранный
	// в неживом документе, успевает попробовать и сдаться, и приезжает
	// в NETWORK_NO_SOURCE — «искал и не нашёл». Это другое число, условие
	// не совпадало никогда, и `load()` не вызывался ни разу. Проверка при этом
	// выглядела осмысленной и была написана ровно по симптому.
	//
	// СПРАШИВАЕМ ТЕПЕРЬ ПРО ДАННЫЕ, А НЕ ПРО НАМЕРЕНИЯ: данных нет совсем
	// (`HAVE_NOTHING`) и никто их не качает. Играющий или уже загруженный
	// плеер сюда не попадает — у него `readyState` заведомо больше, — поэтому
	// сбросить чужое воспроизведение мы не можем. `preload="none"` не трогаем:
	// там автор попросил не грузить ничего заранее.
	function wakeOwnVideos() {
		// Не `video[src]`: источник бывает и отдельным тегом внутри. Лишние
		// элементы отсеет проверка ниже, а забытый селектор — нет.
		document.querySelectorAll<HTMLVideoElement>('video').forEach((video) => {
			if (video.preload === 'none') return;
			if (video.readyState !== HTMLMediaElement.HAVE_NOTHING) return;
			if (video.networkState === HTMLMediaElement.NETWORK_LOADING) return;
			video.load();
		});
	}

	// Обе точки нужны, и вторая не лишняя. `astro:after-swap` — самый ранний
	// момент, когда новая разметка уже в живом документе: видео начинает
	// грузиться, пока страница ещё дорисовывается. `astro:page-load` —
	// единственное событие, которое приходит и при ОБЫЧНОМ открытии страницы.
	// Повторный вызов ничего не стоит: проверка выше пропустит уже
	// загрузившееся.
	document.addEventListener('astro:after-swap', wakeOwnVideos);
	document.addEventListener('astro:page-load', wakeOwnVideos);
</script>
