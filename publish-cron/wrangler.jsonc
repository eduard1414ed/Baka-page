{
	"name": "baki-publish-cron",
	"main": "src/index.js",
	"compatibility_date": "2026-08-06",
	// Раз в минуту — самое частое, что позволяет Cloudflare, и ровно то, что
	// нужно для точности «пост выходит не позже чем через 3 минуты после
	// назначенного времени» (см. тз/09-отложенный-постинг.md): минута на то,
	// чтобы будильник заметил время, плюс 1-2 минуты на саму сборку сайта.
	"triggers": {
		"crons": ["* * * * *"]
	},
	// Служебный адрес baki-publish-cron.…workers.dev держим включённым нарочно:
	// по нему работает ручной запуск POST /run с секретом RUN_TOKEN, он нужен
	// для отладки будильника, не дожидаясь реальной минуты (см. тз/09).
	// Без этой строки wrangler отключает адрес при первом же деплое — ровно так
	// он поступил с адресом сайта, когда 8 августа 2026 к тому привязывали домен.
	"workers_dev": true,
	// Прямая связь с воркером сайта в обход публичного workers.dev-адреса:
	// запрос к своему же workers.dev изнутри другого воркера на том же
	// аккаунте иногда отдаёт 404 (проверено на практике), Service Binding
	// этого не подвержен — обращение идёт напрямую, без похода в сеть.
	"services": [{ "binding": "SITE", "service": "baka-page" }]
}
