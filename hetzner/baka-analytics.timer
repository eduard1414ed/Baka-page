[Unit]
Description=Расписание сводки: понедельник, 09:00 по Москве

[Timer]
# 06:00 UTC = 09:00 по Москве. Понедельник выбран потому, что сводка считает
# семь дней, кончая ВЧЕРА: в понедельник это ровно прошлая календарная
# неделя, с понедельника по воскресенье.
OnCalendar=Mon *-*-* 06:00:00 UTC
# ПЕРЕЖИВАЕТ ВЫКЛЮЧЕННЫЙ СЕРВЕР. Persistent=true означает: пропустил срок,
# потому что машина не работала, — сделай, как только поднимешься. Без него
# перезагрузка в понедельник утром съела бы сводку целиком и молча.
Persistent=true
RandomizedDelaySec=300
Unit=baka-analytics.service

[Install]
WantedBy=timers.target
