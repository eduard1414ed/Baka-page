[Unit]
Description=Письмо о том, что робот %i не отработал

# ЗАЧЕМ ОН НУЖЕН. Робот, упавший молча, неотличим от робота, которому нечего
# сказать. У сводки цена такого молчания прямая: не пришла — заказчик решит,
# что читателей ноль. Этот юнит зовётся из OnFailure= и пишет в телеграм,
# КТО именно не отработал и какой командой посмотреть подробности.

[Service]
Type=oneshot
EnvironmentFile=/root/baka-secrets/telegram.env
ExecStart=/root/baka-robot/notify-fail.sh %i
