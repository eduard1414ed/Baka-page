{
	"name": "baki-cms-auth",
	"main": "src/index.js",
	"compatibility_date": "2026-08-05",
	// СЛУЖЕБНЫЙ АДРЕС baki-cms-auth.…workers.dev — ЭТО И ЕСТЬ ВХОД В АДМИНКУ.
	// Он стоит в `public/admin/config.yml` строкой `base_url`, и по нему идёт
	// весь логин через GitHub. Отключится — админка перестанет пускать вовсе,
	// то есть отвалится весь редакторский путь.
	//
	// БЕЗ ЭТОЙ СТРОКИ WRANGLER ОТКЛЮЧАЕТ АДРЕС ПРИ ПЕРВОМ ЖЕ ДЕПЛОЕ — ровно так
	// он поступил с адресом сайта, когда 8 августа 2026 к тому привязывали
	// домен, и чуть не убил сверку названий с Hetzner. У соседа
	// (`publish-cron/wrangler.jsonc`) строка стояла с объяснением, здесь её
	// не было — при том что `CLAUDE.md` и болячки уверяли, что она есть
	// у обоих (ревизия задачи 15, находка 8). То есть запись в документах
	// защищала не тем, чем казалось.
	//
	// СТРОКА ДОПИСАНА 15 АВГУСТА 2026, НО ВОРКЕР НЕ ДЕПЛОИЛСЯ. Решение
	// заказчика по сессии C: доступы пока не трогать. Деплой воркера входа —
	// это риск остаться без админки, и делать его ради строки, которая нужна
	// только СЛЕДУЮЩЕМУ деплою, незачем. Она сработает тогда, когда воркер
	// правда понадобится выложить.
	"workers_dev": true
}
