#!/bin/bash
# ЗАПУСКАТОР: ДВОЙНОЙ ЩЕЛЧОК — И ПРАВКИ НА САЙТЕ (задача 25).
#
# Это обёртка, и намеренно крошечная: вся работа в scripts/launch-deploy.mjs.
# Здесь только то, чего нельзя сделать из node, — открыть окно и не дать ему
# закрыться, пока человек не прочтёт написанное.
#
# ИМЕНА ПЕРЕМЕННЫХ ТОЛЬКО ЛАТИНИЦЕЙ. Русское имя в bash не имя вовсе: строка
# выполняется как команда и падает, а обращение к ней разбирается как литерал
# и никогда не пусто. На этом уже обжигались (урок в CLAUDE.md).

# Идём в папку проекта. "$0" — путь к самому этому файлу; в нём русские буквы
# и пробелы, поэтому всё в кавычках.
cd "$(dirname "$0")" || exit 1

printf '\033]0;Выкладка сайта\007'
clear

# Ищем node. /etc/paths его обычно даёт, но если Finder запустил нас с урезанным
# окружением — берём известные места, а не гадаем.
NODE_BIN=""
for CANDIDATE in "$(command -v node)" /usr/local/bin/node /opt/homebrew/bin/node; do
	if [ -n "$CANDIDATE" ] && [ -x "$CANDIDATE" ]; then NODE_BIN="$CANDIDATE"; break; fi
done

if [ -z "$NODE_BIN" ]; then
	echo
	echo "✗ Не нашёл Node.js — без него сайт не собрать."
	echo
	echo "ЧТО ДЕЛАТЬ: позовите Claude Code и скажите:"
	echo "«запускатор не находит node»."
	echo
	echo "Нажмите Enter, чтобы закрыть окно."
	read -r IGNORED
	exit 1
fi

"$NODE_BIN" scripts/launch-deploy.mjs
EXIT_CODE=$?

echo
echo "───────────────────────────────────────────────────────────────"
if [ "$EXIT_CODE" -eq 0 ]; then
	echo "Окно можно закрывать."
else
	echo "Работа не доведена до конца — прочтите, что написано выше."
fi
echo "Нажмите Enter, чтобы закрыть окно."
read -r IGNORED
exit "$EXIT_CODE"
